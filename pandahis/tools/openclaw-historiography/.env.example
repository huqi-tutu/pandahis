# 历史图谱 LLM provider 环境变量示例
# 复制为 .env 后按需填写，勿提交真实密钥。

# openclaw | deepseek
HIST_LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 标注与主流水线均在代码内写死 deepseek-v4-flash（见 llm.config）
DEEPSEEK_TEMPERATURE=0.2

# 项目数据根（默认 pandahis/pandahis，一般无需设置）
# HISTOGRAPH_ROOT=/Users/rachelcheng/Desktop/padanhis/pandahis/pandahis

# OpenClaw（仅 HIST_LLM_PROVIDER=openclaw 时需要）
# OPENCLAW_STATE_DIR=~/.openclaw-autoclaw
# HIST_OPENCLAW_AGENT=hist-worker
# TRANSLATE_AGENT=hist-worker

# 翻译完成后自动同步到线上 DB（默认开启）
# TRANSLATE_AUTO_SYNC=1
# MYSQL_HOST=49.235.165.220
# MYSQL_PORT=3306
# MYSQL_USER=histomap_admin
# MYSQL_PASSWORD=
# MYSQL_DB=histomap

# 详情质检/审校 LLM（OpenAI 兼容，默认 DeepSeek Flash）
# 未设置 REVIEW_API_KEY 时回退 DEEPSEEK_API_KEY
REVIEW_API_KEY=
REVIEW_BASE_URL=https://api.deepseek.com
REVIEW_MODEL=deepseek-v4-flash
REVIEW_TEMPERATURE=0.2
# 逐段审校默认超时（秒）；仅 REVIEW_* 通道
REVIEW_TIMEOUT_SEC=900

# Wikimedia API（可选；只读检索用匿名 API 亦可，OAuth 提额至 5000 次/小时）
# 在 https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration 注册
WIKI_CLIENT_ID=
WIKI_CLIENT_SECRET=
WIKI_ACCESS_TOKEN=
WIKI_USER_AGENT=YourApp/1.0 (contact: you@example.com)
