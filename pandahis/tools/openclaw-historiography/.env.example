# 历史图谱 LLM provider 环境变量示例
# 复制为 .env 后按需填写，勿提交真实密钥。

# openclaw | deepseek
HIST_LLM_PROVIDER=deepseek

# OpenAI 兼容通道（当前默认智谱 GLM-5.3）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_MODEL=glm-5.3
# 标注与主流水线默认写死 glm-5.3（见 llm.config）
DEEPSEEK_TEMPERATURE=0.2
# glm-5.3 输出上限约 64K
DEEPSEEK_MAX_TOKENS=65536
# glm-5.3 强制 thinking=enabled；DeepSeek 旧模型可用 disabled
DEEPSEEK_THINKING=enabled
# glm-5.3 推理深度：low（翻译长文推荐）| high | max
DEEPSEEK_REASONING_EFFORT=low

# 项目数据根（默认 pandahis/pandahis，一般无需设置）
# HISTOGRAPH_ROOT=/Users/rachelcheng/Desktop/padanhis/pandahis/pandahis

# OpenClaw（仅 HIST_LLM_PROVIDER=openclaw 时需要）
# OPENCLAW_STATE_DIR=~/.openclaw-autoclaw
# HIST_OPENCLAW_AGENT=hist-worker
# TRANSLATE_AGENT=hist-worker

# 翻译完成后自动同步到线上 DB（默认开启）
# TRANSLATE_AUTO_SYNC=1
# MYSQL_HOST=49.235.165.220
# MYSQL_PORT=3306
# MYSQL_USER=histomap_admin
# MYSQL_PASSWORD=
# MYSQL_DB=histomap

# ── 翻译流水线覆盖/质检旋钮（默认值即推荐值，一般无需设置）──
# Phase1 分批每批 M 句数（长卷改 12 可降低单批失败面）
# TRANSLATE_MOTHER_BATCH=18
# 语义覆盖：单轮最多 LLM 复核单元数
# TRANSLATE_COVERAGE_L2_MAX_REVIEW=24
# 语义覆盖：同单元复核次数上限，达限未 conveyed 即冻结
# TRANSLATE_COVERAGE_L2_MAX_ATTEMPTS=2
# Phase5 LLM 复检（默认关：程序门禁全过则零 LLM；置 1 恢复旧行为）
# TRANSLATE_PHASE5_LLM=0

# ── 翻译流水线（单次 LLM：完整规则 + 原文）──
# TRANSLATE_TEMPERATURE=0.45
# TRANSLATE_TIMEOUT_SEC=1800
# TRANSLATE_VERIFY=1
# TRANSLATE_COVERAGE_MODE=report
# TRANSLATE_COMPARE_DRAFT=0

# 详情质检/审校 LLM（OpenAI 兼容，默认 DeepSeek Flash）
# 未设置 REVIEW_API_KEY 时回退 DEEPSEEK_API_KEY
REVIEW_API_KEY=
REVIEW_BASE_URL=https://api.deepseek.com
REVIEW_MODEL=glm-5.3
REVIEW_TEMPERATURE=0.2
# 逐段审校默认超时（秒）；仅 REVIEW_* 通道
REVIEW_TIMEOUT_SEC=900

# Wikimedia API（可选；只读检索用匿名 API 亦可，OAuth 提额至 5000 次/小时）
# 在 https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration 注册
WIKI_CLIENT_ID=
WIKI_CLIENT_SECRET=
WIKI_ACCESS_TOKEN=
WIKI_USER_AGENT=YourApp/1.0 (contact: you@example.com)
