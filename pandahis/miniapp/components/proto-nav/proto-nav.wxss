/* 对齐原型 .nav-bar：高度 44px → 88rpx，底色 --ui-nav-bg */
.proto-nav-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(248, 246, 242, 0.96);
  border-bottom: none;
  box-shadow: 0 2rpx 8rpx rgba(74, 63, 63, 0.04);
}

.proto-status-h {
  width: 100%;
}

.proto-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.proto-bar--home {
  position: relative;
  justify-content: flex-start;
}

.proto-home-left {
  min-width: 0;
  flex-shrink: 0;
  z-index: 5;
  position: relative;
}

.proto-home-right {
  margin-left: auto;
  min-width: 80rpx;
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
  z-index: 5;
  position: relative;
}

.proto-mode-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(74, 63, 63, 0.06);
  border: none;
  color: #4a3f3f;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
  box-sizing: border-box;
}

.proto-mode-pill--icon {
  width: 56rpx;
  padding: 0;
  background: transparent;
  border: none;
}

.proto-mode-pill-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.proto-title--center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  max-width: 52%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}

.proto-side {
  min-width: 64rpx;
  display: flex;
  align-items: center;
}

.proto-side--left {
  justify-content: flex-start;
  margin-left: -8rpx;
}

.proto-side--right {
  justify-content: flex-end;
}

.proto-back {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx 8rpx 0;
  margin-left: -8rpx;
}

.proto-back-icon {
  width: 58rpx;
  height: 58rpx;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3E%3Cpath fill='none' stroke='%23000' stroke-width='1' stroke-linecap='round' stroke-linejoin='round' d='M15 18l-6-6 6-6'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3E%3Cpath fill='none' stroke='%23000' stroke-width='1' stroke-linecap='round' stroke-linejoin='round' d='M15 18l-6-6 6-6'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: contain;
  mask-size: contain;
  background-color: rgba(38, 38, 38, 0.76);
}

.proto-title {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  letter-spacing: 4rpx;
}

.proto-title--flex {
  flex: 1;
  text-align: center;
  padding: 0 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
