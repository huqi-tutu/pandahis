<view wx:if="{{visible}}" class="dictionary-sheet" catchtap="onBackdropTap">
  <view class="dictionary-sheet-card" catchtap="noop">
    <view class="dictionary-sheet-header">
      <view class="dictionary-sheet-close" bindtap="onClose" aria-role="button" aria-label="关闭">
        <text class="dictionary-sheet-close-icon">✕</text>
      </view>
    </view>

    <scroll-view
      class="dictionary-sheet-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      lower-threshold="80"
      bindscrolltolower="onWikiScrollToLower"
    >
      <!-- 检索词：汉字整体在左，拼音整体在右 -->
      <view class="dictionary-query-row">
        <view wx:if="{{showPinyin && !pinyinLoading && !pinyinError && pinyinEntries.length}}" class="query-with-pinyin">
          <text class="query-chars">{{pinyinCharsText}}</text>
          <text class="query-readings">{{pinyinReadingsText}}</text>
        </view>
        <block wx:else>
          <text class="query-plain">{{queryDisplay}}</text>
          <text wx:if="{{showPinyin && pinyinLoading}}" class="query-pinyin-hint">查音中…</text>
          <text wx:elif="{{showPinyin && pinyinError}}" class="query-pinyin-hint">{{pinyinError}}</text>
        </block>
      </view>

      <!-- 百科（槽位保留） -->
      <view class="dictionary-block dictionary-block-wiki">
        <text class="dictionary-block-label">百科</text>
        <view class="dictionary-block-body">
          <view wx:if="{{wikiLoading}}" class="dictionary-section-state">
            <text class="dictionary-section-state-text">正在查询百科</text>
          </view>

          <block wx:else>
            <view wx:if="{{wikiTitle}}" class="wiki-title-row">
              <text class="wiki-title">{{wikiTitle}}</text>
            </view>

            <view wx:if="{{wikiError}}" class="dictionary-section-state">
              <text class="dictionary-section-state-text">{{wikiError}}</text>
            </view>

            <view wx:elif="{{wikiEmpty}}" class="dictionary-section-state">
              <text class="dictionary-section-state-text">未找到相关百科条目</text>
            </view>

            <view wx:else class="wiki-body">
              <text
                wx:for="{{wikiParagraphs}}"
                wx:key="index"
                class="wiki-paragraph"
              >{{item}}</text>
              <view wx:if="{{wikiLoadingMore}}" class="dictionary-section-state dictionary-section-state-inline">
                <text class="dictionary-section-state-text">加载更多…</text>
              </view>
              <view wx:elif="{{!wikiHasMore && wikiParagraphs.length}}" class="dictionary-section-state dictionary-section-state-inline">
                <text class="dictionary-section-state-text">已全部加载</text>
              </view>
            </view>
          </block>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
