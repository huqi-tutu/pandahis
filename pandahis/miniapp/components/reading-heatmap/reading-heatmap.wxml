<view class="rh-card">
  <view class="rh-title">最近一年阅读足迹</view>

  <view class="rh-body">
    <!-- 左侧星期：与右侧网格同高、同行间距 -->
    <view class="rh-weekdays">
      <view class="rh-month-spacer"></view>
      <view wx:for="{{weekdayLabels}}" wx:key="*this" class="rh-weekday">{{item}}</view>
    </view>

    <!-- 右侧网格：单个横向滚动 -->
    <scroll-view class="rh-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="rh-grid">
        <view wx:for="{{weeks}}" wx:key="index" wx:for-item="week" class="rh-col">
          <view class="rh-month">{{week.monthLabel}}</view>
          <block wx:for="{{week.cells}}" wx:key="date" wx:for-item="cell">
            <view
              wx:if="{{!cell.future}}"
              class="rh-cell {{cell.date === selectedDate ? 'rh-cell--selected' : ''}}"
              style="{{cell.color ? 'background:' + cell.color + ';' : ''}}"
              data-date="{{cell.date}}"
              data-count="{{cell.count}}"
              catchtap="onCellTap"
            ></view>
            <view wx:else class="rh-cell rh-cell--future"></view>
          </block>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="rh-detail" wx:if="{{selected}}">
    <view class="rh-detail-icon-wrap">
      <image class="rh-detail-icon-img" src="{{selected.icon}}" mode="aspectFit" />
    </view>
    <view class="rh-detail-text">
      <view class="rh-detail-date">{{selected.label}}</view>
      <view class="rh-detail-sub">{{selected.sub}}</view>
    </view>
  </view>
</view>
