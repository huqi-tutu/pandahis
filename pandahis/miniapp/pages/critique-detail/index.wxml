<view class="proto-shell" bindtap="onPageTap">
  <proto-nav title="{{navTitle || '评述详情'}}" show-back="{{true}}"></proto-nav>

  <view class="detail-body" style="padding-top: {{pageTopPadPx}}px;">
    <view class="info-card card-paper">
      <view class="info-header">
        <text class="critique-title">{{title || '暂无主题'}}</text>
      </view>
      <view wx:if="{{author || book || era}}" class="info-divider"></view>
      <view wx:if="{{author}}" class="info-row">
        <text class="info-label muted">评述人</text>
        <text class="info-value">{{author}}</text>
      </view>
      <view wx:if="{{book}}" class="info-row">
        <text class="info-label muted">评述著作</text>
        <text class="info-value">{{book}}</text>
      </view>
      <view wx:if="{{era}}" class="info-row">
        <text class="info-label muted">评述时代</text>
        <text class="info-value">{{era}}</text>
      </view>
    </view>

    <view class="section-card card-paper">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">评述详情</text>
      </view>
      <block wx:for="{{[selectionMountKey]}}" wx:key="*this">
        <selection id="critiqueBodySelection" disable-context-menu bindselectionchange="onDetailSelectionChange">
          <text class="section-body" user-select>{{body || '暂无评述详情'}}</text>
        </selection>
      </block>
    </view>
  </view>

  <correction-modal
    visible="{{correctionVisible}}"
    mode="edit"
    civilizationName="{{civilizationName}}"
    dynastyName="{{dynastyName}}"
    boxTitle="{{boxTitle}}"
    selectedText="{{correctionSelectedText}}"
    sourceType="critique_detail_selection"
    submitting="{{correctionSubmitting}}"
    bind:close="closeCorrection"
    bind:submit="onCorrectionSubmit"
  />

  <dictionary-sheet
    visible="{{dictionaryVisible}}"
    query="{{dictionaryQuery}}"
    bind:close="closeDictionary"
  />

  <text-selection-bar
    visible="{{selectionBarVisible}}"
    left="{{selectionBarLeft}}"
    top="{{selectionBarTop}}"
    placement="{{selectionBarPlacement}}"
    showShare="{{false}}"
    bind:copy="onSelectionCopy"
    bind:query="onSelectionQuery"
    bind:correction="onSelectionCorrection"
  />
</view>
