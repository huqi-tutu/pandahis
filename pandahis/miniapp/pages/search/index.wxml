<view class="page-search">
  <proto-nav title="搜索" show-back="{{false}}"></proto-nav>

  <view class="search-body" style="padding-top: {{pageTopPadPx}}px;">

    <!-- 搜索框 -->
    <view class="search-bar-wrap">
      <view class="search-bar">
        <text class="search-ico">⌕</text>
        <input
          class="search-input"
          placeholder="年代 / 人物 / 事件"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindconfirm="onConfirm"
          bindinput="onInput"
          value="{{keyword}}"
          adjust-position="{{true}}"
          cursor-spacing="{{40}}"
        />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="onClear">
          <text class="search-clear-ico">✕</text>
        </view>
      </view>
    </view>

    <!-- 热门搜索：TOP10 横滑 -->
    <view class="search-section" wx:if="{{hotKeywords.length}}">
      <text class="search-section-title">热门搜索</text>
      <scroll-view
        class="hot-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        enable-flex
      >
        <view class="hot-inner">
          <view
            wx:for="{{hotKeywords}}"
            wx:key="keyword"
            class="search-tag {{item.isHot ? 'hot' : ''}}"
            bindtap="tapKeyword"
            data-k="{{item.keyword}}"
          >{{item.keyword}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 最近搜索 -->
    <view class="search-section" wx:if="{{historyKeywords.length}}">
      <text class="search-section-title">最近搜索</text>
      <view class="search-history">
        <view
          wx:for="{{historyKeywords}}"
          wx:key="keyword"
          class="search-history-item"
        >
          <view
            class="search-history-text"
            bindtap="tapKeyword"
            data-k="{{item.keyword}}"
          >{{item.keyword}}</view>
          <view
            class="search-history-del"
            catchtap="removeHistory"
            data-k="{{item.keyword}}"
            hover-class="search-history-del--hover"
            hover-stay-time="80"
          >
            <text class="search-history-del-ico">✕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view
      wx:if="{{!hotKeywords.length && !historyKeywords.length}}"
      class="search-empty"
    >输入关键词搜索朝代、人物与史略</view>

  </view>
</view>
