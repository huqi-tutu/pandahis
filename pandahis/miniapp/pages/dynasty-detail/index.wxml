<wxs src="./panel-scroll.wxs" module="panelScroll" />

<view class="page-shell">

  <!-- 导航栏 -->
  <proto-nav title="{{navTitle}}" show-back="{{true}}" />

  <view wx:if="{{loading}}" class="dynasty-state" style="padding-top: {{scrollTop}}px;">
    <text class="dynasty-state-text">加载中…</text>
  </view>

  <view wx:elif="{{loadError}}" class="dynasty-state" style="padding-top: {{scrollTop}}px;">
    <text class="dynasty-state-text">{{loadError}}</text>
    <view class="dynasty-state-actions">
      <view class="dynasty-retry-btn" bindtap="retryLoad" hover-class="dynasty-retry-hover" hover-stay-time="60">重试</view>
      <view wx:if="{{loadErrorDetail}}" class="dynasty-copy-btn" bindtap="copyLoadError" hover-class="dynasty-retry-hover" hover-stay-time="60">复制错误信息</view>
    </view>
  </view>

  <view wx:elif="{{unit && swim}}">

    <!-- 并发政权 Tab 栏（fixed，紧贴 proto-nav 底部） -->
    <view class="unit-civ-tabs" style="top: {{headerPadPx}}px;">
      <scroll-view class="unit-region-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
        <view class="unit-region-inner">
          <view
            wx:for="{{concurrentItems}}"
            wx:key="*this"
            class="unit-civ-tab {{index === 0 ? 'active' : ''}}"
          >{{item}}</view>
        </view>
      </scroll-view>
      <view class="unit-civ-fade"></view>
    </view>

    <!-- 吸顶后：固定时间轴镜像（由 WXS 跟面板横滑实时同步，非独立 scroll-view） -->
    <view
      wx:if="{{axisPinned && swim}}"
      class="dyn-axis-fixed"
      style="top: {{scrollTop}}px;"
    >
      <view class="dyn-axis-fixed-clip">
        <view
          class="dyn-axis-fixed-track"
          style="transform: translateX(-{{axisMirrorLeft}}px); width: {{swim.canvasWidthRpx || swim.sheetWidthRpx}}rpx;"
        >
          <view class="dyn-axis-scroll-sheet" style="width: {{swim.canvasWidthRpx || swim.sheetWidthRpx}}rpx;">
            <view class="dyn-axis-pad" style="width: {{swim.canvasPadLeftRpx || 40}}rpx;"></view>
            <view class="dyn-axis-sheet" style="width: {{swim.sheetWidthRpx}}rpx;">
              <view class="dyn-swim-axis">
                <view class="dyn-swim-axis-inner">
                  <text
                    wx:for="{{swim.ticks}}"
                    wx:key="label"
                    class="dyn-swim-axis-tick {{item.edgeStart ? 'dyn-swim-axis-tick--edge-start' : ''}}"
                    style="left: {{item.left}};"
                  >{{item.hideLabel ? '' : item.label}}</text>
                  <text class="dyn-swim-axis-tick dyn-swim-axis-tick--end" style="left:100%;">{{swim.endLabel}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 主滚动区 -->
    <scroll-view
      class="dynasty-scroll"
      scroll-y enhanced show-scrollbar="{{false}}"
      style="top: {{scrollTop}}px;"
      bindscroll="onDynastyScroll"
    >

      <!-- 英雄区 -->
      <view class="unit-hero-card">
        <view class="unit-hero">
          <view class="unit-title-line">

            <text class="unit-title">{{dynastyTitle}}</text>

            <view class="unit-title-meta-stack">
              <view class="unit-inline-meta">
                <text class="unit-title-path">{{unit.crumbText}}</text>
                <text class="unit-inline-sep">·</text>
                <text class="unit-title-range">{{heroSubLine}}</text>
              </view>
              <view wx:if="{{nextUnit}}" class="unit-hero-next-dynasty" bindtap="goNext">
                <text class="unit-next-text">下一朝代：{{nextUnit.title}} ›</text>
              </view>
            </view>

            <view class="unit-title-spacer"></view>

            <view class="unit-hero-actions">
              <view class="unit-action-btn" bindtap="onFavoriteTap">
                <image
                  class="unit-action-img"
                  src="/images/icons/{{isFav ? 'shoucangB' : 'shoucangA'}}.png"
                  mode="aspectFit"
                />
              </view>
            </view>

          </view>
        </view>

        <view class="unit-intro" bindtap="openIntro">
          <block wx:key="selectionMountKey">
            <selection id="dynastyIntroSelection" disable-context-menu bindselectionchange="onDetailSelectionChange">
              <text class="unit-intro-text" user-select>{{introDisplay}}</text>
            </selection>
          </block>
          <text wx:if="{{introCanExpand}}" class="unit-intro-after"> ›</text>
        </view>
      </view>

      <!-- ── 历史面板：时间轴 + 画布 共用同一横向滚动（天然同步） ── -->
      <view class="dyn-panel-board">
        <scroll-view
          class="dyn-swim-hscroll dyn-panel-hscroll"
          scroll-x
          enhanced
          show-scrollbar="{{false}}"
          scroll-with-animation="{{false}}"
          bounces="{{false}}"
          scroll-left="{{panelScrollLeft}}"
          data-axis-pinned="{{axisPinned}}"
          bindscroll="{{panelScroll.onScroll}}"
        >
          <view class="dyn-panel-sheet" style="width: {{swim.canvasWidthRpx || swim.sheetWidthRpx}}rpx;">
            <!-- 时间轴行（未吸顶时随面板横滑；吸顶后由占位撑高 + 顶部镜像） -->
            <view wx:if="{{!axisPinned}}" class="dyn-panel-axis">
              <view class="dyn-axis-scroll-sheet" style="width: {{swim.canvasWidthRpx || swim.sheetWidthRpx}}rpx;">
                <view class="dyn-axis-pad" style="width: {{swim.canvasPadLeftRpx || 40}}rpx;"></view>
                <view class="dyn-axis-sheet" style="width: {{swim.sheetWidthRpx}}rpx;">
                  <view class="dyn-swim-axis">
                    <view class="dyn-swim-axis-inner">
                      <text
                        wx:for="{{swim.ticks}}"
                        wx:key="label"
                        class="dyn-swim-axis-tick {{item.edgeStart ? 'dyn-swim-axis-tick--edge-start' : ''}}"
                        style="left: {{item.left}};"
                      >{{item.hideLabel ? "" : item.label}}</text>
                      <text class="dyn-swim-axis-tick dyn-swim-axis-tick--end" style="left:100%;">{{swim.endLabel}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
            <view wx:else class="dyn-panel-axis-spacer"></view>

            <!-- 史略画布 -->
            <view
              class="dyn-canvas"
              style="width: {{swim.canvasWidthRpx || swim.sheetWidthRpx}}rpx; height: {{swim.canvasHeightRpx || 800}}rpx;"
            >
              <view class="dyn-cat-col" style="width: {{swim.canvasPadLeftRpx || 40}}rpx;">
                <view
                  wx:for="{{swim.categoryBands}}"
                  wx:key="key"
                  class="dyn-cat-pill"
                  style="top: {{item.topRpx}}rpx; height: {{item.heightRpx}}rpx; border-left-color: {{item.borderColor}};"
                >
                  <view class="dyn-cat-pill-inner">
                    <text class="dyn-cat-pill-label">{{item.label}}</text>
                    <text class="dyn-cat-pill-progress">{{item.readProgressText || '0/0'}}</text>
                  </view>
                </view>
              </view>

              <view class="dyn-canvas-surface" style="width: {{swim.sheetWidthRpx}}rpx;">
                <!-- 时间竖 Grid：与顶部刻度对齐，极浅贯穿画布 -->
                <view class="dyn-canvas-grid">
                  <block wx:for="{{swim.gridLines}}" wx:key="left">
                    <view class="dyn-canvas-grid-line" style="left: {{item.left}};"></view>
                  </block>
                </view>

                <block wx:for="{{swim.lanes}}" wx:for-item="lane" wx:for-index="li" wx:key="key">
                  <block wx:for="{{lane.collapsedRows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
                    <view
                      wx:for="{{row}}"
                      wx:for-item="bar"
                      wx:key="boxId"
                      id="chip-{{bar.boxId}}"
                      class="dyn-canvas-chip dyn-canvas-chip--{{bar.priority}} dyn-canvas-chip--cat-{{lane.key}} {{bar.type === 'overflow_bucket' ? 'dyn-canvas-chip--overflow-bucket' : ''}} {{chipTooltipHeldId === bar.boxId ? 'dyn-canvas-chip--held' : ''}}"
                      style="left: {{bar.left}}; width: {{bar.chipWidth}}; top: {{bar.topRpx}}rpx; height: {{bar.heightRpx}}rpx; z-index: {{bar.zIndex || 10}};"
                      hover-class="{{bar.type === 'overflow_bucket' ? 'dyn-canvas-chip--bucket-hover' : 'dyn-canvas-chip--hover'}}"
                      hover-stay-time="80"
                      bindtap="onBarTap"
                      bindlongpress="onBarLongPress"
                      data-box="{{bar.boxId}}"
                      data-title="{{bar.title}}"
                      data-type="{{bar.type}}"
                      data-start-year="{{bar.startYear}}"
                      data-end-year="{{bar.endYear}}"
                      data-lane="{{li}}"
                      data-label="{{lane.label}}"
                      data-range="{{bar.timeRange}}"
                      data-lane-key="{{lane.key}}"
                    >
                      <view class="dyn-canvas-chip-inner">
                        <text class="dyn-canvas-chip-title">{{bar.title}}</text>
                        <text wx:if="{{bar.chipTag}}" class="dyn-canvas-chip-tag dyn-canvas-chip-tag--cat-{{lane.key}}">{{bar.chipTag}}</text>
                      </view>
                    </view>
                  </block>
                </block>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view style="height: 190rpx;"></view>
    </scroll-view>

  </view>

  <!-- 续览提示：fixed + pointer-events:none，不参与任何页面布局 -->
  <view
    wx:if="{{swim}}"
    class="continuation-cue continuation-cue--right {{continuationCanvasActive && continuationRightCount > 0 && !overlayVisible && !chipTooltipVisible && !showIntroModal && !priorityMenuVisible ? 'continuation-cue--visible' : ''}}"
    role="status"
    aria-label="右侧还有 {{continuationRightCount}} 条史略"
  >
    <text class="continuation-cue-text">{{continuationRightCount}} 条</text>
    <image
      class="continuation-cue-arrow continuation-cue-arrow--right"
      src="/配图/icons/kaihe.png"
      mode="aspectFit"
      aria-hidden="true"
    />
  </view>
  <view
    wx:if="{{swim}}"
    class="continuation-cue continuation-cue--bottom {{continuationCanvasActive && continuationBottomCount > 0 && !overlayVisible && !chipTooltipVisible && !showIntroModal && !priorityMenuVisible ? 'continuation-cue--visible' : ''}}"
    role="status"
    aria-label="下方还有 {{continuationBottomCount}} 条史略"
  >
    <text class="continuation-cue-text">{{continuationBottomCount}} 条</text>
    <image
      class="continuation-cue-arrow"
      src="/配图/icons/kaihe.png"
      mode="aspectFit"
      aria-hidden="true"
    />
  </view>

  <view wx:if="{{unit && swim}}" class="priority-fab-wrap">
    <view
      class="priority-fab {{priorityMenuVisible ? 'priority-fab--open' : ''}}"
      bindtap="togglePriorityMenu"
      aria-role="button"
      aria-label="切换展示密度，当前{{activePriorityLabel}}"
    >
      <view class="priority-fab-inner">
        <text class="priority-fab-label">{{activePriorityLabel}}</text>
        <image
          class="priority-fab-arrow {{priorityMenuVisible ? '' : 'priority-fab-arrow--down'}}"
          src="/配图/icons/kaihe.png"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <view
    wx:if="{{priorityMenuVisible}}"
    class="priority-menu-backdrop"
    bindtap="closePriorityMenu"
    catchtouchmove="noop"
  >
    <view class="priority-menu" catchtap="noop">
      <view
        wx:for="{{priorityOptions}}"
        wx:key="value"
        class="priority-menu-item {{activePriority === item.value ? 'priority-menu-item--active' : ''}}"
        bindtap="onPriorityTap"
        data-priority="{{item.value}}"
      >
        <text class="priority-menu-item-label">{{item.label}}</text>
        <text wx:if="{{activePriority === item.value}}" class="priority-menu-item-check">✓</text>
      </view>
    </view>
  </view>

  <view wx:if="{{chipTooltipVisible}}" class="chip-tooltip-backdrop chip-tooltip-backdrop--{{chipTooltipPhase}}" catchtap="hideChipTooltip">
    <view
      class="chip-tooltip chip-tooltip--{{chipTooltipPhase}}"
      style="left: {{chipTooltipLeftPx}}px; top: {{chipTooltipTopPx}}px; transform: {{chipTooltipTransform}}; transform-origin: {{chipTooltipOrigin}};"
      catchtap="onChipTooltipCardTap"
      bindtransitionend="onChipTooltipTransitionEnd"
    >
      <view class="chip-tooltip-head">
        <view class="chip-tooltip-head-left">
          <text class="chip-tooltip-title {{chipTooltipPriority === 'P0' ? 'chip-tooltip-title--p0' : ''}}">{{chipTooltipTitle}}</text>
          <text
            wx:if="{{chipTooltipTag}}"
            class="chip-tooltip-tag chip-tooltip-tag--cat-{{chipTooltipLaneKey}}"
          >{{chipTooltipTag}}</text>
          <view class="chip-tooltip-time">
            <text class="chip-tooltip-time-start">{{chipTooltipStartYear}}</text>
            <text wx:if="{{chipTooltipEndYear}}" class="chip-tooltip-time-sep">—</text>
            <text wx:if="{{chipTooltipEndYear}}" class="chip-tooltip-time-end">{{chipTooltipEndYear}}</text>
          </view>
        </view>
        <view class="chip-tooltip-correction" catchtap="onChipCorrectionTap" aria-role="button" aria-label="纠错">
          <image class="chip-tooltip-correction-icon" src="/images/icons/jiucuo.png" mode="aspectFit" />
          <text class="chip-tooltip-correction-label">纠错</text>
        </view>
      </view>
      <view
        wx:if="{{chipTooltipPeakYear || chipTooltipPeakReason || chipTooltipPriority || chipTooltipPriorityReason || chipTooltipEntrySource}}"
        class="chip-tooltip-foot"
      >
        <view wx:if="{{chipTooltipPeakYear || chipTooltipPeakReason}}" class="chip-tooltip-foot-row">
          <text class="chip-tooltip-foot-label">峰值年</text>
          <text
            wx:if="{{chipTooltipPeakYear}}"
            class="chip-tooltip-foot-highlight chip-tooltip-foot-highlight--cat-{{chipTooltipLaneKey}}"
          >{{chipTooltipPeakYear}}</text>
          <text wx:if="{{chipTooltipPeakReason}}" class="chip-tooltip-foot-reason">{{chipTooltipPeakReason}}</text>
        </view>
        <view wx:if="{{chipTooltipPriority || chipTooltipPriorityReason}}" class="chip-tooltip-foot-row">
          <text class="chip-tooltip-foot-label">优先级</text>
          <text
            wx:if="{{chipTooltipPriority}}"
            class="chip-tooltip-foot-highlight chip-tooltip-foot-highlight--cat-{{chipTooltipLaneKey}}"
          >{{chipTooltipPriority}}</text>
          <text wx:if="{{chipTooltipPriorityReason}}" class="chip-tooltip-foot-reason">{{chipTooltipPriorityReason}}</text>
        </view>
        <view wx:if="{{chipTooltipEntrySource}}" class="chip-tooltip-foot-row">
          <text class="chip-tooltip-foot-label">数据来源</text>
          <text class="chip-tooltip-foot-highlight">{{chipTooltipEntrySource}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="ud-modal" wx:if="{{showIntroModal}}" bindtap="closeIntro">
    <view class="ud-modal-card" catchtap="noop">
      <view class="ud-modal-header">
        <view class="ud-modal-title">{{introModalTitle}}</view>
        <view class="ud-modal-close" catchtap="closeIntro">
          <text class="ud-modal-close-icon">✕</text>
        </view>
      </view>
      <scroll-view scroll-y class="ud-modal-body" enhanced show-scrollbar="{{false}}">
        <block wx:key="selectionMountKey">
          <selection id="dynastyModalSelection" disable-context-menu bindselectionchange="onDetailSelectionChange">
            <text wx:for="{{introParagraphs}}" wx:key="index" class="ud-modal-para" user-select>{{item}}</text>
          </selection>
        </block>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{overlayVisible}}" class="more-overlay-backdrop" bindtap="hideOverlay">
    <view class="more-overlay-sheet" catchtap="">
      <view class="more-overlay-handle"></view>
      <view class="more-overlay-header">
        <view class="more-overlay-header-main">
          <text class="more-overlay-title">查看更多</text>
          <text
            wx:if="{{overlayCountTag}}"
            class="more-overlay-count-tag more-overlay-count-tag--cat-{{overlayLaneKey}}"
          >{{overlayCountTag}}</text>
        </view>
        <view class="more-overlay-close" bindtap="hideOverlay">
          <text class="more-overlay-close-icon">✕</text>
        </view>
      </view>
      <scroll-view class="more-overlay-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{overlayBars}}"
          wx:key="title"
          class="more-overlay-item"
          bindtap="onBarTap"
          bindlongpress="onBarLongPress"
          data-box="{{item.boxId}}"
          data-title="{{item.title}}"
          data-lane-key="{{overlayLaneKey}}"
          data-range="{{item.timeRange}}"
        >
          <view class="more-overlay-item-left">
            <view class="more-overlay-dot more-overlay-dot--{{item.type || 'default'}}"></view>
            <view class="more-overlay-item-name">
              <text class="more-overlay-item-title {{item.priority === 'p0' ? 'more-overlay-item-title--p0' : ''}}">{{item.title}}</text>
              <text
                wx:if="{{item.chipTag}}"
                class="more-overlay-item-tag more-overlay-item-tag--cat-{{overlayLaneKey}}"
              >{{item.chipTag}}</text>
            </view>
          </view>
          <text class="more-overlay-item-range">{{item.timeRange}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <correction-modal
    visible="{{correctionVisible}}"
    mode="edit"
    civilizationName="{{correctionCivilizationName}}"
    dynastyName="{{correctionDynastyName}}"
    boxTitle="{{correctionBoxTitle}}"
    sourceType="dynasty_canvas"
    submitting="{{correctionSubmitting}}"
    bind:close="closeCorrection"
    bind:submit="onCorrectionSubmit"
  />

  <dictionary-sheet
    visible="{{dictionaryVisible}}"
    query="{{dictionaryQuery}}"
    bind:close="closeDictionary"
  />

  <text-selection-bar
    visible="{{selectionBarVisible}}"
    left="{{selectionBarLeft}}"
    top="{{selectionBarTop}}"
    placement="{{selectionBarPlacement}}"
    bind:share="onSelectionShare"
    bind:copy="onSelectionCopy"
    bind:query="onSelectionQuery"
    bind:correction="onSelectionCorrection"
  />

  <share-poster-sheet
    visible="{{sharePosterVisible}}"
    quoteText="{{sharePosterQuote}}"
    userName="{{sharePosterUserName}}"
    userAvatarUrl="{{sharePosterUserAvatar}}"
    sourceLine1="{{sharePosterSourceLine1}}"
    sourceLine2="{{sharePosterSourceLine2}}"
    excerptDate="{{sharePosterExcerptDate}}"
    bind:close="closeSharePoster"
  />

</view>
