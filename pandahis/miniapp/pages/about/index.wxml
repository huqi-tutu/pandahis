<proto-nav title="{{aboutNavTitle}}" show-back="{{true}}"></proto-nav>

<scroll-view class="page-about" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{pageTopPadPx}}px;">
  <view class="logo-wrap">
    <image class="brand-logo" src="{{brandLogoUrl}}" mode="widthFix" />
    <view class="version">Chronicle · Cartography v{{version}}</view>
  </view>

  <view class="card-paper intro-card">
    <view
      wx:for="{{introParas}}"
      wx:key="*this"
      class="para text-body {{index > 0 ? 'para-gap' : ''}}"
    >{{item}}</view>
  </view>

  <view class="footer text-caption">© Pandahis</view>
</scroll-view>
