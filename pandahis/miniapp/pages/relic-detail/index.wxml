<view class="proto-shell" bindtap="onPageTap">
  <proto-nav title="{{navTitle || name || '见证'}}" show-back="{{true}}"></proto-nav>

  <view class="detail-body" style="padding-top: {{pageTopPadPx}}px;">
    <image wx:if="{{imageUrl}}" class="hero-img-real" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="hero-img muted">文物图片占位</view>

    <view class="info-card card-paper">
      <view class="info-header">
        <text class="relic-title">{{name}}</text>
      </view>
      <view wx:if="{{museum}}" class="info-divider"></view>
      <view wx:if="{{museum}}" class="info-location">
        <text class="location-icon">◎</text>
        <text class="location-text">{{museum}}</text>
      </view>
    </view>

    <view class="section-card card-paper">
      <view class="section-header">
        <view class="section-bar"></view>
        <text class="section-title">详细介绍</text>
      </view>
      <block wx:for="{{[selectionMountKey]}}" wx:key="*this">
        <selection id="relicBodySelection" disable-context-menu bindselectionchange="onDetailSelectionChange">
          <text class="section-body" user-select>
            <block wx:if="{{detailSegs.length}}">
              <text
                wx:for="{{detailSegs}}"
                wx:key="index"
                id="{{item.anchorId}}"
                class="{{item.highlight ? 'note-hl' : ''}} {{item.focus ? 'note-hl--focus' : ''}}"
              >{{item.text}}</text>
            </block>
            <block wx:else>{{detail || '暂无详细介绍'}}</block>
          </text>
        </selection>
      </block>
    </view>
  </view>

  <correction-modal
    visible="{{correctionVisible}}"
    mode="edit"
    civilizationName="{{civilizationName}}"
    dynastyName="{{dynastyName}}"
    boxTitle="{{boxTitle}}"
    selectedText="{{correctionSelectedText}}"
    sourceType="relic_detail_selection"
    submitting="{{correctionSubmitting}}"
    bind:close="closeCorrection"
    bind:submit="onCorrectionSubmit"
  />

  <note-modal
    visible="{{noteVisible}}"
    mode="edit"
    boxTitle="{{boxTitle}}"
    civilizationName="{{civilizationName}}"
    dynastyName="{{dynastyName}}"
    selectedText="{{noteSelectedText}}"
    submitting="{{noteSubmitting}}"
    bind:close="closeNote"
    bind:submit="onNoteSubmit"
  />

  <dictionary-sheet
    visible="{{dictionaryVisible}}"
    query="{{dictionaryQuery}}"
    bind:close="closeDictionary"
  />

  <text-selection-bar
    visible="{{selectionBarVisible}}"
    left="{{selectionBarLeft}}"
    top="{{selectionBarTop}}"
    placement="{{selectionBarPlacement}}"
    showShare="{{false}}"
    bind:copy="onSelectionCopy"
    bind:query="onSelectionQuery"
    bind:note="onSelectionNote"
    bind:correction="onSelectionCorrection"
  />
</view>
