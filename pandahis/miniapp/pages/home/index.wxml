<!-- 沉浸 · 政权矩阵（产品 home-matrix 1:1） -->
<view wx:if="{{mode=='immersive'}}" class="page-shell">
  <proto-nav title="{{appDisplayName}}" home-nav="{{true}}" />

  <view
    id="civTabArea"
    class="civ-tab-area civ-tab-area--text-only"
    style="top:{{headerPadPx}}px; height:{{tabAreaH}}rpx;"
  >
    <view class="civ-text-bar">
      <scroll-view class="civ-text-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{civTextScrollLeft}}" scroll-with-animation>
        <view class="civ-text-inner">
          <view
            wx:for="{{civTextItems}}"
            wx:key="id"
            class="civ-text-item {{item.realIdx === civIndex ? 'civ-text-item--active' : ''}}"
            data-ri="{{item.realIdx}}"
            bindtap="onCivTap"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="civ-all-btn-wrap" catchtap="onToggleCivPicker">
        <view class="civ-all-btn">
          <image class="civ-all-btn-icon" src="/配图/icons/quanbu.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- scroll-top 常时绑定：number 与 undefined 切换会在部分基础库把滚动位置重置为 0（收展回顶的根因），勿改回条件绑定 -->
  <scroll-view
    id="matrixScroll"
    class="matrix-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    scroll-with-animation="{{false}}"
    scroll-top="{{matrixScrollTop}}"
    scroll-into-view="{{matrixScrollIntoView}}"
    
    style="top: {{scrollAreaTop}}px; height: {{matrixHeight}}px;"
    bindscroll="onMatrixScroll"
    bindscrollend="onMatrixScrollEnd"
  >
    <view
      class="matrix-body {{matrixBodyOffset ? 'matrix-body--offset-lock' : ''}}"
      style="height: {{matrixTotalH + matrixScrollBottomPad}}rpx; transform: translateY({{matrixBodyOffset}}px);"
    >
      <!-- 文档流锚点：供 scroll-into-view 精确定位（绝对定位的时间轴行无法用于滚动锚定） -->
      <view class="matrix-scroll-anchors" aria-hidden="true">
        <view
          wx:for="{{matrixRows}}"
          wx:key="key"
          wx:for-item="row"
          id="anchor_{{row.key}}"
          class="matrix-scroll-anchor"
          style="height: {{row.h}}rpx;"
        ></view>
        <view class="matrix-scroll-anchor matrix-scroll-anchor--pad" style="height: {{matrixScrollBottomPad}}rpx;"></view>
      </view>
      <view wx:if="{{matrixReady}}" class="matrix-time-col">
        <view wx:for="{{matrixRows}}" wx:key="key" wx:for-item="row" id="ts_{{row.key}}" class="time-row-abs {{row.showYear ? '' : 'time-row-abs--compact'}} {{row.expandable ? 'time-row-abs--hit' : ''}}" style="top: {{row.y}}rpx; height: {{row.hxHitH || row.h}}rpx; z-index: {{row.expandable ? 4 : 1}};" bindtap="{{row.expandable ? 'onDynastyToggle' : ''}}" data-dynasty="{{row.dynastyKey}}" data-row-key="{{row.key}}">
          <view class="time-label-wrap">
            <view wx:if="{{row.showYear}}" class="time-year-row">
              <view class="time-h-line time-h-line--edge"></view>
              <view class="time-year" style="font-size: {{row.yearFontSize}}rpx;">{{row.year}}</view>
              <view class="time-h-line time-h-line--edge"></view>
            </view>
            <view wx:if="{{row.hxLabel}}" class="time-hx-wrap {{row.expandable ? 'time-hx-wrap--tap' : ''}}">
              <text class="time-dynasty {{row.isMajorNode ? 'time-dynasty--major' : ''}}" style="font-size: {{row.hxFontSize}}rpx;">{{row.hxLabel}}</text>
              <image wx:if="{{row.expandable}}" class="time-expand-arrow {{row.expanded ? 'time-expand-arrow--expanded' : ''}}" src="/配图/icons/kaihe.png" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{matrixReady}}" class="matrix-canvas">
        <view class="matrix-canvas-inner">
          <view wx:for="{{matrixBlocks}}" wx:key="id" wx:for-item="blk" class="era-block {{blk.edgeClass}}{{blk.isDynastyContainer ? ' era-block--dynasty-container' : ''}}" style="top: {{blk.top}}rpx; height: {{blk.h}}rpx; left: {{blk.leftPct}}%; width: {{blk.widthPct}}%; border-radius: {{blk.radiusStyle}}; z-index: {{blk.zIndex || 1}};" hover-class="{{blk.isDynastyContainer ? '' : 'era-block--hover'}}" bindtap="{{blk.isDynastyContainer ? '' : 'onCardTap'}}" data-dynasty="{{blk.dynasty}}" data-display-name="{{blk.displayName}}" data-person="{{blk.person}}" data-civ="{{blk.civ}}" data-anchor-year="{{blk.anchorYear}}" data-entity-type="{{blk.entityType}}" data-entity-id="{{blk.entityId}}" data-dynasty-id="{{blk.dynastyId}}" data-legacy-id="{{blk.legacyId}}">
            <view class="era-block-fill {{blk.fillSeamFix ? 'era-block-fill--solid-seam' : ''}}{{blk.seamGapTop ? ' era-block-fill--gap-top' : ''}}{{blk.seamGapBottom ? ' era-block-fill--gap-bottom' : ''}}{{blk.seamGapLeft ? ' era-block-fill--gap-left' : ''}}{{blk.seamGapRight ? ' era-block-fill--gap-right' : ''}}" style="background: {{blk.cardBg}}; border-radius: {{blk.radiusStyle}};{{blk.fillStyleExtra || ''}}"></view>
            <view class="era-block-highlight" style="border-radius: {{blk.radiusStyle}};"></view>
            <view wx:if="{{blk.strokeStyle}}" class="era-block-stroke" style="border-radius: {{blk.radiusStyle}}; {{blk.strokeStyle}}"></view>
          </view>
          <!-- 元容器空白区点击层：低于南宋帝王(5)、与元二级卡同层(4)，二级卡后渲染故优先 -->
          <view wx:for="{{matrixContainerHits}}" wx:key="id" wx:for-item="hit" class="container-hit" style="top: {{hit.top}}rpx; height: {{hit.h}}rpx; left: {{hit.leftPct}}%; width: {{hit.widthPct}}%; z-index: {{hit.zIndex || 4}};" bindtap="onCardTap" data-dynasty="{{hit.dynasty}}" data-display-name="{{hit.displayName}}" data-person="{{hit.person}}" data-civ="{{hit.civ}}" data-anchor-year="{{hit.anchorYear}}" data-entity-type="{{hit.entityType}}" data-entity-id="{{hit.entityId}}" data-dynasty-id="{{hit.dynastyId}}" data-legacy-id="{{hit.legacyId}}" data-container-id="{{hit.containerId}}"></view>
          <!-- 容器内二级帝王卡（等宽等高 · 半透明白底） -->
          <view wx:for="{{matrixSubCards}}" wx:key="id" wx:for-item="sub" class="container-sub-card" style="top: {{sub.top}}rpx; height: {{sub.h}}rpx; left: {{sub.leftPct}}%; width: {{sub.widthPct}}%; border-radius: {{sub.radiusRpx}}rpx; z-index: {{sub.zIndex || 8}};" hover-class="container-sub-card--hover" bindtap="onCardTap" data-dynasty="{{sub.dynasty}}" data-display-name="{{sub.displayName}}" data-person="{{sub.person}}" data-civ="{{sub.civ}}" data-anchor-year="{{sub.anchorYear}}" data-entity-type="{{sub.entityType}}" data-entity-id="{{sub.entityId}}" data-dynasty-id="{{sub.dynastyId}}" data-legacy-id="{{sub.legacyId}}" data-container-id="{{sub.containerId}}">
            <view class="container-sub-card-fill" style="background: {{sub.subCardBg}}; {{sub.subCardStroke}}; border-radius: {{sub.radiusRpx}}rpx;"></view>
            <view class="container-sub-card-highlight" style="border-radius: {{sub.radiusRpx}}rpx;"></view>
          </view>
          <view wx:for="{{matrixOverlays}}" wx:key="id" wx:for-item="ovl" class="entry-chrome" style="z-index: {{ovl.zIndex || 20}};">
            <view wx:if="{{!ovl.hideLabels}}" class="entry-header-wrap{{ovl.isContainerDynastyHeader ? ' entry-header-wrap--container-dynasty' : ''}}{{ovl.isContainerDynastyHeaderYuan ? ' entry-header-wrap--container-dynasty-yuan' : ''}}{{ovl.isContainerDynastyHeaderRight ? ' entry-header-wrap--container-dynasty-right' : ''}}{{ovl.labelLayout === 'stacked' && !ovl.isContainerDynastyHeader ? ' entry-header-wrap--stacked' : ''}}{{ovl.isCollapsedDynastyCard ? ' entry-header-wrap--collapsed-dynasty' : ''}}{{ovl.isContainerEmperorCard ? ' entry-header-wrap--container-emperor' : ''}}{{ovl.isContainerEmperorInline ? ' entry-header-wrap--container-emperor-inline' : ''}}{{ovl.isContainerEmperorCompact ? ' entry-header-wrap--container-emperor-compact' : ''}}{{ovl.isContainerRegimeLabel ? ' entry-header-wrap--container-regime' : ''}}{{ovl.isWudaiFiveRegimeVertical ? ' entry-header-wrap--container-regime-vertical' : ''}}{{ovl.isRegimeCard && !ovl.isContainerRegimeLabel ? ' entry-header-wrap--regime' : ''}}" style="top: {{ovl.headerTop}}rpx; left: {{ovl.headerLeftPct}}%; width: {{ovl.headerWidthPct}}%;{{ovl.headerHeight ? ' height: ' + ovl.headerHeight + 'rpx;' : ''}}">
              <view wx:if="{{ovl.isContainerDynastyHeader}}" class="entry-header entry-header--container-dynasty-title" bindtap="onCardTap" data-dynasty="{{ovl.dynasty || ovl.displayName}}" data-display-name="{{ovl.displayName}}" data-dynasty-id="{{ovl.dynastyId}}" data-entity-type="{{ovl.entityType}}" data-entity-id="{{ovl.entityId}}" data-legacy-id="{{ovl.legacyId}}" data-container-id="{{ovl.containerId}}" data-anchor-year="{{ovl.anchorYear}}">
                <block wx:if="{{ovl.containerTagPlacement === 'inline-name'}}">
                  <view class="entry-name-tag-row entry-name-tag-row--container-dynasty">
                    <text class="card-person {{ovl.isCollapsedDynastyCard ? 'card-person--collapsed-dynasty card-person--container-dynasty' : 'card-person--wide card-person--serif card-person--container-dynasty'}}">{{ovl.displayName}}</text>
                    <view wx:if="{{!ovl.hideTags && ovl.highlights.length}}" class="entry-tag-row">
                      <view wx:for="{{ovl.highlights}}" wx:key="text" wx:for-item="tag" class="entry-tag{{tag.tagClass ? ' ' + tag.tagClass : ''}}" style="{{tag.tagStyle}}">
                        <view wx:if="{{tag.iconSrc}}" class="entry-tag-icon-slot">
                          <image class="entry-tag-icon" src="{{tag.iconSrc}}" mode="aspectFit" style="{{tag.iconStyle || ''}}" />
                        </view>
                        <view class="entry-tag-text-slot">
                          <text class="entry-tag-text" style="{{tag.textStyle || ''}}">{{tag.text}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <text wx:if="{{!ovl.hideTime}}" class="entry-time-inline entry-time-inline--container-dynasty" style="font-size: {{ovl.timeFontRpx}}rpx;">{{ovl.timeRange}}</text>
                </block>
                <block wx:else>
                  <text class="card-person {{ovl.isCollapsedDynastyCard ? 'card-person--collapsed-dynasty card-person--container-dynasty' : 'card-person--wide card-person--serif card-person--container-dynasty'}}">{{ovl.displayName}}</text>
                  <view wx:if="{{!ovl.hideTags && ovl.highlights.length}}" class="entry-tag-row entry-tag-row--below-name">
                    <view wx:for="{{ovl.highlights}}" wx:key="text" wx:for-item="tag" class="entry-tag{{tag.tagClass ? ' ' + tag.tagClass : ''}}" style="{{tag.tagStyle}}">
                      <view wx:if="{{tag.iconSrc}}" class="entry-tag-icon-slot">
                        <image class="entry-tag-icon" src="{{tag.iconSrc}}" mode="aspectFit" style="{{tag.iconStyle || ''}}" />
                      </view>
                      <view class="entry-tag-text-slot">
                        <text class="entry-tag-text" style="{{tag.textStyle || ''}}">{{tag.text}}</text>
                      </view>
                    </view>
                  </view>
                  <text wx:if="{{!ovl.hideTime}}" class="entry-time-inline entry-time-inline--container-dynasty" style="font-size: {{ovl.timeFontRpx}}rpx;">{{ovl.timeRange}}</text>
                </block>
              </view>
              <view wx:else class="entry-header entry-header--{{ovl.labelLayout}}">
                <block wx:if="{{ovl.labelLayout === 'stacked'}}">
                  <text class="card-person {{ovl.isCollapsedDynastyCard ? 'card-person--collapsed-dynasty card-person--serif' : ('card-person--stacked' + (ovl.kind === 'single' ? '' : (ovl.isContainerRegimeLabel ? ' card-person--sub-regime' : ' card-person--serif')))}}">{{ovl.kind === 'single' ? ovl.person : ovl.displayName}}</text>
                  <view wx:if="{{!ovl.hideTags && ovl.highlights.length}}" class="entry-tag-row entry-tag-row--below-name">
                    <view wx:for="{{ovl.highlights}}" wx:key="text" wx:for-item="tag" class="entry-tag{{tag.tagClass ? ' ' + tag.tagClass : ''}}" style="{{tag.tagStyle}}">
                      <view wx:if="{{tag.iconSrc}}" class="entry-tag-icon-slot">
                        <image class="entry-tag-icon" src="{{tag.iconSrc}}" mode="aspectFit" style="{{tag.iconStyle || ''}}" />
                      </view>
                      <view class="entry-tag-text-slot">
                        <text class="entry-tag-text" style="{{tag.textStyle || ''}}">{{tag.text}}</text>
                      </view>
                    </view>
                  </view>
                  <text wx:if="{{!ovl.hideTime}}" class="entry-time-inline entry-time-inline--stacked" style="font-size: {{ovl.timeFontRpx}}rpx;">{{ovl.timeRange}}</text>
                </block>
                <block wx:else>
                  <view class="entry-name-tag-row">
                    <text class="card-person card-person--{{ovl.labelLayout}}{{ovl.kind === 'single' ? '' : (ovl.isContainerRegimeLabel ? ' card-person--sub-regime' : ' card-person--serif')}}">{{ovl.kind === 'single' ? ovl.person : ovl.displayName}}</text>
                    <view wx:if="{{!ovl.hideTags && ovl.highlights.length}}" class="entry-tag-row">
                      <view wx:for="{{ovl.highlights}}" wx:key="text" wx:for-item="tag" class="entry-tag{{tag.tagClass ? ' ' + tag.tagClass : ''}}" style="{{tag.tagStyle}}">
                        <view wx:if="{{tag.iconSrc}}" class="entry-tag-icon-slot">
                          <image class="entry-tag-icon" src="{{tag.iconSrc}}" mode="aspectFit" style="{{tag.iconStyle || ''}}" />
                        </view>
                        <view class="entry-tag-text-slot">
                          <text class="entry-tag-text" style="{{tag.textStyle || ''}}">{{tag.text}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <text wx:if="{{!ovl.hideTime}}" class="entry-time-inline" style="font-size: {{ovl.timeFontRpx}}rpx;">{{ovl.timeRange}}</text>
                </block>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  
  </scroll-view>


  <view
    wx:if="{{!matrixReady}}"
    class="matrix-skeleton"
    style="top: {{scrollAreaTop}}px; height: {{matrixHeight}}px;"
  >
    <view class="matrix-skeleton-time"></view>
    <view class="matrix-skeleton-canvas">
      <view class="matrix-skeleton-card" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
        <view class="matrix-skeleton-meta">
          <view class="matrix-skeleton-name"></view>
          <view class="matrix-skeleton-tag"></view>
        </view>
        <view class="matrix-skeleton-year"></view>
        <view class="matrix-skeleton-sheen"></view>
      </view>
    </view>
  </view>

  <!-- 导航索引触控层（catch 捕获，阻止 scroll-view 原生滚动） -->
  <view wx:if="{{matrixReady}}" class="dynasty-nav-touch" style="top: {{scrollAreaTop}}px; height: {{matrixHeight}}px;" catchtouchstart="onNavTouchStart" catchtouchmove="onNavTouchMove" catchtouchend="onNavTouchEnd"></view>
  <!-- 导航索引视觉层（纯展示，不接收触摸） -->
  <view wx:if="{{matrixReady}}" class="dynasty-nav {{navActive ? 'dynasty-nav--active' : 'dynasty-nav--hidden'}}" style="top: {{scrollAreaTop}}px; height: {{matrixHeight}}px;">
    <view
      wx:for="{{navItems}}"
      wx:key="key"
      class="dynasty-nav-item {{navActiveIdx === index ? 'dynasty-nav-item--active' : ''}}"
      data-key="{{item.key}}"
      data-y-px="{{item.yPx}}"
    >{{item.label}}</view>
  </view>

  <!-- 导航 HUD -->
  <view wx:if="{{navHudVisible}}" class="nav-hud {{navHudFading ? 'nav-hud--fading' : ''}}" style="top: {{navHudTop}}px; left: {{navHudLeft}}px;">
    <view class="nav-hud-midline"></view>
    <text class="nav-hud-title">{{navHudTitle}}</text>
    <text class="nav-hud-year">{{navHudYear}}</text>
    <text wx:if="{{navHudEmp}}" class="nav-hud-emp">{{navHudEmp}}</text>
  </view>

  <view wx:if="{{civPickerOpen}}" class="civ-picker" style="top: {{headerPadPx}}px;" catchtouchmove="preventMove">
    <view class="civ-picker-sheet" style="height: {{civPickerSheetH}}rpx;" catchtap="preventMove">
      <view class="civ-picker-grid">
        <view wx:for="{{civPickerItems}}" wx:key="id" class="civ-picker-item {{item.realIdx === civIndex ? 'civ-picker-item--active' : ''}}" data-ri="{{item.realIdx}}" bindtap="onCivPickerSelect">
          <view class="civ-picker-card" style="width: {{civPickerCardW}}rpx; height: {{civPickerCardH}}rpx;">
            <image class="civ-picker-card-img" src="{{item.img}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
    <view class="civ-picker-backdrop" bindtap="onCivPickerClose"></view>
  </view>

  <view wx:if="{{matrixDataLoading && matrixReady}}" class="matrix-data-loading">
    <view class="matrix-data-loading__inner">
      <view class="matrix-data-loading__dot"></view>
      <text class="matrix-data-loading__text">同步历史数据…</text>
    </view>
  </view>
</view>

<!-- 总览 · 世界地图（产品 home-overview 1:1） -->
<view wx:elif="{{mode=='overview'}}" class="page-shell page-shell--overview">
  <proto-nav title="{{appDisplayName}}" home-nav="{{true}}" mode-pill-text="总览 ▾" bind:modepilltap="goMatrix" />
  <view class="overview-body" style="padding-top: {{pageTopPadPx}}px;">
    <view class="hint-bar">
      <text class="hint-text muted">横向滑动浏览地图 · 点击区域进入史略</text>
    </view>
    <scroll-view scroll-x class="map-scroll" enhanced show-scrollbar="{{false}}">
      <view class="map-frame">
        <image class="map-image" src="{{overviewMapUrl}}" mode="widthFix" show-menu-by-longpress="{{false}}" />
        <view wx:for="{{civSpots}}" wx:key="id" class="civ-spot" style="left: {{item.x}}%; top: {{item.y}}%;" bindtap="onSpotTap" data-id="{{item.id}}">
          <view class="spot-dot" style="background: {{item.color}};"></view>
          <text class="spot-label" style="color: {{item.color}};">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="era-bar-section">
      <view class="dynasty-era-bar">
        <view class="era-seg era-c1"><text>先秦</text></view>
        <view class="era-seg era-c2"><text>秦汉</text></view>
        <view class="era-seg era-c3"><text>三国·魏晋</text></view>
        <view class="era-seg era-c4"><text>隋唐</text></view>
        <view class="era-seg era-c5"><text>宋</text></view>
        <view class="era-seg era-c6"><text>元</text></view>
        <view class="era-seg era-c1"><text>明</text></view>
        <view class="era-seg era-c2"><text>清</text></view>
      </view>
    </view>
    <view class="civ-list-section">
      <view class="section-title-bar">
        <text class="list-title">地域文明</text>
        <text class="list-count muted">{{civSpots.length}} 个文明</text>
      </view>
      <view class="civ-grid">
        <view wx:for="{{civSpots}}" wx:key="id" class="civ-grid-card" bindtap="onCivCardTap" data-id="{{item.id}}">
          <image class="civ-card-img" src="{{item.img}}" mode="aspectFill" lazy-load />
          <view class="civ-card-overlay" style="background: linear-gradient(180deg, transparent 30%, {{item.color}}cc 100%);"></view>
          <text class="civ-card-name">{{item.name}}</text>
        </view>
      </view>
    </view>
    <view style="height: 120rpx;"></view>
  </view>
</view>
