<view class="page-shell safe-bottom">
  <!-- 左上角：游客入口，与右上角胶囊上下居中对齐 -->
  <view
    class="guest-entry"
    style="top: {{guestTop}}px; height: {{guestHeight}}px; line-height: {{guestHeight}}px;"
    bindtap="guestBrowse"
  >立即体验</view>

  <view class="login-body">
    <glass-card wx:if="{{pendingInvite}}" className="invite-banner">
      <view class="invite-title">好友邀请</view>
      <view class="invite-desc muted">检测到邀请码，新用户注册后双方各得阅读点；已注册用户可在「邀请加入」页绑定。</view>
    </glass-card>

    <view class="login-center">
      <!-- 品牌区 -->
      <view class="brand-zone">
        <image class="brand-logo" src="{{brandLogoUrl}}" mode="widthFix" />
        <text class="logo-sub">时间 · 空间 · 文明</text>
      </view>

      <!-- 手机号登录（主操作） -->
      <view class="phone-section">
        <view class="input-group">
          <view class="input-wrap">
            <text class="input-prefix muted">+86</text>
            <input
              class="phone-input"
              type="number"
              placeholder="请输入手机号"
              placeholder-class="input-placeholder"
              maxlength="11"
              bindinput="onPhoneInput"
              value="{{phone}}"
              adjust-position="{{true}}"
              cursor-spacing="{{80}}"
            />
          </view>
        </view>
        <view class="input-group">
          <view class="input-wrap">
            <input
              class="code-input"
              type="number"
              placeholder="验证码"
              placeholder-class="input-placeholder"
              maxlength="6"
              bindinput="onCodeInput"
              value="{{code}}"
              adjust-position="{{true}}"
              cursor-spacing="{{80}}"
            />
            <view class="send-code {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
              <text>{{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}</text>
            </view>
          </view>
        </view>
        <button class="btn-phone" bindtap="loginByPhone">登录 / 注册</button>
      </view>

      <!-- 协议勾选 -->
      <view class="agreement" bindtap="toggleAgree">
        <view class="agree-check {{agreed ? 'agree-check--on' : ''}}">
          <text wx:if="{{agreed}}" class="agree-check-mark">✓</text>
        </view>
        <view class="agree-body">
          <text class="agree-text">我已阅读并同意</text>
          <text class="agree-link" catchtap="openAgreement">《用户服务协议》</text>
          <text class="agree-text">与</text>
          <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
        </view>
      </view>

      <!-- 微信快捷登录 -->
      <view class="quick-zone">
        <button class="btn-wechat {{loggingIn ? 'btn-wechat--loading' : ''}}" bindtap="loginWx" disabled="{{loggingIn}}">
          <image class="btn-wechat-icon" src="/images/icons/weixin.png" mode="aspectFit" />
        </button>
      </view>
    </view>

    <!-- 开发联调（仅开发者工具可见） -->
    <view wx:if="{{devVisible}}" class="dev-section">
      <view class="dev-title">开发联调</view>
      <view class="dev-desc muted">当前 API：{{apiBase}}</view>
      <view class="dev-desc muted">默认连生产；本机后端启动后再切 localhost。</view>
      <view class="btn-dev accent" bindtap="loginDev">本机 API + dev-local-token</view>
      <view class="btn-dev btn-dev--ghost" bindtap="useLocalApi">仅切换本机 API</view>
      <view class="btn-dev btn-dev--ghost" bindtap="useProdApi">恢复生产 API</view>
    </view>
  </view>
</view>
