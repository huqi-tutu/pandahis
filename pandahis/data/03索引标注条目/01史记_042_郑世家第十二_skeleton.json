  "entries": [
    {
      "史略ID": "SHIJI_042_01",
      "史略名称": "郑厉公",
      "史略简介": "郑厉公",
      "原文字句": "庄公又娶宋雍氏女，生厉公突。雍氏有宠於宋。宋庄公闻祭仲之立忽，乃使人诱召祭仲而执之，曰：“不立突，将死。”亦执突以求赂焉。祭仲许宋，与宋盟。以突归，立之。昭公忽",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
