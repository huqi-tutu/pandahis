{
  "work": "03后汉书",
  "vol": "122",
  "source_file": "03后汉书_122_郡国四.txt",
  "source_path": "02二十四史拆分后/03后汉书_拆分后/03后汉书_122_郡国四.txt",
  "paragraph_mode": "line",
  "total": 302,
  "paragraphs": [
    {
      "id": 1,
      "text": "志第二十二  郡国四"
    },
    {
      "id": 2,
      "text": "青州"
    },
    {
      "id": 3,
      "text": "△济南 平原 乐安 北海 东莱 齐国"
    },
    {
      "id": 4,
      "text": "荆州"
    },
    {
      "id": 5,
      "text": "△南阳 南郡 江夏 零陵 桂阳 武陵 长沙"
    },
    {
      "id": 6,
      "text": "扬州"
    },
    {
      "id": 7,
      "text": "△九江 丹阳 庐江 会稽 吴郡 豫章"
    },
    {
      "id": 8,
      "text": "§济南国（故齐，文帝分。雒阳东千八百里。）十城，户七万八千五百四十四，口四十五万三千三百八。"
    },
    {
      "id": 9,
      "text": "〖东平陵〗有铁。有谭城。有天山。"
    },
    {
      "id": 10,
      "text": "〖著〗"
    },
    {
      "id": 11,
      "text": "〖于陵〗"
    },
    {
      "id": 12,
      "text": "〖台〗"
    },
    {
      "id": 13,
      "text": "〖菅〗有赖亭。"
    },
    {
      "id": 14,
      "text": "〖土鼓〗"
    },
    {
      "id": 15,
      "text": "〖梁邹〗"
    },
    {
      "id": 16,
      "text": "〖邹平〗"
    },
    {
      "id": 17,
      "text": "〖东朝阳〗"
    },
    {
      "id": 18,
      "text": "〖历城〗有铁。有巨里聚。"
    },
    {
      "id": 19,
      "text": "§平原郡（高帝置。雒阳北一千三百里。）九城，户十五万五千五百八十八，口百万二千六百五十八。"
    },
    {
      "id": 20,
      "text": "〖平原〗"
    },
    {
      "id": 21,
      "text": "〖高唐〗湿水出。"
    },
    {
      "id": 22,
      "text": "〖般〗"
    },
    {
      "id": 23,
      "text": "〖鬲〗侯国。夏时有鬲君，灭浞，立少康。"
    },
    {
      "id": 24,
      "text": "〖祝阿〗春秋时曰祝柯。有野井亭。"
    },
    {
      "id": 25,
      "text": "〖乐陵〗"
    },
    {
      "id": 26,
      "text": "〖湿阴〗"
    },
    {
      "id": 27,
      "text": "〖安德〗侯国。"
    },
    {
      "id": 28,
      "text": "〖厌次〗本富平。明帝更名。"
    },
    {
      "id": 29,
      "text": "§乐安国（高帝西平昌置，为千乘，永元七年更名。雒阳东千五百二十里。）九城，户七万四千四百，口四十二万四千七十五。"
    },
    {
      "id": 30,
      "text": "〖临济〗本狄，安帝更名。"
    },
    {
      "id": 31,
      "text": "〖千乘〗"
    },
    {
      "id": 32,
      "text": "〖高菀〗"
    },
    {
      "id": 33,
      "text": "〖乐安〗"
    },
    {
      "id": 34,
      "text": "〖博昌〗有薄姑城。有贝中聚。有时水。"
    },
    {
      "id": 35,
      "text": "〖蓼城〗侯国。"
    },
    {
      "id": 36,
      "text": "〖利〗故属齐。"
    },
    {
      "id": 37,
      "text": "〖益〗侯国。故属北海。"
    },
    {
      "id": 38,
      "text": "〖寿光〗故属北海。有灌亭。"
    },
    {
      "id": 39,
      "text": "§北海国（景帝置。建武十三年省菑川、高密、胶东三国，以其县属。）十八城，户十五万八千六百四十一，口八十五万三千六百四。"
    },
    {
      "id": 40,
      "text": "〖剧〗有纪亭，古纪国。"
    },
    {
      "id": 41,
      "text": "〖营陵〗"
    },
    {
      "id": 42,
      "text": "〖平寿〗有斟城。有寒亭，古寒国，浞封此。"
    },
    {
      "id": 43,
      "text": "〖都昌〗"
    },
    {
      "id": 44,
      "text": "〖安丘〗有渠丘亭。"
    },
    {
      "id": 45,
      "text": "〖淳于〗永元九年夏。有密乡。"
    },
    {
      "id": 46,
      "text": "〖平昌〗侯国，故属琅邪，有蒌乡。"
    },
    {
      "id": 47,
      "text": "〖朱虚〗侯国，故属琅邪，永初元年属。"
    },
    {
      "id": 48,
      "text": "〖东安平〗故属菑川。六国时曰安平。有酅亭。"
    },
    {
      "id": 49,
      "text": "〖高密〗侯国。"
    },
    {
      "id": 50,
      "text": "〖昌安〗侯国，安帝复。"
    },
    {
      "id": 51,
      "text": "〖夷安〗侯国，安帝复。"
    },
    {
      "id": 52,
      "text": "〖胶东〗侯国。"
    },
    {
      "id": 53,
      "text": "〖即墨〗侯国。有棠乡。"
    },
    {
      "id": 54,
      "text": "〖壮武〗安帝复。"
    },
    {
      "id": 55,
      "text": "〖下密〗安帝复。"
    },
    {
      "id": 56,
      "text": "〖挺〗"
    },
    {
      "id": 57,
      "text": "§东莱郡（高帝置。雒阳东三千一百二十八里。）十三城，户十万四千二百九十七，口四十八万四千三百九十三。"
    },
    {
      "id": 58,
      "text": "〖黄〗"
    },
    {
      "id": 59,
      "text": "〖牟平〗"
    },
    {
      "id": 60,
      "text": "〖惤〗侯国。"
    },
    {
      "id": 61,
      "text": "〖曲成〗侯国。"
    },
    {
      "id": 62,
      "text": "〖掖〗侯国。有过乡。"
    },
    {
      "id": 63,
      "text": "〖当利〗侯国"
    },
    {
      "id": 64,
      "text": "〖东牟〗侯国。"
    },
    {
      "id": 65,
      "text": "〖昌阳〗"
    },
    {
      "id": 66,
      "text": "〖卢乡〗"
    },
    {
      "id": 67,
      "text": "〖长广〗故属琅邪。"
    },
    {
      "id": 68,
      "text": "〖黔陬〗侯国，故属琅邪。有介亭。"
    },
    {
      "id": 69,
      "text": "〖葛卢〗有尤涉亭。"
    },
    {
      "id": 70,
      "text": "〖不其〗侯国，故属琅邪。"
    },
    {
      "id": 71,
      "text": "§齐国（秦置。雒阳东千八百里。）六城，户六万四千四百一十五，口四十九万一千七百六十五。"
    },
    {
      "id": 72,
      "text": "〖临菑〗本齐，刺史治。"
    },
    {
      "id": 73,
      "text": "〖西安〗有棘里亭。有蘧丘里，古渠丘。"
    },
    {
      "id": 74,
      "text": "〖昌国〗"
    },
    {
      "id": 75,
      "text": "〖临朐〗有三亭，古郱邑。"
    },
    {
      "id": 76,
      "text": "〖广〗"
    },
    {
      "id": 77,
      "text": "〖般阳〗故属济南。"
    },
    {
      "id": 78,
      "text": "右青州刺史部，郡、国六，县六十五。"
    },
    {
      "id": 79,
      "text": "§南阳郡（秦置。雒阳南七百里。）三十七城，户五十二万八千五百五十一，口二百四十三万九千六百一十八。"
    },
    {
      "id": 80,
      "text": "〖宛〗本申伯国。有南就聚。有瓜里津。有夕阳聚。有东武亭。"
    },
    {
      "id": 81,
      "text": "〖冠军〗邑。"
    },
    {
      "id": 82,
      "text": "〖叶〗有长山，曰方城。有卷城。"
    },
    {
      "id": 83,
      "text": "〖新野〗有东乡，故新都。有黄邮聚。"
    },
    {
      "id": 84,
      "text": "〖章陵〗故舂陵，世祖更名。有上唐乡。"
    },
    {
      "id": 85,
      "text": "〖西鄂〗"
    },
    {
      "id": 86,
      "text": "〖雉〗"
    },
    {
      "id": 87,
      "text": "〖鲁阳〗有鲁山。有牛兰累亭。"
    },
    {
      "id": 88,
      "text": "〖犨〗"
    },
    {
      "id": 89,
      "text": "〖堵阳〗"
    },
    {
      "id": 90,
      "text": "〖博望〗"
    },
    {
      "id": 91,
      "text": "〖舞阴〗邑。"
    },
    {
      "id": 92,
      "text": "〖比阳〗"
    },
    {
      "id": 93,
      "text": "〖复阳〗侯国。有杏聚。"
    },
    {
      "id": 94,
      "text": "〖平氏〗桐柏大复山，淮水出。有宜秋聚。"
    },
    {
      "id": 95,
      "text": "〖棘阳〗有蓝乡。有黄淳聚。"
    },
    {
      "id": 96,
      "text": "〖湖阳〗邑。"
    },
    {
      "id": 97,
      "text": "〖随〗西有断蛇丘。"
    },
    {
      "id": 98,
      "text": "〖育阳〗邑。有小长安，有东阳聚。"
    },
    {
      "id": 99,
      "text": "〖涅阳〗"
    },
    {
      "id": 100,
      "text": "〖阴〗"
    },
    {
      "id": 101,
      "text": "〖酂〗"
    },
    {
      "id": 102,
      "text": "〖邓〗有鄾聚。"
    },
    {
      "id": 103,
      "text": "〖山都〗侯国。"
    },
    {
      "id": 104,
      "text": "〖郦〗侯国"
    },
    {
      "id": 105,
      "text": "〖穰〗"
    },
    {
      "id": 106,
      "text": "〖朝阳〗"
    },
    {
      "id": 107,
      "text": "〖蔡阳〗侯国。"
    },
    {
      "id": 108,
      "text": "〖安众〗侯国。"
    },
    {
      "id": 109,
      "text": "〖筑阳〗侯国。有涉都乡。"
    },
    {
      "id": 110,
      "text": "〖武当〗有和成聚。"
    },
    {
      "id": 111,
      "text": "〖顺阳〗侯国，故博山。有须聚。"
    },
    {
      "id": 112,
      "text": "〖成都〗"
    },
    {
      "id": 113,
      "text": "〖襄乡〗"
    },
    {
      "id": 114,
      "text": "〖南乡〗"
    },
    {
      "id": 115,
      "text": "〖丹水〗故属弘农。有章密乡。有三户亭。"
    },
    {
      "id": 116,
      "text": "〖析〗故属弘农，故楚白羽邑。有武关，在县西。有丰乡城。"
    },
    {
      "id": 117,
      "text": "§南郡（秦置。雒阳南一千五百里。）十七城，户十六万二千五百七十，口七十四万七千六百四。"
    },
    {
      "id": 118,
      "text": "〖江陵〗有津乡。"
    },
    {
      "id": 119,
      "text": "〖巫〗西有白帝城。"
    },
    {
      "id": 120,
      "text": "〖秭归〗本国。"
    },
    {
      "id": 121,
      "text": "〖中卢〗侯国。"
    },
    {
      "id": 122,
      "text": "〖编〗有蓝口聚。"
    },
    {
      "id": 123,
      "text": "〖当阳〗"
    },
    {
      "id": 124,
      "text": "〖华容〗侯国。云梦泽在南。"
    },
    {
      "id": 125,
      "text": "〖襄阳〗有阿头山。"
    },
    {
      "id": 126,
      "text": "〖邔〗侯国。有犁丘城。"
    },
    {
      "id": 127,
      "text": "〖宜城〗侯国。"
    },
    {
      "id": 128,
      "text": "〖鄀〗侯国。永平元年夏。"
    },
    {
      "id": 129,
      "text": "〖临沮〗侯国。有荆山。"
    },
    {
      "id": 130,
      "text": "〖枝江〗侯国。本罗国。有丹阳聚。"
    },
    {
      "id": 131,
      "text": "〖夷道〗"
    },
    {
      "id": 132,
      "text": "〖夷陵〗有荆门，虎牙山。"
    },
    {
      "id": 133,
      "text": "〖州陵〗"
    },
    {
      "id": 134,
      "text": "〖很山〗故属武陵。"
    },
    {
      "id": 135,
      "text": "§江夏郡（高帝置。雒阳南千五百里。）十四城，户五万八千四百三十四，口二十六万五千四百六十四。"
    },
    {
      "id": 136,
      "text": "〖西陵〗"
    },
    {
      "id": 137,
      "text": "〖西阳〗"
    },
    {
      "id": 138,
      "text": "〖轪〗侯国。"
    },
    {
      "id": 139,
      "text": "〖鄳〗"
    },
    {
      "id": 140,
      "text": "〖竟陵〗侯国。有郧乡。有章山，本内方。"
    },
    {
      "id": 141,
      "text": "〖云杜〗"
    },
    {
      "id": 142,
      "text": "〖沙羡〗"
    },
    {
      "id": 143,
      "text": "〖邾〗"
    },
    {
      "id": 144,
      "text": "〖下雉〗"
    },
    {
      "id": 145,
      "text": "〖蕲春〗侯国。"
    },
    {
      "id": 146,
      "text": "〖鄂〗"
    },
    {
      "id": 147,
      "text": "〖平春〗侯国。"
    },
    {
      "id": 148,
      "text": "〖南新市〗侯国。"
    },
    {
      "id": 149,
      "text": "〖安陆〗"
    },
    {
      "id": 150,
      "text": "§零陵郡（武帝置。雒阳南三千三百里。）十三城，户二十一万二千二百八十四，口百万一千五百七十八。"
    },
    {
      "id": 151,
      "text": "〖泉陵〗"
    },
    {
      "id": 152,
      "text": "〖零陵〗有阳朔山，湘水出。"
    },
    {
      "id": 153,
      "text": "〖营道〗南有九疑山。"
    },
    {
      "id": 154,
      "text": "〖营浦〗"
    },
    {
      "id": 155,
      "text": "〖泠道〗"
    },
    {
      "id": 156,
      "text": "〖洮阳〗"
    },
    {
      "id": 157,
      "text": "〖都梁〗有路山。"
    },
    {
      "id": 158,
      "text": "〖夫夷〗侯国。"
    },
    {
      "id": 159,
      "text": "〖始安〗侯国。"
    },
    {
      "id": 160,
      "text": "〖重安〗侯国，故钟武，永建三年更名。"
    },
    {
      "id": 161,
      "text": "〖湘乡〗"
    },
    {
      "id": 162,
      "text": "〖昭阳〗侯国。"
    },
    {
      "id": 163,
      "text": "〖烝阳〗侯国，故属长沙"
    },
    {
      "id": 164,
      "text": "§桂阳郡（高帝置。山领山。在雒阳南三千九百里。）十一城，户十三万五千二十九，口五十五一千四百三。"
    },
    {
      "id": 165,
      "text": "〖郴〗有客岭山。"
    },
    {
      "id": 166,
      "text": "〖便〗"
    },
    {
      "id": 167,
      "text": "〖耒阳〗有铁。"
    },
    {
      "id": 168,
      "text": "〖阴山〗"
    },
    {
      "id": 169,
      "text": "〖南平〗"
    },
    {
      "id": 170,
      "text": "〖临武〗"
    },
    {
      "id": 171,
      "text": "〖桂阳〗"
    },
    {
      "id": 172,
      "text": "〖含洭〗"
    },
    {
      "id": 173,
      "text": "〖浈阳〗有苲领山。"
    },
    {
      "id": 174,
      "text": "〖曲江〗"
    },
    {
      "id": 175,
      "text": "〖汉宁〗永和元年置。"
    },
    {
      "id": 176,
      "text": "§武陵郡（秦昭王置。名黔中郡，高帝五年更名。雒阳南二千一百里。）十二城，户四万六千六百七十二，口二十五万九百一十三。"
    },
    {
      "id": 177,
      "text": "〖临沅〗"
    },
    {
      "id": 178,
      "text": "〖汉寿〗故索，阳嘉三年更名，刺史治。"
    },
    {
      "id": 179,
      "text": "〖孱陵〗"
    },
    {
      "id": 180,
      "text": "〖零阳〗"
    },
    {
      "id": 181,
      "text": "〖充〗"
    },
    {
      "id": 182,
      "text": "〖沅陵〗先有壶头山。"
    },
    {
      "id": 183,
      "text": "〖辰阳〗"
    },
    {
      "id": 184,
      "text": "〖酉阳〗"
    },
    {
      "id": 185,
      "text": "〖迁陵〗"
    },
    {
      "id": 186,
      "text": "〖镡成〗"
    },
    {
      "id": 187,
      "text": "〖沅南〗建武二十六年置。"
    },
    {
      "id": 188,
      "text": "〖作唐〗"
    },
    {
      "id": 189,
      "text": "§长沙郡（秦置。雒阳南二千八百里。）十三城，户二十五万五千八百五十四，口百五万九千三百七十二。"
    },
    {
      "id": 190,
      "text": "〖临湘〗"
    },
    {
      "id": 191,
      "text": "〖攸〗"
    },
    {
      "id": 192,
      "text": "〖荼陵〗"
    },
    {
      "id": 193,
      "text": "〖安城〗"
    },
    {
      "id": 194,
      "text": "〖酃〗"
    },
    {
      "id": 195,
      "text": "〖湘南〗侯国。衡山在东南。"
    },
    {
      "id": 196,
      "text": "〖连道〗"
    },
    {
      "id": 197,
      "text": "〖昭陵〗"
    },
    {
      "id": 198,
      "text": "〖益阳〗"
    },
    {
      "id": 199,
      "text": "〖下隽〗"
    },
    {
      "id": 200,
      "text": "〖罗〗"
    },
    {
      "id": 201,
      "text": "〖醴陵〗"
    },
    {
      "id": 202,
      "text": "〖容陵〗"
    },
    {
      "id": 203,
      "text": "右荆州刺史部，郡七，县、邑、侯国百一十七。"
    },
    {
      "id": 204,
      "text": "§九江郡（秦置。雒阳东一千五百里。）十四城，户八万九千四百三十六，口四十三万二千四百二十六。"
    },
    {
      "id": 205,
      "text": "〖阴陵〗"
    },
    {
      "id": 206,
      "text": "〖寿春〗"
    },
    {
      "id": 207,
      "text": "〖浚遒〗"
    },
    {
      "id": 208,
      "text": "〖成德〗"
    },
    {
      "id": 209,
      "text": "〖西曲阳〗"
    },
    {
      "id": 210,
      "text": "〖合肥〗侯国"
    },
    {
      "id": 211,
      "text": "〖历阳〗侯国，刺史治。"
    },
    {
      "id": 212,
      "text": "〖当涂〗有马丘聚，徐凤反于此。"
    },
    {
      "id": 213,
      "text": "〖全椒〗"
    },
    {
      "id": 214,
      "text": "〖钟离〗侯国。"
    },
    {
      "id": 215,
      "text": "〖阜陵〗"
    },
    {
      "id": 216,
      "text": "〖下蔡〗故属沛。"
    },
    {
      "id": 217,
      "text": "〖平阿〗故属沛。有徐山。"
    },
    {
      "id": 218,
      "text": "〖义成〗故属沛。"
    },
    {
      "id": 219,
      "text": "§丹阳郡（秦鄣郡，武帝更名。雒阳东二千一百六十里。建安十三年，孙权分新都郡。）十六城，户十三万六千五百一十八，口六十三万五百四十五。"
    },
    {
      "id": 220,
      "text": "〖宛陵〗"
    },
    {
      "id": 221,
      "text": "〖溧阳〗"
    },
    {
      "id": 222,
      "text": "〖丹阳〗"
    },
    {
      "id": 223,
      "text": "〖故鄣〗"
    },
    {
      "id": 224,
      "text": "〖于潜〗"
    },
    {
      "id": 225,
      "text": "〖泾〗"
    },
    {
      "id": 226,
      "text": "〖歙〗"
    },
    {
      "id": 227,
      "text": "〖黝〗"
    },
    {
      "id": 228,
      "text": "〖陵阳〗"
    },
    {
      "id": 229,
      "text": "〖芜湖〗中江在西。"
    },
    {
      "id": 230,
      "text": "〖秣陵〗南有牛渚。"
    },
    {
      "id": 231,
      "text": "〖湖熟〗侯国。"
    },
    {
      "id": 232,
      "text": "〖句容〗"
    },
    {
      "id": 233,
      "text": "〖江乘〗"
    },
    {
      "id": 234,
      "text": "〖春谷〗"
    },
    {
      "id": 235,
      "text": "〖石城〗"
    },
    {
      "id": 236,
      "text": "§庐江郡（文帝分淮南置。建武十三年省六安国，以其县属。雒阳东一千七百里。）十四城，户十万一千三百九十二，口四十二万四千六百八十三。"
    },
    {
      "id": 237,
      "text": "〖舒〗有桐乡。"
    },
    {
      "id": 238,
      "text": "〖雩娄〗侯国。"
    },
    {
      "id": 239,
      "text": "〖寻阳〗南有九江，东合为大江。"
    },
    {
      "id": 240,
      "text": "〖潜〗"
    },
    {
      "id": 241,
      "text": "〖临湖〗侯国。"
    },
    {
      "id": 242,
      "text": "〖龙舒〗侯国。"
    },
    {
      "id": 243,
      "text": "〖襄安〗"
    },
    {
      "id": 244,
      "text": "〖皖〗有铁。"
    },
    {
      "id": 245,
      "text": "〖居巢〗侯国。"
    },
    {
      "id": 246,
      "text": "〖六安〗国。"
    },
    {
      "id": 247,
      "text": "〖蓼〗侯国。"
    },
    {
      "id": 248,
      "text": "〖安丰〗有大别山。"
    },
    {
      "id": 249,
      "text": "〖阳泉〗侯国。"
    },
    {
      "id": 250,
      "text": "〖安风〗侯国。"
    },
    {
      "id": 251,
      "text": "§会稽郡（秦置。本治吴，立郡吴，乃移山阴。雒阳东三千八百里。）十四城，户十二万三千九十，口四十八万一千一百九十六。"
    },
    {
      "id": 252,
      "text": "〖山阴〗会稽山在南，上有禹冢。有浙江。"
    },
    {
      "id": 253,
      "text": "〖鄮〗"
    },
    {
      "id": 254,
      "text": "〖乌伤〗"
    },
    {
      "id": 255,
      "text": "〖诸暨〗"
    },
    {
      "id": 256,
      "text": "〖余暨〗"
    },
    {
      "id": 257,
      "text": "〖太末〗"
    },
    {
      "id": 258,
      "text": "〖上虞〗"
    },
    {
      "id": 259,
      "text": "〖剡〗"
    },
    {
      "id": 260,
      "text": "〖余姚〗"
    },
    {
      "id": 261,
      "text": "〖句章〗"
    },
    {
      "id": 262,
      "text": "〖鄞〗"
    },
    {
      "id": 263,
      "text": "〖章安〗故治，闽越地，光武更名。"
    },
    {
      "id": 264,
      "text": "〖永宁〗永和三年以章安县东瓯乡为县。"
    },
    {
      "id": 265,
      "text": "〖东部〗侯国。"
    },
    {
      "id": 266,
      "text": "§吴郡（顺帝分会稽置。雒阳东三千二百里。）十三城，户十六万四千一百六十四，口七十万七百八十二。"
    },
    {
      "id": 267,
      "text": "〖吴〗本国。震泽在西，后名具区泽。"
    },
    {
      "id": 268,
      "text": "〖海盐〗"
    },
    {
      "id": 269,
      "text": "〖乌程〗"
    },
    {
      "id": 270,
      "text": "〖余杭〗"
    },
    {
      "id": 271,
      "text": "〖毗陵〗季札所居。北江在北。"
    },
    {
      "id": 272,
      "text": "〖丹徒〗"
    },
    {
      "id": 273,
      "text": "〖曲阿〗"
    },
    {
      "id": 274,
      "text": "〖由拳〗"
    },
    {
      "id": 275,
      "text": "〖安〗"
    },
    {
      "id": 276,
      "text": "〖富春〗"
    },
    {
      "id": 277,
      "text": "〖阳羡〗邑。"
    },
    {
      "id": 278,
      "text": "〖无锡〗侯国。"
    },
    {
      "id": 279,
      "text": "〖娄〗"
    },
    {
      "id": 280,
      "text": "§豫章郡（高帝置。雒阳南二千七百里。）二十一城，户四十万六千四百九十六，口百六十六万八千九百六。"
    },
    {
      "id": 281,
      "text": "〖南昌〗"
    },
    {
      "id": 282,
      "text": "〖建城〗"
    },
    {
      "id": 283,
      "text": "〖新淦〗"
    },
    {
      "id": 284,
      "text": "〖宜春〗"
    },
    {
      "id": 285,
      "text": "〖庐陵〗"
    },
    {
      "id": 286,
      "text": "〖赣〗有豫章水。"
    },
    {
      "id": 287,
      "text": "〖雩都〗"
    },
    {
      "id": 288,
      "text": "〖南野〗有台领山。"
    },
    {
      "id": 289,
      "text": "〖南城〗"
    },
    {
      "id": 290,
      "text": "〖鄱阳〗有鄱水。黄金采。"
    },
    {
      "id": 291,
      "text": "〖历陵〗有傅易山。"
    },
    {
      "id": 292,
      "text": "〖余汗〗"
    },
    {
      "id": 293,
      "text": "〖鄡阳〗"
    },
    {
      "id": 294,
      "text": "〖彭泽〗彭蠡泽在西。"
    },
    {
      "id": 295,
      "text": "〖柴桑〗"
    },
    {
      "id": 296,
      "text": "〖艾〗"
    },
    {
      "id": 297,
      "text": "〖海昏〗侯国。"
    },
    {
      "id": 298,
      "text": "〖平都〗侯国，故安平。"
    },
    {
      "id": 299,
      "text": "〖石阳〗"
    },
    {
      "id": 300,
      "text": "〖临汝〗永元八年置。"
    },
    {
      "id": 301,
      "text": "〖建昌〗永元十六年分海昏置。"
    },
    {
      "id": 302,
      "text": "右扬州刺史部，郡六、县邑、侯国九十二。"
    }
  ]
}