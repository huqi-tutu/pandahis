{
  "work": "03后汉书",
  "vol": "120",
  "source_file": "03后汉书_120_郡国二.txt",
  "source_path": "02二十四史拆分后/03后汉书_拆分后/03后汉书_120_郡国二.txt",
  "paragraph_mode": "line",
  "total": 220,
  "paragraphs": [
    {
      "id": 1,
      "text": "志第二十  郡国二"
    },
    {
      "id": 2,
      "text": "豫州"
    },
    {
      "id": 3,
      "text": "△颍川 汝南 梁国 沛国 陈国 鲁国"
    },
    {
      "id": 4,
      "text": "冀州"
    },
    {
      "id": 5,
      "text": "△魏群 钜鹿 常山 中山 安平 河间 清河 赵国 勃海"
    },
    {
      "id": 6,
      "text": "§颍川郡（秦置。雒阳东南五百里。）十七城，户二十六万三千四百四十，口百四十三万六千五百一十三。"
    },
    {
      "id": 7,
      "text": "〖阳翟〗禹所都。有钧台。有高氏亭。有雍氏城。"
    },
    {
      "id": 8,
      "text": "〖襄〗有养阴里。"
    },
    {
      "id": 9,
      "text": "〖襄城〗有西不羹。有汜城。有汾丘。有鱼齿山。"
    },
    {
      "id": 10,
      "text": "〖昆阳〗有湛水。"
    },
    {
      "id": 11,
      "text": "〖定陵〗有东不羹。"
    },
    {
      "id": 12,
      "text": "〖舞阳〗邑。"
    },
    {
      "id": 13,
      "text": "〖郾〗"
    },
    {
      "id": 14,
      "text": "〖临颍〗"
    },
    {
      "id": 15,
      "text": "〖颍阳〗"
    },
    {
      "id": 16,
      "text": "〖颍阴〗有狐宗乡，或曰古狐人亭。有岸亭。"
    },
    {
      "id": 17,
      "text": "〖许〗"
    },
    {
      "id": 18,
      "text": "〖新汲〗"
    },
    {
      "id": 19,
      "text": "〖鄢陵〗春秋时曰鄢。"
    },
    {
      "id": 20,
      "text": "〖长社〗有长葛城。有向乡。有蜀城，有蜀津。"
    },
    {
      "id": 21,
      "text": "〖阳城〗有嵩高山，洧水、颍水出。有铁。有负黍聚。"
    },
    {
      "id": 22,
      "text": "〖父城〗有应乡。"
    },
    {
      "id": 23,
      "text": "〖轮氏〗建初四年置。"
    },
    {
      "id": 24,
      "text": "§汝南郡（高帝置。雒阳东南六百五十里。）三十七城，户四十万四千四百四十八，口二百一十万七百八十八。"
    },
    {
      "id": 25,
      "text": "〖平舆〗有沈亭，故国，姬姓。"
    },
    {
      "id": 26,
      "text": "〖新阳〗侯国。"
    },
    {
      "id": 27,
      "text": "〖西平〗有铁。有柏亭，故柏国。"
    },
    {
      "id": 28,
      "text": "〖上蔡〗本蔡国。"
    },
    {
      "id": 29,
      "text": "〖南顿〗本顿国。"
    },
    {
      "id": 30,
      "text": "〖汝阴〗本胡国。"
    },
    {
      "id": 31,
      "text": "〖汝阳〗"
    },
    {
      "id": 32,
      "text": "〖新息〗侯国。"
    },
    {
      "id": 33,
      "text": "〖北宜春〗"
    },
    {
      "id": 34,
      "text": "〖氵隐强〗侯国。"
    },
    {
      "id": 35,
      "text": "〖灌阳〗"
    },
    {
      "id": 36,
      "text": "〖期思〗有蒋乡，故蒋国。"
    },
    {
      "id": 37,
      "text": "〖阳安〗有道亭，故国。"
    },
    {
      "id": 38,
      "text": "〖项〗"
    },
    {
      "id": 39,
      "text": "〖西华〗"
    },
    {
      "id": 40,
      "text": "〖细阳〗"
    },
    {
      "id": 41,
      "text": "〖安城〗侯国。有武城亭。"
    },
    {
      "id": 42,
      "text": "〖吴房〗有棠溪亭。"
    },
    {
      "id": 43,
      "text": "〖鲖阳〗侯国。"
    },
    {
      "id": 44,
      "text": "〖慎阳〗"
    },
    {
      "id": 45,
      "text": "〖慎〗"
    },
    {
      "id": 46,
      "text": "〖新蔡〗有大吕亭。"
    },
    {
      "id": 47,
      "text": "〖安阳〗侯国。有江亭，故国，嬴姓。"
    },
    {
      "id": 48,
      "text": "〖富波〗侯国，永元中复。"
    },
    {
      "id": 49,
      "text": "〖宜禄〗永元中复。"
    },
    {
      "id": 50,
      "text": "〖郎陵〗侯国。"
    },
    {
      "id": 51,
      "text": "〖弋阳〗侯国。有黄亭，故黄国，嬴姓。"
    },
    {
      "id": 52,
      "text": "〖召陵〗有陉亭。有安陵乡。"
    },
    {
      "id": 53,
      "text": "〖征羌〗侯国。有安陵亭。"
    },
    {
      "id": 54,
      "text": "〖思善〗侯国。"
    },
    {
      "id": 55,
      "text": "〖宋〗公国，周名郪丘，汉改为新郪，章帝建初四年徙宋公于此。有繁阳亭。"
    },
    {
      "id": 56,
      "text": "〖襃信〗侯国。有赖亭，故国。"
    },
    {
      "id": 57,
      "text": "〖原鹿〗侯国。"
    },
    {
      "id": 58,
      "text": "〖定颍〗侯国。"
    },
    {
      "id": 59,
      "text": "〖固始〗侯国。故寝也，光武中兴更名。有寝丘。"
    },
    {
      "id": 60,
      "text": "〖山桑〗侯国，故属沛。有下城父聚。有垂惠聚。"
    },
    {
      "id": 61,
      "text": "〖城父〗故属沛，春秋时曰夷。有章华台。"
    },
    {
      "id": 62,
      "text": "§梁国（秦砀郡，高帝改。其三县，元和元年属。雒阳东南八百五十里。）九城，户八万三千三百，口四十三万一千二百八十三。"
    },
    {
      "id": 63,
      "text": "〖下邑〗"
    },
    {
      "id": 64,
      "text": "〖睢阳〗本宋国阏伯墟。有卢门亭。有鱼门。有阳梁聚。"
    },
    {
      "id": 65,
      "text": "〖虞〗有空桐地，有桐地，有桐亭。有纶城，少康邑。"
    },
    {
      "id": 66,
      "text": "〖砀山〗出文石。"
    },
    {
      "id": 67,
      "text": "〖蒙〗有蒙泽。"
    },
    {
      "id": 68,
      "text": "〖谷熟〗有新城。有邳亭。"
    },
    {
      "id": 69,
      "text": "〖鄢〗故属陈留。"
    },
    {
      "id": 70,
      "text": "〖宁陵〗故属陈留。有葛乡，故葛伯国。"
    },
    {
      "id": 71,
      "text": "〖薄〗故属山阳，汤所都。"
    },
    {
      "id": 72,
      "text": "§沛国（秦泗水郡，高帝改。雒阳东南千二百里。）二十一城，户二十万四百九十五，口二十五万一千三百九十三。"
    },
    {
      "id": 73,
      "text": "〖相〗"
    },
    {
      "id": 74,
      "text": "〖萧〗本国。"
    },
    {
      "id": 75,
      "text": "〖沛〗有泗水亭。"
    },
    {
      "id": 76,
      "text": "〖丰〗西有大泽，高祖斩白蛇于此。在枌榆亭。"
    },
    {
      "id": 77,
      "text": "〖酂〗有鄍聚。"
    },
    {
      "id": 78,
      "text": "〖谷阳〗"
    },
    {
      "id": 79,
      "text": "〖谯〗刺史治。"
    },
    {
      "id": 80,
      "text": "〖洨〗有垓下聚。"
    },
    {
      "id": 81,
      "text": "〖蕲〗有大泽乡，陈涉起此"
    },
    {
      "id": 82,
      "text": "〖铚〗"
    },
    {
      "id": 83,
      "text": "〖郸〗"
    },
    {
      "id": 84,
      "text": "〖建平〗"
    },
    {
      "id": 85,
      "text": "〖临睢〗故芒，光武更名。"
    },
    {
      "id": 86,
      "text": "〖竹邑〗侯国，故竹。"
    },
    {
      "id": 87,
      "text": "〖公丘〗本滕国。"
    },
    {
      "id": 88,
      "text": "〖龙亢〗"
    },
    {
      "id": 89,
      "text": "〖向〗本国。"
    },
    {
      "id": 90,
      "text": "〖符离〗"
    },
    {
      "id": 91,
      "text": "〖虹〗"
    },
    {
      "id": 92,
      "text": "〖太丘〗"
    },
    {
      "id": 93,
      "text": "〖杼秋〗故属梁国，有澶渊聚。"
    },
    {
      "id": 94,
      "text": "§陈国（高帝置为淮阳，章和二年改。雒阳东南七百里。）九城，户十一万二千六百五十三，口百五十四万七千五百七十二。"
    },
    {
      "id": 95,
      "text": "〖陈〗"
    },
    {
      "id": 96,
      "text": "〖阳夏〗有固陵聚。"
    },
    {
      "id": 97,
      "text": "〖宁平〗"
    },
    {
      "id": 98,
      "text": "〖苦〗春秋时曰相。有赖乡。"
    },
    {
      "id": 99,
      "text": "〖柘〗"
    },
    {
      "id": 100,
      "text": "〖新平〗"
    },
    {
      "id": 101,
      "text": "〖扶乐〗"
    },
    {
      "id": 102,
      "text": "〖武平〗"
    },
    {
      "id": 103,
      "text": "〖长平〗故属汝南。有辰亭。有赭丘城。"
    },
    {
      "id": 104,
      "text": "§鲁国（秦薛郡，高后改。本属徐州，光武改属豫州。）六城，户七万八千四百四十七，口四十一万一千五百九十。"
    },
    {
      "id": 105,
      "text": "〖鲁国〗古奄国。有大庭氏库。有铁。有阙里，孔子所居。有牛首亭。有五父衢。"
    },
    {
      "id": 106,
      "text": "〖驺〗本邾国。"
    },
    {
      "id": 107,
      "text": "〖蕃〗有南梁水。"
    },
    {
      "id": 108,
      "text": "〖薛〗本国，六国时曰徐州。"
    },
    {
      "id": 109,
      "text": "〖卞〗有盗泉。有郚乡城。"
    },
    {
      "id": 110,
      "text": "〖汶阳〗"
    },
    {
      "id": 111,
      "text": "右豫州刺史部，郡、国六，县、邑公、侯国九十九。"
    },
    {
      "id": 112,
      "text": "§魏郡（高帝置。雒阳东北七百里。）十五城，户十二万九千三百一十，口六十九万五千六百六。"
    },
    {
      "id": 113,
      "text": "〖邺〗有故大河。有滏水。有氵釜水，有汙城。有平阳城。有武城。有九侯城。"
    },
    {
      "id": 114,
      "text": "〖繁阳〗"
    },
    {
      "id": 115,
      "text": "〖内黄〗清河水出。有羛阳聚。有黄泽。"
    },
    {
      "id": 116,
      "text": "〖魏〗"
    },
    {
      "id": 117,
      "text": "〖元城〗五鹿墟，故沙鹿，有沙亭。"
    },
    {
      "id": 118,
      "text": "〖黎阳〗"
    },
    {
      "id": 119,
      "text": "〖阴安〗邑"
    },
    {
      "id": 120,
      "text": "〖馆陶〗"
    },
    {
      "id": 121,
      "text": "〖清渊〗"
    },
    {
      "id": 122,
      "text": "〖平恩〗"
    },
    {
      "id": 123,
      "text": "〖沙〗侯国。"
    },
    {
      "id": 124,
      "text": "〖斥丘〗有葛。"
    },
    {
      "id": 125,
      "text": "〖武安〗有铁。"
    },
    {
      "id": 126,
      "text": "〖曲梁〗侯国，故属广平。有鸡泽。"
    },
    {
      "id": 127,
      "text": "〖梁期〗"
    },
    {
      "id": 128,
      "text": "§钜鹿郡（秦置。建武十三年省广平国，以其县属。雒阳北千一百里。）十五城，户十万九千五百一十七，口六十万二千九十六。"
    },
    {
      "id": 129,
      "text": "〖廮陶〗有薄落亭。"
    },
    {
      "id": 130,
      "text": "〖钜鹿〗故大鹿，有大陆泽。"
    },
    {
      "id": 131,
      "text": "〖杨氏〗"
    },
    {
      "id": 132,
      "text": "〖鄡〗"
    },
    {
      "id": 133,
      "text": "〖下曲阳〗有鼓聚，故翟鼓子国。有昔阳亭。"
    },
    {
      "id": 134,
      "text": "〖任〗"
    },
    {
      "id": 135,
      "text": "〖南和〗"
    },
    {
      "id": 136,
      "text": "〖广平〗"
    },
    {
      "id": 137,
      "text": "〖斥章〗"
    },
    {
      "id": 138,
      "text": "〖广宗〗"
    },
    {
      "id": 139,
      "text": "〖曲周〗"
    },
    {
      "id": 140,
      "text": "〖列人〗"
    },
    {
      "id": 141,
      "text": "〖广年〗"
    },
    {
      "id": 142,
      "text": "〖平乡〗"
    },
    {
      "id": 143,
      "text": "〖南〗"
    },
    {
      "id": 144,
      "text": "§常山国（高帝置。建武十三年省真定国，以其县属。）十三城，户九万七千五百，口六十三万一千一百八十四。"
    },
    {
      "id": 145,
      "text": "〖元氏〗"
    },
    {
      "id": 146,
      "text": "〖高邑〗故鄗，光武更名。刺史治。有千秋亭、五成陌，光武即位于上此矣。"
    },
    {
      "id": 147,
      "text": "〖都乡〗侯国。有铁。"
    },
    {
      "id": 148,
      "text": "〖南行唐〗有石臼谷。"
    },
    {
      "id": 149,
      "text": "〖房子〗赞皇山，济水所出。"
    },
    {
      "id": 150,
      "text": "〖平棘〗有塞。"
    },
    {
      "id": 151,
      "text": "〖栾城〗"
    },
    {
      "id": 152,
      "text": "〖九门〗"
    },
    {
      "id": 153,
      "text": "〖灵寿〗卫水出。"
    },
    {
      "id": 154,
      "text": "〖蒲吾〗"
    },
    {
      "id": 155,
      "text": "〖井陉〗"
    },
    {
      "id": 156,
      "text": "〖真定〗"
    },
    {
      "id": 157,
      "text": "〖上艾〗故属太原。"
    },
    {
      "id": 158,
      "text": "§中山国（高祖置。雒阳北一千四百里。）十三城，户九万七千四百一十二，口六十五万八千一百九十五。"
    },
    {
      "id": 159,
      "text": "〖卢奴〗"
    },
    {
      "id": 160,
      "text": "〖北平〗有铁。"
    },
    {
      "id": 161,
      "text": "〖毋极〗"
    },
    {
      "id": 162,
      "text": "〖新市〗有鲜虞亭，故国，子姓。"
    },
    {
      "id": 163,
      "text": "〖望都〗"
    },
    {
      "id": 164,
      "text": "〖唐〗有中人亭，有左人乡。"
    },
    {
      "id": 165,
      "text": "〖安国〗"
    },
    {
      "id": 166,
      "text": "〖安憙〗本安险，章帝更名。"
    },
    {
      "id": 167,
      "text": "〖汉昌〗本苦陉，章帝更名。"
    },
    {
      "id": 168,
      "text": "〖蠡吾〗侯国，故属涿。"
    },
    {
      "id": 169,
      "text": "〖上曲阳〗故属常山。恒山在西北。"
    },
    {
      "id": 170,
      "text": "〖蒲阴〗本曲逆，章帝更名。有阳城。"
    },
    {
      "id": 171,
      "text": "〖广昌〗故属代郡。"
    },
    {
      "id": 172,
      "text": "§安平国（故信都，高帝置。明帝名乐成，延光元年改。雒阳北二千里。）十三城，户九万一千四百四十，口六十五万五千一百一十八。"
    },
    {
      "id": 173,
      "text": "信都〗有绛水、呼沱河。"
    },
    {
      "id": 174,
      "text": "〖阜城〗故昌城。"
    },
    {
      "id": 175,
      "text": "〖南宫〗"
    },
    {
      "id": 176,
      "text": "〖扶柳〗"
    },
    {
      "id": 177,
      "text": "〖下博〗"
    },
    {
      "id": 178,
      "text": "〖武邑〗"
    },
    {
      "id": 179,
      "text": "〖观津〗经西有漳水，津名薄落津。"
    },
    {
      "id": 180,
      "text": "〖堂阳〗故属钜鹿。"
    },
    {
      "id": 181,
      "text": "〖武遂〗故属河间。"
    },
    {
      "id": 182,
      "text": "〖饶阳〗故名饶，属涿。有无蒌亭。"
    },
    {
      "id": 183,
      "text": "〖安平〗故属涿。"
    },
    {
      "id": 184,
      "text": "〖南深〗泽故属涿。"
    },
    {
      "id": 185,
      "text": "§河间国（文帝置，世祖省属信都，和帝永元二年复故。雒阳北二千五百里。）十一城，户九万三千七百五十四，口六十三万四千四百二十一。"
    },
    {
      "id": 186,
      "text": "〖乐成〗"
    },
    {
      "id": 187,
      "text": "〖弓高〗"
    },
    {
      "id": 188,
      "text": "〖易〗故属涿。"
    },
    {
      "id": 189,
      "text": "〖武垣〗故属涿。"
    },
    {
      "id": 190,
      "text": "〖中水〗故属涿。"
    },
    {
      "id": 191,
      "text": "〖鄚〗故属涿。"
    },
    {
      "id": 192,
      "text": "高阳〗故属涿。有葛城。"
    },
    {
      "id": 193,
      "text": "〖文安〗故属勃海。"
    },
    {
      "id": 194,
      "text": "〖束州〗故属勃海。"
    },
    {
      "id": 195,
      "text": "〖成平〗故属勃海。"
    },
    {
      "id": 196,
      "text": "〖东平舒〗故属勃海。"
    },
    {
      "id": 197,
      "text": "§清河国（高帝置。桓帝建和二年改为甘陵。雒阳北千二百八十里。）七城，户十二万三千九百六十四，口七十六万四百一十八。"
    },
    {
      "id": 198,
      "text": "〖甘陵〗故厝，安帝更名。"
    },
    {
      "id": 199,
      "text": "〖贝丘〗"
    },
    {
      "id": 200,
      "text": "〖东武城〗"
    },
    {
      "id": 201,
      "text": "〖鄃〗"
    },
    {
      "id": 202,
      "text": "〖灵〗和帝永元九年夏。"
    },
    {
      "id": 203,
      "text": "〖绎幕〗"
    },
    {
      "id": 204,
      "text": "〖广川〗故属信都。有棘津城。"
    },
    {
      "id": 205,
      "text": "§赵国（秦邯郸郡，高帝改名。雒阳北千一百里。）五城，户三万二千七百一十九，口十八万八千三百八十一。"
    },
    {
      "id": 206,
      "text": "〖邯郸〗有丛台。"
    },
    {
      "id": 207,
      "text": "〖易阳〗"
    },
    {
      "id": 208,
      "text": "〖襄国〗本邢国，秦为信都，项羽更名。有檀台。有苏人亭。"
    },
    {
      "id": 209,
      "text": "〖柏人〗"
    },
    {
      "id": 210,
      "text": "〖中丘〗"
    },
    {
      "id": 211,
      "text": "§勃海郡（高帝置。雒阳北千六百里。）八城，户十三万二千三百八十九，口百一十万六千五百"
    },
    {
      "id": 212,
      "text": "〖南皮〗"
    },
    {
      "id": 213,
      "text": "〖高城〗侯国。"
    },
    {
      "id": 214,
      "text": "〖重合〗侯国。"
    },
    {
      "id": 215,
      "text": "〖浮阳〗侯国"
    },
    {
      "id": 216,
      "text": "〖东光〗"
    },
    {
      "id": 217,
      "text": "〖章武〗"
    },
    {
      "id": 218,
      "text": "〖阳信〗延光元年复。"
    },
    {
      "id": 219,
      "text": "〖脩〗故属信都。"
    },
    {
      "id": 220,
      "text": "右冀州刺史部，郡、国九，县、邑、侯国百。"
    }
  ]
}