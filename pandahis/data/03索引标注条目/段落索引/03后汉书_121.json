{
  "work": "03后汉书",
  "vol": "121",
  "source_file": "03后汉书_121_郡国三.txt",
  "source_path": "02二十四史拆分后/03后汉书_拆分后/03后汉书_121_郡国三.txt",
  "paragraph_mode": "line",
  "total": 162,
  "paragraphs": [
    {
      "id": 1,
      "text": "志第二十一  郡国三"
    },
    {
      "id": 2,
      "text": "兖州"
    },
    {
      "id": 3,
      "text": "△陈留 东郡 东平 任城 泰山 济北 山阳 济阴"
    },
    {
      "id": 4,
      "text": "徐州"
    },
    {
      "id": 5,
      "text": "△东海 琅邪 彭城 广陵 下邳"
    },
    {
      "id": 6,
      "text": "§陈留郡（武帝置。雒阳东五百三十里。）十七城，户十七万七千五百二十九，口八十六万九千四百三十三。"
    },
    {
      "id": 7,
      "text": "〖陈留〗有鸣雁亭。"
    },
    {
      "id": 8,
      "text": "〖浚仪〗本大梁。"
    },
    {
      "id": 9,
      "text": "〖尉氏〗"
    },
    {
      "id": 10,
      "text": "〖雍丘〗本杞国。"
    },
    {
      "id": 11,
      "text": "〖襄邑〗有滑亭。有承匡城。"
    },
    {
      "id": 12,
      "text": "〖外黄〗有葵丘聚，齐桓公会此，城中有曲棘里。有繁阳城。"
    },
    {
      "id": 13,
      "text": "〖小黄〗"
    },
    {
      "id": 14,
      "text": "〖东昏〗"
    },
    {
      "id": 15,
      "text": "〖济阳〗"
    },
    {
      "id": 16,
      "text": "〖平丘〗有临济亭，田儋死此。有匡。有黄池亭。"
    },
    {
      "id": 17,
      "text": "〖封丘〗有桐牢亭，或曰古虫牢。"
    },
    {
      "id": 18,
      "text": "〖酸枣〗"
    },
    {
      "id": 19,
      "text": "〖长垣〗侯国。有匡城。有蒲城。有祭城。"
    },
    {
      "id": 20,
      "text": "〖己吾〗有大棘乡。有首乡。"
    },
    {
      "id": 21,
      "text": "〖考城〗故菑，章帝更名。故属梁。"
    },
    {
      "id": 22,
      "text": "〖圉〗故属淮阳。有高阳亭。"
    },
    {
      "id": 23,
      "text": "〖扶沟〗故属淮阳。"
    },
    {
      "id": 24,
      "text": "§东郡（秦置。去雒阳八百余里。）十五城，户十三万六千八十八，口六十万三千三百九十三。"
    },
    {
      "id": 25,
      "text": "〖濮阳〗古昆吾国，春秋时曰濮。有咸城，或曰古咸国。有清丘。有鉏城。"
    },
    {
      "id": 26,
      "text": "〖燕〗本南燕国。有雍乡。有胙城，占胙国。有平阳亭。有瓦亭。有桃城。"
    },
    {
      "id": 27,
      "text": "〖白马〗有韦乡。"
    },
    {
      "id": 28,
      "text": "〖顿丘〗"
    },
    {
      "id": 29,
      "text": "〖东阿〗有清亭。"
    },
    {
      "id": 30,
      "text": "〖东武阳〗湿水出。"
    },
    {
      "id": 31,
      "text": "〖范〗有秦亭。"
    },
    {
      "id": 32,
      "text": "〖临邑〗有泲庙。"
    },
    {
      "id": 33,
      "text": "〖博平〗"
    },
    {
      "id": 34,
      "text": "〖聊城〗有夷仪聚。有聂城。"
    },
    {
      "id": 35,
      "text": "〖发干〗"
    },
    {
      "id": 36,
      "text": "〖乐平〗侯国。故清，章帝更名。"
    },
    {
      "id": 37,
      "text": "〖阳平〗侯国。有莘亭。有冈成城。"
    },
    {
      "id": 38,
      "text": "〖卫〗公国。本观故国，姚姓，光武更名。有河牧城。有竿城。"
    },
    {
      "id": 39,
      "text": "〖谷城〗春秋时小谷。有巂下聚。"
    },
    {
      "id": 40,
      "text": "§东平国（故梁，景帝分为济东国，宣帝改。雒阳东九百七十五里。）七城，户七万九千一十二，口四十四万八千二百七十。"
    },
    {
      "id": 41,
      "text": "〖无盐〗本宿国，任姓。有章城。"
    },
    {
      "id": 42,
      "text": "〖东平陆〗六国时曰平陆。有阚亭。有堂阳亭。"
    },
    {
      "id": 43,
      "text": "〖富成〗"
    },
    {
      "id": 44,
      "text": "〖章〗"
    },
    {
      "id": 45,
      "text": "〖寿张〗春秋曰良，汉曰寿良，光武改曰寿张。有堂聚，故聚属东郡。"
    },
    {
      "id": 46,
      "text": "〖须昌〗故属东郡。有致密城，古中都。有阳谷城。"
    },
    {
      "id": 47,
      "text": "〖宁阳〗故属泰山。"
    },
    {
      "id": 48,
      "text": "§任城国（章帝元和元年，分东平为任城。雒阳东千一百里。）三城，户三万六千四百四十二，口十九万四千一百五十六。"
    },
    {
      "id": 49,
      "text": "〖任城〗本任国。有桃聚。"
    },
    {
      "id": 50,
      "text": "〖亢父〗"
    },
    {
      "id": 51,
      "text": "〖樊〗"
    },
    {
      "id": 52,
      "text": "§泰山郡（高帝置。雒阳东千四百里。）十二城，户八千九百二十九，口四十三万七千三百一十七。"
    },
    {
      "id": 53,
      "text": "〖奉高〗有明堂，武帝造。"
    },
    {
      "id": 54,
      "text": "〖博〗有泰山庙。岱山在西北。有龟山。有龙乡城。"
    },
    {
      "id": 55,
      "text": "〖梁甫〗侯国。有菟裘聚。"
    },
    {
      "id": 56,
      "text": "〖钜平〗侯国。有亭禅山。有阳关亭。"
    },
    {
      "id": 57,
      "text": "〖嬴〗有铁。"
    },
    {
      "id": 58,
      "text": "〖山茌〗侯国。"
    },
    {
      "id": 59,
      "text": "〖莱芜〗有原山，潘水出。"
    },
    {
      "id": 60,
      "text": "〖盖〗沂水出。"
    },
    {
      "id": 61,
      "text": "〖南武阳〗侯国。有颛臾城。"
    },
    {
      "id": 62,
      "text": "〖南城〗故属东海。有东阳城。"
    },
    {
      "id": 63,
      "text": "〖费〗侯国，故属东海。有祊亭。有台亭。"
    },
    {
      "id": 64,
      "text": "〖牟〗故国。"
    },
    {
      "id": 65,
      "text": "§济北国（和帝永元二年，分泰山置。雒阳东千一百五十里。）五城，户四万五千六百八十九，口二十三万五千八百九十七。"
    },
    {
      "id": 66,
      "text": "〖卢〗有平阴城。有防门。有光里。有景兹山。有敖山。有清亭。有长城至东海。"
    },
    {
      "id": 67,
      "text": "〖蛇丘〗有遂乡。有下讙亭。有铸乡城。"
    },
    {
      "id": 68,
      "text": "〖成〗本国。"
    },
    {
      "id": 69,
      "text": "〖茌平〗本属东郡。"
    },
    {
      "id": 70,
      "text": "〖刚〗"
    },
    {
      "id": 71,
      "text": "§山阳郡（故梁，景帝分置。雒阳东八百一十里。）十城，户十万九千八百九十八，口六十万六千九十一。"
    },
    {
      "id": 72,
      "text": "〖昌邑〗刺史治。有梁丘城。有甲父亭。"
    },
    {
      "id": 73,
      "text": "〖东缗〗春秋时曰缗。"
    },
    {
      "id": 74,
      "text": "〖钜野〗有大野泽。"
    },
    {
      "id": 75,
      "text": "〖高平〗侯国。故橐，章帝更名。有茅乡城。"
    },
    {
      "id": 76,
      "text": "〖湖陆〗故湖陵，章帝更名。"
    },
    {
      "id": 77,
      "text": "〖南平阳〗侯国。有漆亭。有闾丘亭。"
    },
    {
      "id": 78,
      "text": "〖方与〗有武唐亭，鲁侯观鱼台。有泥母亭，或曰古宁母。"
    },
    {
      "id": 79,
      "text": "〖瑕丘〗"
    },
    {
      "id": 80,
      "text": "〖金乡〗"
    },
    {
      "id": 81,
      "text": "〖防东〗"
    },
    {
      "id": 82,
      "text": "§济阴郡（故梁，景帝分置。雒阳东八百里。）十一城，户十三万三千七百一十五，口六十五万七千五百五十四。"
    },
    {
      "id": 83,
      "text": "〖定陶〗本曹国，古陶，尧所居。有三鬷亭。"
    },
    {
      "id": 84,
      "text": "〖冤句〗有煮枣城。"
    },
    {
      "id": 85,
      "text": "〖成阳〗有尧冢、灵台，有雷泽。"
    },
    {
      "id": 86,
      "text": "〖乘氏〗侯国。有泗水。有鹿城乡。"
    },
    {
      "id": 87,
      "text": "〖句阳〗有垂亭。"
    },
    {
      "id": 88,
      "text": "〖鄄城〗"
    },
    {
      "id": 89,
      "text": "〖离狐〗故属东郡。"
    },
    {
      "id": 90,
      "text": "〖廪丘〗故属东郡。有高鱼城。有运城。"
    },
    {
      "id": 91,
      "text": "〖单父〗侯国，故属山阳。"
    },
    {
      "id": 92,
      "text": "〖成武〗故属山阳。有郜城。"
    },
    {
      "id": 93,
      "text": "〖己氏〗故属梁。"
    },
    {
      "id": 94,
      "text": "右兖州刺史部，郡、国八，县、邑、公、侯国八十。"
    },
    {
      "id": 95,
      "text": "§东海郡（高帝置，雒阳东千五百里。）十三城，户十四万八千七百八十四，口七十万六千四百一十六。"
    },
    {
      "id": 96,
      "text": "〖郯〗本国，刺史治。"
    },
    {
      "id": 97,
      "text": "〖兰陵〗有次室亭。"
    },
    {
      "id": 98,
      "text": "〖戚〗"
    },
    {
      "id": 99,
      "text": "〖朐〗有铁。有伊卢乡。"
    },
    {
      "id": 100,
      "text": "〖襄贲〗"
    },
    {
      "id": 101,
      "text": "〖昌虑〗有蓝乡。"
    },
    {
      "id": 102,
      "text": "〖承〗"
    },
    {
      "id": 103,
      "text": "〖阴平〗"
    },
    {
      "id": 104,
      "text": "〖利城〗"
    },
    {
      "id": 105,
      "text": "〖合乡〗"
    },
    {
      "id": 106,
      "text": "〖祝其〗有羽山。春秋时曰祝其，夹谷地。"
    },
    {
      "id": 107,
      "text": "〖厚丘〗"
    },
    {
      "id": 108,
      "text": "〖赣榆〗本属琅邪，建初五年复。"
    },
    {
      "id": 109,
      "text": "§琅邪国（秦置。建武中省城阳国，以其县属。雒阳东一千五百里。）十三城，户二万八百四，口五十七万九百六十七。"
    },
    {
      "id": 110,
      "text": "〖开阳〗故属东海，建初五年属。"
    },
    {
      "id": 111,
      "text": "〖东武〗"
    },
    {
      "id": 112,
      "text": "〖琅邪〗"
    },
    {
      "id": 113,
      "text": "〖东莞〗有郓亭。有邳乡。有公来山。或曰古浮来。"
    },
    {
      "id": 114,
      "text": "〖西海〗"
    },
    {
      "id": 115,
      "text": "〖诸〗"
    },
    {
      "id": 116,
      "text": "〖莒〗本国，故属城阳。有铁。有峥嵘谷。"
    },
    {
      "id": 117,
      "text": "〖东安〗故属城阳。"
    },
    {
      "id": 118,
      "text": "〖阳都〗故属城阳。有牟台。"
    },
    {
      "id": 119,
      "text": "〖临沂〗故属东海。有丛亭。"
    },
    {
      "id": 120,
      "text": "〖即丘〗侯国，故属东海，春秋曰祝丘。"
    },
    {
      "id": 121,
      "text": "〖缯〗侯国，故属东海。有概亭。"
    },
    {
      "id": 122,
      "text": "〖姑幕〗"
    },
    {
      "id": 123,
      "text": "§彭城国（高祖置为楚，章帝改。雒阳东千二百二十里。）八城，户八万六千一百七十，口四十九万三千二十七。"
    },
    {
      "id": 124,
      "text": "〖彭城〗有铁。"
    },
    {
      "id": 125,
      "text": "〖武原〗"
    },
    {
      "id": 126,
      "text": "〖傅阳〗有柤水。"
    },
    {
      "id": 127,
      "text": "〖吕〗"
    },
    {
      "id": 128,
      "text": "〖留〗"
    },
    {
      "id": 129,
      "text": "〖梧〗"
    },
    {
      "id": 130,
      "text": "〖菑丘〗"
    },
    {
      "id": 131,
      "text": "〖广戚〗故属沛。"
    },
    {
      "id": 132,
      "text": "§广陵郡（景帝置为江都，武帝更名。建武中省泗水国，以其县属。雒阳东一千六百四十里。）十一城，户八万三千九百七，口四十一万百九十。"
    },
    {
      "id": 133,
      "text": "〖广陵〗有东陵亭。"
    },
    {
      "id": 134,
      "text": "〖江都〗有江水祠。"
    },
    {
      "id": 135,
      "text": "〖高邮〗"
    },
    {
      "id": 136,
      "text": "〖平安〗"
    },
    {
      "id": 137,
      "text": "〖氵夌〗故属泗水。"
    },
    {
      "id": 138,
      "text": "〖东阳〗故属临淮。有长洲泽，吴王濞太仓在此。"
    },
    {
      "id": 139,
      "text": "〖射阳〗故属临淮。"
    },
    {
      "id": 140,
      "text": "〖盐渎〗故属临淮"
    },
    {
      "id": 141,
      "text": "〖舆〗侯国，故属临淮。"
    },
    {
      "id": 142,
      "text": "〖堂邑〗故属临淮。有铁。春秋时曰堂。"
    },
    {
      "id": 143,
      "text": "〖海西〗故属东海。"
    },
    {
      "id": 144,
      "text": "§下邳国（武帝置为临淮郡，永平十五年更为下邳国。雒阳东千四百里。）十七城，户十三万六千三百八十九，口六十一万一千八十三。"
    },
    {
      "id": 145,
      "text": "〖下邳〗本属东海。有葛峄山，本峄阳山。有铁。"
    },
    {
      "id": 146,
      "text": "〖徐〗本国。有楼亭，或曰古蒌林。"
    },
    {
      "id": 147,
      "text": "〖僮〗侯国。"
    },
    {
      "id": 148,
      "text": "〖睢陵〗"
    },
    {
      "id": 149,
      "text": "〖下相〗"
    },
    {
      "id": 150,
      "text": "〖淮阴〗"
    },
    {
      "id": 151,
      "text": "〖淮浦〗"
    },
    {
      "id": 152,
      "text": "〖盱台〗"
    },
    {
      "id": 153,
      "text": "〖高山〗"
    },
    {
      "id": 154,
      "text": "〖潘旌〗"
    },
    {
      "id": 155,
      "text": "〖淮陵〗"
    },
    {
      "id": 156,
      "text": "〖取虑〗有蒲姑陂。"
    },
    {
      "id": 157,
      "text": "〖东成〗"
    },
    {
      "id": 158,
      "text": "〖曲阳〗侯国，故属东海。"
    },
    {
      "id": 159,
      "text": "〖司吾〗侯国，故属东海。"
    },
    {
      "id": 160,
      "text": "〖良成〗故属东海。春秋时曰良。"
    },
    {
      "id": 161,
      "text": "〖夏丘〗故属沛。"
    },
    {
      "id": 162,
      "text": "右徐州刺史部，郡、国五，县、邑、侯国六十二。"
    }
  ]
}