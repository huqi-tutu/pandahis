      "text": "《孙子》十六篇。六国时。《捷子》二篇。齐人，武帝时说。"
    },
    {
      "id": 225,
      "text": "《曹羽》二篇。楚人，武帝时说于齐王。"
    },
    {
      "id": 226,
      "text": "《郎中婴齐》十二篇。武帝时。"
    },
    {
      "id": 227,
      "text": "《臣君子》二篇。蜀人。"
    },
    {
      "id": 228,
      "text": "《郑长者》一篇。六国时。先韩子，韩子称之。"
    },
    {
      "id": 229,
      "text": "《楚子》三篇。"
    },
    {
      "id": 230,
      "text": "《道家言》二篇。近世，不知作者。"
    },
    {
      "id": 231,
      "text": "右道三十七家，九百九十三篇。"
    },
    {
      "id": 232,
      "text": "道家者流，盖出于史官，历记成败存亡祸福古今之道，然后知秉要执本，清虚以自守，卑弱以自持，此君人南面之术也。合于尧之克攘，《易》之嗛々，一谦而四益，此其所长也。及放者为之，则欲绝去礼学，兼弃仁义，曰独任清虚可以为治。"
    },
    {
      "id": 233,
      "text": "《宋司星子韦》三篇。景公之史。"
    },
    {
      "id": 234,
      "text": "《公檮生终始》十四篇。传邹奭《始终》书。"
    },
    {
      "id": 235,
      "text": "《公孙发》二十二篇。六国时。"
    },
    {
      "id": 236,
      "text": "《邹子》四十九篇。名衍，齐人，为燕昭王师，居稷下，号谈天衍。"
    },
    {
      "id": 237,
      "text": "《邹子终始》五十六篇。"
    },
    {
      "id": 238,
      "text": "《乘丘子》五篇。六国时。"
    },
    {
      "id": 239,
      "text": "《杜文公》五篇。六国时。"
    },
    {
      "id": 240,
      "text": "《黄帝泰素》二十篇。六国时韩诸公子所作。"
    },
    {
      "id": 241,
      "text": "《南公》三十一篇。六国时。"
    },
    {
      "id": 242,
      "text": "《容成子》十四篇。"
    },
    {
      "id": 243,
      "text": "《张苍》十六篇。丞相北平侯。"
    },
    {
      "id": 244,
      "text": "《邹奭子》十二篇。齐人，号曰雕龙奭。"
    },
    {
      "id": 245,
      "text": "《闾丘子》十三篇。名快，魏人，在南公前。"
    },
    {
      "id": 246,
      "text": "《冯促》十三篇。郑人。"
    },
    {
      "id": 247,
      "text": "《将巨子》五篇。六国时。先南公，南公称之。"
    },
    {
      "id": 248,
      "text": "《五曹官制》五篇。汉制，似贾谊所条。"
    },
    {
      "id": 249,
      "text": "《周伯》十一篇。齐人，六国时。"
    },
    {
      "id": 250,
      "text": "《卫侯官》十二篇。近世，不知作者。"
    },
    {
      "id": 251,
      "text": "于长《天下忠臣》九篇。平阴人，近世。"
    },
    {
      "id": 252,
      "text": "《公孙浑邪》十五篇。平曲侯。"
    },
    {
      "id": 253,
      "text": "《杂阴阳》三十八篇。不知作者。"
    },
    {
      "id": 254,
      "text": "右阴阳二十一家，三百六十九篇。"
    },
    {
      "id": 255,
      "text": "阴阳家者流，盖出于羲和之官，敬顺昊天，历象日月星辰，敬授民时，此其所长也。及拘者为之，则牵于禁忌，泥于小数，舍人事而任鬼神。"
    },
    {
      "id": 256,
      "text": "《李子》三十二篇。名悝，相魏文侯，富国强兵。"
    },
    {
      "id": 257,
      "text": "《商君》二十九篇。名鞅，姬姓，卫后也，相秦孝公，有《列传》。"
    },
    {
      "id": 258,
      "text": "《申子》六篇。名不害，京人，相韩昭侯，终其身诸侯不敢侵韩。"
    },
    {
      "id": 259,
      "text": "《处子》九篇。《慎子》四十二篇。名到，先申、韩，申、韩称之。"
    },
    {
      "id": 260,
      "text": "《韩子》五十五篇。名非，韩诸公子，使秦，李斯害而杀之。"
    },
    {
      "id": 261,
      "text": "《游棣子》一篇。"
    },
    {
      "id": 262,
      "text": "《晁错》三十一篇。"
    },
    {
      "id": 263,
      "text": "《燕十事》十篇。不知作者。"
    },
    {
      "id": 264,
      "text": "《法家言》二篇。不知作者。"
    },
    {
      "id": 265,
      "text": "右法十家，二百一十七篇。"
    },
    {
      "id": 266,
      "text": "法家者流，盖出于理官。信赏必罚，以辅礼制。《易》曰“先王以明罚饬法”，此其所长也。及刻者为之，则无教化，去仁爱，专任刑法而欲以致治，至于残害至亲，伤恩薄厚。"
    },
    {
      "id": 267,
      "text": "《邓析》二篇。郑人，与子产并时。"
    },
    {
      "id": 268,
      "text": "《尹文子》一篇。说齐宣王。先公孙龙。"
    },
    {
      "id": 269,
      "text": "《公孙龙子》十四篇。赵人。"
    },
    {
      "id": 270,
      "text": "《成公生》五篇。与黄公等同时。"
    },
    {
      "id": 271,
      "text": "《惠子》一篇。名施，与庄子并时。"
    },
    {
      "id": 272,
      "text": "《黄公》四篇。名疵，为秦博士，作歌诗，在秦时歌诗中。"
    },
    {
      "id": 273,
      "text": "《毛公》九篇。赵人，与公孙龙等并游平原君赵胜家。"
    },
    {
      "id": 274,
      "text": "右名七家，三十六篇。"
    },
    {
      "id": 275,
      "text": "名家者流，盖出于礼官。古者名位不同，礼亦异数。孔子曰：“必也正名乎！名不正则言不顺，言不顺则事不成。”此其所长也。及譥者为之，则苟钩鈲鋠析乱而已。"
    },
    {
      "id": 276,
      "text": "《尹佚》二篇。周臣，在成、康时也。"
    },
    {
      "id": 277,
      "text": "《田俅子》三篇。先韩子。"
    },
    {
      "id": 278,
      "text": "《我子》一篇。"
    },
    {
      "id": 279,
      "text": "《随巢子》六篇。墨翟弟子。"
    },
    {
      "id": 280,
      "text": "《胡非子》三篇。墨翟弟子。"
    },
    {
      "id": 281,
      "text": "《墨子》七十一篇。名翟，为宋大夫，在孔子后。"
    },
    {
      "id": 282,
      "text": "右墨六家，八十六篇。"
    },
    {
      "id": 283,
      "text": "墨家者流，盖出于清庙之守。茅屋采椽，是以贵俭；养三老五更，是以兼爱；选士大射，是以上贤；宗祀严父，是以右鬼；顺四时而行，是以非命；以孝视天下，是以上同；此其所长也。及蔽者为之，见俭之利，因以非礼，推兼爱之意，而不知别亲疏。"
    },
    {
      "id": 284,
      "text": "《苏子》三十一篇。名秦，有《列传》。"
    },
    {
      "id": 285,
      "text": "《张子》十篇。名仪，有《列传》。"
    },
    {
      "id": 286,
      "text": "《庞煖》二篇。为燕将。"
    },
    {
      "id": 287,
      "text": "《阙子》一篇。"
    },
    {
      "id": 288,
      "text": "《国筮子》十七篇。"
    },
    {
      "id": 289,
      "text": "《秦零陵令信》一篇。难秦相李斯。"
    },
    {
      "id": 290,
      "text": "《蒯子》五篇。名通。"
    },
    {
      "id": 291,
      "text": "《邹阳》七篇。"
    },
    {
      "id": 292,
      "text": "《主父偃》二十八篇。"
    },
    {
      "id": 293,
      "text": "《徐氏》一篇。"
    },
    {
      "id": 294,
      "text": "《庄安》一篇。"
    },
    {
      "id": 295,
      "text": "《待诏金马聊苍》三篇。赵人，武帝时。"
    },
    {
      "id": 296,
      "text": "右从横十二家，百七篇。"
    },
    {
      "id": 297,
      "text": "从横家者流，盖出于行人之官。孔子曰：“诵《诗》三百，使于四方，不能颛对，虽多亦奚以为？”又曰：“使乎，使乎！”言其当权事制宜，受命而不受辞。此其所长也。及邪人为之，则上诈谖而弃其信。"
    },
    {
      "id": 298,
      "text": "孔甲《盘盂》二十六篇。黄帝之史，或曰夏帝孔甲，似皆非。《大禹》三十七篇。传言禹所作，其文似后世语。"
    },
    {
      "id": 299,
      "text": "《五子胥》八篇。名员，春秋时为吴将，忠直遇谗死。"
    },
    {
      "id": 300,
      "text": "《子晚子》三十五篇。齐人，好议兵，与《司马法》相似。"
    },
    {
      "id": 301,
      "text": "《由余》三篇。戎人，秦穆公聘以为大夫。"
    },
    {
      "id": 302,
      "text": "《尉缭》二十九篇。六国时。"
    },
    {
      "id": 303,
      "text": "《尸子》二十篇。名佼，鲁人，秦相商君师之。鞅死，佼逃入蜀。"
    },
    {
      "id": 304,
      "text": "《吕氏春秋》二十六篇。秦相吕不韦辑智略士作。"
    },
    {
      "id": 305,
      "text": "《淮南内》二十一篇。王安。"
    },
    {
      "id": 306,
      "text": "《淮南外》三十三篇。"
    },
    {
      "id": 307,
      "text": "《东方朔》二十篇。"
    },
    {
      "id": 308,
      "text": "《伯象先生》一篇。"
    },
    {
      "id": 309,
      "text": "《荆轲论》五篇。轲为燕刺秦王，不成而死，司马相如等论之。"
    },
    {
      "id": 310,
      "text": "《吴子》一篇。"
    },
    {
      "id": 311,
      "text": "《公孙尼》一篇。"
    },
    {
      "id": 312,
      "text": "《博士臣贤对》一篇。汉世，难韩子、商君。"
    },
    {
      "id": 313,
      "text": "《臣说》三篇。武帝时作赋。"
    },
    {
      "id": 314,
      "text": "《解子簿书》三十五篇。"
    },
    {
      "id": 315,
      "text": "《推杂书》八十七篇。"
    },
    {
      "id": 316,
      "text": "《杂家言》一篇。王伯，不知作者。"
    },
    {
      "id": 317,
      "text": "右杂二十家，四百三篇。入兵法。"
    },
    {
      "id": 318,
      "text": "杂家者流，盖出于议官。兼儒、墨，合名、法，知国体之有此，见王治之无不贯，此其所长也。及荡者为之，则漫羡而无所归心。"
    },
    {
      "id": 319,
      "text": "《神农》二十篇。六国时，诸子疾时怠于农业，道耕农事，托之神农。"
    },
    {
      "id": 320,
      "text": "《野老》十七篇。六国时，在齐、楚间。"
    },
    {
      "id": 321,
      "text": "《宰氏》十七篇。不知何世。"
    },
    {
      "id": 322,
      "text": "《董安国》十六篇。汉代内史，不知何帝时。"
    },
    {
      "id": 323,
      "text": "《尹都尉》十四篇。不知何世。《赵氏》五篇。不知何世。"
    },
    {
      "id": 324,
      "text": "《汜胜之》十八篇。成帝时为议郎。"
    },
    {
      "id": 325,
      "text": "《王氏》六篇。不知何世。"
    },
    {
      "id": 326,
      "text": "《蔡癸》一篇。宣帝时，以言便宜，至弘农太守。"
    },
    {
      "id": 327,
      "text": "右农九家，百一十四篇。"
    },
    {
      "id": 328,
      "text": "农家者流，盖出于农稷之官。播百谷，劝耕桑，以足衣食，故八政一曰食，二曰货。孔子曰“所重民食”，此其所长也。及鄙者为之，以为无所事圣王，欲使君臣并耕，誖上下之序。"
    },
    {
      "id": 329,
      "text": "《伊尹说》二十七篇。其语浅薄，似依托也。"
    },
    {
      "id": 330,
      "text": "《鬻子说》十九篇。后世所加。"
    },
    {
      "id": 331,
      "text": "《周考》七十六篇。考周事也。"
    },
    {
      "id": 332,
      "text": "《青史子》五十七篇。古史官记事也。"
    },
    {
      "id": 333,
      "text": "《师旷》六篇。见《春秋》，其言浅薄，本与此同，似因托之。"
    },
    {
      "id": 334,
      "text": "《务成子》十一篇。称尧问，非古语。"
    },
    {
      "id": 335,
      "text": "《宋子》十八篇。孙卿道宋子，其言黄、老意。"
    },
    {
      "id": 336,
      "text": "《天乙》三篇。天乙谓汤，其言非殷时，皆依托也。"
    },
    {
      "id": 337,
      "text": "《黄帝说》四十篇。迂诞依托。"
    },
    {
      "id": 338,
      "text": "《封禅方说》十八篇。武帝时。"
    },
    {
      "id": 339,
      "text": "《待诏臣饶心术》二十五篇。武帝时。"
    },
    {
      "id": 340,
      "text": "《待诏臣安成未央术》一篇。"
    },
    {
      "id": 341,
      "text": "《臣寿周纪》七篇。项国圉人，宣帝时。"
    },
    {
      "id": 342,
      "text": "《虞初周说》九百四十三篇。河南人，武帝时以方士侍郎号黄车使者。"
    },
    {
      "id": 343,
      "text": "《百家》百三十九卷。"
    },
    {
      "id": 344,
      "text": "右小说十五家，千三百八十篇。"
    },
    {
      "id": 345,
      "text": "小说家者流，盖出于稗官。街谈巷语，道听涂说者之所造也。孔子曰：“虽小道，必有可观者焉，致远恐泥，是以君子弗为也。”然亦弗灭也。闾里小知者之所及，亦使缀而不忘。如或一言可采，此亦刍荛狂夫之议也。"
    },
    {
      "id": 346,
      "text": "凡诸子百八十九家，四千三百二十四篇。出蹴"
    },
    {
      "id": 347,
      "text": "一家，二十五篇。"
    },
    {
      "id": 348,
      "text": "诸子十家，其可观者九家而已。皆起于王道既微，诸侯力政，时君世主，好恶殊方，是以九家之术蜂出并作，各引一端，崇其所善，以此驰说，取合诸侯。其言虽殊，辟犹水火，相灭亦相生也。仁之与义，敬之与和，相反而皆相成也。《易》曰：“天下同归而殊涂，一致而百虑。”今异家者各推所长，穷知究虑，以明其指，虽有蔽短，合其要归，亦《六经》之支与流裔。使其人遭明王圣主，得其所折中，皆股肱之材已。仲尼有言：“礼失而求诸野。”方今去圣久远，道术缺废，无所更索，彼九家者，不犹愈于野乎？若能修六艺之术。而观此九家之言，舍短取长，则可以通万方之略矣。"
    },
    {
      "id": 349,
      "text": "屈原赋二十五篇。楚怀王大夫，有《列传》。"
    },
    {
      "id": 350,
      "text": "唐勒赋四篇。楚人。"
    },
    {
      "id": 351,
      "text": "宋玉赋十六篇。楚人，与唐勒并时，在屈原后也。"
    },
    {
      "id": 352,
      "text": "赵幽王赋一篇。"
    },
    {
      "id": 353,
      "text": "庄夫子赋二十四篇。名忌，吴人。贾谊赋七篇。"
    },
    {
      "id": 354,
      "text": "枚乘赋九篇。"
    },
    {
      "id": 355,
      "text": "司马相如赋二十九篇。"
    },
    {
      "id": 356,
      "text": "淮南王赋八十二篇。"
    },
    {
      "id": 357,
      "text": "淮南王群臣赋四十四篇。"
    },
    {
      "id": 358,
      "text": "太常蓼侯孔臧赋二十篇。"
    },
    {
      "id": 359,
      "text": "阳丘侯刘郾赋十九篇。"
    },
    {
      "id": 360,
      "text": "吾丘寿王赋十五篇。"
    },
    {
      "id": 361,
      "text": "蔡甲赋一篇。"
    },
    {
      "id": 362,
      "text": "上所自造赋二篇。"
    },
    {
      "id": 363,
      "text": "儿宽赋二篇。"
    },
    {
      "id": 364,
      "text": "光禄大夫张子侨赋三篇。与王褒同时也。"
    },
    {
      "id": 365,
      "text": "阳成侯刘德赋九篇。"
    },
    {
      "id": 366,
      "text": "刘向赋三十三篇。"
    },
    {
      "id": 367,
      "text": "王褒赋十六篇。"
    },
    {
