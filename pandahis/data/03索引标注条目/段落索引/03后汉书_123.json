{
  "work": "03后汉书",
  "vol": "123",
  "source_file": "03后汉书_123_郡国五.txt",
  "source_path": "02二十四史拆分后/03后汉书_拆分后/03后汉书_123_郡国五.txt",
  "paragraph_mode": "line",
  "total": 529,
  "paragraphs": [
    {
      "id": 1,
      "text": "志第二十三  郡国五"
    },
    {
      "id": 2,
      "text": "益州"
    },
    {
      "id": 3,
      "text": "△汉中 巴郡 广汉 蜀郡 犍为 牂牁 越巂 益州永昌 广汉属国 蜀郡属国 犍为属国"
    },
    {
      "id": 4,
      "text": "凉州"
    },
    {
      "id": 5,
      "text": "△陇西 汉阳 武都 金城 安定 北地 武威 张掖酒泉 敦煌 张掖属国 张掖居延属国"
    },
    {
      "id": 6,
      "text": "并州"
    },
    {
      "id": 7,
      "text": "△上党 太原 上郡 西河 五原 云中 定襄 雁门 朔方"
    },
    {
      "id": 8,
      "text": "幽州"
    },
    {
      "id": 9,
      "text": "△涿郡 广阳 代郡 上谷 渔阳 右北平 辽西 辽东玄菟 乐浪 辽东属国"
    },
    {
      "id": 10,
      "text": "交州"
    },
    {
      "id": 11,
      "text": "△南海 苍梧 郁林 合浦 交趾 九真 日南"
    },
    {
      "id": 12,
      "text": "§汉中郡（秦置。雒阳西千九百九十里。）九城，户五万七千三百四十四，口二十六万七千四百二。"
    },
    {
      "id": 13,
      "text": "〖南郑〗"
    },
    {
      "id": 14,
      "text": "〖成固〗妫墟在西北。"
    },
    {
      "id": 15,
      "text": "〖西城〗"
    },
    {
      "id": 16,
      "text": "〖襃中〗"
    },
    {
      "id": 17,
      "text": "〖沔阳〗有铁。"
    },
    {
      "id": 18,
      "text": "〖安阳〗"
    },
    {
      "id": 19,
      "text": "〖锡〗有锡，春秋时曰锡穴。"
    },
    {
      "id": 20,
      "text": "〖上庸〗本庸国。"
    },
    {
      "id": 21,
      "text": "〖房陵〗"
    },
    {
      "id": 22,
      "text": "§巴陵（秦置。雒阳西三千七百里。）十四城，户三十一万六百九十一，口百八万六千四十九。"
    },
    {
      "id": 23,
      "text": "〖江州〗"
    },
    {
      "id": 24,
      "text": "〖宕渠〗有铁。"
    },
    {
      "id": 25,
      "text": "〖朐忍〗"
    },
    {
      "id": 26,
      "text": "〖阆中〗"
    },
    {
      "id": 27,
      "text": "〖鱼复〗扞水有扞关。"
    },
    {
      "id": 28,
      "text": "〖临江〗"
    },
    {
      "id": 29,
      "text": "〖枳〗"
    },
    {
      "id": 30,
      "text": "〖涪陵〗出丹。"
    },
    {
      "id": 31,
      "text": "〖垫江〗"
    },
    {
      "id": 32,
      "text": "〖安汉〗"
    },
    {
      "id": 33,
      "text": "〖平都〗"
    },
    {
      "id": 34,
      "text": "〖充国〗永元二年分阆中置。"
    },
    {
      "id": 35,
      "text": "〖宣汉〗"
    },
    {
      "id": 36,
      "text": "〖汉昌〗永元中置。"
    },
    {
      "id": 37,
      "text": "§广汉郡（高帝置。雒阳西三千里。）十一城，户十三万九千八百六十五，口五十万九千四百三十八。"
    },
    {
      "id": 38,
      "text": "〖雒〗刺史治。"
    },
    {
      "id": 39,
      "text": "〖新都〗"
    },
    {
      "id": 40,
      "text": "〖绵竹〗"
    },
    {
      "id": 41,
      "text": "〖什邡〗"
    },
    {
      "id": 42,
      "text": "〖涪〗"
    },
    {
      "id": 43,
      "text": "〖梓潼〗"
    },
    {
      "id": 44,
      "text": "〖白水〗"
    },
    {
      "id": 45,
      "text": "〖葭萌〗"
    },
    {
      "id": 46,
      "text": "〖郪〗"
    },
    {
      "id": 47,
      "text": "〖广汉〗有沈水。"
    },
    {
      "id": 48,
      "text": "〖德阳〗"
    },
    {
      "id": 49,
      "text": "§蜀郡（秦置。雒阳西三千一百里。）十一城，户三十万四百五十二，口百三十五万四百七十六。"
    },
    {
      "id": 50,
      "text": "〖成都〗"
    },
    {
      "id": 51,
      "text": "〖郫〗"
    },
    {
      "id": 52,
      "text": "〖江原〗"
    },
    {
      "id": 53,
      "text": "〖繁〗"
    },
    {
      "id": 54,
      "text": "〖广都〗"
    },
    {
      "id": 55,
      "text": "〖临邛〗有铁。"
    },
    {
      "id": 56,
      "text": "〖湔氐道〗岷山在西徼外。"
    },
    {
      "id": 57,
      "text": "〖汶江道〗"
    },
    {
      "id": 58,
      "text": "〖八陵〗"
    },
    {
      "id": 59,
      "text": "〖广柔〗"
    },
    {
      "id": 60,
      "text": "〖绵虒道〗"
    },
    {
      "id": 61,
      "text": "§犍为郡（武帝置。雒阳西三千二百七十里。刘璋分立江阳郡。）九城，户十三万七千七百一十三，口四十一万一千三百七十八。"
    },
    {
      "id": 62,
      "text": "〖武阳〗有彭亡聚。"
    },
    {
      "id": 63,
      "text": "〖资中〗"
    },
    {
      "id": 64,
      "text": "〖牛鞞〗"
    },
    {
      "id": 65,
      "text": "〖南安〗有鱼涪津。"
    },
    {
      "id": 66,
      "text": "〖僰道〗"
    },
    {
      "id": 67,
      "text": "〖江阳〗"
    },
    {
      "id": 68,
      "text": "〖符节〗"
    },
    {
      "id": 69,
      "text": "〖南广〗"
    },
    {
      "id": 70,
      "text": "〖汉安〗"
    },
    {
      "id": 71,
      "text": "§牂牁郡（武帝置。雒阳西五千七百里。）十六城，户三万一千五百二十三，口二十六万七千二百五十三。"
    },
    {
      "id": 72,
      "text": "〖故且兰〗"
    },
    {
      "id": 73,
      "text": "〖平夷〗"
    },
    {
      "id": 74,
      "text": "〖鄨〗"
    },
    {
      "id": 75,
      "text": "〖毋敛〗"
    },
    {
      "id": 76,
      "text": "〖谈指〗出丹。"
    },
    {
      "id": 77,
      "text": "〖夜郎〗出雄黄、雌黄。"
    },
    {
      "id": 78,
      "text": "〖同并〗"
    },
    {
      "id": 79,
      "text": "〖谈稾〗"
    },
    {
      "id": 80,
      "text": "〖漏江〗"
    },
    {
      "id": 81,
      "text": "〖毋单〗"
    },
    {
      "id": 82,
      "text": "〖宛温〗"
    },
    {
      "id": 83,
      "text": "〖镡封〗"
    },
    {
      "id": 84,
      "text": "〖漏卧〗"
    },
    {
      "id": 85,
      "text": "〖句町〗"
    },
    {
      "id": 86,
      "text": "〖进乘〗"
    },
    {
      "id": 87,
      "text": "〖西随〗"
    },
    {
      "id": 88,
      "text": "§越巂郡（武帝置。雒阳四千八百里。）十四城，户十三万一百二十，口六十二万三千四百一十八"
    },
    {
      "id": 89,
      "text": "〖邛都〗南山出铜。"
    },
    {
      "id": 90,
      "text": "〖遂久〗"
    },
    {
      "id": 91,
      "text": "〖灵关道〗"
    },
    {
      "id": 92,
      "text": "〖台登〗出铁。"
    },
    {
      "id": 93,
      "text": "〖青蛉〗有禺同山，俗谓有金马碧鸡。"
    },
    {
      "id": 94,
      "text": "〖卑水〗"
    },
    {
      "id": 95,
      "text": "〖三缝〗"
    },
    {
      "id": 96,
      "text": "〖会无〗出铁。"
    },
    {
      "id": 97,
      "text": "〖定莋〗"
    },
    {
      "id": 98,
      "text": "〖阐〗"
    },
    {
      "id": 99,
      "text": "〖苏示〗"
    },
    {
      "id": 100,
      "text": "〖大莋〗"
    },
    {
      "id": 101,
      "text": "〖莋秦〗"
    },
    {
      "id": 102,
      "text": "〖姑复〗"
    },
    {
      "id": 103,
      "text": "§益州郡（武帝置。故滇王国。雒阳西五千六百里。诸葛亮表有耽文山、泽山、司弥瘗山、娄山、辟龙山，此等并皆未详所在县。）十七城，户二万九千三十六。口十一万八百二。"
    },
    {
      "id": 104,
      "text": "〖滇池〗出铁。有池泽。北有黑水祠。"
    },
    {
      "id": 105,
      "text": "〖胜休〗"
    },
    {
      "id": 106,
      "text": "〖俞元〗装山出铜。"
    },
    {
      "id": 107,
      "text": "〖律高〗石室山出锡。盢町山出银、铅。"
    },
    {
      "id": 108,
      "text": "〖贲古〗采山出铜、锡。羊山出银、铅。"
    },
    {
      "id": 109,
      "text": "〖毋棳〗"
    },
    {
      "id": 110,
      "text": "〖建伶〗"
    },
    {
      "id": 111,
      "text": "〖谷昌〗"
    },
    {
      "id": 112,
      "text": "〖牧靡〗"
    },
    {
      "id": 113,
      "text": "〖味〗"
    },
    {
      "id": 114,
      "text": "〖昆泽〗"
    },
    {
      "id": 115,
      "text": "〖同濑〗"
    },
    {
      "id": 116,
      "text": "〖同劳〗"
    },
    {
      "id": 117,
      "text": "〖双柏〗出银。"
    },
    {
      "id": 118,
      "text": "〖连然〗"
    },
    {
      "id": 119,
      "text": "〖梇栋〗"
    },
    {
      "id": 120,
      "text": "〖秦臧〗"
    },
    {
      "id": 121,
      "text": "§永昌郡（明帝永平十二年分益州置。雒阳西七千二百六十里。）八城，户二十三万一千八百九十七，口百八十九万七千三百四十四。"
    },
    {
      "id": 122,
      "text": "〖不韦〗出铁。"
    },
    {
      "id": 123,
      "text": "〖巂唐〗"
    },
    {
      "id": 124,
      "text": "〖比苏〗"
    },
    {
      "id": 125,
      "text": "〖楪榆〗"
    },
    {
      "id": 126,
      "text": "〖邪龙〗"
    },
    {
      "id": 127,
      "text": "〖云南〗"
    },
    {
      "id": 128,
      "text": "〖哀牢〗永平中置，故牢王国。"
    },
    {
      "id": 129,
      "text": "〖博南〗永平中置。南界出金。"
    },
    {
      "id": 130,
      "text": "§广汉属国（故北部都尉，属广汉郡，安帝时以为属国都尉，别领三城。）户三万七千一百一十，口二十万五千六百五十二。"
    },
    {
      "id": 131,
      "text": "〖阴平道〗"
    },
    {
      "id": 132,
      "text": "〖甸氐道〗"
    },
    {
      "id": 133,
      "text": "〖刚氐道〗"
    },
    {
      "id": 134,
      "text": "§蜀郡属国（故属西部都尉，延光元年以为属国都尉，别领四城。）户十一万一千五百六十八，口四十七万五千六百二十九。"
    },
    {
      "id": 135,
      "text": "〖汉嘉〗故青衣，阳嘉二年改。有蒙山。"
    },
    {
      "id": 136,
      "text": "〖严道〗有邛僰九折坂者，邛邮置。"
    },
    {
      "id": 137,
      "text": "〖徙〗"
    },
    {
      "id": 138,
      "text": "〖旄牛〗"
    },
    {
      "id": 139,
      "text": "§犍为属国（故郡南部都尉，永初元年以为属国都尉，别领二城。）户七千九百三十八，口三万七千一百八十七。"
    },
    {
      "id": 140,
      "text": "〖朱提〗山出银、铜。"
    },
    {
      "id": 141,
      "text": "〖汉阳〗"
    },
    {
      "id": 142,
      "text": "右益州刺史部，郡、国十二，县、道一百一十八。"
    },
    {
      "id": 143,
      "text": "§陇西郡（秦置。雒阳西二千二百二十里。）十一城，户五千六百二十八，口二万九千六百三十七。"
    },
    {
      "id": 144,
      "text": "〖狄道〗"
    },
    {
      "id": 145,
      "text": "〖安故〗"
    },
    {
      "id": 146,
      "text": "〖氐道〗养水出此。"
    },
    {
      "id": 147,
      "text": "〖首阳〗有鸟鼠同穴山，渭水出。"
    },
    {
      "id": 148,
      "text": "〖大夏〗"
    },
    {
      "id": 149,
      "text": "〖襄武〗有五鸡聚。"
    },
    {
      "id": 150,
      "text": "〖临洮〗有西顷山。"
    },
    {
      "id": 151,
      "text": "〖枹罕〗故属金城。"
    },
    {
      "id": 152,
      "text": "〖白石〗故属金城。"
    },
    {
      "id": 153,
      "text": "〖鄣〗"
    },
    {
      "id": 154,
      "text": "〖河关〗故属金城。积石山在西南，河水出。"
    },
    {
      "id": 155,
      "text": "§汉阳郡（武帝置，为天水，永元十七年更名。在雒阳西二千里。）十三城，户二万七千四百二十三，口十三万一百三十八。"
    },
    {
      "id": 156,
      "text": "〖冀〗有朱圄山。有缇群山。有雒门聚。"
    },
    {
      "id": 157,
      "text": "〖望恒〗"
    },
    {
      "id": 158,
      "text": "〖阿阳〗"
    },
    {
      "id": 159,
      "text": "〖略阳〗有街泉亭。"
    },
    {
      "id": 160,
      "text": "〖勇士〗"
    },
    {
      "id": 161,
      "text": "〖成纪〗"
    },
    {
      "id": 162,
      "text": "〖陇〗刺史治。有大坂名陇坻，豲坻聚有秦亭。"
    },
    {
      "id": 163,
      "text": "〖豲道〗"
    },
    {
      "id": 164,
      "text": "〖兰干〗"
    },
    {
      "id": 165,
      "text": "〖平襄〗"
    },
    {
      "id": 166,
      "text": "〖显亲〗"
    },
    {
      "id": 167,
      "text": "〖上邽〗故属陇西。"
    },
    {
      "id": 168,
      "text": "〖西〗故属陇西。有嶓冢山，西汉水。"
    },
    {
      "id": 169,
      "text": "§武都郡（武帝置。雒阳西一千九百六十里。）七城，户二万一百二，口八万一千七百二十八。"
    },
    {
      "id": 170,
      "text": "〖下辨〗"
    },
    {
      "id": 171,
      "text": "〖武都道〗"
    },
    {
      "id": 172,
      "text": "〖上禄〗"
    },
    {
      "id": 173,
      "text": "〖故道〗"
    },
    {
      "id": 174,
      "text": "〖河池〗"
    },
    {
      "id": 175,
      "text": "〖沮〗沔水出东狼谷。"
    },
    {
      "id": 176,
      "text": "〖羌道〗"
    },
    {
      "id": 177,
      "text": "§金城郡（昭帝置。雒阳西二千八百里。）十城，户三千八百五十八，口万八千九百四十七。"
    },
    {
      "id": 178,
      "text": "〖允吾〗"
    },
    {
      "id": 179,
      "text": "〖浩亹〗"
    },
    {
      "id": 180,
      "text": "〖令居〗"
    },
    {
      "id": 181,
      "text": "〖枝阳〗"
    },
    {
      "id": 182,
      "text": "〖金城〗"
    },
    {
      "id": 183,
      "text": "〖榆中〗"
    },
    {
      "id": 184,
      "text": "〖临羌〗有昆仑山。"
    },
    {
      "id": 185,
      "text": "〖破羌〗"
    },
    {
      "id": 186,
      "text": "〖安夷〗"
    },
    {
      "id": 187,
      "text": "〖允街〗"
    },
    {
      "id": 188,
      "text": "§安定郡（武帝置。雒阳西千七百里。）八城，户六千九十四，口二万九千六十。"
    },
    {
      "id": 189,
      "text": "〖临泾〗"
    },
    {
      "id": 190,
      "text": "〖高平〗有第一城。"
    },
    {
      "id": 191,
      "text": "〖朝那〗"
    },
    {
      "id": 192,
      "text": "〖乌枝〗有瓦亭，出薄落谷。"
    },
    {
      "id": 193,
      "text": "〖三水〗"
    },
    {
