      "政权ID": "ZQ_HX_CHUNQIU_JIN",
      "帝王ID": "DW_HX_CHUNQIU_JIN_JINHUIGONG"
    },
    {
      "史略ID": "SHIJI_039_07",
      "史略名称": "晋文公",
      "史略简介": "晋文公",
      "原文字句": "何以教之？”怀公卒杀狐突。秦缪公乃发兵送内重耳，使人告栾、郤之党为内应，杀怀公於高梁，入重耳。重耳立，是为文公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
      "paragraphs": [
        {
          "volume": "晋世家",
