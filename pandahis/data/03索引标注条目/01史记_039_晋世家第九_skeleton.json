    {
      "史略ID": "SHIJI_039_09",
      "史略名称": "晋武公",
      "史略简介": "晋武公",
      "原文字句": "晋唐叔虞者，周武王子而成王弟。初，武王与叔虞母会时，梦天谓武王曰：“余命女生子，名虞，余与之唐。”及生子，文在其手曰“虞”，故遂因命之曰虞。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
      "paragraphs": [
        {
          "volume": "晋世家",
          "paragraph_from": 1,
          "paragraph_to": 23
        }
      ],
      "史略开始年": -679,
      "史略结束年": -677,
      "优先级": "P0",
      "优先级判定理由": "晋武公独立叙事块，共23段",
      "五级细坐标": "史记·卷039·诸侯·09",
      "六级段落锚点": "[P1-P23]",
      "原文出处": "晋世家·P1-P23",
      "_needs_llm": [],
      "四级帝王坐标": "晋武公",
