      "五级细坐标": "史记·卷039·诸侯·06",
      "六级段落锚点": "[P45-P61]",
      "原文出处": "晋世家·P45-P61",
      "_needs_llm": [],
      "四级帝王坐标": "晋惠公",
      "三级政权坐标": "晋",
      "二级朝代坐标": "春秋",
      "一级文明坐标": "华夏",
