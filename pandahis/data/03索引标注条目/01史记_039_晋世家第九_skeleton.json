    {
      "史略ID": "SHIJI_039_08",
      "史略名称": "晋景公",
      "史略简介": "晋景公",
      "原文字句": "赵盾使赵穿迎襄公弟黑臀于周而立之，是为成公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
