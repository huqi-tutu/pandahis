      "paragraph_to": 25,
      "boundary_evidence": {
        "open_paragraph": 13,
        "open_phrase": "庄公又娶宋雍氏女，生厉公突。雍氏有宠於宋。宋庄公闻祭仲之立忽，乃使人诱召祭仲而执",
        "close_paragraph": 25,
        "close_note": "Step1b-β 自 primary_subjects 合并 P13–P25"
      }
    },
    {
