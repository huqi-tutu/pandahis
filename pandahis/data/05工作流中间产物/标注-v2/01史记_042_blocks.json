      "category": "诸侯",
      "paragraph_from": 51,
      "paragraph_to": 58,
      "boundary_evidence": {
        "open_paragraph": 51,
        "open_phrase": "釐公五年，郑相子驷朝釐公，釐公不礼。子驷怒，使厨人药杀釐公，赴诸侯曰“釐公暴病卒",
        "close_paragraph": 58,
