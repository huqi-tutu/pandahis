      "paragraph_to": 12,
      "boundary_evidence": {
        "open_paragraph": 5,
        "open_phrase": "武公十年，娶申侯女为夫人，曰武姜。生太子寤生，生之难，及生，夫人弗爱。后生少子叔",
        "close_paragraph": 12,
