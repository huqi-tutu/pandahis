      "name": "耿弇",
      "category": "武将",
      "paragraph_from": 2,
      "paragraph_to": 16,
      "boundary_evidence": {
        "open_paragraph": 2,
        "open_phrase": "耿弇字伯昭，扶风茂陵人也。其先武帝时以吏二千石自巨鹿徙焉。父况，字侠游，以明经为",
        "close_paragraph": 16,
        "close_note": "Step1b-β 自 primary_subjects 合并 P2–P16"
      }
    },
    {
      "name": "耿国",
      "category": "武将",
      "paragraph_from": 22,
      "paragraph_to": 23,
      "boundary_evidence": {
        "open_paragraph": 22,
        "open_phrase": "国字叔虑，建武四年初入侍，光武拜为黄门侍郎，应对左右，帝以为能，迁射声校尉。七年",
        "close_paragraph": 23,
        "close_note": "Step1b-β 自 primary_subjects 合并 P22–P23"
      }
    },
    {
      "name": "耿秉",
      "category": "武将",
      "paragraph_from": 25,
      "paragraph_to": 30,
      "boundary_evidence": {
        "open_paragraph": 25,
        "open_phrase": "秉字伯初，有伟体，腰带八围。博通书记，能说《司马兵法》，尤好将帅之略。以父任为郎",
        "close_paragraph": 30,
        "close_note": "Step1b-β 自 primary_subjects 合并 P25–P30"
      }
    },
    {
      "name": "耿夔",
      "category": "武将",
      "paragraph_from": 33,
      "paragraph_to": 35,
      "boundary_evidence": {
        "open_paragraph": 33,
        "open_phrase": "夔字定公。少有气决。永元初，为车骑将军窦宪假司马，北击匈奴，转骑都尉。三年，宪复",
        "close_paragraph": 35,
        "close_note": "Step1b-β 自 primary_subjects 合并 P33–P35"
      }
    },
    {
      "name": "耿恭",
      "category": "武将",
      "paragraph_from": 36,
      "paragraph_to": 41,
      "boundary_evidence": {
        "open_paragraph": 36,
        "open_phrase": "恭字伯宗，国弟广之子也。少孤。慷慨多大略，有将帅才。永平十七年冬，骑都尉刘张出击",
        "close_paragraph": 41,
        "close_note": "Step1b-β 自 primary_subjects 合并 P36–P41"
      }
    }
