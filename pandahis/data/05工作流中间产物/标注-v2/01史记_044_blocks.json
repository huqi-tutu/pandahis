      "paragraph_from": 19,
      "paragraph_to": 21,
      "boundary_evidence": {
        "open_paragraph": 19,
        "open_phrase": "三十八年，伐秦，败我武下，得其将识。是岁，文侯卒，子击立，是为武侯。",
        "close_paragraph": 21,
        "close_note": "Step1b-β 自 primary_subjects 合并 P19–P21"
