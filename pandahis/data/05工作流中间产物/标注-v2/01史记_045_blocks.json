      "paragraph_to": 27,
      "boundary_evidence": {
        "open_paragraph": 22,
        "open_phrase": "宣惠王五年，张仪相秦。八年，魏败我将韩举。十一年，君号为王。与赵会区鼠。十四年，",
        "close_paragraph": 27,
        "close_note": "Step1b-β 自 primary_subjects 合并 P22–P27"
