      "paragraph_from": 18,
      "paragraph_to": 21,
      "boundary_evidence": {
        "open_paragraph": 18,
        "open_phrase": "昭侯元年，秦败我西山。二年，宋取我黄池。魏取朱。六年，伐东周，取陵观、邢丘。",
        "close_paragraph": 21,
        "close_note": "Step1b-β 自 primary_subjects 合并 P18–P21"
