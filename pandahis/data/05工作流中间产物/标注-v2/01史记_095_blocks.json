      "category": "武将",
      "paragraph_from": 23,
      "paragraph_to": 29,
      "boundary_evidence": {
        "open_paragraph": 23,
        "open_phrase": "汝阴侯夏侯婴，沛人也。为沛厩司御。每送使客还，过沛泗上亭，与高祖语，未尝不移日也",
        "close_paragraph": 29,
