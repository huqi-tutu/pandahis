{
  "work": "01史记",
  "vol": "107",
  "total_paragraphs": 37,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "魏其侯窦婴者，孝文后从兄子也。父世观津人。喜宾客。"
    },
    {
      "paragraph": 2,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "梁孝王者，孝景弟也，其母窦太后爱之。梁孝王朝，因昆弟燕饮。"
    },
    {
      "paragraph": 3,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "孝景三年，吴楚反，上察宗室诸窦毋如窦婴贤，乃召婴。"
    },
    {
      "paragraph": 4,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "孝景四年，立栗太子，使魏其侯为太子傅。"
    },
    {
      "paragraph": 5,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "桃侯免相，窦太后数言魏其侯。"
    },
    {
      "paragraph": 6,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "武安侯田蚡者，孝景后同母弟也，生长陵。"
    },
    {
      "paragraph": 7,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "蚡辩有口，学槃盂诸书，王太后贤之。"
    },
    {
      "paragraph": 8,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "武安侯新欲用事为相，卑下宾客，进名士家居者贵之。"
    },
    {
      "paragraph": 9,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "建元元年，丞相绾病免，上议置丞相、太尉。"
    },
    {
      "paragraph": 10,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "君侯能兼容，则幸久；不能，今以毁去矣。魏其不听。"
    },
    {
      "paragraph": 11,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "魏其、武安俱好儒术，推毂赵绾为御史大夫，王臧为郎中令。"
    },
    {
      "paragraph": 12,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "太后好黄老之言，而魏其、武安、赵绾、王臧等务隆推儒术。"
    },
    {
      "paragraph": 13,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "武安侯虽不任职，以王太后故，亲幸，数言事多效。"
    },
    {
      "paragraph": 14,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "武安者，貌侵，生贵甚。又以为诸侯王多长，上初即位。"
    },
    {
      "paragraph": 15,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "魏其失窦太后，益疏不用，无势，诸客稍稍自引而怠傲。"
    },
    {
      "paragraph": 16,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "魏其日默默不得志，而独厚遇灌将军。"
    },
    {
      "paragraph": 17,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "灌将军夫者，颍阴人也。夫父张孟，尝为颍阴侯婴舍人。"
    },
    {
      "paragraph": 18,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "颍阴侯言之上，上以夫为中郎将。数月，坐法去。"
    },
    {
      "paragraph": 19,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "灌夫为人刚直使酒，不好面谀。"
    },
    {
      "paragraph": 20,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "夫不喜文学，好任侠，已然诺。"
    },
    {
      "paragraph": 21,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "灌夫家居虽富，然失势，卿相侍中宾客益衰。"
    },
    {
      "paragraph": 22,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "灌夫有服，过丞相。丞相从容曰：吾欲与仲孺过魏其侯。"
    },
    {
      "paragraph": 23,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "灌夫曰：将军乃肯幸临况魏其侯，夫安敢以服为解！"
    },
    {
      "paragraph": 24,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "丞相特前戏许灌夫，殊无意往。及夫至门，丞相尚卧。"
    },
    {
      "paragraph": 25,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "丞相尝使籍福请魏其城南田。魏其大望曰：老仆虽弃。"
    },
    {
      "paragraph": 26,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "元光四年春，丞相言灌夫家在颍川，横甚，民苦之。"
    },
    {
      "paragraph": 27,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "夏，丞相取燕王女为夫人，有太后诏，召列侯宗室皆往贺。"
    },
    {
      "paragraph": 28,
      "primary_subject": "灌夫",
      "disposition": "block",
      "text_snippet": "夫怒，因嘻笑曰：将军贵人也，属之！时武安不肯。"
    },
    {
      "paragraph": 29,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "魏其侯大媿，为资使宾客请，莫能解。"
    },
    {
      "paragraph": 30,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "魏其锐身为救灌夫。夫人谏魏其曰：灌将军得罪丞相。"
    },
    {
      "paragraph": 31,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "魏其之东朝，盛推灌夫之善，言其醉饱得过。"
    },
    {
      "paragraph": 32,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "上怒内史曰：公平生数言魏其、武安长短，今日廷论。"
    },
    {
      "paragraph": 33,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "武安已罢朝，出止车门，召韩御史大夫载，怒曰。"
    },
    {
      "paragraph": 34,
      "primary_subject": "窦婴",
      "disposition": "block",
      "text_snippet": "於是上使御史簿责魏其所言灌夫，颇不雠，欺谩。"
    },
    {
      "paragraph": 35,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "其春，武安侯病，专呼服谢罪。使巫视鬼者视之。"
    },
    {
      "paragraph": 36,
      "primary_subject": "田蚡",
      "disposition": "block",
      "text_snippet": "淮南王安谋反觉，治。王前朝，武安侯为太尉，时迎王至霸上。"
    },
    {
      "paragraph": 37,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：魏其、武安皆以外戚重，灌夫用一时决筴而名显。"
    }
  ]
}
