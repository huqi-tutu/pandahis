    {
      "name": "刘党",
      "category": "宗戚",
      "paragraph_from": 17,
      "paragraph_to": 22,
      "boundary_evidence": {
        "open_paragraph": 17,
        "open_phrase": "乐成靖王党，永平九年赐号重熹王，十五年封乐成王。党聪惠，善《史书》，喜正文字。与",
        "close_paragraph": 22,
        "close_note": "Step1b-β 自 primary_subjects 合并 P17–P22"
