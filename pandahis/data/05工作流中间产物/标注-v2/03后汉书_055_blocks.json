    },
    {
      "name": "刘衍",
      "category": "宗戚",
      "paragraph_from": 23,
      "paragraph_to": 26,
      "boundary_evidence": {
        "open_paragraph": 23,
        "open_phrase": "下邳惠王衍，永平十五年封。衍有容貌，肃宗即位，常在左右。建初初冠，诏赐衍师傅已下",
        "close_paragraph": 26,
        "close_note": "Step1b-β 自 primary_subjects 合并 P23–P26"
      }
    },
    {
      "name": "刘畅",
      "category": "宗戚",
      "paragraph_from": 27,
      "paragraph_to": 35,
      "boundary_evidence": {
        "open_paragraph": 27,
        "open_phrase": "梁节王畅，永平十五年封为汝南王。母阴贵人有宠，畅尤被爱幸，国土租入倍于诸国。肃宗",
        "close_paragraph": 35,
