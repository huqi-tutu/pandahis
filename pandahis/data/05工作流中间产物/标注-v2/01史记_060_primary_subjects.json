{
  "work": "01史记",
  "vol": "060",
  "total_paragraphs": 34,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "大司马臣去病昧死再拜上疏皇帝陛下：陛下过听，使臣去病待罪行间。"
    },
    {
      "paragraph": 2,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "六年三月戊申朔，乙亥，御史臣光，守尚书令丞非，下御史书到，言："
    },
    {
      "paragraph": 3,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "制曰：盖闻周封八百，姬姓并列，或子、男、附庸。"
    },
    {
      "paragraph": 4,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "三月丙子，奏未央宫。丞相臣青翟、御史大夫臣汤昧死言："
    },
    {
      "paragraph": 5,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "制曰：康叔亲属有十而独尊者，襃有德也。"
    },
    {
      "paragraph": 6,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "四月戊寅，奏未央宫。丞相臣青翟、御史大夫臣汤昧死言："
    },
    {
      "paragraph": 7,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "内襃有德，外讨彊暴。极临北海，西溱月氏，匈奴、西域，举国奉师。"
    },
    {
      "paragraph": 8,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "丞相臣青翟、太仆臣贺、行御史大夫事太常臣充、太子少傅臣安行宗正事昧死言："
    },
    {
      "paragraph": 9,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "四月丙申，奏未央宫。太仆臣贺行御史大夫事昧死言："
    },
    {
      "paragraph": 10,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "制曰：立皇子闳为齐王，旦为燕王，胥为广陵王。"
    },
    {
      "paragraph": 11,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "四月丁酉，奏未央宫。六年四月戊寅朔，癸卯，御史大夫汤下丞相，"
    },
    {
      "paragraph": 12,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "维六年四月乙巳，皇帝使御史大夫汤庙立子闳为齐王。"
    },
    {
      "paragraph": 13,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "右齐王策。"
    },
    {
      "paragraph": 14,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "维六年四月乙巳，皇帝使御史大夫汤庙立子旦为燕王。"
    },
    {
      "paragraph": 15,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "右燕王策。"
    },
    {
      "paragraph": 16,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "维六年四月乙巳，皇帝使御史大夫汤庙立子胥为广陵王。"
    },
    {
      "paragraph": 17,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "右广陵王策。"
    },
    {
      "paragraph": 18,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：古人有言曰爱之欲其富，亲之欲其贵。"
    },
    {
      "paragraph": 19,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "褚先生曰：臣幸得以文学为侍郎，好览观太史公之列传。"
    },
    {
      "paragraph": 20,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "盖闻孝武帝之时，同日而俱拜三子为王：封一子於齐，一子於广陵，一子於燕。"
    },
    {
      "paragraph": 21,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "王夫人者，赵人也，与卫夫人并幸武帝，而生子闳。"
    },
    {
      "paragraph": 22,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "所谓受此土者，诸侯王始封者必受土於天子之社，归立之以为国社，以岁时祠之。"
    },
    {
      "paragraph": 23,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "齐地多变诈，不习於礼义，故戒之曰恭朕之诏，唯命不可为常。"
    },
    {
      "paragraph": 24,
      "primary_subject": "刘闳",
      "disposition": "block",
      "text_snippet": "传曰青采出於蓝，而质青於蓝者，教使然也。"
    },
    {
      "paragraph": 25,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "夫广陵在吴越之地，其民精而轻，故诫之曰江湖之间，其人轻心。"
    },
    {
      "paragraph": 26,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "会孝武帝崩，孝昭帝初立，先朝广陵王胥，厚赏赐金钱财币，直三千馀万，益地百里，邑万户。"
    },
    {
      "paragraph": 27,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "会昭帝崩，宣帝初立，缘恩行义，以本始元年中，裂汉地，尽以封广陵王胥四子："
    },
    {
      "paragraph": 28,
      "primary_subject": "刘胥",
      "disposition": "block",
      "text_snippet": "其后胥果作威福，通楚王使者。"
    },
    {
      "paragraph": 29,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "燕土墝埆，北迫匈奴，其人民勇而少虑，故诫之曰荤粥氏无有孝行而禽兽心，以窃盗侵犯边民。"
    },
    {
      "paragraph": 30,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "会武帝年老长，而太子不幸薨，未有所立，而旦使来上书，请身入宿卫於长安。"
    },
    {
      "paragraph": 31,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "会武帝崩，昭帝初立，旦果作怨而望大臣。"
    },
    {
      "paragraph": 32,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "其后旦复与左将军上官桀等谋反，宣言曰我次太子，太子不在，我当立，大臣共抑我云云。"
    },
    {
      "paragraph": 33,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "孝昭以骨肉之亲，不忍致法，宽赦旦妻子，免为庶人。"
    },
    {
      "paragraph": 34,
      "primary_subject": "刘旦",
      "disposition": "block",
      "text_snippet": "宣帝初立，推恩宣德，以本始元年中尽复封燕王旦两子："
    }
  ]
}
