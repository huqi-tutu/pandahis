    {
      "name": "任延",
      "category": "文臣",
      "paragraph_from": 8,
      "paragraph_to": 18,
      "boundary_evidence": {
        "open_paragraph": 8,
        "open_phrase": "任延字长孙，南阳宛人也。年十二，为诸生，学于长安，明《诗》《易》《春秋》，显名太",
        "close_paragraph": 18,
        "close_note": "Step1b-β 自 primary_subjects 合并 P8–P18"
      }
    },
    {
      "name": "王景",
      "category": "文臣",
      "paragraph_from": 19,
      "paragraph_to": 25,
      "boundary_evidence": {
        "open_paragraph": 19,
        "open_phrase": "王景字仲通，乐浪讲邯人也。八世祖仲，本琅邪不其人。好道术，明天文。诸吕作乱，齐哀",
        "close_paragraph": 25,
        "close_note": "Step1b-β 自 primary_subjects 合并 P19–P25"
      }
    },
    {
      "name": "孟尝",
      "category": "文臣",
      "paragraph_from": 40,
      "paragraph_to": 45,
      "boundary_evidence": {
        "open_paragraph": 40,
        "open_phrase": "孟尝字伯周，会稽上虞上也。其先三世为郡吏，并伏节死难。尝少修操行，仕郡为户曹史。",
        "close_paragraph": 45,
        "close_note": "Step1b-β 自 primary_subjects 合并 P40–P45"
      }
    },
    {
      "name": "刘宠",
      "category": "文臣",
      "paragraph_from": 54,
      "paragraph_to": 61,
      "boundary_evidence": {
        "open_paragraph": 54,
        "open_phrase": "刘宠字祖荣，东莱牟平人，齐悼惠王之后也。悼惠王子孝王将闾，将闾少子封牟平侯，子孙",
        "close_paragraph": 61,
        "close_note": "Step1b-β 自 primary_subjects 合并 P54–P61"
      }
    },
