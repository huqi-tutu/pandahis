      "category": "文臣",
      "paragraph_from": 3,
      "paragraph_to": 7,
      "boundary_evidence": {
        "open_paragraph": 3,
        "open_phrase": "卫飒字子产，河内脩武人也。家贫好学问，随师无粮，常佣以自给。王莽时，仕郡历州宰。",
        "close_paragraph": 7,
