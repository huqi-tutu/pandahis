      "paragraph_from": 22,
      "paragraph_to": 34,
      "boundary_evidence": {
        "open_paragraph": 22,
        "open_phrase": "华佗字元化，沛国谯人也，一名旉。游学徐土，兼通数经。晓养性之术，年且百岁而犹有壮",
        "close_paragraph": 34,
        "close_note": "Step1b-β 自 primary_subjects 合并 P22–P34"
