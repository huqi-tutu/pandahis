      "paragraph_from": 40,
      "paragraph_to": 46,
      "boundary_evidence": {
        "open_paragraph": 40,
        "open_phrase": "费长房者，汝南人也。曾为市掾。市中有老翁卖药，悬一壶于肆头，及市罢，辄跳入壶中。",
        "close_paragraph": 46,
