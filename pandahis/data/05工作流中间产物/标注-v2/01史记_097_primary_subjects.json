{
  "work": "01史记",
  "vol": "097",
  "total_paragraphs": 33,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "郦生食其者，陈留高阳人也。好读书，家贫落魄，无以为衣食业，为里监门吏。"
    },
    {
      "paragraph": 2,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "及陈胜、项梁等起，诸将徇地过高阳者数十人，郦生闻其将皆握齱好苛礼自用"
    },
    {
      "paragraph": 3,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "沛公至高阳传舍，使人召郦生。郦生至，入谒，沛公方倨床使两女子洗足"
    },
    {
      "paragraph": 4,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "郦生言其弟郦商，使将数千人从沛公西南略地。郦生常为说客，驰使诸侯。"
    },
    {
      "paragraph": 5,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "汉三年秋，项羽击汉，拔荥阳，汉兵遁保巩、洛。"
    },
    {
      "paragraph": 6,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "乃从其画，复守敖仓，而使郦生说齐王曰："
    },
    {
      "paragraph": 7,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "项王有倍约之名，杀义帝之负；於人之功无所记，於人之罪无所忘"
    },
    {
      "paragraph": 8,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "淮阴侯闻郦生伏轼下齐七十馀城，乃夜度兵平原袭齐。"
    },
    {
      "paragraph": 9,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "汉十二年，曲周侯郦商以丞相将兵击黥布有功。高祖举列侯功臣，思郦食其。"
    },
    {
      "paragraph": 10,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "郦食其子疥数将兵，功未当侯，上以其父故，封疥为高梁侯。"
    },
    {
      "paragraph": 11,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "陆贾者，楚人也。以客从高祖定天下，名为有口辩士，居左右，常使诸侯。"
    },
    {
      "paragraph": 12,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "及高祖时，中国初定，尉他平南越，因王之。高祖使陆贾赐尉他印为南越王。"
    },
    {
      "paragraph": 13,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "陆生至，尉他魋结箕倨见陆生。陆生因进说他曰："
    },
    {
      "paragraph": 14,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "且夫秦失其政，诸侯豪桀并起，唯汉王先入关，据咸阳。"
    },
    {
      "paragraph": 15,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "於是尉他乃蹶然起坐，谢陆生曰："
    },
    {
      "paragraph": 16,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "陆生时时前说称诗书。高帝骂之曰："
    },
    {
      "paragraph": 17,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "孝惠帝时，吕太后用事，欲王诸吕，畏大臣有口者，陆生自度不能争之，乃病免家居。"
    },
    {
      "paragraph": 18,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "吕太后时，王诸吕，诸吕擅权，欲劫少主，危刘氏。右丞相陈平患之"
    },
    {
      "paragraph": 19,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "臣常欲谓太尉绛侯，绛侯与我戏，易吾言。君何不交驩太尉，深相结？"
    },
    {
      "paragraph": 20,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "及诛诸吕，立孝文帝，陆生颇有力焉。孝文帝即位，欲使人之南越。"
    },
    {
      "paragraph": 21,
      "primary_subject": "陆贾",
      "disposition": "block",
      "text_snippet": "语在南越语中。陆生竟以寿终。"
    },
    {
      "paragraph": 22,
      "primary_subject": "朱建",
      "disposition": "block",
      "text_snippet": "平原君朱建者，楚人也。故尝为淮南王黥布相，有罪去，后复事黥布。"
    },
    {
      "paragraph": 23,
      "primary_subject": "朱建",
      "disposition": "block",
      "text_snippet": "平原君为人辩有口，刻廉刚直，家於长安。行不苟合，义不取容。"
    },
    {
      "paragraph": 24,
      "primary_subject": "朱建",
      "disposition": "block",
      "text_snippet": "辟阳侯幸吕太后，人或毁辟阳侯於孝惠帝，孝惠帝大怒，下吏，欲诛之。"
    },
    {
      "paragraph": 25,
      "primary_subject": "朱建",
      "disposition": "block",
      "text_snippet": "吕太后崩，大臣诛诸吕，辟阳侯於诸吕至深，而卒不诛。"
    },
    {
      "paragraph": 26,
      "primary_subject": "朱建",
      "disposition": "block",
      "text_snippet": "孝文帝时，淮南厉王杀辟阳侯，以诸吕故。文帝闻其客平原君为计策，使吏捕欲治。"
    },
    {
      "paragraph": 27,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "初，沛公引兵过陈留，郦生踵军门上谒曰："
    },
    {
      "paragraph": 28,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "沛公曰：“为我谢之，言我方以天下为事，未暇见儒人也。”"
    },
    {
      "paragraph": 29,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "复入言沛公，吾高阳酒徒也，非儒人也。"
    },
    {
      "paragraph": 30,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "郦生入，揖沛公曰：“足下甚苦，暴衣露冠，将兵助楚讨不义"
    },
    {
      "paragraph": 31,
      "primary_subject": "郦食其",
      "disposition": "block",
      "text_snippet": "於是郦生乃夜见陈留令，说之曰："
    },
    {
      "paragraph": 32,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：世之传郦生书，多曰汉王已拔三秦，东击项籍而引军於巩洛之间"
    },
    {
      "paragraph": 33,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "余读陆生新语书十二篇，固当世之辩士。至平原君子与余善，是以得具论之。"
    }
  ]
}
