    {
      "name": "卫青",
      "category": "武将",
      "paragraph_from": 1,
      "paragraph_to": 12,
      "boundary_evidence": {
        "open_paragraph": 1,
        "open_phrase": "大将军卫青者，平阳人也。其父郑季，为吏，给事平阳侯家，与侯妾卫媪通，生青。青同母",
        "close_note": "P1–P12 卫青传首"
      }
    },
    {
      "name": "霍去病",
      "category": "武将",
      "paragraph_from": 13,
      "paragraph_to": 31,
      "boundary_evidence": {
        "open_paragraph": 13,
        "open_phrase": "是岁也，大将军姊子霍去病年十八，幸，为天子侍中。善骑射，再从大将军，受诏与壮士，",
        "close_note": "P13–P31 骠骑合战段（双挂卫霍）"
      }
    },
    {
      "name": "卫青",
      "category": "武将",
      "paragraph_from": 32,
      "paragraph_to": 51,
      "boundary_evidence": {
        "open_paragraph": 32,
        "open_phrase": "自骠骑将军死后，大将军长子宜春侯伉坐法失侯。后五岁，伉弟二人，阴安侯不疑及发干侯",
        "close_note": "P32–P51 骠骑死后·大将军及诸将"
      }
    },
    {
      "name": "霍去病",
      "category": "武将",
      "paragraph_from": 52,
      "paragraph_to": 53,
      "boundary_evidence": {
        "open_paragraph": 52,
        "open_phrase": "最骠骑将军去病，凡六出击匈奴，其四出以将军，斩捕首虏十一万馀级。及浑邪王以众降数",
        "close_note": "P52–P53 骠骑军功总述及附传收束"
      }
    }
  ],
