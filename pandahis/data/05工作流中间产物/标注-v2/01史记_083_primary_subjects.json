{
  "work": "01史记",
  "vol": "083",
  "total_paragraphs": 33,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "鲁仲连者，齐人也。好奇伟俶傥之画策，而不肯仕宦任职，好持高节。游於赵。"
    },
    {
      "paragraph": 2,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "赵孝成王时，而秦王使白起破赵长平之军前后四十馀万，秦兵遂东围邯郸。"
    },
    {
      "paragraph": 3,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "赵王恐，诸侯之救兵莫敢击秦军。魏安釐王使将军晋鄙救赵，畏秦，止於荡阴不进。"
    },
    {
      "paragraph": 4,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "此时鲁仲连適游赵，会秦围赵，闻魏将欲令赵尊秦为帝，乃见平原君曰："
    },
    {
      "paragraph": 5,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "平原君遂见新垣衍曰：东国有鲁仲连先生者，今其人在此，胜请为绍介，交之於将军。"
    },
    {
      "paragraph": 6,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "鲁连见新垣衍而无言。新垣衍曰：吾视居此围城之中者，皆有求於平原君者也。"
    },
    {
      "paragraph": 7,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "新垣衍曰：先生助之将柰何？鲁连曰：吾将使梁及燕助之，齐、楚则固助之矣。"
    },
    {
      "paragraph": 8,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "新垣衍曰：秦称帝之害何如？鲁连曰：昔者齐威王尝为仁义矣，率天下诸侯而朝周。"
    },
    {
      "paragraph": 9,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "新垣衍曰：先生独不见夫仆乎？十人而从一人者，宁力不胜而智不若邪？畏之也。"
    },
    {
      "paragraph": 10,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "鄂侯争之彊，辩之疾，故脯鄂侯。文王闻之，喟然而叹，故拘之牖里之库百日，欲令之死。"
    },
    {
      "paragraph": 11,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "於是平原君欲封鲁连，鲁连辞让者三，终不肯受。平原君乃置酒，酒酣起前，以千金为鲁连寿。"
    },
    {
      "paragraph": 12,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "其后二十馀年，燕将攻下聊城，聊城人或谗之燕，燕将惧诛，因保守聊城，不敢归。"
    },
    {
      "paragraph": 13,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "且楚攻齐之南阳，魏攻平陆，而齐无南面之心，以为亡南阳之害小，不如得济北之利大。"
    },
    {
      "paragraph": 14,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "且吾闻之，规小节者不能成荣名，恶小耻者不能立大功。昔者管夷吾射桓公中其钩，篡也。"
    },
    {
      "paragraph": 15,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "燕将见鲁连书，泣三日，犹豫不能自决。欲归燕，已有隙，恐诛；欲降齐，所杀虏於齐甚众。"
    },
    {
      "paragraph": 16,
      "primary_subject": "鲁仲连",
      "disposition": "block",
      "text_snippet": "聊城乱，田单遂屠聊城。归而言鲁连，欲爵之。鲁连逃隐於海上。"
    },
    {
      "paragraph": 17,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "邹阳者，齐人也。游於梁，与故吴人庄忌夫子、淮阴枚生之徒交。"
    },
    {
      "paragraph": 18,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "邹阳客游，以谗见禽，恐死而负累，乃从狱中上书曰：臣闻忠无不报，信不见疑。"
    },
    {
      "paragraph": 19,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "昔卞和献宝，楚王刖之；李斯竭忠，胡亥极刑。是以箕子详狂，接舆辟世，恐遭此患也。"
    },
    {
      "paragraph": 20,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "谚曰：有白头如新，倾盖如故。何则？知与不知也。故昔樊於期逃秦之燕。"
    },
    {
      "paragraph": 21,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "故女无美恶，入宫见妒；士无贤不肖，入朝见嫉。昔者司马喜髌脚於宋，卒相中山。"
    },
    {
      "paragraph": 22,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "不容於世，义不苟取，比周於朝，以移主上之心。故百里奚乞食於路，缪公委之以政。"
    },
    {
      "paragraph": 23,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "是以秦用戎人由余而霸中国，齐用越人蒙而彊威、宣。此二国，岂拘於俗，牵於世。"
    },
    {
      "paragraph": 24,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "是以圣王觉寤，捐子之之心，而能不说於田常之贤；封比干之后，修孕妇之墓。"
    },
    {
      "paragraph": 25,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "至夫秦用商鞅之法，东弱韩、魏，兵彊天下，而卒车裂之；越用大夫种之谋。"
    },
    {
      "paragraph": 26,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "臣闻明月之珠，夜光之璧，以闇投人於道路，人无不按剑相眄者。何则？无因而至前也。"
    },
    {
      "paragraph": 27,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "故无因至前，虽出随侯之珠，夜光之璧，犹结怨而不见德。故有人先谈，则以枯木朽株树功而不忘。"
    },
    {
      "paragraph": 28,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "是以圣王制世御俗，独化於陶钧之上，而不牵於卑乱之语，不夺於众多之口。"
    },
    {
      "paragraph": 29,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "故秦皇帝任中庶子蒙嘉之言，以信荆轲之说，而匕首窃发；周文王猎泾、渭，载吕尚而归。"
    },
    {
      "paragraph": 30,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "今人主沈於谄谀之辞，牵於帷裳之制，使不羁之士与牛骥同皂，此鲍焦所以忿於世而不留富贵之乐也。"
    },
    {
      "paragraph": 31,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "臣闻盛饰入朝者不以利汙义，砥厉名号者不以欲伤行，故县名胜母而曾子不入。"
    },
    {
      "paragraph": 32,
      "primary_subject": "邹阳",
      "disposition": "block",
      "text_snippet": "书奏梁孝王，孝王使人出之，卒为上客。"
    },
    {
      "paragraph": 33,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：鲁连其指意虽不合大义，然余多其在布衣之位，荡然肆志，不诎於诸侯。"
    }
  ]
}
