{
  "work": "01史记",
  "vol": "090",
  "total_paragraphs": 13,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "魏豹",
      "disposition": "block",
      "text_snippet": "魏豹者，故魏诸公子也。其兄魏咎，故魏时封为宁陵君。"
    },
    {
      "paragraph": 2,
      "primary_subject": "魏豹",
      "disposition": "block",
      "text_snippet": "章邯已破陈王，乃进兵击魏王於临济。"
    },
    {
      "paragraph": 3,
      "primary_subject": "魏豹",
      "disposition": "block",
      "text_snippet": "约定，咎自烧杀。"
    },
    {
      "paragraph": 4,
      "primary_subject": "魏豹",
      "disposition": "block",
      "text_snippet": "魏豹亡走楚。楚怀王予魏豹数千人，复徇魏地。"
    },
    {
      "paragraph": 5,
      "primary_subject": "魏豹",
      "disposition": "block",
      "text_snippet": "汉王还定三秦，渡临晋，魏王豹以国属焉。"
    },
    {
      "paragraph": 6,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "彭越者，昌邑人也，字仲。常渔钜野泽中，为群盗。"
    },
    {
      "paragraph": 7,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "居岁馀，泽间少年相聚百馀人，往从彭越。"
    },
    {
      "paragraph": 8,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "沛公之从砀北击昌邑，彭越助之。"
    },
    {
      "paragraph": 9,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "汉王之败彭城解而西也，彭越皆复亡其所下城。"
    },
    {
      "paragraph": 10,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "汉王败，使使召彭越并力击楚。"
    },
    {
      "paragraph": 11,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "六年，朝陈。九年，十年，皆来朝长安。"
    },
    {
      "paragraph": 12,
      "primary_subject": "彭越",
      "disposition": "block",
      "text_snippet": "十年秋，陈豨反代地，高帝自往击，至邯郸，徵兵梁王。"
    },
    {
      "paragraph": 13,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：魏豹、彭越虽故贱，然已席卷千里。"
    }
  ]
}
