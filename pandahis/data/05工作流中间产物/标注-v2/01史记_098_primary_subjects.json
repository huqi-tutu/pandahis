{
  "work": "01史记",
  "vol": "098",
  "total_paragraphs": 18,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "阳陵侯傅宽，以魏五大夫骑将从，为舍人，起横阳。"
    },
    {
      "paragraph": 2,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "从击项籍，待怀，赐爵通德侯。"
    },
    {
      "paragraph": 3,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "属淮阴，击破齐历下军，击田解。"
    },
    {
      "paragraph": 4,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "四月，击陈豨，属太尉勃，以相国代丞相哙击豨。"
    },
    {
      "paragraph": 5,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "二岁，为代丞相，将屯。"
    },
    {
      "paragraph": 6,
      "primary_subject": "傅宽",
      "disposition": "block",
      "text_snippet": "孝惠五年卒，谥为景侯。子顷侯精立，二十四年卒。"
    },
    {
      "paragraph": 7,
      "primary_subject": "世系链",
      "disposition": "exclude",
      "exclude_reason": "世系链",
      "text_snippet": "子侯偃立，三十一年，坐与淮南王谋反，死，国除。"
    },
    {
      "paragraph": 8,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "信武侯靳歙，以中涓从，起宛朐。"
    },
    {
      "paragraph": 9,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "从定三秦。别西击章平军於陇西，破之。"
    },
    {
      "paragraph": 10,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "略梁地，别将击邢说军菑南，破之。"
    },
    {
      "paragraph": 11,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "别之河内，击赵将贲郝军朝歌，破之。"
    },
    {
      "paragraph": 12,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "从攻安阳以东，至棘蒲，下七县。"
    },
    {
      "paragraph": 13,
      "primary_subject": "靳歙",
      "disposition": "block",
      "text_snippet": "以骑都尉从击代，攻韩信平城下，还军东垣。"
    },
    {
      "paragraph": 14,
      "primary_subject": "世系链",
      "disposition": "exclude",
      "exclude_reason": "世系链",
      "text_snippet": "高后五年，歙卒，谥为肃侯。子亭代侯。"
    },
    {
      "paragraph": 15,
      "primary_subject": "蒯成侯",
      "disposition": "block",
      "text_snippet": "蒯成侯緤者，沛人也，姓周氏。"
    },
    {
      "paragraph": 16,
      "primary_subject": "蒯成侯",
      "disposition": "block",
      "text_snippet": "上欲自击陈豨，蒯成侯泣曰："
    },
    {
      "paragraph": 17,
      "primary_subject": "世系链",
      "disposition": "exclude",
      "exclude_reason": "世系链",
      "text_snippet": "至孝文五年，緤以寿终，谥为贞侯。子昌代侯，有罪，国除。"
    },
    {
      "paragraph": 18,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：阳陵侯傅宽、信武侯靳歙皆高爵，从高祖起山东。"
    }
  ]
}
