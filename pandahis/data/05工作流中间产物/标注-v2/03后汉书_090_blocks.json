    {
      "name": "范式",
      "category": "文臣",
      "paragraph_from": 36,
      "paragraph_to": 41,
      "boundary_evidence": {
        "open_paragraph": 36,
        "open_phrase": "范式字巨卿，山阳金乡人也，一名汜。少游太学，为诸生，与汝南张劭为友。劭字元伯。二",
        "close_paragraph": 41,
