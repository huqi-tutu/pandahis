{
  "work": "01史记",
  "vol": "096",
  "total_paragraphs": 35,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "张丞相苍者，阳武人也。好书律历。秦时为御史，主柱下方书。有罪，亡归。"
    },
    {
      "paragraph": 2,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "及沛公略地过阳武，苍以客从攻南阳。苍坐法当斩，解衣伏质，身长大，肥白如瓠，时王陵见而怪其美士，乃言沛公，赦勿斩。"
    },
    {
      "paragraph": 3,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "迁为计相，一月，更以列侯为主计四岁。是时萧何为相国，而张苍乃自秦时为柱下史，明习天下图书计籍。"
    },
    {
      "paragraph": 4,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "周昌者，沛人也。其从兄曰周苛，秦时皆为泗水卒史。及高祖起沛，击破泗水守监，於是周昌、周苛自卒史从沛公，沛公以周昌为职志，周苛为客。"
    },
    {
      "paragraph": 5,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "汉王四年，楚围汉王荥阳急，汉王遁出去，而使周苛守荥阳城。楚破荥阳城，欲令周苛将。苛骂曰：“若趣降汉王！不然，今为虏矣！”项羽怒，亨周苛。"
    },
    {
      "paragraph": 6,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "昌为人彊力，敢直言，自萧、曹等皆卑下之。昌尝燕时入奏事，高帝方拥戚姬，昌还走，高帝逐得，骑周昌项，问曰：“我何如主也？”"
    },
    {
      "paragraph": 7,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "是后戚姬子如意为赵王，年十岁，高祖忧即万岁之后不全也。赵尧年少，为符玺御史。赵人方与公谓御史大夫周昌曰：“君之史赵尧，年虽少，然奇才也，君必异之，是且代君之位。”"
    },
    {
      "paragraph": 8,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "居顷之，赵尧侍高祖。高祖独心不乐，悲歌，群臣不知上之所以然。赵尧进请问曰：“陛下所为不乐，非为赵王年少而戚夫人与吕后有卻邪？备万岁之后而赵王不能自全乎？”"
    },
    {
      "paragraph": 9,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "既行久之，高祖持御史大夫印弄之，曰：“谁可以为御史大夫者？”孰视赵尧，曰：“无以易尧。”遂拜赵尧为御史大夫。"
    },
    {
      "paragraph": 10,
      "primary_subject": "周昌",
      "disposition": "block",
      "text_snippet": "高祖崩，吕太后使使召赵王，其相周昌令王称疾不行。使者三反，周昌固为不遣赵王。於是高后患之，乃使使召周昌。"
    },
    {
      "paragraph": 11,
      "primary_subject": "任敖",
      "disposition": "block",
      "text_snippet": "后五岁，高后闻御史大夫江邑侯赵尧高祖时定赵王如意之画，乃抵尧罪，以广阿侯任敖为御史大夫。"
    },
    {
      "paragraph": 12,
      "primary_subject": "任敖",
      "disposition": "block",
      "text_snippet": "任敖者，故沛狱吏。高祖尝辟吏，吏系吕后，遇之不谨。任敖素善高祖，怒，击伤主吕后吏。"
    },
    {
      "paragraph": 13,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "苍与绛侯等尊立代王为孝文皇帝。四年，丞相灌婴卒，张苍为丞相。"
    },
    {
      "paragraph": 14,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "自汉兴至孝文二十馀年，会天下初定，将相公卿皆军吏。张苍为计相时，绪正律历。"
    },
    {
      "paragraph": 15,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "张苍德王陵。王陵者，安国侯也。及苍贵，常父事王陵。陵死后，苍为丞相，洗沐，常先朝陵夫人上食，然后敢归家。"
    },
    {
      "paragraph": 16,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "苍为丞相十馀年，鲁人公孙臣上书言汉土德时，其符有黄龙当见。诏下其议张苍，张苍以为非是，罢之。"
    },
    {
      "paragraph": 17,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "初，张苍父长不满五尺，及生苍，苍长八尺馀，为侯、丞相。苍子复长。及孙类，长六尺馀，坐法失侯。"
    },
    {
      "paragraph": 18,
      "primary_subject": "张苍",
      "disposition": "block",
      "text_snippet": "妻妾以百数，尝孕者不复幸。苍年百有馀岁而卒。"
    },
    {
      "paragraph": 19,
      "primary_subject": "申屠嘉",
      "disposition": "block",
      "text_snippet": "申屠丞相嘉者，梁人，以材官蹶张从高帝击项籍，迁为队率。从击黥布军，为都尉。孝惠时，为淮阳守。"
    },
    {
      "paragraph": 20,
      "primary_subject": "申屠嘉",
      "disposition": "block",
      "text_snippet": "张苍免相，孝文帝欲用皇后弟窦广国为丞相，曰：“恐天下以吾私广国。”广国贤有行，故欲相之，念久之不可，而高帝时大臣又皆多死，馀见无可者，乃以御史大夫嘉为丞相，因故邑封为故安侯。"
    },
    {
      "paragraph": 21,
      "primary_subject": "申屠嘉",
      "disposition": "block",
      "text_snippet": "嘉为人廉直，门不受私谒。是时太中大夫邓通方隆爱幸，赏赐累巨万。文帝尝燕饮通家，其宠如是。"
    },
    {
      "paragraph": 22,
      "primary_subject": "申屠嘉",
      "disposition": "block",
      "text_snippet": "嘉为丞相五岁，孝文帝崩，孝景帝即位。二年，晁错为内史，贵幸用事，诸法令多所请变更，议以谪罚侵削诸侯。"
    },
    {
      "paragraph": 23,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "自申屠嘉死之后，景帝时开封侯陶青、桃侯刘舍为丞相。及今上时，柏至侯许昌、平棘侯薛泽、武彊侯庄青翟、高陵侯赵周等为丞相。"
    },
    {
      "paragraph": 24,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：“张苍文学律历，为汉名相，而绌贾生、公孙臣等言正朔服色事而不遵，明用秦之颛顼历，何哉？"
    },
    {
      "paragraph": 25,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "孝武时丞相多甚，不记，莫录其行起居状略，且纪征和以来。"
    },
    {
      "paragraph": 26,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "有车丞相，长陵人也。卒而有韦丞相代。韦丞相贤者，鲁人也。以读书术为吏，至大鸿胪。"
    },
    {
      "paragraph": 27,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "魏丞相相者，济阴人也。以文吏至丞相。其人好武，皆令诸吏带剑，带剑前奏事。"
    },
    {
      "paragraph": 28,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "后坐骑至庙，不敬，有诏夺爵一级，为关内侯，失列侯，得食其故国邑。魏丞相卒，以御史大夫邴吉代。"
    },
    {
      "paragraph": 29,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "邴丞相吉者，鲁国人也。以读书好法令至御史大夫。孝宣帝时，以有旧故，封为列侯，而因为丞相。"
    },
    {
      "paragraph": 30,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "邴丞相卒，黄丞相代。长安中有善相工田文者，与韦丞相、魏丞相、邴丞相微贱时会於客家，田文言曰：“今此三君者，皆丞相也。”"
    },
    {
      "paragraph": 31,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "黄丞相霸者，淮阳人也。以读书为吏，至颍川太守。治颍川，以礼义条教喻告化之。"
    },
    {
      "paragraph": 32,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "徵为京兆尹而至丞相，复以礼义为治。以丞相病死。子嗣，后为列侯。黄丞相卒，以御史大夫于定国代。"
    },
    {
      "paragraph": 33,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "韦丞相玄成者，即前韦丞相子也。代父，后失列侯。其人少时好读书，明於诗、论语。"
    },
    {
      "paragraph": 34,
      "primary_subject": "共段总述",
      "disposition": "exclude",
      "exclude_reason": "共段总述",
      "text_snippet": "丞相匡衡者，东海人也。好读书，从博士受诗。家贫，衡佣作以给食饮。"
    },
    {
      "paragraph": 35,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：深惟士之游宦所以至封侯者，微甚。然多至御史大夫即去者。"
    }
  ]
}
