      "paragraph_from": 41,
      "paragraph_to": 43,
      "boundary_evidence": {
        "open_paragraph": 41,
        "open_phrase": "安城孝侯赐字子琴，光武族兄也。祖父利，苍梧太守。赐少孤。兄显报怨杀人，吏捕显杀之",
        "close_paragraph": 43,
