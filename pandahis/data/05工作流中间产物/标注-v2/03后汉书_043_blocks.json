      "name": "刘平",
      "category": "文臣",
      "paragraph_from": 6,
      "paragraph_to": 10,
      "boundary_evidence": {
        "open_paragraph": 6,
        "open_phrase": "刘平字公子，楚郡彭城人也。本名旷，显宗后改为平。王莽时为郡吏，守菑丘长，政教大行",
        "close_paragraph": 10,
