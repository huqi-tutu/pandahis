{
  "work": "01史记",
  "vol": "093",
  "total_paragraphs": 29,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "韩王信者，故韩襄王孽孙也，长八尺五寸。"
    },
    {
      "paragraph": 2,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "项梁败死定陶，成奔怀王。沛公引兵击阳城，使张良以韩司徒降下韩故地，得信，以为韩将"
    },
    {
      "paragraph": 3,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "沛公立为汉王，韩信从入汉中，乃说汉王曰"
    },
    {
      "paragraph": 4,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "项籍之封诸王皆就国，韩王成以不从无功，不遣就国"
    },
    {
      "paragraph": 5,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "明年春，上以韩信材武，所王北近巩、洛"
    },
    {
      "paragraph": 6,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "七年冬，上自往击，破信军铜鞮，斩其将王喜。"
    },
    {
      "paragraph": 7,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "入平城，汉救兵亦到，胡骑遂解去。"
    },
    {
      "paragraph": 8,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "汉十年，信令王黄等说误陈豨。"
    },
    {
      "paragraph": 9,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "信之入匈奴，与太子俱；及至穨当城，生子，因名曰穨当。"
    },
    {
      "paragraph": 10,
      "primary_subject": "韩信",
      "disposition": "block",
      "text_snippet": "吴楚军时，弓高侯功冠诸将。"
    },
    {
      "paragraph": 11,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "卢绾者，丰人也，与高祖同里。"
    },
    {
      "paragraph": 12,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "汉五年冬，以破项籍，乃使卢绾别将，与刘贾击临江王共尉，破之。"
    },
    {
      "paragraph": 13,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "汉五年八月，乃立卢绾为燕王。"
    },
    {
      "paragraph": 14,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "汉十一年秋，陈豨反代地，高祖如邯郸击豨兵，燕王绾亦击其东北。"
    },
    {
      "paragraph": 15,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "汉十二年，东击黥布，豨常将兵居代，汉使樊哙击斩豨。"
    },
    {
      "paragraph": 16,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "吕后妇人，专欲以事诛异姓王者及大功臣。"
    },
    {
      "paragraph": 17,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "高后时，卢绾妻子亡降汉，会高后病，不能见"
    },
    {
      "paragraph": 18,
      "primary_subject": "卢绾",
      "disposition": "block",
      "text_snippet": "孝景中六年，卢绾孙他之，以东胡王降，封为亚谷侯。"
    },
    {
      "paragraph": 19,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "陈豨者，宛朐人也，不知始所以得从。"
    },
    {
      "paragraph": 20,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "豨常告归过赵，赵相周昌见豨宾客随之者千馀乘"
    },
    {
      "paragraph": 21,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "九月，遂与王黄等反，自立为代王，劫略赵、代。"
    },
    {
      "paragraph": 22,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "上闻，乃赦赵、代吏人为豨所诖误劫略者，皆赦之。"
    },
    {
      "paragraph": 23,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "上曰：“是力不足也。”赦之，复以为常山守、尉。"
    },
    {
      "paragraph": 24,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "皆曰：“善。”於是上曰：“陈豨将谁？”"
    },
    {
      "paragraph": 25,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "上曰：“吾知之矣。”乃各以千金购黄、臣等。"
    },
    {
      "paragraph": 26,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "十一年冬，汉兵击斩陈豨将侯敞、王黄於曲逆下"
    },
    {
      "paragraph": 27,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "上还至洛阳。上曰：“代居常山北，赵乃从山南有之，远。”"
    },
    {
      "paragraph": 28,
      "primary_subject": "陈豨",
      "disposition": "block",
      "text_snippet": "高祖十二年冬，樊哙军卒追斩豨於灵丘。"
    },
    {
      "paragraph": 29,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：韩信、卢绾非素积德累善之世"
    }
  ]
}
