      "paragraph_from": 6,
      "paragraph_to": 7,
      "boundary_evidence": {
        "open_paragraph": 6,
        "open_phrase": "广汉姜诗妻者，同郡庞盛之女也。诗事母至孝，妻奉顺尤笃。母好饮江水，水去舍六七里，",
        "close_paragraph": 7,
        "close_note": "Step1b-β 自 primary_subjects 合并 P6–P7"
