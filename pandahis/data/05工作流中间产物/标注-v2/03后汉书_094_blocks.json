      "paragraph_from": 5,
      "paragraph_to": 5,
      "boundary_evidence": {
        "open_paragraph": 5,
        "open_phrase": "太原王霸妻者，不知何氏之女也。霸少立高节，光武时连征，不仕。霸已见《逸人传》。妻",
        "close_paragraph": 5,
