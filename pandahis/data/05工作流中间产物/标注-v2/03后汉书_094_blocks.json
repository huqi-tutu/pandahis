      "paragraph_from": 9,
      "paragraph_to": 24,
      "boundary_evidence": {
        "open_paragraph": 9,
        "open_phrase": "扶风曹世叔妻者，同郡班彪之女也，名昭，字惠班，一名姬。博学高才。世叔早卒，有节行",
        "close_paragraph": 24,
