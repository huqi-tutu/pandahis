{
  "work": "01史记",
  "vol": "094",
  "total_paragraphs": 20,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "田儋",
      "disposition": "block",
      "text_snippet": "田儋者，狄人也，故齐王田氏族也。儋从弟田荣，荣弟田横，皆豪，宗彊，能得人。"
    },
    {
      "paragraph": 2,
      "primary_subject": "田儋",
      "disposition": "block",
      "text_snippet": "陈涉之初起王楚也，使周市略定魏地，北至狄，狄城守。田儋详为缚其奴，从少年之廷，欲谒杀奴。"
    },
    {
      "paragraph": 3,
      "primary_subject": "田儋",
      "disposition": "block",
      "text_snippet": "秦将章邯围魏王咎於临济，急。魏王请救於齐，齐王田儋将兵救魏。章邯夜衔枚击，大破齐、魏军，杀田儋於临济下。"
    },
    {
      "paragraph": 4,
      "primary_subject": "世系链",
      "disposition": "exclude",
      "exclude_reason": "世系链",
      "text_snippet": "齐人闻王田儋死，乃立故齐王建之弟田假为齐王，田角为相，田间为将，以距诸侯。"
    },
    {
      "paragraph": 5,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "田荣之走东阿，章邯追围之。项梁闻田荣之急，乃引兵击破章邯军东阿下。"
    },
    {
      "paragraph": 6,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "章邯走而西，项梁因追之。而田荣怒齐之立假，乃引兵归，击逐齐王假。假亡走楚。"
    },
    {
      "paragraph": 7,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "荣相之，田横为将，平齐地。"
    },
    {
      "paragraph": 8,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "项梁既追章邯，章邯兵益盛，项梁使使告赵、齐，发兵共击章邯。田荣曰：使楚杀田假，赵杀田角、田间，乃肯出兵。"
    },
    {
      "paragraph": 9,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "项羽既存赵，降章邯等，西屠咸阳，灭秦而立侯王也，乃徙齐王田市更王胶东，治即墨。"
    },
    {
      "paragraph": 10,
      "primary_subject": "田荣",
      "disposition": "block",
      "text_snippet": "项王既归，诸侯各就国，田荣使人将兵助陈馀，令反赵地，而荣亦发兵以距击田都，田都亡走楚。"
    },
    {
      "paragraph": 11,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "项王闻之，大怒，乃北伐齐。齐王田荣兵败，走平原，平原人杀荣。项王遂烧夷齐城郭，所过者尽屠之。"
    },
    {
      "paragraph": 12,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "横定齐三年，汉王使郦生往说下齐王广及其相国横。横以为然，解其历下军。"
    },
    {
      "paragraph": 13,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "汉将韩信引兵且东击齐。齐初使华无伤、田解军於历下以距汉，汉使至，乃罢守战备，纵酒，且遣使与汉平。"
    },
    {
      "paragraph": 14,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "彭越是时居梁地，中立，且为汉，且为楚。韩信已杀龙且，因令曹参进兵破杀田既於胶东，使灌婴破杀齐将田吸於千乘。"
    },
    {
      "paragraph": 15,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "后岁馀，汉灭项籍，汉王立为皇帝，以彭越为梁王。田横惧诛，而与其徒属五百馀人入海，居岛中。"
    },
    {
      "paragraph": 16,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "使还报，高皇帝乃诏卫尉郦商曰：齐王田横即至，人马从者敢动摇者致族夷！"
    },
    {
      "paragraph": 17,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "乃复使使持节具告以诏商状，曰：田横来，大者王，小者乃侯耳；不来，且举兵加诛焉。田横乃与其客二人乘传诣雒阳。"
    },
    {
      "paragraph": 18,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "未至三十里，至尸乡厩置，横谢使者曰：人臣见天子当洗沐。止留。谓其客曰：横始与汉王俱南面称孤，今汉王为天子，而横乃为亡虏而北面事之，其耻固已甚矣。"
    },
    {
      "paragraph": 19,
      "primary_subject": "田横",
      "disposition": "block",
      "text_snippet": "既葬，二客穿其冢旁孔，皆自刭，下从之。高帝闻之，乃大惊，以田横之客皆贤。吾闻其馀尚五百人在海中，使使召之。"
    },
    {
      "paragraph": 20,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：甚矣蒯通之谋，乱齐骄淮阴，其卒亡此两人！蒯通者，善为长短说，论战国之权变，为八十一首。"
    }
  ]
}
