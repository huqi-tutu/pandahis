      "name": "聂政",
      "category": "庶众",
      "paragraph_from": 21,
      "paragraph_to": 30,
      "boundary_evidence": {
        "open_paragraph": 21,
        "open_phrase": "聂政者，轵深井里人也。杀人避仇，与母、姊如齐，以屠为事。",
        "close_paragraph": 30,
        "close_note": "Step1b-β 自 primary_subjects 合并 P21–P30"
