      "paragraph_from": 14,
      "paragraph_to": 19,
      "boundary_evidence": {
        "open_paragraph": 14,
        "open_phrase": "豫让者，晋人也，故尝事范氏及中行氏，而无所知名。去而事智伯，智伯甚尊宠之。及智伯",
        "close_paragraph": 19,
        "close_note": "Step1b-β 自 primary_subjects 合并 P14–P19"
