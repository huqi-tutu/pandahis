      "paragraph_from": 8,
      "paragraph_to": 12,
      "boundary_evidence": {
        "open_paragraph": 8,
        "open_phrase": "故尝阴养谋臣以求立。",
        "close_paragraph": 12,
        "close_note": "Step1b-β 自 primary_subjects 合并 P8–P12"
