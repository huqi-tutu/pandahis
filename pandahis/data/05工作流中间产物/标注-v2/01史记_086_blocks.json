      "paragraph_from": 5,
      "paragraph_to": 5,
      "boundary_evidence": {
        "open_paragraph": 5,
        "open_phrase": "专诸者，吴堂邑人也。伍子胥之亡楚而如吴也，知专诸之能。伍子胥既见吴王僚，说以伐楚",
        "close_paragraph": 5,
        "close_note": "Step1b-β 自 primary_subjects 合并 P5–P5"
