      "name": "王良",
      "category": "文臣",
      "paragraph_from": 15,
      "paragraph_to": 18,
      "boundary_evidence": {
        "open_paragraph": 15,
        "open_phrase": "王良字仲子，东海兰陵人也。少好学，习《小夏侯尚书》。王莽时，寝病不仕，教授诸生千",
        "close_paragraph": 18,
        "close_note": "Step1b-β 自 primary_subjects 合并 P15–P18"
