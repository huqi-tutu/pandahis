    },
    {
      "name": "杜林",
      "category": "文臣",
      "paragraph_from": 20,
      "paragraph_to": 29,
      "boundary_evidence": {
        "open_paragraph": 20,
        "open_phrase": "杜林字伯山，扶风茂陵人也。父邺，成、哀间为凉州刺史。林少好学沉深，家既多书，又外",
        "close_paragraph": 29,
        "close_note": "Step1b-β 自 primary_subjects 合并 P20–P29"
      }
    },
    {
      "name": "郑均",
      "category": "文臣",
      "paragraph_from": 41,
      "paragraph_to": 43,
      "boundary_evidence": {
        "open_paragraph": 41,
        "open_phrase": "郑均字仲虞，东平任城人也。少好黄、老书。兄为县吏，颇受礼遗，均数谏止，不听。即脱",
        "close_paragraph": 43,
        "close_note": "Step1b-β 自 primary_subjects 合并 P41–P43"
      }
    },
    {
      "name": "赵典",
