    {
      "name": "高彪",
      "category": "文臣",
      "paragraph_from": 44,
      "paragraph_to": 48,
      "boundary_evidence": {
        "open_paragraph": 44,
        "open_phrase": "高彪字义方，吴郡无锡人也。家本单寒，至彪为诸生，游太学。有雅才而讷于言。尝从马融",
        "close_paragraph": 48,
