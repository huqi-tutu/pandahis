      "category": "文臣",
      "paragraph_from": 18,
      "paragraph_to": 28,
      "boundary_evidence": {
        "open_paragraph": 18,
        "open_phrase": "刘梁字曼山，一名岑，东平宁阳人也。梁宗室子孙，而少孤贫，卖书于市以自资。",
        "close_paragraph": 28,
