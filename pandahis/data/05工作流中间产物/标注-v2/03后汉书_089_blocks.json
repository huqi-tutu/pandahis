      "name": "边韶",
      "category": "文臣",
      "paragraph_from": 29,
      "paragraph_to": 38,
      "boundary_evidence": {
        "open_paragraph": 29,
        "open_phrase": "边让字文礼，除留浚仪人也。少辩博，能属文。作《章华赋》，虽多淫丽之辞，而终之以正",
        "close_paragraph": 38,
        "close_note": "Step1b-β 自 primary_subjects 合并 P29–P38"
