{
  "work": "01史记",
  "vol": "057",
  "total_paragraphs": 33,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "绛侯周勃者，沛人也。其先卷人，徙沛。勃以织薄曲为生，常为人吹箫给丧事，材官引彊。"
    },
    {
      "paragraph": 2,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "高祖之为沛公初起，勃以中涓从攻胡陵，下方与。方与反，与战，卻適。攻丰。击秦军砀东。"
    },
    {
      "paragraph": 3,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "项羽至，以沛公为汉王。汉王赐勃爵为威武侯。从入汉中，拜为将军。还定三秦，至秦，赐食邑怀德。"
    },
    {
      "paragraph": 4,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "以将军从高帝击反韩王信於代，降下霍人。以前至武泉，击胡骑，破之武泉北。"
    },
    {
      "paragraph": 5,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "击陈豨，屠马邑。所将卒斩豨将军乘马絺。击韩信、陈豨、赵利军於楼烦，破之。"
    },
    {
      "paragraph": 6,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "燕王卢绾反，勃以相国代樊哙将，击下蓟，得绾大将抵、丞相偃、守陉、太尉弱、御史大夫施，屠浑都。"
    },
    {
      "paragraph": 7,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "勃为人木彊敦厚，高帝以为可属大事。勃不好文学，每召诸生说士，东乡坐而责之。"
    },
    {
      "paragraph": 8,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "勃既定燕而归，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃为太尉。"
    },
    {
      "paragraph": 9,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "文帝既立，以勃为右丞相，赐金五千斤，食邑万户。居月馀，人或说勃曰。"
    },
    {
      "paragraph": 10,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "乃免相就国。"
    },
    {
      "paragraph": 11,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "岁馀，每河东守尉行县至绛，绛侯勃自畏恐诛，常被甲，令家人持兵以见之。"
    },
    {
      "paragraph": 12,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "其后人有上书告勃欲反，下廷尉。廷尉下其事长安，逮捕勃治之。勃恐，不知置辞。"
    },
    {
      "paragraph": 13,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "文帝既见绛侯狱辞，乃谢曰：“吏方验而出之。”於是使使持节赦绛侯，复爵邑。"
    },
    {
      "paragraph": 14,
      "primary_subject": "周勃",
      "disposition": "block",
      "text_snippet": "绛侯既出，曰：“吾尝将百万军，然安知狱吏之贵乎！”"
    },
    {
      "paragraph": 15,
      "primary_subject": "周亚夫",
      "co_owner": "周勃",
      "disposition": "block",
      "text_snippet": "绛侯复就国。孝文帝十一年卒，谥为武侯。子胜之代侯。六岁，尚公主，不相中，坐杀人，国除。绝一岁，文帝乃择绛侯勃子贤者河内守亚夫，封为条侯，续绛侯后。"
    },
    {
      "paragraph": 16,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "条侯亚夫自未侯为河内守时，许负相之，曰：“君后三岁而侯。侯八岁为将相，持国秉，贵重矣，於人臣无两。"
    },
    {
      "paragraph": 17,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "文帝之后六年，匈奴大入边。乃以宗正刘礼为将军，军霸上；祝兹侯徐厉为将军，军棘门；以河内守亚夫为将军，军细柳：以备胡。"
    },
    {
      "paragraph": 18,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "孝文且崩时，诫太子曰：“即有缓急，周亚夫真可任将兵。”文帝崩，拜亚夫为车骑将军。"
    },
    {
      "paragraph": 19,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "孝景三年，吴楚反。亚夫以中尉为太尉，东击吴楚。因自请上曰：“楚兵剽轻，难与争锋。"
    },
    {
      "paragraph": 20,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "太尉既会兵荥阳，吴方攻梁，梁急，请救。太尉引兵东北走昌邑，深壁而守。"
    },
    {
      "paragraph": 21,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "梁日使使请太尉，太尉守便宜，不肯往。梁上书言景帝，景帝使使诏救梁。太尉不奉诏，坚壁不出。"
    },
    {
      "paragraph": 22,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "归，复置太尉官。五岁，迁为丞相，景帝甚重之。景帝废栗太子，丞相固争之，不得。"
    },
    {
      "paragraph": 23,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "窦太后曰：“皇后兄王信可侯也。”景帝让曰：“始南皮、章武侯先帝不侯，及臣即位乃侯之。"
    },
    {
      "paragraph": 24,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "不如约，天下共击之’。今信虽皇后兄，无功，侯之，非约也。”景帝默然而止。"
    },
    {
      "paragraph": 25,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "其后匈奴王唯徐卢等五人降，景帝欲侯之以劝后。丞相亚夫曰：“彼背其主降陛下，陛下侯之，则何以责人臣不守节者乎？”"
    },
    {
      "paragraph": 26,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "乃悉封唯徐卢等为列侯。亚夫因谢病。景帝中三年，以病免相。"
    },
    {
      "paragraph": 27,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "顷之，景帝居禁中，召条侯，赐食。独置大胾，无切肉，又不置櫡。条侯心不平，顾谓尚席取櫡。"
    },
    {
      "paragraph": 28,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "居无何，条侯子为父买工官尚方甲楯五百被可以葬者。取庸苦之，不予钱。"
    },
    {
      "paragraph": 29,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "庸知其盗买县官器，怒而上变告子，事连汙条侯。书既闻上，上下吏。吏簿责条侯，条侯不对。"
    },
    {
      "paragraph": 30,
      "primary_subject": "世系链",
      "disposition": "exclude",
      "exclude_reason": "世系链",
      "text_snippet": "绝一岁，景帝乃更封绛侯勃他子坚为平曲侯，续绛侯后。十九年卒，谥为共侯。子建德代侯，十三年，为太子太傅。"
    },
    {
      "paragraph": 31,
      "primary_subject": "周亚夫",
      "disposition": "block",
      "text_snippet": "条侯果饿死。死后，景帝乃封王信为盖侯。"
    },
    {
      "paragraph": 32,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：绛侯周勃始为布衣时，鄙朴人也，才能不过凡庸。"
    },
    {
      "paragraph": 33,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "亚夫之用兵，持威重，执坚刃，穰苴曷有加焉！足己而不学，守节不逊，终以穷困。悲夫！"
    }
  ]
}
