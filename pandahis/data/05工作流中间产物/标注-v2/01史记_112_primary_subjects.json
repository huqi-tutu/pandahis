{
  "work": "01史记",
  "vol": "112",
  "total_paragraphs": 39,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "丞相公孙弘者，齐菑川国薛县人也，字季。少时为薛狱吏，有罪，免。"
    },
    {
      "paragraph": 2,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "建元元年，天子初即位，招贤良文学之士。是时弘年六十，徵以贤良为博士。"
    },
    {
      "paragraph": 3,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "使匈奴，还报，不合上意，上怒，以为不能，弘乃病免归。"
    },
    {
      "paragraph": 4,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "元光五年，有诏徵文学，菑川国复推上公孙弘。弘让谢国人曰："
    },
    {
      "paragraph": 5,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "弘为人恢奇多闻，常称以为人主病不广大，人臣病不俭节。"
    },
    {
      "paragraph": 6,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "於是天子察其行敦厚，辩论有馀，习文法吏事，而又缘饰以儒术，上大说之。"
    },
    {
      "paragraph": 7,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "上然弘言。左右幸臣每毁弘，上益厚遇之。"
    },
    {
      "paragraph": 8,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "元朔三年，张欧免，以弘为御史大夫。是时通西南夷，东置沧海，北筑朔方之郡。"
    },
    {
      "paragraph": 9,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "汲黯曰：“弘位在三公，奉禄甚多。然为布被，此诈也。”上问弘。"
    },
    {
      "paragraph": 10,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "晏婴相景公，食不重肉，妾不衣丝，齐国亦治，此下比於民。"
    },
    {
      "paragraph": 11,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "弘为人意忌，外宽内深。诸尝与弘有卻者，虽详与善，阴报其祸。"
    },
    {
      "paragraph": 12,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "淮南、衡山谋反，治党与方急。弘病甚，自以为无功而封，位至丞相，宜佐明主填抚国家。"
    },
    {
      "paragraph": 13,
      "primary_subject": "公孙弘",
      "disposition": "block",
      "text_snippet": "元狩二年，弘病，竟以丞相终。子度嗣为平津侯。"
    },
    {
      "paragraph": 14,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "主父偃者，齐临菑人也。学长短纵横之术，晚乃学易、春秋、百家言。"
    },
    {
      "paragraph": 15,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "司马法曰：“国虽大，好战必亡；天下虽平，忘战必危。”"
    },
    {
      "paragraph": 16,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "地固泽卤，不生五穀。然后发天下丁男以守北河。"
    },
    {
      "paragraph": 17,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "及至高皇帝定天下，略地於边，闻匈奴聚於代谷之外而欲击之。"
    },
    {
      "paragraph": 18,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "是时赵人徐乐、齐人严安俱上书言世务，各一事。"
    },
    {
      "paragraph": 19,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "陈涉无千乘之尊，尺土之地，身非王公大人名族之后，无乡曲之誉。"
    },
    {
      "paragraph": 20,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "况群臣百姓能为乱乎哉！此二体者，安危之明要也，贤主所留意而深察也。"
    },
    {
      "paragraph": 21,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "间者关东五穀不登，年岁未复，民多穷困，重之以边境之事。"
    },
    {
      "paragraph": 22,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "严安上书曰：臣闻周有天下，其治三百馀岁，成康其隆也，刑错四十馀年而不用。"
    },
    {
      "paragraph": 23,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "及至秦王，蚕食天下，并吞战国，称号曰皇帝，主海内之政。"
    },
    {
      "paragraph": 24,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "秦贵为天子，富有天下，灭世绝祀者，穷兵之祸也。"
    },
    {
      "paragraph": 25,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "今欲招南夷，朝夜郎，降羌僰，略濊州，建城邑，深入匈奴，燔其茏城。"
    },
    {
      "paragraph": 26,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "书奏天子，天子召见三人，谓曰：“公等皆安在？何相见之晚也！”"
    },
    {
      "paragraph": 27,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "偃说上曰：“古者诸侯不过百里，彊弱之形易制。"
    },
    {
      "paragraph": 28,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "尊立卫皇后，及发燕王定国阴事，盖偃有功焉。"
    },
    {
      "paragraph": 29,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "人或说偃曰：“太横矣。”主父曰：“臣结发游学四十馀年，身不得遂。"
    },
    {
      "paragraph": 30,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "吾日暮途远，故倒行暴施之。”"
    },
    {
      "paragraph": 31,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "偃盛言朔方地肥饶，外阻河，蒙恬城之以逐匈奴。"
    },
    {
      "paragraph": 32,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "元朔二年，主父言齐王内淫佚行僻，上拜主父为齐相。"
    },
    {
      "paragraph": 33,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "主父始为布衣时，尝游燕、赵，及其贵，发燕事。"
    },
    {
      "paragraph": 34,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "主父方贵幸时，宾客以千数，及其族死，无一人收者，唯独洨孔车收葬之。"
    },
    {
      "paragraph": 35,
      "primary_subject": "主父偃",
      "disposition": "block",
      "text_snippet": "天子后闻之，以为孔车长者也。"
    },
    {
      "paragraph": 36,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：公孙弘行义虽脩，然亦遇时。"
    },
    {
      "paragraph": 37,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "太皇太后诏大司徒大司空：“盖闻治国之道，富民为始；富民之要，在於节俭。”"
    },
    {
      "paragraph": 38,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "赐告治病，牛酒杂帛。居数月，有瘳，视事。"
    },
    {
      "paragraph": 39,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "班固称曰：公孙弘、卜式、儿宽皆以鸿渐之翼困於燕雀。"
    }
  ]
}
