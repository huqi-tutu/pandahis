      "name": "韩棱",
      "category": "文臣",
      "paragraph_from": 45,
      "paragraph_to": 50,
      "boundary_evidence": {
        "open_paragraph": 45,
        "open_phrase": "韩棱字伯师，颍川舞阳人，弓高侯穨当之后也。世为乡里著姓。父寻，建武中为陇西太守。",
        "close_paragraph": 50,
