      "name": "刘如意",
      "category": "宗戚",
      "paragraph_from": 4,
      "paragraph_to": 4,
      "boundary_evidence": {
        "open_paragraph": 4,
        "open_phrase": "赵隐王如意，九年位。四年，高祖崩，吕太后征王到长安",
        "close_paragraph": 4,
        "close_note": "赵隐王"
      }
    },
    {
      "name": "刘友",
      "category": "宗戚",
      "paragraph_from": 5,
      "paragraph_to": 7,
      "boundary_evidence": {
        "open_paragraph": 5,
        "open_phrase": "赵幽王友，十一年立为淮阳王。赵隐王如意死，孝惠元年",
        "close_paragraph": 7,
        "close_note": "赵幽王及子遂"
      }
    },
    {
      "name": "刘恢",
      "category": "宗戚",
      "paragraph_from": 8,
      "paragraph_to": 8,
      "boundary_evidence": {
        "open_paragraph": 8,
        "open_phrase": "赵共王恢。十一年，梁王彭越诛，立恢为梁王。十六年",
        "close_paragraph": 8,
        "close_note": "赵共王"
