{
  "work": "01史记",
  "vol": "102",
  "total_paragraphs": 18,
  "method": "Step1b-α LLM",
  "paragraphs": [
    {
      "paragraph": 1,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "张廷尉释之者，堵阳人也，字季。有兄仲同居。以訾为骑郎，事孝文帝，十岁不得调，无所知名。"
    },
    {
      "paragraph": 2,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "释之从行，登虎圈。上问上林尉诸禽兽簿，十馀问，尉左右视，尽不能对。"
    },
    {
      "paragraph": 3,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "虎圈啬夫从旁代尉对上所问禽兽簿甚悉，欲以观其能口对响应无穷者。文帝曰：“吏不当若是邪？尉无赖！”"
    },
    {
      "paragraph": 4,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "上就车，召释之参乘，徐行，问释之秦之敝。具以质言。至宫，上拜释之为公车令。"
    },
    {
      "paragraph": 5,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "顷之，太子与梁王共车入朝，不下司马门，於是释之追止太子、梁王无得入殿门。"
    },
    {
      "paragraph": 6,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "薄太后乃使使承诏赦太子、梁王，然后得入。文帝由是奇释之，拜为中大夫。"
    },
    {
      "paragraph": 7,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "顷之，至中郎将。从行至霸陵，居北临厕。是时慎夫人从，上指示慎夫人新丰道，曰：“此走邯郸道也。”"
    },
    {
      "paragraph": 8,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "左右皆曰：“善。”释之前进曰：“使其中有可欲者，虽锢南山犹有郄；使其中无可欲者，虽无石椁，又何戚焉！”"
    },
    {
      "paragraph": 9,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "顷之，上行出中渭桥，有一人从桥下走出，乘舆马惊。於是使骑捕，属之廷尉。释之治问。"
    },
    {
      "paragraph": 10,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "其后有人盗高庙坐前玉环，捕得，文帝怒，下廷尉治。释之案律盗宗庙服御物者为奏，奏当弃市。"
    },
    {
      "paragraph": 11,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "后文帝崩，景帝立，释之恐，称病。欲免去，惧大诛至；欲见谢，则未知何如。"
    },
    {
      "paragraph": 12,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "王生者，善为黄老言，处士也。尝召居廷中，三公九卿尽会立，王生老人，曰“吾袜解”，顾谓张廷尉：“为我结袜！”"
    },
    {
      "paragraph": 13,
      "primary_subject": "张释之",
      "disposition": "block",
      "text_snippet": "张廷尉事景帝岁馀，为淮南王相，犹尚以前过也。久之，释之卒。其子曰张挚，字长公，官至大夫，免。"
    },
    {
      "paragraph": 14,
      "primary_subject": "冯唐",
      "disposition": "block",
      "text_snippet": "冯唐者，其大父赵人。父徙代。汉兴徙安陵。唐以孝著，为中郎署长，事文帝。"
    },
    {
      "paragraph": 15,
      "primary_subject": "冯唐",
      "disposition": "block",
      "text_snippet": "当是之时，匈奴新大入朝冉阝，杀北地都尉卬。上以胡寇为意，乃卒复问唐曰：“公何以知吾不能用廉颇、李牧也？”"
    },
    {
      "paragraph": 16,
      "primary_subject": "冯唐",
      "disposition": "block",
      "text_snippet": "七年，景帝立，以唐为楚相，免。武帝立，求贤良，举冯唐。唐时年九十馀，不能复为官，乃以唐子冯遂为郎。"
    },
    {
      "paragraph": 17,
      "primary_subject": "太史公曰",
      "disposition": "exclude",
      "exclude_reason": "太史公曰",
      "text_snippet": "太史公曰：张季之言长者，守法不阿意；冯公之论将率，有味哉！有味哉！"
    },
    {
      "paragraph": 18,
      "primary_subject": "论赞",
      "disposition": "exclude",
      "exclude_reason": "论赞",
      "text_snippet": "语曰“不知其人，视其友”。二君之所称诵，可著廊庙。"
    }
  ]
}
