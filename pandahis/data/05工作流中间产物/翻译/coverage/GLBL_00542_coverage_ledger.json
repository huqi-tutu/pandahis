    },
    "M184": {
      "status": "conveyed",
      "claim_fp": "358d18ca11c41c6f",
      "checked_at": "2026-08-09T01:03:06.237316+00:00",
      "note": "译文包含高祖回来见信死且喜且怜，问信死何言，吕后答恨不用蒯通计，高祖称其为齐辩士，诏齐捕蒯通。"
    },
    "M185": {
