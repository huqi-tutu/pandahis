{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00260",
  "updated_at": "2026-08-09T08:20:02.767633+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "764419a17919e5ac",
      "checked_at": "2026-08-09T08:19:37.430730+00:00",
      "note": "义纵是河东人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "3e7e637f5635786b",
      "checked_at": "2026-08-09T08:19:37.430746+00:00",
      "note": "少年时，他曾和张次公一起结伙抢劫，当强盗。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "bea324192b244eb3",
      "checked_at": "2026-08-09T08:19:37.430751+00:00",
      "note": "义纵有个姐姐叫姁，靠医术得到王太后的宠幸。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "4f854b2082dc4b2e",
      "checked_at": "2026-08-09T08:19:37.430755+00:00",
      "note": "王太后问她：“你有兄弟可以当官吗？”姐姐说：“有个弟弟，但品行不好，不行。”"
    },
    "M005–M007": {
      "status": "conveyed",
      "claim_fp": "bee44b79a6cdb9fc",
      "checked_at": "2026-08-09T08:19:37.430759+00:00",
      "note": "太后便把这事告诉了皇帝，任命义姁的弟弟义纵为中郎，又补任上党郡中令。义纵治理地方敢作敢为，缺少含蓄宽容，县里没有拖欠未办的事，政绩被举为第一。后来升任长陵令和长安令，他执法行事，不回避权贵外戚。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "0799340f07b3c9ec",
      "checked_at": "2026-08-09T08:19:37.430763+00:00",
      "note": "因为逮捕审讯了太后外孙脩成君的儿子仲，皇帝认为他能干，升他为河内都尉。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "59a8011606a14909",
      "checked_at": "2026-08-09T08:19:37.430767+00:00",
      "note": "义纵一到任，就族灭了当地豪强穰氏一伙，河内郡从此路不拾遗。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "36ee7eeda7be93ac",
      "checked_at": "2026-08-09T08:19:37.430780+00:00",
      "note": "而张次公也做了郎官，凭着勇猛从军，敢于深入敌阵，立了功，被封为岸头侯。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "76b2c65d4ab8e3cf",
      "checked_at": "2026-08-09T08:19:37.430783+00:00",
      "note": "宁成在家闲居，皇帝想让他做郡守。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "c94484fe2f53d663",
      "checked_at": "2026-08-09T08:19:37.430786+00:00",
      "note": "御史大夫公孙弘说宁成治理如狼牧羊，不可让他治民。皇帝于是任命宁成为关都尉。"
    },
    "M013–M015": {
      "status": "conveyed",
      "claim_fp": "eaa474255da254d9",
      "checked_at": "2026-08-09T08:19:37.430790+00:00",
      "note": "一年多后，关东各郡国出入关的官吏都流传一句话：“宁见乳虎，无值宁成之怒”——宁愿碰见哺乳的母虎，也不愿撞上宁成发怒。义纵从河内调任南阳太守，听说宁成家住南阳，等义纵到关口时，宁成侧着身子迎送，但义纵气焰很盛，不以礼相待。到了郡里，义纵就查办宁氏，彻底击破了宁成的家。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "16706f083a72edd4",
      "checked_at": "2026-08-09T08:19:37.430793+00:00",
      "note": "宁成获罪，孔氏、暴氏之流也都逃亡了，南阳的官吏百姓吓得重足而立，不敢并脚走路。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "e5f96370137de597",
      "checked_at": "2026-08-09T08:19:37.430797+00:00",
      "note": "而平氏人朱彊、杜衍、杜周成了义纵的爪牙，被任用，升为廷史。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "2317c3896688aca1",
      "checked_at": "2026-08-09T08:19:37.430800+00:00",
      "note": "军队多次出兵定襄，定襄的官吏百姓混乱败坏，朝廷于是调义纵为定襄太守。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "0a87d863732acf30",
      "checked_at": "2026-08-09T08:19:48.614845+00:00",
      "note": "义纵到任定襄，第一件事就是突查监狱。狱中关押的重罪轻罪囚犯二百多人，私自入狱探视的宾客兄弟也有二百多人，他一股脑儿全给抓了。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "1c6e831c1a3ffa76",
      "checked_at": "2026-08-09T08:19:48.614857+00:00",
      "note": "义纵一并逮捕审讯，给他们安了个罪名，说这些人「为死罪解脱」——是替死囚开脱罪责。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "3eff1786b1203bad",
      "checked_at": "2026-08-09T08:19:48.614861+00:00",
      "note": "当天，这四百多人全部上报处死。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "d3a429c446393514",
      "checked_at": "2026-08-09T08:19:48.614864+00:00",
      "note": "这一下，定襄郡上下吓得「不寒而栗」，连平日最狡猾的刁民也乖乖配合官吏，再没人敢犯事。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "d8f1fea1b66265f7",
      "checked_at": "2026-08-09T08:19:48.614866+00:00",
      "note": "当时，赵禹、张汤已经凭着严苛位列九卿，但他们的治理还算宽缓，是依法行事；而义纵的做派，却是「鹰击毛挚」——像老鹰扑食、猛禽振翅一样，凶狠凌厉，毫不留情。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "c98f2c9c25512178",
      "checked_at": "2026-08-09T08:19:48.614869+00:00",
      "note": "后来五铢钱和白金币通行，民间奸诈之事四起，京城尤其严重，朝廷便任命义纵为右内史，王温舒为中尉，一起整治京师。"
    },
    "M025–M026": {
      "status": "conveyed",
      "claim_fp": "ee834c0eefe35486",
      "checked_at": "2026-08-09T08:19:48.614872+00:00",
      "note": "王温舒这人极其凶恶，他办事不先跟义纵打招呼，义纵便以气势压他，败坏他的功劳。义纵的治理，诛杀极多，但只算小治，奸邪之事反而越来越多，朝廷的直指使者开始出动了。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "52fd727eb2a8e23a",
      "checked_at": "2026-08-09T08:19:48.614874+00:00",
      "note": "当时官吏治民，以斩杀捆绑为能事，阎奉也因手段凶恶而被任用。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "f3f7588cf718e524",
      "checked_at": "2026-08-09T08:19:48.614877+00:00",
      "note": "义纵本人廉洁，治理效法郅都。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "6c553dd253360a7b",
      "checked_at": "2026-08-09T08:19:48.614880+00:00",
      "note": "皇帝对义纵生了气，说：「纵以我为不复行此道乎？」——你义纵以为我不会再走这条路了吗？心里记恨着他。"
    },
    "M030–M031": {
      "status": "conveyed",
      "claim_fp": "006e63657786fdcd",
      "checked_at": "2026-08-09T08:19:48.614884+00:00",
      "note": "到了冬天，杨可正受理告缗，义纵认为这是乱民之举，派吏抓捕杨可派出的使者。天子听说后，派杜式审理此案，认定义纵「废格沮事」——阻挠诏令、破坏国事，判处义纵在街市上处死。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "0071e981a3f126f5",
      "checked_at": "2026-08-09T08:19:48.614887+00:00",
      "note": "一年之后，张汤也死了。"
    }
  }
}
