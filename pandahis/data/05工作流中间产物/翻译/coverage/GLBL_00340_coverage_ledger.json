  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "272fa83e800ea1a0",
      "checked_at": "2026-08-09T02:43:58.550810+00:00",
      "note": "张禹，字子文，是河内轵县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "ed2156c517131f78",
      "checked_at": "2026-08-09T02:43:58.550821+00:00",
      "note": "到了他父亲那一辈，才把家迁到了莲勺。"
    },
    "M003–M005": {
      "status": "conveyed",
      "claim_fp": "d333234d4b17f27a",
      "checked_at": "2026-08-09T02:43:58.550825+00:00",
      "note": "张禹小时候，常常跟着家里人到集市上去，特别喜欢在算卦看相的人跟前围观。时间一长，他居然颇能明白那些辨别蓍草、布列卦象的门道，时不时还在旁边插上几句。算卦的先生很喜欢他，又觉得这孩子相貌不凡，就对张禹的父亲说：「是儿多知，可令学经。」——这孩子见识多，可以让他去学经书。等到张禹长大成人，便到长安求学，跟随沛郡的施雠学习「易」，又向琅邪的王阳、胶东的庸生请教「论语」，学得都很精通明白，有了不少门徒弟子"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "55c8f0d8cf2d5e5e",
      "checked_at": "2026-08-09T02:43:58.550829+00:00",
      "note": "甘露年间，许多儒生举荐张禹，皇帝下诏让太子太傅萧望之来考问他。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "8b526b31adaa1fc1",
      "checked_at": "2026-08-09T02:43:58.550832+00:00",
      "note": "张禹应答「易」和「论语」的大义，萧望之听了很赞赏，上奏说张禹经学精熟，有师法传承，可以试用任职。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "00a8a42cce7ef4a6",
      "checked_at": "2026-08-09T02:43:58.550835+00:00",
      "note": "可这道奏章却被压了下来，张禹只好罢官回到原来的职务。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "35d1f5ac8dc18ef8",
      "checked_at": "2026-08-09T02:43:58.550840+00:00",
      "note": "对应母本'久之，试为博士'。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "1226df3abe57f9bb",
      "checked_at": "2026-08-09T02:43:58.550851+00:00",
      "note": "对应母本'初元中，立皇太子，而博士郑宽中以《尚书》授太子，荐言禹善说《论语》'。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "159018b92e18c6c2",
      "checked_at": "2026-08-09T02:43:58.550854+00:00",
      "note": "对应母本'诏令禹授太子《论语》，由是迁光禄大夫'。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "3c1ccc4d9369b110",
      "checked_at": "2026-08-09T02:43:58.550858+00:00",
      "note": "对应母本'数岁，出为东平内史'。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "f19e4f87e3fd7fd0",
      "checked_at": "2026-08-09T02:43:58.550861+00:00",
      "note": "对应母本'拜为诸吏光禄大夫，秋中二千石，给事中，领尚书事'。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "36d58cd55edcffe6",
      "checked_at": "2026-08-09T02:43:58.550864+00:00",
      "note": "对应母本'是时，帝舅阳平侯王凤为大将军，辅政专权'。"
    },
    "M015–M018": {
      "status": "conveyed",
      "claim_fp": "34a436739f6d6dd0",
      "checked_at": "2026-08-09T02:43:58.550867+00:00",
      "note": "所有关键信息均已传达，虽未逐字对应，但事实完整。"
    },
    "M019–M020": {
      "status": "conveyed",
      "claim_fp": "3258a43dcaae1490",
      "checked_at": "2026-08-09T02:44:24.556926+00:00",
      "note": "译文详细描述了张禹为相六年，鸿嘉元年以老病乞骸骨，皇上优礼再三才允许，并赐安车驷马、黄金百斤，罢就第，以列侯朝朔望，位特进，见礼如丞相，置从事史五人，益封四百户。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "331d4b57d2cf007b",
      "checked_at": "2026-08-09T02:44:24.556939+00:00",
      "note": "译文提到“此后天子多次赏赐，前后加起来有数千万钱”，与主张一致。"
    },
    "M022–M023": {
      "status": "conveyed",
      "claim_fp": "7f8e3414b059a15e",
      "checked_at": "2026-08-09T02:44:24.556943+00:00",
      "note": "译文描述张禹为人谨慎厚道，经营家产，以田为业，富贵后多买田至四百顷，皆泾渭灌溉的良田。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "a280a34ea206a639",
      "checked_at": "2026-08-09T02:44:24.556946+00:00",
      "note": "译文有“其他财物也与此相称”，对应“它财物称是”。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "c4f52079835841fa",
      "checked_at": "2026-08-09T02:44:24.556950+00:00",
      "note": "译文提到张禹通晓音律，生活奢侈，住大宅，后堂摆弄丝竹管弦。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "efe1723eb0c1584d",
      "checked_at": "2026-08-09T02:44:24.556954+00:00",
      "note": "译文明确列出彭宣官至大司空，戴崇官至少府九卿。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "7e48dafc724c946b",
      "checked_at": "2026-08-09T02:44:24.556956+00:00",
      "note": "彭宣为人恭谨节俭、有法度，而戴崇开朗随和、多才多艺，两人品行不同。张禹心里亲近喜爱戴崇，对彭宣则敬而远之。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "ac397b33e670bc5d",
      "checked_at": "2026-08-09T02:44:24.556959+00:00",
      "note": "戴崇每次来看望老师，常常责备张禹说，应该摆酒设乐，和弟子一起娱乐。"
    },
    "M029–M030": {
      "status": "conveyed",
      "claim_fp": "abb849591441f906",
      "checked_at": "2026-08-09T02:44:24.556961+00:00",
      "note": "张禹就带戴崇进后堂饮酒吃饭，有妇女作陪，优伶奏乐，管弦铿锵，尽兴之极，直到深夜才散。而彭宣来的时候，张禹只在便坐接见他，和他讲论经义，天晚了就赐顿饭，不过一肉一酒相对而已。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "06c02fb1eac01054",
      "checked_at": "2026-08-09T02:44:24.556964+00:00",
      "note": "彭宣从来没进过张禹的后堂。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "eca1baf0ccf9d4b7",
      "checked_at": "2026-08-09T02:44:24.556966+00:00",
      "note": "后来两人都知道了对方的待遇，各自都觉得挺满意。"
    },
    "M033–M034": {
      "status": "conveyed",
      "claim_fp": "1df93f79042638b9",
      "checked_at": "2026-08-09T02:44:24.556968+00:00",
      "note": "他看中了平陵的肥牛亭那块地，觉得位置好，又靠近延陵，就上奏请求把这块地赐给自己。皇上把地赐给了他，还下诏让平陵把亭子迁到别处。曲阳侯王根听说后，出来争辩说：这块地是平陵寝庙衣冠出游的必经之路，张禹身为天子师傅，不遵谦让之礼，竟然索要衣冠出游之道，还要迁走旧亭，实在不妥。孔子说过‘赐爱其羊，我爱其礼’，应该另赐别的地给张禹。王根虽然是皇帝的舅舅，但皇上敬重他不如敬重张禹，王根的话虽然恳切，皇上还是不"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "f230e663c3a512cb",
      "checked_at": "2026-08-09T02:44:24.556971+00:00",
      "note": "译文明确表达了王根因忌恨张禹得宠而多次诋毁他，与母本信息一致。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "5596bda37251e9bd",
      "checked_at": "2026-08-09T02:44:24.556973+00:00",
      "note": "译文直接表达了天子更加敬重厚待张禹，与母本信息一致。"
    },
    "M037–M039": {
      "status": "conveyed",
      "claim_fp": "a8b8c09c6d611c98",
      "checked_at": "2026-08-09T02:44:42.895868+00:00",
      "note": "译文详细描述了张禹生病时皇上亲临探视，张禹请求将女儿调近，皇上调任萧咸为弘农太守，以及张禹小儿子被任命为黄门郎、给事中。"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "3495a15b2f13c4a5",
      "checked_at": "2026-08-09T02:44:42.895877+00:00",
      "note": "译文明确提到张禹虽闲居在家，但作为天子老师，国家大政必与其商议。"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "3179a1e1840b1307",
      "checked_at": "2026-08-09T02:44:42.895880+00:00",
      "note": "译文提到永始、元延年间日蚀地震频繁，吏民上书指责王氏专权。"
    },
    "M042–M044": {
      "status": "conveyed",
      "claim_fp": "ebc6682fb2073b99",
      "checked_at": "2026-08-09T02:44:42.895883+00:00",
      "note": "译文描述了皇上亲问张禹天变，张禹因年老子孙弱及与曲阳侯不和而有所顾虑，并引用春秋灾异之说劝皇上修政事，以经术断之，皇上因此不再怀疑王氏。"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "fa02123e9c979154",
      "checked_at": "2026-08-09T02:44:42.895887+00:00",
      "note": "译文提到后来曲阳侯王根及诸王子弟听说张禹的话后很高兴，并亲近张禹。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "5175c487580bdbd3",
      "checked_at": "2026-08-09T02:44:42.895889+00:00",
      "note": "译文描述了张禹在灾变或皇上身体不安时，择日洁斋、露蓍、正衣冠占筮，吉卦献占，不吉则忧色。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "5bbcb556fc7427ba",
      "checked_at": "2026-08-09T02:44:42.895892+00:00",
      "note": "张禹有四个儿子，长子张宏继承侯爵。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "78fb4cbf19661f60",
      "checked_at": "2026-08-09T02:44:42.895895+00:00",
      "note": "官至太常，位列九卿。"
    },
    "M049": {
      "status": "conveyed",
      "claim_fp": "fbfc971f9fda6b88",
      "checked_at": "2026-08-09T02:44:42.895897+00:00",
      "note": "其余三个弟弟都做了校尉、散骑、诸曹等官。"
    },
    "M050": {
      "status": "conveyed",
      "claim_fp": "1c3f2f2b2640afe8",
      "checked_at": "2026-08-09T02:44:42.895900+00:00",
      "note": "当初，张禹做太子的老师时，因为皇上难以频繁地当面回答经义问题，便撰写了「论语章句」献上。"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "ae70bad1b835ebdb",
      "checked_at": "2026-08-09T02:44:42.895902+00:00",
      "note": "起初，鲁地扶卿以及夏侯胜、王阳、萧望之、韦玄成等人都讲说「论语」，篇章次序各有不同。"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "0020e05d1fe3486e",
      "checked_at": "2026-08-09T02:44:42.895904+00:00",
      "note": "张禹先师从王阳，后来又师从庸生，博采众家所长，最后出书而身居尊贵之位。"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "1faeb336bc993adb",
      "checked_at": "2026-08-09T02:44:42.895907+00:00",
      "note": "准确传达了母本信息，包括诸儒之语和学者从张氏、余家寝微的结果。"
    }
  }
}
