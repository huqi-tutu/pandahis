{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00510",
  "updated_at": "2026-08-09T10:06:54.522066+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "122311cbed192393",
      "checked_at": "2026-08-09T10:06:09.423166+00:00",
      "note": "季布是楚地人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "90f069b6c08a5bcb",
      "checked_at": "2026-08-09T10:06:09.423179+00:00",
      "note": "他为人讲气性、行侠仗义，在楚地很有名气。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "059272c97c9f8e62",
      "checked_at": "2026-08-09T10:06:09.423184+00:00",
      "note": "项羽派他带兵，他多次让汉王刘邦陷入困境。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "b8a128d6136d7efc",
      "checked_at": "2026-08-09T10:06:09.423187+00:00",
      "note": "汉高祖悬赏千金捉拿季布，谁敢窝藏他，罪及三族。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "006fd7ca243d5a5d",
      "checked_at": "2026-08-09T10:06:09.423191+00:00",
      "note": "季布藏在濮阳周氏家里。"
    },
    "M006–M007": {
      "status": "conveyed",
      "claim_fp": "a64fa3d5b7ae028f",
      "checked_at": "2026-08-09T10:06:09.423195+00:00",
      "note": "周氏说...季布答应了他。周氏于是给季布剃去头发、戴上颈枷，穿上粗布褐衣，放进广柳车中，连同他家的几十个奴仆一起，运到鲁地朱家那里卖掉。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "3943e709ec8febac",
      "checked_at": "2026-08-09T10:06:09.423199+00:00",
      "note": "朱家心里知道这是季布，就买下他，安置在田庄里。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "1d5cc34d3b806bd9",
      "checked_at": "2026-08-09T10:06:09.423211+00:00",
      "note": "朱家告诫儿子说：「田里的事都听这个奴仆的，吃饭一定要和他一起吃。」朱家便乘着轻便的轺车前往洛阳，去见汝阴侯滕公。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "5726744fb71b2873",
      "checked_at": "2026-08-09T10:06:09.423215+00:00",
      "note": "滕公留朱家喝了几天酒。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "8ec9f969219ca56e",
      "checked_at": "2026-08-09T10:06:09.423218+00:00",
      "note": "朱家趁机对滕公说：「季布犯了什么大罪，皇上追捕他追得这么急？」滕公说：「季布多次替项羽让皇上受窘，皇上怨恨他，所以一定要抓到他。」朱家说：「您看季布是个什么样的人？」滕公说：「是个贤才。」朱家说：「做臣子的各为自己的主子效力，季布为项羽效力，不过是尽职罢了。项羽的臣子难道能杀尽吗？如今皇上刚得天下，仅仅因为自己的私怨追捕一个人，这向天下人显示的气量多么狭小啊！况且凭季布的贤能，汉朝追捕得这么急，他"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "a3a53c5b6cfe923c",
      "checked_at": "2026-08-09T10:06:09.423221+00:00",
      "note": "皇上于是赦免了季布。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "ff11518938f47e7e",
      "checked_at": "2026-08-09T10:06:09.423224+00:00",
      "note": "当时，各位名公都称赞季布能摧折刚强、化为柔顺，朱家也因此在当世出了名。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "f9be4093940580c1",
      "checked_at": "2026-08-09T10:06:09.423228+00:00",
      "note": "季布被召见，向皇上谢罪，皇上任命他为郎中。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "cf7ca00146aec591",
      "checked_at": "2026-08-09T10:06:09.423230+00:00",
      "note": "孝惠帝时，季布担任中郎将。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "a0dc8a1af1be3921",
      "checked_at": "2026-08-09T10:06:09.423234+00:00",
      "note": "匈奴单于曾经写信轻慢吕后，言辞不逊，吕后大怒，召集诸将商议这件事。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "d31bda250b515058",
      "checked_at": "2026-08-09T10:06:09.423238+00:00",
      "note": "上将军樊哙说：「我愿率领十万兵马，横行匈奴境内。」诸将都迎合吕后的意思，说「对」。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "34f94f9551fcb8f3",
      "checked_at": "2026-08-09T10:06:09.423241+00:00",
      "note": "季布说：「樊哙该杀！当年高帝率领四十多万兵马，还在平城被围困，如今樊哙凭什么用十万人马就能横行匈奴之中，这是当面欺君！况且秦朝因为对匈奴用兵，陈胜等人乘机起事。如今创伤还没养好，樊哙又当面阿谀，想动摇天下。」这时殿上的人都吓坏了，太后宣布退朝，于是不再商议攻打匈奴的事。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "cc0b709284c54ccd",
      "checked_at": "2026-08-09T10:06:25.051598+00:00",
      "note": "季布做了河东郡守。孝文帝的时候，有人称赞季布贤能，孝文帝便召他进京，想任命他为御史大夫。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "753baddbd9ef023d",
      "checked_at": "2026-08-09T10:06:25.051634+00:00",
      "note": "可又有人说他虽勇敢，却爱喝酒、发脾气，让人难以亲近。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "1745e95c815a633c",
      "checked_at": "2026-08-09T10:06:25.051637+00:00",
      "note": "季布到了京城，在官邸里住了一个月，被召见之后，又被打发走了。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "5aec95748464f50e",
      "checked_at": "2026-08-09T10:06:25.051640+00:00",
      "note": "季布于是进言说：“臣没有功劳，却窃取了恩宠，在河东待罪。”"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "d2ef29c3ce654727",
      "checked_at": "2026-08-09T10:06:25.051642+00:00",
      "note": "陛下无缘无故召臣进京，这一定是有人拿臣来欺骗陛下；如今臣到了京城，没有接受任何事务，就被打发回去，这一定是有人毁谤臣。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "07a3e1bac02a5884",
      "checked_at": "2026-08-09T10:06:25.051645+00:00",
      "note": "陛下因为一个人的赞誉就召见臣，又因为一个人的毁谤就赶走臣，臣担心天下有见识的人听说了，会由此窥测到陛下的深浅。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "cb15f7be9c67a61b",
      "checked_at": "2026-08-09T10:06:25.051647+00:00",
      "note": "孝文帝默然不语，面露惭愧，过了好半天才说：“河东是我的股肱之郡，所以特地召见你罢了。”季布于是辞别文帝，回到河东任上。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "57cba74338424e14",
      "checked_at": "2026-08-09T10:06:25.051650+00:00",
      "note": "楚地有个叫曹丘生的人，是个辩士，多次借重权势捞取金钱。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "9047929b26f9cf34",
      "checked_at": "2026-08-09T10:06:25.051652+00:00",
      "note": "他侍奉贵人赵同等人，与窦长君交好。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "9e66dfb139902a0c",
      "checked_at": "2026-08-09T10:06:25.051655+00:00",
      "note": "季布听说了这件事，寄了一封信劝谏窦长君说：“我听说曹丘生不是个忠厚长者，你不要和他来往。”等到曹丘生回乡，想要窦长君写封信介绍自己去见季布。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "6a8464bde733ea10",
      "checked_at": "2026-08-09T10:06:25.051657+00:00",
      "note": "窦长君说：“季将军不喜欢你，你不要去。”曹丘生坚持要信，窦长君只好写了，曹丘生便动身出发。"
    },
    "M030–M031": {
      "status": "conveyed",
      "claim_fp": "eb9b2cfe346d3942",
      "checked_at": "2026-08-09T10:06:25.051659+00:00",
      "note": "他先派人把信送去，季布果然大怒，等着曹丘生来。曹丘生到了，就对季布作揖说：“楚地有句谚语说‘得黄金百，不如得季布一诺’，您凭什么在梁、楚一带得到这样的名声呢？况且我是楚人，您也是楚人。我在天下到处宣扬您的名声，难道不重要吗？为什么您这样深地拒绝我呢！”季布于是大为高兴，把曹丘生请进来，留他住了几个月，待为上等宾客，送了他厚礼。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "10f0cc334070b4af",
      "checked_at": "2026-08-09T10:06:25.051661+00:00",
      "note": "季布的名声之所以更加显扬，正是曹丘生宣扬的结果。"
    },
    "M033–M034": {
      "status": "conveyed",
      "claim_fp": "0c90c2a6918dcbb5",
      "checked_at": "2026-08-09T10:06:25.051664+00:00",
      "note": "季布的弟弟季心，气概盖过关中，待人恭敬谨慎，行侠仗义，方圆数千里之内，士人都争着为他效死。季心曾经杀人，逃到吴地，跟随袁丝藏匿。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "b8f769eb5bcc953b",
      "checked_at": "2026-08-09T10:06:25.051666+00:00",
      "note": "他像对待兄长一样侍奉袁丝，像对待弟弟一样畜养灌夫、籍福等人。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "68b1b2e8577f02dd",
      "checked_at": "2026-08-09T10:06:25.051669+00:00",
      "note": "季心曾经担任中司马，连中尉郅都都不敢不对他以礼相待。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "d8358581ccd39a55",
      "checked_at": "2026-08-09T10:06:32.397250+00:00",
      "note": "关中一带的少年们常常偷偷借用他的名义在外行事"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "9e96038e0b5f86df",
      "checked_at": "2026-08-09T10:06:32.397258+00:00",
      "note": "季心以勇，布以诺，著闻关中——季心靠的是勇武，季布靠的是信诺，兄弟俩的名声在关中无人不晓"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "6d57543e017ad68e",
      "checked_at": "2026-08-09T10:06:32.397260+00:00",
      "note": "还有一位同母异父的弟弟叫丁公，是楚将"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "526fdabeebdcaf65",
      "checked_at": "2026-08-09T10:06:32.397263+00:00",
      "note": "当年丁公为项羽在彭城西边追击高祖，把高祖逼得走投无路，两军短兵相接，高祖情急之下回头对丁公说：「两贤岂相戹哉！」——两位豪杰何必互相为难呢？丁公听了这话，便引兵而还，汉王这才得以脱身"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "1e4a19e55cd710f7",
      "checked_at": "2026-08-09T10:06:32.397266+00:00",
      "note": "等到项羽灭亡，丁公前来谒见高祖"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "5c6e9a81860d4ce3",
      "checked_at": "2026-08-09T10:06:32.397268+00:00",
      "note": "高祖却把丁公在军中示众，说：「丁公为项王臣不忠，使项王失天下者，乃丁公也。」——丁公身为项王的臣子却不忠，让项王失去天下的，正是这个人。于是斩丁公，又说：「使后世为人臣者无效丁公！」——让后世做臣子的人，都不要效仿丁公"
    }
  }
}
