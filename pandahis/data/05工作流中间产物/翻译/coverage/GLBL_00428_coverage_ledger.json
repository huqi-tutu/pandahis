    "M099": {
      "status": "conveyed",
      "claim_fp": "49132c8a54243d50",
      "checked_at": "2026-07-28T03:32:20.092765+00:00",
      "note": "燕易王的母亲，是燕文侯的夫人，跟苏秦私通。"
    },
    "M100": {
      "status": "conveyed",
      "claim_fp": "473d318aeac4aa13",
      "checked_at": "2026-07-28T03:32:20.092767+00:00",
      "note": "燕王知道这事，却对苏秦更加优待。"
    },
    "M101": {
      "status": "conveyed",
      "claim_fp": "7114e0c01b9938cf",
      "checked_at": "2026-07-28T03:32:20.092770+00:00",
      "note": "苏秦心里害怕被杀，就游说燕王说：“我待在燕国，不能让燕国的地位变重；要是让我去齐国，燕国反而会受到重视。”燕王说：“听凭先生自己的安排。”"
    },
    "M102": {
      "status": "conveyed",
      "claim_fp": "557f051aaa2ae930",
      "checked_at": "2026-07-28T03:32:20.092773+00:00",
      "note": "于是苏秦假装在燕国犯了罪，逃跑到齐国，齐宣王让他做了客卿。"
    },
