{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00063",
  "updated_at": "2026-07-26T11:56:22.954041+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "54f07185a070913e",
      "checked_at": "2026-07-26T11:49:04.732123+00:00",
      "note": "赵盾派赵穿去周王室，把晋襄公的弟弟黑臀接了回来，立为国君，这就是晋成公。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "2013a3c5f3dbeb8e",
      "checked_at": "2026-07-26T11:49:04.732134+00:00",
      "note": "按《史记》的写法，这位成公是晋文公的小儿子，母亲是周王室的女子。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "0cb2f14da56ccafd",
      "checked_at": "2026-07-26T11:49:04.732137+00:00",
      "note": "即位后选了壬申这天，在武宫举行了朝拜典礼。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "408b074e8f9714d6",
      "checked_at": "2026-07-26T11:49:04.732140+00:00",
      "note": "成公元年，赐予赵氏公族的地位。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "cb8ac47184ca49e5",
      "checked_at": "2026-07-26T11:49:04.732143+00:00",
      "note": "这一年还去讨伐郑国，原因是郑国背叛了晋国。"
    },
    "M006–M007": {
      "status": "conveyed",
      "claim_fp": "9e8b63eeaba6a6bf",
      "checked_at": "2026-07-26T11:49:04.732145+00:00",
      "note": "成公三年，郑伯刚即位，转而依附晋国，背弃了楚国。楚国大怒，发兵攻打郑国，晋国则派兵前往救援。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "35d1755c3b623436",
      "checked_at": "2026-07-26T11:49:04.732148+00:00",
      "note": "成公六年，晋国攻打秦国，俘虏了秦将赤。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "40535a2f33513527",
      "checked_at": "2026-07-26T11:49:04.732150+00:00",
      "note": "成公七年，成公与楚庄王争夺霸权，在扈地会合诸侯。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "dfa68ff719300c83",
      "checked_at": "2026-07-26T11:49:04.732152+00:00",
      "note": "陈国害怕楚国，没来参加盟会。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "8acd63053542d2a5",
      "checked_at": "2026-07-26T11:49:04.732155+00:00",
      "note": "晋国便派中行桓子去攻打陈国，并趁势救援郑国，与楚军交战，击败了楚军。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "ee650bed4dd3df2c",
      "checked_at": "2026-07-26T11:49:04.732158+00:00",
      "note": "景公元年春天，陈国大夫夏徵舒杀了他的国君陈灵公。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "282a714d81ac1336",
      "checked_at": "2026-07-26T11:49:04.732160+00:00",
      "note": "景公二年，楚庄王出兵陈国，杀了夏徵舒。"
    },
    "M014–M015": {
      "status": "conveyed",
      "claim_fp": "e1d14167fa7c2cec",
      "checked_at": "2026-07-26T11:49:04.732163+00:00",
      "note": "景公三年，楚庄王围攻郑国，郑国向晋国告急。晋国派荀林父率领中军，随会率领上军，赵朔率领下军，郤克、栾书、先縠、韩厥、巩朔为副将。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "ad11d9d54c51255b",
      "checked_at": "2026-07-26T11:49:04.732165+00:00",
      "note": "六月，大军到了黄河边。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "37d0ff0be07b7a9f",
      "checked_at": "2026-07-26T11:49:04.732167+00:00",
      "note": "就听说楚国已经降服了郑国，…荀林父想就此回师。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "9a9b4526dca025fa",
      "checked_at": "2026-07-26T11:49:04.732169+00:00",
      "note": "先縠说：『凡来救郑，不至不可，将率离心。』…于是强行率军渡过了黄河。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "754055a88bb426f6",
      "checked_at": "2026-07-26T11:50:09.709488+00:00",
      "note": "明确提到饮马黄河"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "39901545d29f8289",
      "checked_at": "2026-07-26T11:50:09.709494+00:00",
      "note": "明确写出楚晋大战"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "3352f5af8084b1b6",
      "checked_at": "2026-07-26T11:50:09.709496+00:00",
      "note": "明确郑国倒向楚国攻打晋军"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "617e892e66502749",
      "checked_at": "2026-07-26T11:50:09.709499+00:00",
      "note": "详细描写败退争渡惨烈"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "47f87b3e625de497",
      "checked_at": "2026-07-26T11:50:09.709501+00:00",
      "note": "明确智罃被俘"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "03fc4401d2bef041",
      "checked_at": "2026-07-26T11:50:09.709503+00:00",
      "note": "完整引用原文并解释"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "1721b46caddae455",
      "checked_at": "2026-07-26T11:50:09.709505+00:00",
      "note": "完整传达了随会的劝谏和结果。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "c1f6716fd0e3090e",
      "checked_at": "2026-07-26T11:50:09.709508+00:00",
      "note": "明确提到先縠畏罪逃往翟。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "5b2281d873dd51fc",
      "checked_at": "2026-07-26T11:50:09.709510+00:00",
      "note": "明确提到先縠被灭族。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "f7b534e4ac15d318",
      "checked_at": "2026-07-26T11:50:09.709512+00:00",
      "note": "明确点明先縠与先轸的父子关系。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "c019707dd2fd0a2f",
      "checked_at": "2026-07-26T11:50:09.709514+00:00",
      "note": "明确提及伐郑报复。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "d1bd9a0df8c1b58e",
      "checked_at": "2026-07-26T11:50:09.709516+00:00",
      "note": "传达了楚庄王强势及挫晋于河上的事实。"
    },
    "M031–M032": {
      "status": "conveyed",
      "claim_fp": "8c39d46b2bf73cbe",
      "checked_at": "2026-07-26T11:50:09.709518+00:00",
      "note": "到了六年，楚伐宋，宋来告急晋，晋欲救之，伯宗谋曰：「楚，天方开之，不可当。」乃使解扬绐为救宋。……结果解扬半道经过郑国时被郑人逮住交给了楚军。楚庄王拿出厚礼收买他，让他在宋国城下喊反话，告诉宋国人晋国不会来救兵了，赶紧投降。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "ffe20dd97a90896b",
      "checked_at": "2026-07-26T11:50:09.709521+00:00",
      "note": "解扬绐许之，卒致晋君言。解扬当着楚庄王的面假意应承，可一被推到宋国城下，他扯开嗓子喊出的却是晋景公的原话——「晋国大军将至，你们务必坚守！」"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "77d3334262b9b849",
      "checked_at": "2026-07-26T11:50:09.709523+00:00",
      "note": "楚欲杀之，或谏，乃归解扬。楚庄王气得要杀解扬，旁边有人劝解说，这是个忠臣，杀了反而成全他的名声。楚王这才作罢，把解扬释放回了晋国。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "9c0ff29383faa29d",
      "checked_at": "2026-07-26T11:50:09.709525+00:00",
      "note": "到了七年，晋使随会灭赤狄。趁着楚军主力转向宋国的空档，晋国派随会率军一举灭掉了盘踞在背后的赤狄，稳住后方。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "6c66de1ccd3d819e",
      "checked_at": "2026-07-26T11:50:09.709527+00:00",
      "note": "到了八年，使郤克於齐。晋景公派大夫郤克出使齐国，想缓和一下东方的关系。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "e8424090135fff31",
      "checked_at": "2026-07-26T11:51:01.069328+00:00",
      "note": "齐顷公的母亲从楼上看到郤克的样子，竟然笑出声来"
    },
    "M038–M040": {
      "status": "conveyed",
      "claim_fp": "5a789300c326b330",
      "checked_at": "2026-07-26T11:51:01.069336+00:00",
      "note": "三个分句全部对应传达"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "a22839a99f27784d",
      "checked_at": "2026-07-26T11:51:01.069338+00:00",
      "note": "景公没有答应"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "9fe149f7f0b729d3",
      "checked_at": "2026-07-26T11:51:01.069341+00:00",
      "note": "魏文子请求退休养老，顺势把执政位子让给了郤克，于是郤克掌握了晋国大权"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "a9853f3313d98dd7",
      "checked_at": "2026-07-26T11:51:01.069344+00:00",
      "note": "后来晋国确实出兵伐齐了，齐国派太子彊到晋国做人质，晋军这才退回去"
    },
    "M044": {
      "status": "conveyed",
      "claim_fp": "eb1921f19af60ae1",
      "checked_at": "2026-07-26T11:51:01.069347+00:00",
      "note": "齐国又去攻打鲁国，夺取了隆地"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "92f350bfb05aee67",
      "checked_at": "2026-07-26T11:51:01.069350+00:00",
      "note": "鲁国向卫国告急，卫国和鲁国都通过郤克这条线向晋国求救。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "3a61ec3c9858c97f",
      "checked_at": "2026-07-26T11:51:01.069352+00:00",
      "note": "晋国便派出郤克、栾书、韩厥率领兵车八百乘，与鲁、卫两国共同讨伐齐国。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "b3dccb884205a630",
      "checked_at": "2026-07-26T11:51:01.069355+00:00",
      "note": "联军与齐顷公在鞍地开战，齐顷公受伤被困，情势十分危急。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "9e5e52b343afd525",
      "checked_at": "2026-07-26T11:51:01.069359+00:00",
      "note": "齐顷公和车右换了位置，又下车去取水喝，这才趁乱逃了出去。"
    },
    "M049": {
      "status": "conveyed",
      "claim_fp": "b0d26a509a15cd4d",
      "checked_at": "2026-07-26T11:51:01.069361+00:00",
      "note": "齐军大败而走，晋军一路向北追到了齐都。"
    },
    "M050": {
      "status": "conveyed",
      "claim_fp": "8c9654fa36a2f685",
      "checked_at": "2026-07-26T11:51:01.069364+00:00",
      "note": "顷公献出宝器请求讲和，晋军不答应。"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "ebedc24e6cda7925",
      "checked_at": "2026-07-26T11:51:01.069366+00:00",
      "note": "「郤克提出条件：『必得萧桐侄子为质。』齐国使者说：『萧桐侄子，顷公母；顷公母犹晋君母，柰何必得之？不义，请复战。』萧桐侄子是顷公的母亲，顷公的母亲就像晋国君主的母亲一样，怎么能拉去做人质呢？这不义，宁可再打一仗。晋国这才同意讲和，撤兵回去了。」"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "f92c5a78e594ff6b",
      "checked_at": "2026-07-26T11:51:01.069368+00:00",
      "note": "「这年还发生了一桩跨国私奔案。楚国申公巫臣拐走了夏姬，逃奔到晋国，晋国任命巫臣做了邢地的大夫。」"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "7bba4b95981647c9",
      "checked_at": "2026-07-26T11:51:01.069371+00:00",
      "note": "「几年后，到晋景公十二年冬天，齐顷公亲自到晋国朝见，想把晋景公尊奉为王，景公推辞不敢接受。」"
    },
    "M054": {
      "status": "conveyed",
      "claim_fp": "b62f04f0c22179dd",
      "checked_at": "2026-07-26T11:51:01.069374+00:00",
      "note": "「晋国也开始组建六军，韩厥、巩朔、赵穿、荀骓、赵括、赵旃都被拜为卿。同时有一个好消息——当年邲之战被楚军俘虏的智罃，也从楚国回来了。」"
    },
    "M055": {
      "status": "conveyed",
      "claim_fp": "ab483a02d2975dd9",
      "checked_at": "2026-07-26T11:51:43.216498+00:00",
      "note": "晋景公十三年，鲁成公来朝见，晋国却摆出一副爱搭不理的态度。...鲁成公憋着一肚子火走了，回去就跟晋国翻了脸。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "54e2b385a9104c5f",
      "checked_at": "2026-07-26T11:51:43.216507+00:00",
      "note": "这事之后，晋国出兵伐郑，拿下了氾地。"
    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "75871ff4368d1da3",
      "checked_at": "2026-07-26T11:51:43.216510+00:00",
      "note": "同一年里还出了一件怪事。有人跑去问伯宗怎么看，伯宗觉得这事儿不值得大惊小怪。"
    },
    "M058–M059": {
      "status": "conveyed",
      "claim_fp": "c9ad5a29357ac379",
      "checked_at": "2026-07-26T11:51:43.216513+00:00",
      "note": "楚国的子反跟巫臣结了仇，一怒之下灭了巫臣全族。...巫臣...让人给子反捎了一封信...「必令子罢於奔命！」...他主动请命出使吴国，让自己的儿子留在吴国做了行人这个外交官，手把手教吴国人驾战车、练兵打仗。"
    },
    "M060": {
      "status": "conveyed",
      "claim_fp": "a27f9a9e55c241c8",
      "checked_at": "2026-07-26T11:51:43.216516+00:00",
      "note": "吴国和晋国从此搭上了线，约好了联手对付楚国。"
    },
    "M061": {
      "status": "conveyed",
      "claim_fp": "849ebca69a07b084",
      "checked_at": "2026-07-26T11:51:43.216519+00:00",
      "note": "晋国诛杀赵同、赵括，灭了这两支。"
    },
    "M062": {
      "status": "conveyed",
      "claim_fp": "d9fed3f63820e5eb",
      "checked_at": "2026-07-26T11:51:43.216522+00:00",
      "note": "白话译文最后一段明确提到韩厥的话和立赵武为后、归还封邑。"
    }
  }
}
