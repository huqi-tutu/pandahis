  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "ef8ea2803c48db8c",
      "checked_at": "2026-08-09T03:20:10.999830+00:00",
      "note": "汝阴侯夏侯婴，是沛县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "7f87481f2f331f13",
      "checked_at": "2026-08-09T03:20:10.999839+00:00",
      "note": "早年在沛县当掌管马厩的官，负责驾车。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "c121a346bc1f2dc1",
      "checked_at": "2026-08-09T03:20:10.999844+00:00",
      "note": "每次送使者客人回来，路过沛县泗上亭，跟高祖刘邦聊天，一聊就是一整天，常常忘了时间。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "9fc423eeac5cf963",
      "checked_at": "2026-08-09T03:20:10.999848+00:00",
      "note": "后来夏侯婴试补为县吏，跟高祖关系十分亲密。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "8ade1b1bc1d79f5c",
      "checked_at": "2026-08-09T03:20:10.999852+00:00",
      "note": "有一次高祖开玩笑误伤了夏侯婴，有人把这事告发了。"
    },
    "M006–M007": {
      "status": "conveyed",
      "claim_fp": "8a9f5c6be27fbb0a",
      "checked_at": "2026-08-09T03:20:10.999855+00:00",
      "note": "高祖当时是亭长，伤人罪重，他申诉说本意不是伤害夏侯婴，夏侯婴也为他作证。后来案件翻覆，夏侯婴因高祖受牵连被关押了一年多，挨了几百下笞刑，最终让高祖脱了罪。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "b97f6f65c6600727",
      "checked_at": "2026-08-09T03:20:10.999860+00:00",
      "note": "高祖起初带着部属想攻打沛县时，夏侯婴以县令史的身份为高祖效力。"
    },
    "M009–M012": {
      "status": "conveyed",
      "claim_fp": "73065d63a00395db",
      "checked_at": "2026-08-09T03:20:10.999873+00:00",
      "note": "沛县投降那天，高祖成了沛公，赐夏侯婴七大夫爵位，任命他为太仆。随军攻打胡陵，夏侯婴与萧何招降了泗水监平，平献胡陵投降，夏侯婴获赐五大夫爵位。随军攻打秦军于砀东，攻济阳，下户牖，在雍丘击败李由军，因兵车急攻作战勇猛，获赐执帛爵位。常以太仆身份驾车随军攻打章邯军于东阿、濮阳下，因兵车急攻作战勇猛，击败敌军，获赐执珪爵位。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "97e92a3439dc44e3",
      "checked_at": "2026-08-09T03:20:10.999877+00:00",
      "note": "又常驾车随军攻打赵贲军于开封，杨熊军于曲遇。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "d6560b68d429d482",
      "checked_at": "2026-08-09T03:20:10.999881+00:00",
      "note": "又常驾车随军攻打秦军于雒阳东，因兵车急攻作战勇猛，获赐爵位并转封为滕公。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "0709f0f0a0878aac",
      "checked_at": "2026-08-09T03:20:10.999884+00:00",
      "note": "又驾车随军攻打南阳，在蓝田、芷阳作战，因兵车急攻作战勇猛，一路打到霸上。"
    },
    "M016–M017": {
      "status": "conveyed",
      "claim_fp": "f1c09e69f3def3d7",
      "checked_at": "2026-08-09T03:20:10.999887+00:00",
      "note": "项羽入关，灭了秦朝，立沛公为汉王。汉王赐夏侯婴列侯爵位，号昭平侯，再次任太仆，随军进入蜀、汉。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "ae4d130926f2f72e",
      "checked_at": "2026-08-09T03:20:10.999891+00:00",
      "note": "白话译文直接包含该句，信息完整传达。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "4b216a6d9ce300a6",
      "checked_at": "2026-08-09T03:20:23.678175+00:00",
      "note": "汉军一路打到了彭城，可项羽的大军在这里给了汉王狠狠一击，汉军大败。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "ca12fa20204f5e3a",
      "checked_at": "2026-08-09T03:20:23.678188+00:00",
      "note": "汉王战败，形势不利，骑马仓皇逃走。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "57016fccfc3bd84c",
      "checked_at": "2026-08-09T03:20:23.678191+00:00",
      "note": "半路上遇到了自己的儿子孝惠和女儿鲁元，夏侯婴把他们抱上车一起逃。"
    },
    "M022–M023": {
      "status": "conveyed",
      "claim_fp": "8eae868c4290b4eb",
      "checked_at": "2026-08-09T03:20:23.678195+00:00",
      "note": "汉王急了——马已经跑得疲惫不堪，追兵就在后面，他好几次把两个孩子踹下车想丢掉他们。夏侯婴每次都停车把他们捡回来，坚持载着他们走，缓缓前行，直到面朝雍树的方向才纵马奔驰。汉王气得要命，一路上十多次想杀了夏侯婴，但最终靠着夏侯婴的坚持，一行人得以脱险，把孝惠和鲁元安全送到了丰邑。"
    },
    "M024–M025": {
      "status": "conveyed",
      "claim_fp": "4183ffb655e8f413",
      "checked_at": "2026-08-09T03:20:23.678198+00:00",
      "note": "汉王到了荥阳，收拢散兵，重新振作，赐给夏侯婴祈阳的食邑。此后夏侯婴又常常驾车随汉王攻打项羽，一路追到陈地，最终平定了楚地，到了鲁地，又增加了兹氏的食邑。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "7faa43b51be4fe7c",
      "checked_at": "2026-08-09T03:20:23.678202+00:00",
      "note": "汉王登基做了皇帝。"
    },
    "M027–M028": {
      "status": "conveyed",
      "claim_fp": "1f6684fbc4348de2",
      "checked_at": "2026-08-09T03:20:23.678205+00:00",
      "note": "汉王登基做了皇帝。那年秋天，燕王臧荼反叛，夏侯婴以太仆的身份随军攻打臧荼。第二年，又随高祖到陈地，擒获了楚王韩信。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "01e1bfa15d61c039",
      "checked_at": "2026-08-09T03:20:23.678208+00:00",
      "note": "高祖改封夏侯婴的食邑为汝阴，剖符为凭，世代相传，永不断绝。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "0a67416e11c06e97",
      "checked_at": "2026-08-09T03:20:23.678211+00:00",
      "note": "随后夏侯婴以太仆身份随军攻打代地，打到武泉、云中，增加了一千户食邑。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "12cf68d254d70bf2",
      "checked_at": "2026-08-09T03:20:23.678215+00:00",
      "note": "接着又随军攻打韩信军与胡骑于晋阳旁边，大破敌军。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "1b35441065447156",
      "checked_at": "2026-08-09T03:20:23.678218+00:00",
      "note": "追击败军到平城时，被匈奴围困，七天无法通行。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "d85327a72055d2ca",
      "checked_at": "2026-08-09T03:20:23.678220+00:00",
      "note": "高祖派使者厚赠匈奴阏氏，冒顿才打开包围圈的一角。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "fa6199c2c432139c",
      "checked_at": "2026-08-09T03:20:23.678224+00:00",
      "note": "高帝出围后想快马奔驰，夏侯婴却坚持慢慢走，命令弓弩手全部拉满弓弦向外戒备，最终得以脱险。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "f090124a4ef0ddc0",
      "checked_at": "2026-08-09T03:20:23.678226+00:00",
      "note": "高祖又增加夏侯婴细阳一千户食邑。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "f6d718f395364df5",
      "checked_at": "2026-08-09T03:20:23.678229+00:00",
      "note": "夏侯婴再以太仆身份随军攻打句注北面的胡骑，大破敌军。"
    },
    "M037–M038": {
      "status": "conveyed",
      "claim_fp": "c7dba15eb68183c6",
      "checked_at": "2026-08-09T03:20:29.278140+00:00",
      "note": "译文明确提到以太仆身份攻打平城南的匈奴骑兵，三次冲入敌阵，功劳最多，赐五百户；又以太仆身份攻打陈豨、黥布军，冲入敌阵、击退敌人，增加一千户，最终食邑汝阴六千九百户，免除此前所食。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "b4b699da512251c4",
      "checked_at": "2026-08-09T03:20:29.278149+00:00",
      "note": "译文明确说刘邦去世后，夏侯婴继续以太仆的身份侍奉孝惠帝。"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "728ceefdb737e634",
      "checked_at": "2026-08-09T03:20:29.278153+00:00",
      "note": "译文明确说孝惠帝和吕后感念夏侯婴救出孝惠帝和鲁元公主，赐给他县北第一等宅第，命名为「近我」，以示尊崇。"
    }
  }
}
