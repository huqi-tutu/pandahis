{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00190",
  "updated_at": "2026-08-09T10:30:09.491469+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "f092b1d3ce8fe1f7",
      "checked_at": "2026-08-09T10:29:42.194762+00:00",
      "note": "孝元冯昭仪，是汉元帝的昭仪，也是汉平帝的祖母。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "6685f462bf79f229",
      "checked_at": "2026-08-09T10:29:42.194764+00:00",
      "note": "汉元帝即位的第二年，她被选入后宫。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "92000397d1a18128",
      "checked_at": "2026-08-09T10:29:42.194765+00:00",
      "note": "当时她的父亲冯奉世担任执金吾，负责京城治安。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "1d6ba53dfaa78370",
      "checked_at": "2026-08-09T10:29:42.194766+00:00",
      "note": "冯昭仪起初被封为长使，几个月后升为美人，五年后在馆舍生下男孩，被拜为婕妤。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "cd49881cc7830756",
      "checked_at": "2026-08-09T10:29:42.194767+00:00",
      "note": "此时冯奉世已任右将军光禄勋，长子冯野王任左冯翊，父子并居朝廷，舆论认为他们是凭才能胜任职位，并非靠女宠。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "c1ed208174d7c0c1",
      "checked_at": "2026-08-09T10:29:42.194768+00:00",
      "note": "而冯婕妤在后宫的受宠程度，与傅昭仪相当。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "739136fe1d084396",
      "checked_at": "2026-08-09T10:29:42.194769+00:00",
      "note": "建昭年间，元帝到虎圈观看斗兽，后宫妃嫔都陪坐。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "546b6838d5cf060f",
      "checked_at": "2026-08-09T10:29:42.194774+00:00",
      "note": "一只熊逃出虎圈，攀上栏杆想要爬上大殿。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "57b331e12e0e851f",
      "checked_at": "2026-08-09T10:29:42.194775+00:00",
      "note": "傅昭仪等妃嫔都惊慌逃跑，冯婕妤却径直上前挡在熊面前，左右侍卫才将熊格杀。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "22d9ebf3f83a2ad5",
      "checked_at": "2026-08-09T10:29:42.194776+00:00",
      "note": "元帝问她：「人情惊惧，何故前当熊？」冯婕妤回答：「猛兽得人而止，妾恐熊至御坐，故以身当之。」元帝感叹，因此更加敬重她。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "2c9399f0621f995e",
      "checked_at": "2026-08-09T10:29:42.194777+00:00",
      "note": "傅昭仪等人都感到惭愧。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "840a8e253fb39732",
      "checked_at": "2026-08-09T10:29:42.194778+00:00",
      "note": "第二年夏天，冯婕妤的儿子被立为信都王，冯婕妤被尊为昭仪。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "b1649121b84e54b1",
      "checked_at": "2026-08-09T10:29:42.194779+00:00",
      "note": "河平年间，冯昭仪随信都王前往封国。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "295081087c928861",
      "checked_at": "2026-08-09T10:29:42.194779+00:00",
      "note": "后来改封到中山国，这就是中山孝王。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "fa2001979f5ddf37",
      "checked_at": "2026-08-09T10:29:42.194780+00:00",
      "note": "后来定陶王被征召为太子，中山王的舅舅冯参被封为宜乡侯。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "4f60ab05fa43de47",
      "checked_at": "2026-08-09T10:29:42.194781+00:00",
      "note": "冯参，是冯太后的幼弟。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "47699732237b326d",
      "checked_at": "2026-08-09T10:29:42.194782+00:00",
      "note": "哀帝即位后，派中郎谒者张由带医生为中山小王治病。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "ad4c54aa4b587a7d",
      "checked_at": "2026-08-09T10:29:42.194783+00:00",
      "note": "张由素有狂病，病发后生气离开，西归长安。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "0be29f6a6543e51f",
      "checked_at": "2026-08-09T10:29:56.852189+00:00",
      "note": "尚书按文书责问他擅离职守之罪，张由害怕，便诬告中山太后诅咒皇帝和太后。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "df61407494739656",
      "checked_at": "2026-08-09T10:29:56.852193+00:00",
      "note": "此时的太后，正是当年的傅昭仪。她素来怨恨冯太后，便借机派御史丁玄查办此案，将中山国一百多名御者、官吏以及冯氏兄弟全部收捕，分押在雒阳、魏郡、巨鹿三地。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "a0722b741aefed20",
      "checked_at": "2026-08-09T10:29:56.852194+00:00",
      "note": "几十天过去，一无所获，朝廷又派中谒者令史立与丞相长史、大鸿胪丞共同审理。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "f86c319be3a43039",
      "checked_at": "2026-08-09T10:29:56.852196+00:00",
      "note": "史立受傅太后暗中指使，一心想着借此封侯，便严刑拷打冯太后的妹妹冯习和守寡的弟媳君之，被折磨致死的多达数十人。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "e6fa2381b4abe084",
      "checked_at": "2026-08-09T10:29:56.852197+00:00",
      "note": "巫师刘吾屈打成招，承认了诅咒之事。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "34b0c1bb84f681bb",
      "checked_at": "2026-08-09T10:29:56.852198+00:00",
      "note": "医生徐遂成又对冯习、君之说：「武帝时医修氏刺治武帝得二千万耳，今愈上，不得封侯，不如杀上，令中山王代，可得封。」——当年给武帝治病的医修氏也不过得了二千万钱，如今把皇上治好了也封不了侯，不如杀了皇上，让中山王即位，就能封侯了。史立等人据此弹劾冯太后诅咒谋反，定为大逆之罪。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "f09cef3cb2579625",
      "checked_at": "2026-08-09T10:29:56.852199+00:00",
      "note": "他们责问冯太后，冯太后拒不认罪。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "88db4d4532e3e18f",
      "checked_at": "2026-08-09T10:29:56.852201+00:00",
      "note": "史立讥讽道：「熊之上殿何其勇，今何怯也！」冯太后回头对左右说：「此乃中语，前世事，吏何用知之？是欲陷我效也！」说罢，饮药自杀。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "60b1279df46f8337",
      "checked_at": "2026-08-09T10:29:56.852202+00:00",
      "note": "冯太后未死时，有司曾请求诛杀她，哀帝不忍心处以极刑，只将她废为庶人，迁往云阳宫。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "8ac435a5e20e5642",
      "checked_at": "2026-08-09T10:29:56.852203+00:00",
      "note": "她死后，有司又上奏说：「太后死在未废前。」哀帝于是下诏，按诸侯王太后的礼仪安葬了她。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "ecfb2fab5f42f127",
      "checked_at": "2026-08-09T10:29:56.852204+00:00",
      "note": "宜乡侯冯参、君之、冯习的丈夫及儿子等连坐之人，有的自杀，有的被处死。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "dd9e490a2b2cc93b",
      "checked_at": "2026-08-09T10:29:56.852205+00:00",
      "note": "冯参的女儿冯弁是中山孝王后，生有两个女儿，有司奏请将她们免为庶人，与冯氏宗族一起迁回原郡。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "e8ff671c0cbf0be8",
      "checked_at": "2026-08-09T10:29:56.852206+00:00",
      "note": "而诬告者张由，因率先告发被赐爵关内侯；史立则升任中太仆。"
    }
  }
}
