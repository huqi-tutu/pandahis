    "M029–M030": {
      "status": "conveyed",
      "claim_fp": "a7a20e5b2014b5cc",
      "checked_at": "2026-08-09T10:32:28.901489+00:00",
      "note": "涵盖了减车驾、毋若未央宫有所发、遗赐衣服如故事、其余太迫急、竟宁前比之岂可、故时赐外家酒肉上表乃决。"
    },
