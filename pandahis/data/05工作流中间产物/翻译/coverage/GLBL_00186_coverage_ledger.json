    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "002ad5a0f082dfd0",
      "checked_at": "2026-08-09T01:25:29.227433+00:00",
      "note": "宣帝还没发迹的时候，就依靠史氏家族生活"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "d21e0a8201fe4427",
      "checked_at": "2026-08-09T01:25:29.227437+00:00",
