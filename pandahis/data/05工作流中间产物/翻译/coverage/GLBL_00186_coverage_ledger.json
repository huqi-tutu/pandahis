      "note": "史丹，字君仲，鲁国人，后来迁居到杜陵。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "0b460623b05b6743",
      "checked_at": "2026-08-09T01:25:29.227405+00:00",
      "note": "他的祖父叫史恭，史恭有个妹妹，汉武帝时做了卫太子的良娣，生下了悼皇考。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "978e3a0561e9ca73",
      "checked_at": "2026-08-09T01:25:29.227429+00:00",
