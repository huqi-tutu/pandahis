{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00519",
  "updated_at": "2026-08-09T07:19:15.620138+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "95cb813f037f35cc",
      "checked_at": "2026-08-09T07:18:50.855242+00:00",
      "note": "段会宗，字子孙，是天水郡上邽县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "3a9916341e8ff0d4",
      "checked_at": "2026-08-09T07:18:50.855251+00:00",
      "note": "竟宁年间，他从杜陵令的职位上，被丞相、御史、车骑将军、前将军、后将军五府联合举荐，出任西域都护、骑都尉、光禄大夫。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "24cdbdbb66cdfb37",
      "checked_at": "2026-08-09T07:18:50.855256+00:00",
      "note": "西域各国都敬畏他的威望与信誉。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "36bbdb29f725c0b7",
      "checked_at": "2026-08-09T07:18:50.855259+00:00",
      "note": "任职三年，任期届满归还，被任命为沛郡太守。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "e7d8d35b9121b6d6",
      "checked_at": "2026-08-09T07:18:50.855263+00:00",
      "note": "后来因为匈奴单于要入朝觐见，朝廷调他去做雁门太守。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "31fc86287049b8f0",
      "checked_at": "2026-08-09T07:18:50.855266+00:00",
      "note": "过了几年，他因犯法被免官。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "84f271a15e99a566",
      "checked_at": "2026-08-09T07:18:50.855269+00:00",
      "note": "西域各国纷纷上书，希望段会宗再去，于是在阳朔年间，他再次出任西域都护。"
    },
    "M008–M009": {
      "status": "conveyed",
      "claim_fp": "238b8728d8c3a752",
      "checked_at": "2026-08-09T07:18:50.855283+00:00",
      "note": "段会宗为人注重大节，看重功名，与谷永关系友好。谷永怜悯他年老还要远行，写信劝诫他说：“足下以柔远之令德，复典都护之重职，甚休甚休！若子之材，可优游都城而取卿相，何必勒功昆山之仄，总领百蛮，怀柔殊俗？子之所长，愚无以喻。虽然，朋友以言赠行，敢不略意。方今汉德隆盛，远人宾服，傅、郑、甘、陈之功没齿不可复见，愿吾子因循旧贯，毋求奇功，终更亟还，亦足以复雁门之踦，万里之外以身为本。愿详思愚言。”——意思是"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "611318ae6eb85a96",
      "checked_at": "2026-08-09T07:18:50.855287+00:00",
      "note": "段会宗出发之后，西域各国派子弟到郊外迎接。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "878d8ee705b01e96",
      "checked_at": "2026-08-09T07:18:50.855291+00:00",
      "note": "小昆弥安日，当年是段会宗所立，心里感激他，想去拜见，翕侯们劝阻也不听，最终还是到了龟兹拜见。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "3873999165c300c2",
      "checked_at": "2026-08-09T07:18:50.855294+00:00",
      "note": "西域城郭诸国对他非常亲近归附。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "1b0121692e68be82",
      "checked_at": "2026-08-09T07:18:50.855297+00:00",
      "note": "这时康居太子保苏匿率领一万多人想投降，段会宗上奏朝廷，汉朝派卫司马前去迎接。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "87c757db731345f3",
      "checked_at": "2026-08-09T07:18:50.855300+00:00",
      "note": "段会宗调发戊己校尉的军队跟随司马接受投降。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "3cfaac99475fab8e",
      "checked_at": "2026-08-09T07:18:50.855304+00:00",
      "note": "司马畏惧降众人多，想让他们都自缚，保苏匿心生怨恨，率众逃走了。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "fe81f591f62ffbda",
      "checked_at": "2026-08-09T07:18:50.855308+00:00",
      "note": "段会宗任期届满归还，因为擅自调发戊己校尉的军队、犯了‘乏兴’之罪，皇帝下诏允许他以钱赎罪。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "2c2289f7ba2aceee",
      "checked_at": "2026-08-09T07:18:50.855311+00:00",
      "note": "后来他被任命为金城太守，又因病免职。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "18b760087e334534",
      "checked_at": "2026-08-09T07:18:50.855314+00:00",
      "note": "一年多后，小昆弥被国民所杀，翕侯们大乱。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "0029a13c05e52507",
      "checked_at": "2026-08-09T07:19:00.836353+00:00",
      "note": "汉朝征召段会宗为左曹中郎将、光禄大夫，派他前往安抚乌孙，立小昆弥的哥哥末振将，安定其国后返回。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "5d4eb1ad5bebfe7a",
      "checked_at": "2026-08-09T07:19:00.836361+00:00",
      "note": "第二年，末振将杀了大昆弥，恰逢自己病死，汉朝遗憾未能诛杀他。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "6d33f17424576f9f",
      "checked_at": "2026-08-09T07:19:00.836365+00:00",
      "note": "元延年间，又派段会宗调发戊己校尉及诸国军队，前往诛杀末振将的太子番丘。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "d6b62516844feb59",
      "checked_at": "2026-08-09T07:19:00.836368+00:00",
      "note": "会宗担心大兵进入乌孙会惊动番丘，让他逃亡而不可得，于是将所发军队留在垫娄地，挑选精兵三十弩，径直赶到昆弥所在之处，召来番丘，责问他说：「末振将骨肉相杀，杀汉公主子孙，未伏诛而死，使者受诏诛番丘。」随即亲手用剑击杀番丘。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "1ac257b9cacb6331",
      "checked_at": "2026-08-09T07:19:00.836372+00:00",
      "note": "番丘的官属们惊恐，骑马奔回。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "972b1db55157aa13",
      "checked_at": "2026-08-09T07:19:00.836376+00:00",
      "note": "小昆弥乌犁靡是末振将兄长的儿子，勒兵数千骑围住会宗。会宗向他说明来诛之意：「今围守杀我，如取汉牛一毛耳。宛王郅支头县槁街，乌孙所知也。」昆弥以下服，说：「末振将负汉，诛其子可也，独不可告我，令饮食之邪？」会宗说：「豫告昆弥，逃匿之，为大罪。即饮食以付我，伤骨肉恩，故不先告。」昆弥以下号泣罢去。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "0b48c6c8ccc4f40d",
      "checked_at": "2026-08-09T07:19:00.836378+00:00",
      "note": "会宗回朝奏报，公卿们评议他权衡得宜，以轻兵深入乌孙，当即诛杀番丘。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "aeb123511ea3a769",
      "checked_at": "2026-08-09T07:19:00.836382+00:00",
      "note": "宣扬了国威，应当重赏。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "acdac7852a97fa1a",
      "checked_at": "2026-08-09T07:19:00.836384+00:00",
      "note": "天子赐段会宗关内侯爵位，黄金百斤。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "0d642f363f4ec014",
      "checked_at": "2026-08-09T07:19:00.836387+00:00",
      "note": "此时，小昆弥的叔父卑爰疐拥兵想害昆弥，汉朝又派段会宗去安抚，与都护孙建合力。第二年，段会宗病死在乌孙，享年七十五岁，城郭诸国为他发丧立祠。"
    },
    "M018–M019": {
      "status": "conveyed",
      "claim_fp": "9604bf453532a4dc",
      "checked_at": "2026-08-09T07:19:02.677546+00:00",
      "note": "信息完整传达，包括时间、事件、官职、任务和结果。"
    }
  }
}
