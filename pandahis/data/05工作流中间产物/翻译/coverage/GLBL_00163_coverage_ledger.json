    },
    "M069": {
      "status": "conveyed",
      "claim_fp": "e4e59eca29a21abc",
      "checked_at": "2026-08-09T01:17:12.540176+00:00",
      "note": "计谋定好就举兵西进"
    },
    "M070": {
      "status": "conveyed",
      "claim_fp": "26e2dee9ccfcc75f",
      "checked_at": "2026-08-09T01:17:12.540179+00:00",
      "note": "结果在大梁被击破，在狐父吃了败仗，一路东逃到丹徒，被越人擒获，身死国灭，为天下笑。"
