      "note": "白话译文表达了高皇帝从丰沛起兵，天下响应，与母本信息一致。"
    },
    "M065": {
      "status": "conveyed",
      "claim_fp": "b953d2069a340d42",
      "checked_at": "2026-08-09T01:17:12.540166+00:00",
      "note": "白话译文表达了趁秦之亡而动，与母本信息一致。"
    },
    "M066–M067": {
      "status": "conveyed",
      "claim_fp": "9c7034a8d06a4a6b",
      "checked_at": "2026-08-09T01:17:12.540170+00:00",
      "note": "白话译文完整包含了百姓愿望、高皇帝功绩、吴王封号、不朝、四郡、铸钱、煮盐、造船、国富民多等信息，与母本信息一致。"
    },
    "M068": {
      "status": "conveyed",
      "claim_fp": "adf822b94ba3b963",
