      "status": "conveyed",
      "claim_fp": "53e040ba9048e999",
      "checked_at": "2026-08-09T08:18:30.071634+00:00",
      "note": "直接对应。"
    },
    "M044": {
      "status": "conveyed",
      "claim_fp": "f136c9d18a03aace",
      "checked_at": "2026-08-09T08:18:30.071637+00:00",
      "note": "所有要点均已传达。"
    },
    "M045–M048": {
      "status": "conveyed",
      "claim_fp": "cf60ea32b4279f4a",
      "checked_at": "2026-08-09T08:18:30.071640+00:00",
      "note": "所有要点均已传达。"
    },
    "M049–M050": {
      "status": "conveyed",
      "claim_fp": "9c9aeceb17ff5b5e",
      "checked_at": "2026-08-09T08:18:30.071644+00:00",
      "note": "直接对应。"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "460aaf0d41a8f98b",
      "checked_at": "2026-08-09T08:18:30.071646+00:00",
      "note": "白话译文明确描述了延年出至都亭谒母，母闭阁不见。"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "da58475590166281",
      "checked_at": "2026-08-09T08:18:30.071649+00:00",
      "note": "译文完整传达了母本信息，包括延年免冠顿首、母因数责、延年服罪、自为母御归府舍。"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "e0bfb6159d3049dd",
      "checked_at": "2026-08-09T08:18:30.071652+00:00",
      "note": "译文传达了母本信息，包括母毕正腊、谓延年天道神明、人不可独杀、不意当老见壮子被刑戮、行矣去女东归、扫除墓地、遂去归郡见昆弟宗人复为言之。"
    },
    "M054": {
      "status": "conveyed",
      "claim_fp": "ba197664435c1df8",
      "checked_at": "2026-08-09T08:18:30.071654+00:00",
      "note": "译文明确表达了后岁余果败。"
    },
    "M055": {
      "status": "conveyed",
      "claim_fp": "e03eb79a2f0aca6d",
      "checked_at": "2026-08-09T08:18:34.346216+00:00",
      "note": "直接传达了东海之人皆贤知其母的信息。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "0d96f621fd18262e",
      "checked_at": "2026-08-09T08:18:34.346237+00:00",
      "note": "明确传达了兄弟五人皆有吏材至大官，以及东海号曰万石严妪。"
    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "641b8a7f62c2370c",
      "checked_at": "2026-08-09T08:18:34.346242+00:00",
      "note": "明确传达了次弟彭祖至太子太傅，且在儒林传。"
    }
  }
