    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "97b6b7b18bebe713",
      "checked_at": "2026-08-09T10:28:05.580665+00:00",
      "note": "传达了公孙弘为御史大夫、筑朔方、言西南夷害、可且罢、专力事匈奴等信息。"
    },
    "M033": {
