  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "85eb6f9ede54c08c",
      "checked_at": "2026-08-09T10:42:17.261793+00:00",
      "note": "开篇点明汉武帝宠臣中士人出身的是韩王孙韩嫣，宦官出身的是李延年。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "aec2ffda47b8a912",
      "checked_at": "2026-08-09T10:42:17.261804+00:00",
      "note": "韩嫣是弓高侯的庶孙，即非嫡系所出。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "31ee96ec36aba4f5",
      "checked_at": "2026-08-09T10:42:17.261807+00:00",
      "note": "武帝为胶东王时，韩嫣陪他学书法，关系亲密。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "40856f4bb2d8c151",
      "checked_at": "2026-08-09T10:42:17.261811+00:00",
      "note": "武帝被立为太子后，对韩嫣更加亲近。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "c18c0531fcd09415",
      "checked_at": "2026-08-09T10:42:17.261815+00:00",
      "note": "韩嫣擅长骑马射箭，善于谄媚逢迎。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "21791d61463d849e",
      "checked_at": "2026-08-09T10:42:17.261818+00:00",
      "note": "武帝即位后想讨伐匈奴，韩嫣学习胡人兵法，官至上大夫，赏赐可比邓通。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "930ff2af4789620d",
      "checked_at": "2026-08-09T10:42:17.261821+00:00",
      "note": "他常常与皇帝同卧同起，几乎形影不离。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "c51190f51a7e11c9",
      "checked_at": "2026-08-09T10:42:17.261831+00:00",
      "note": "有一次，江都王入朝觐见，得到诏令可以跟随皇帝到上林苑打猎。"
    },
    "M009–M010": {
      "status": "conveyed",
      "claim_fp": "247a6ff797713695",
      "checked_at": "2026-08-09T10:42:17.261834+00:00",
      "note": "那天，天子的车驾还在清道戒严，尚未出发，武帝先派韩嫣乘坐副车，带着数十上百名骑兵，一路奔驰去查看野兽的踪迹。江都王远远望见这副排场，以为是天子车驾到了，连忙让随从退避，自己伏在道旁恭恭敬敬地拜见。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "045b2a69a293f467",
      "checked_at": "2026-08-09T10:42:17.261837+00:00",
      "note": "谁知韩嫣驱车经过，连看都没看他一眼，径直扬长而去。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "a1a3dde2cf513556",
      "checked_at": "2026-08-09T10:42:17.261840+00:00",
      "note": "车驾过去之后，江都王又羞又怒，跑到皇太后面前哭诉，说：“请准许我回到封国，入宫担任宿卫，地位与韩嫣一样。”"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "24e84f1b28d5efb0",
      "checked_at": "2026-08-09T10:42:17.261843+00:00",
      "note": "皇太后听了这番话，心里便对韩嫣记下了一笔怨恨。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "608f57431ae5ed23",
      "checked_at": "2026-08-09T10:42:17.261846+00:00",
      "note": "他侍奉武帝，出入后宫永巷毫无禁忌，与后宫有奸情的传闻渐渐传到皇太后耳中。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "43ee8a6eb4a3dcbb",
      "checked_at": "2026-08-09T10:42:17.261848+00:00",
      "note": "太后本就对他心存芥蒂，这下更是怒不可遏，直接派使者赐韩嫣死。"
    },
    "M016–M017": {
      "status": "conveyed",
      "claim_fp": "ef6e1296b6bab2a3",
      "checked_at": "2026-08-09T10:42:17.261851+00:00",
      "note": "武帝得知后，亲自替韩嫣求情谢罪，但太后态度坚决，终究没能挽回。韩嫣就这样死了。他的弟弟案道侯韩说，同样靠着谄媚得宠，在武帝朝中也是一号人物。"
    }
  }
}
