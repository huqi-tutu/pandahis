    "M055": {
      "status": "conveyed",
      "claim_fp": "ff9caae653650925",
      "checked_at": "2026-07-28T01:04:26.730023+00:00",
      "note": "原来那些大夫全都成了新王的臣子，肥义被任命为相国，同时担任新王的师傅。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "ba017faad0765626",
      "checked_at": "2026-07-28T01:04:26.730032+00:00",
