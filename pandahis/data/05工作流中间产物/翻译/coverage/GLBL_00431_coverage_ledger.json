      "note": "译文完整呈现高帝话语。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "36187bb3fe6354dc",
      "checked_at": "2026-08-08T15:25:18.782917+00:00",
      "note": "译文完整呈现对话及萧何态度。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "45aec475dfd9fad1",
      "checked_at": "2026-08-08T15:25:18.782918+00:00",
      "note": "译文明确表达置田宅必居穷处、不治垣屋。"
    },
