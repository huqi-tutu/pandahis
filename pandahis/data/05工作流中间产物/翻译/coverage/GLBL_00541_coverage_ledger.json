  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "08ef8d66ed84d955",
      "checked_at": "2026-08-09T10:22:24.378930+00:00",
      "note": "他最初以中涓的身份随从刘邦，在宛朐起事。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "00597a529c0b2195",
      "checked_at": "2026-08-09T10:22:24.378940+00:00",
      "note": "他先攻打了济阳"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "7ca992546a455bb8",
      "checked_at": "2026-08-09T10:22:24.378943+00:00",
      "note": "又击败了秦将李由的军队"
    },
    "M004–M005": {
      "status": "conveyed",
      "claim_fp": "2df79d5e11d9bd27",
      "checked_at": "2026-08-09T10:22:24.378947+00:00",
      "note": "在亳南、开封东北一带攻击秦军时，他斩杀了骑千人将一人，斩首五十七级，俘虏七十三人，因此获赐爵位，封号为临平君。此后又在蓝田北作战，斩杀车司马二人、骑长一人，斩首二十八级，俘虏五十七人。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "4347209f7205adbf",
      "checked_at": "2026-08-09T10:22:24.378950+00:00",
      "note": "一路打到霸上。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "c6ef4fa025fb3ae7",
      "checked_at": "2026-08-09T10:22:24.378953+00:00",
      "note": "后来沛公被立为汉王，赐给靳歙建武侯的爵位，升任他为骑都尉。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "8cfaa12104beaa1f",
      "checked_at": "2026-08-09T10:22:24.378956+00:00",
      "note": "靳歙跟随汉王平定三秦"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "ba9614a652042a1f",
      "checked_at": "2026-08-09T10:22:24.378966+00:00",
      "note": "又随军东进攻打楚军，一直打到彭城"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "1f57d8f2626097da",
      "checked_at": "2026-08-09T10:22:24.378969+00:00",
      "note": "汉军在彭城大败而回，退守雍丘，随后又去攻打反叛的王武等人"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "f9b4eb9ff04b52c5",
      "checked_at": "2026-08-09T10:22:24.378972+00:00",
      "note": "在荥阳东击败了楚军"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "d04045adea305fc6",
      "checked_at": "2026-08-09T10:22:24.378975+00:00",
      "note": "汉三年，获赐食邑四千二百户"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "1fd073be1840be45",
      "checked_at": "2026-08-09T10:22:24.378978+00:00",
      "note": "此后靳歙随军攻打安阳以东，到达棘蒲，攻下七县"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "af4916d67625c474",
      "checked_at": "2026-08-09T10:22:24.378981+00:00",
      "note": "又随军攻下邯郸。"
    },
    "M015–M016": {
      "status": "conveyed",
      "claim_fp": "1ca62dc0cfac57a3",
      "checked_at": "2026-08-09T10:22:24.378983+00:00",
      "note": "接着攻打朝歌、邯郸，并另率一军击败赵军，降服了邯郸郡六县。回军敖仓后，在成皋南击败项羽军队，切断了楚军粮道，从荥阳一直到襄邑。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "0638741f6377c1b6",
      "checked_at": "2026-08-09T10:22:24.378986+00:00",
      "note": "又在鲁地击败项冠的军队。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "bcc6f6dde01c70cc",
      "checked_at": "2026-08-09T10:22:24.378988+00:00",
      "note": "攻占地盘，东到缯、郯、下邳，南到蕲、竹邑。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "1d5335f46a1f5104",
      "checked_at": "2026-08-09T10:22:37.306013+00:00",
      "note": "在济阳城下，靳歙又击败了项羽的部将项悍。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "ae8945e9e3451abc",
      "checked_at": "2026-08-09T10:22:37.306021+00:00",
      "note": "随后回师陈地，与项羽主力交战，再次大破楚军。"
    },
    "M021–M022": {
      "status": "conveyed",
      "claim_fp": "37dea67507fae649",
      "checked_at": "2026-08-09T10:22:37.306024+00:00",
      "note": "接着他另率一军平定江陵，江陵的柱国、大司马以下八人先后投降，靳歙亲手擒获了江陵王，把他活着押送到雒阳，南郡也因此平定。之后靳歙随刘邦到陈地，参与擒拿楚王韩信，刘邦剖符为信，许诺爵位世代相传、永不断绝，定食邑四千六百户，封号信武侯。"
    },
    "M023–M024": {
      "status": "conveyed",
      "claim_fp": "c756ebbd5170dca0",
      "checked_at": "2026-08-09T10:22:37.306028+00:00",
      "note": "后来，靳歙以骑都尉的身份随军攻打代地，在平城城下与韩王信交战，回师驻守东垣。因战功升任车骑将军，统领梁、赵、齐、燕、楚五国的车骑部队，另率军进击陈豨的丞相侯敞，将其击败，顺势降服了曲逆。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "b9da793ab96da31b",
      "checked_at": "2026-08-09T10:22:37.306031+00:00",
      "note": "此后又随刘邦征讨黥布，再立战功，增封食邑，定食五千三百户。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "c76bb6893b8fdf18",
      "checked_at": "2026-08-09T10:22:37.306035+00:00",
      "note": "纵观靳歙一生征战：总计斩首九十级，俘虏一百三十二人；另破敌军十四支，降城五十九座，平定郡、国各一个，县二十三个；擒获王、柱国各一人，二千石以下至五百石的官员三十九人。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "8a26316ea8b8846c",
      "checked_at": "2026-08-09T10:22:37.306038+00:00",
      "note": "高后五年，靳歙去世，谥号为肃侯。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "385c488991efb744",
      "checked_at": "2026-08-09T10:22:37.306041+00:00",
      "note": "儿子靳亭继承侯位。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "da9c8380a35bddca",
      "checked_at": "2026-08-09T10:22:37.306044+00:00",
      "note": "二十一年后，靳亭因役使封国百姓超过律令规定，在孝文帝后元三年被夺去侯爵，封国废除。"
    }
  }
}
