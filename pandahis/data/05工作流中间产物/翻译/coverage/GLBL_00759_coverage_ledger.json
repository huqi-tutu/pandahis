  "updated_at": "2026-08-05T18:13:14.351585+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "2f8f64edfce6fd80",
      "checked_at": "2026-07-26T17:07:07.458987+00:00",
      "note": "庆父连杀子般和鲁闵公之后，自己也慌了。他怕季友回来找他算账，赶紧逃到了莒国。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "de7f0afa6140ce85",
      "checked_at": "2026-07-26T17:07:07.458997+00:00",
      "note": "季友在陈国的帮助下，护送子申从陈国回到鲁国，拥立他为国君。子申，就是鲁釐公。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "a73f1fba835c29da",
      "checked_at": "2026-07-26T17:07:07.459000+00:00",
      "note": "这里有个细节，釐公亦庄公少子，他跟之前被庆父杀掉的那两位一样，都是鲁庄公的儿子。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "3eab1d7e984393f3",
      "checked_at": "2026-07-26T17:07:07.459003+00:00",
      "note": "庆父跑了，他的同谋哀姜也坐不住了。《史记》的记载很简短：哀姜恐，奔邾。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "1fe82e0b53fa2e5a",
      "checked_at": "2026-07-26T17:07:07.459005+00:00",
      "note": "季友以赂如莒求庆父，庆父归，使人杀庆父，庆父请奔，弗听，乃使大夫奚斯行哭而往。季友派人带着财物去莒国，要求莒国把庆父交出来。莒国收了贿赂，把庆父遣返回鲁国。庆父一回来，季友就派人去杀他。庆父请求让自己流亡国外，季友不答应。于是，季友派了一个叫奚斯的大夫，哭着去见庆父。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "d1830b8a78e74c78",
      "checked_at": "2026-07-26T17:07:07.459008+00:00",
      "note": "庆父听懂了。庆父闻奚斯音，乃自杀。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "4922987b5757e636",
      "checked_at": "2026-07-26T17:07:07.459010+00:00",
      "note": "齐桓公作为当时的霸主，听说哀姜和庆父的乱伦丑闻差点毁了鲁国，出面来收拾局面。他把哀姜从邾国召回，直接处死，然后把尸体运回鲁国，公开陈尸示众。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "ffb178d1aa109e8e",
      "checked_at": "2026-07-26T17:07:07.459013+00:00",
      "note": "鲁釐公还是尽了一份人子的心。《史记》写鲁釐公请而葬之。哀姜毕竟是他的嫡母，尽管她参与了庆父的阴谋，釐公还是向齐国请求，把哀姜安葬了。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "61e42f5f43c1f4eb",
      "checked_at": "2026-07-26T17:07:07.459016+00:00",
      "note": "季友的母亲是陈国的女子，所以他当初流亡的时候去了陈国。这也是为什么陈国会出兵帮忙，护送季友和子申回鲁国即位。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "d3db9a645300f2c6",
      "checked_at": "2026-07-26T17:07:07.459018+00:00",
      "note": "季友快出生的时候，他父亲鲁桓公派人占卜。卜辞说：是个男孩，名字叫“友”；他将来会站在两社之间，成为公室的辅佐大臣；如果季友哪天不在了，鲁国也就衰落了。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "4fbd670e111dfbd2",
      "checked_at": "2026-07-26T17:07:07.459021+00:00",
      "note": "季友出生时，手掌上竟然有一个“友”字形状的纹路——跟占卜的结果完全吻合。于是就给他起名叫“友”，号称成季。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "b52da423ad7b6341",
      "checked_at": "2026-07-26T17:07:07.459048+00:00",
      "note": "季友的后代，就是后来鲁国的季氏；庆父虽然被杀了，他的后代却留了下来，成为孟氏。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "0e252c9d88a69c74",
      "checked_at": "2026-07-26T17:07:07.459051+00:00",
      "note": "釐公元年，以汶阳鄪封季友。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "cbf912d1883b083d",
      "checked_at": "2026-07-26T17:07:07.459054+00:00",
      "note": "季友为相——季友从此执掌鲁国的国政。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "6ef05e5df051a10a",
      "checked_at": "2026-07-26T17:07:07.459064+00:00",
      "note": "九年，晋里克杀其君奚齐、卓子。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "1f3d613c81cacf0d",
      "checked_at": "2026-07-26T17:07:07.459067+00:00",
      "note": "齐桓公率釐公讨晋乱，至高梁而还，立晋惠公。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "efc3f64b1fa4d234",
      "checked_at": "2026-07-26T17:07:07.459069+00:00",
      "note": "二十四年，晋文公即位。"
    }
  }
}
