  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "463dcf13cc61e905",
      "checked_at": "2026-08-08T14:52:54.089995+00:00",
      "note": "燕王刘泽，论辈分只是刘氏宗族里的远支亲属，跟高祖刘邦的血缘已经隔得很远了。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "5cdde2a09d91f2d5",
      "checked_at": "2026-08-08T14:52:54.090006+00:00",
      "note": "高帝三年（前204年），刘泽做了郎中"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "b9e37726760fb160",
      "checked_at": "2026-08-08T14:52:54.090008+00:00",
      "note": "高帝十一年（前196年），刘泽以将军的身份率军攻打叛将陈豨，一战俘获了陈豨的部将王黄，立下军功，被封为营陵侯。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "3fb69761e6f69bb2",
      "checked_at": "2026-08-08T14:52:54.090010+00:00",
      "note": "高后（吕后）当政的时候，齐国有个叫田生的人，四处游历却缺少盘缠，便凭着画策求见营陵侯刘泽。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "c460fc53453c6eb4",
      "checked_at": "2026-08-08T14:52:54.090011+00:00",
      "note": "刘泽见了大为高兴，出手就是二百斤黄金，送给田生作寿礼。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "d7fda64bab819e84",
      "checked_at": "2026-08-08T14:52:54.090012+00:00",
      "note": "田生拿到金子，二话不说，转身就回了齐国。"
    },
    "M007–M008": {
      "status": "conveyed",
      "claim_fp": "c812ab851cd266b9",
      "checked_at": "2026-08-08T14:52:54.090014+00:00",
      "note": "信息完整传达，包括时间、人物、事件。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "c774e60f47ba3e41",
      "checked_at": "2026-08-08T14:52:54.090021+00:00",
      "note": "白话译文明确说：张卿答应了。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "195e245ab08590c4",
      "checked_at": "2026-08-08T14:52:54.090023+00:00",
      "note": "白话译文描述：田生把帷帐器物布置得华丽非凡，排场简直跟列侯一个档次。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "6b1af70804408d3f",
      "checked_at": "2026-08-08T14:52:54.090025+00:00",
      "note": "白话译文说：张卿一看，吃了一惊。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "1449a0f4921f9365",
      "checked_at": "2026-08-08T14:52:54.090026+00:00",
      "note": "白话译文详细转述了田生对张卿说的话，包括观察诸侯王邸宅、吕氏功劳、太后想立吕产为王等。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "e5c1ba5427acee34",
      "checked_at": "2026-08-08T14:52:54.090027+00:00",
      "note": "白话译文提到：太后又怕这事太冒失，担心大臣们不答应。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "5fbc4e7526936ab9",
      "checked_at": "2026-08-08T14:52:54.090029+00:00",
      "note": "田生对张卿说：'你张卿是太后跟前最得宠的人，大臣们也敬你三分，何不先给大臣们透个风，让他们去跟太后提？太后一高兴，这事就成了。'"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "467beb44cc6542fc",
      "checked_at": "2026-08-08T14:52:54.090030+00:00",
      "note": "田生又说：'等吕家的人封了王，一个万户侯的封赏，也少不了你张卿的。'"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "192110d1f3523a46",
      "checked_at": "2026-08-08T14:52:54.090031+00:00",
      "note": "田生最后点了一句：'太后心里早就有这个打算，你张卿是内臣，要是迟迟不张罗，等太后自己开口，恐怕祸事就要落到你头上了。'"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "e394ec8c4a665ac0",
      "checked_at": "2026-08-08T14:52:54.090032+00:00",
      "note": "张卿觉得这话句句在理，连连点头，便去给大臣们透风，让他们把话递到太后那儿。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "c856b5a4feec5959",
      "checked_at": "2026-08-08T14:52:54.090033+00:00",
      "note": "太后上朝的时候，顺势问起大臣们的意见。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "5b49190081dacb10",
      "checked_at": "2026-08-08T14:53:06.405899+00:00",
      "note": "大臣们顺着太后的意思，请求立吕产为吕王。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "ce6ad90a92d47b91",
      "checked_at": "2026-08-08T14:53:06.405905+00:00",
      "note": "太后高兴，赐给张卿千斤金，张卿把一半分给了田生。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "14060b720754b5b2",
      "checked_at": "2026-08-08T14:53:06.405908+00:00",
      "note": "田生不肯接受，趁机对张卿说：「吕产封了王，大臣们未必心服。如今营陵侯刘泽，是刘氏一族，身为大将军，只有他还在不满。您去跟太后说，划出十几个县封他为王，他得了王位，高兴地离开，吕氏诸王的地位就更稳固了。」张卿进宫禀报，太后同意了。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "23783fd286bcb7dc",
      "checked_at": "2026-08-08T14:53:06.405910+00:00",
      "note": "于是封营陵侯刘泽为琅邪王。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "37cbdea485e5e0b3",
      "checked_at": "2026-08-08T14:53:06.405912+00:00",
      "note": "琅邪王便与田生一同前往封国。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "aa8d7ee88d5c7c42",
      "checked_at": "2026-08-08T14:53:06.405915+00:00",
      "note": "田生劝刘泽赶快赶路，不要停留。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "506ce1969474846e",
      "checked_at": "2026-08-08T14:53:06.405917+00:00",
      "note": "出了函谷关，太后果然派人追赶阻止，但刘泽已经出关，追的人就回去了。"
    },
    "M026–M027": {
      "status": "conveyed",
      "claim_fp": "17399329aa5a6138",
      "checked_at": "2026-08-08T14:53:06.405920+00:00",
      "note": "等到太后去世，琅邪王刘泽说：'皇帝年幼，吕氏掌权，刘氏势单力薄。'于是领兵与齐王合谋西进，想要诛灭吕氏。到达梁地，听说汉朝派灌将军驻守荥阳，刘泽回兵防备西界，然后独自轻骑疾驰到长安。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "3b369ba395a9081e",
      "checked_at": "2026-08-08T14:53:06.405922+00:00",
      "note": "代王也从代地来到长安。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "e564ffe4e5b85df6",
      "checked_at": "2026-08-08T14:53:06.405924+00:00",
      "note": "众将相与琅邪王共同拥立代王为天子。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "f6ecf6f6c16fdb42",
      "checked_at": "2026-08-08T14:53:06.405926+00:00",
      "note": "天子于是改封刘泽为燕王，又把琅邪还给齐国，恢复原有土地。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "ae802e68f8cd18a0",
      "checked_at": "2026-08-08T14:53:06.405929+00:00",
      "note": "刘泽在燕王位两年后去世，谥号为敬王。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "6154098dc2c36d19",
      "checked_at": "2026-08-08T14:53:06.405931+00:00",
      "note": "白话译文明确提及王位传给儿子刘嘉，即康王，与主张一致。"
    }
  }
}
