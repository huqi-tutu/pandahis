{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00212",
  "updated_at": "2026-08-09T06:41:21.038386+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "22e507f152378100",
      "checked_at": "2026-08-08T15:03:34.454330+00:00",
      "note": "薄姬是高祖刘邦的妃子，也是汉文帝刘恒的母亲。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "4fcd1e4d8d1aa2de",
      "checked_at": "2026-08-08T15:03:34.454333+00:00",
      "note": "她的父亲是吴地人，秦朝时与从前魏王宗室的女子魏媪私通，生下了薄姬。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "a5ef8a40b968f0e1",
      "checked_at": "2026-08-08T15:03:34.454334+00:00",
      "note": "薄姬的父亲死在会稽山阴县，就葬在了那里。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "c7048e1fddaf4493",
      "checked_at": "2026-08-08T15:03:34.454335+00:00",
      "note": "等到诸侯纷纷反叛秦朝，魏豹自立为王，魏媪便把女儿薄姬送进了魏王宫中。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "763a883ca12b021e",
      "checked_at": "2026-08-08T15:03:34.454337+00:00",
      "note": "相士许负为薄姬看相，说她将来会生下天子。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "6685fef93e7270de",
      "checked_at": "2026-08-08T15:03:34.454351+00:00",
      "note": "当时，项羽正与汉王刘邦在荥阳对峙，天下局势尚未分明。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "18f20ae3d3a088e9",
      "checked_at": "2026-08-08T15:03:34.454352+00:00",
      "note": "魏豹起初与汉军一起攻打楚军，等听到许负的话后，心中暗喜，于是背叛汉朝保持中立，又与楚军联合。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "4c25acfa22d39965",
      "checked_at": "2026-08-08T15:03:34.454358+00:00",
      "note": "汉王派曹参等人俘虏了魏王豹，把他的封国设为郡，薄姬也被送入织室。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "60fbc318e0d3b75e",
      "checked_at": "2026-08-08T15:03:34.454359+00:00",
      "note": "魏豹死后，汉王到织室见到薄姬，下诏将她纳入后宫，但一年多没有得到宠幸。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "e397087dd3778ea3",
      "checked_at": "2026-08-08T15:03:34.454360+00:00",
      "note": "当初薄姬年少时，与管夫人、赵子儿关系亲密，三人约定说：「先贵毋相忘！」——谁先富贵了，不要忘记彼此。后来管夫人、赵子儿先被汉王宠幸。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "52be859478506c40",
      "checked_at": "2026-08-08T15:03:34.454361+00:00",
      "note": "汉王四年，刘邦在河南成皋的灵台，两位美人侍奉在旁，一起嘲笑薄姬当初的约定。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "b2af5f629717cec4",
      "checked_at": "2026-08-08T15:03:34.454362+00:00",
      "note": "汉王问她们笑什么，两人如实相告。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "af345fd7be223ebc",
      "checked_at": "2026-08-08T15:03:34.454364+00:00",
      "note": "汉王听后心中凄然，怜悯薄姬，当天就召见她，想要宠幸她。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "296c36d5ea9d2194",
      "checked_at": "2026-08-08T15:03:34.454365+00:00",
      "note": "薄姬回答说：「昨暮梦龙据妾胸。」汉王说：「是贵征也，吾为汝成之。」于是宠幸了她，薄姬便有了身孕。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "56f6c6b3442c0f06",
      "checked_at": "2026-08-08T15:03:34.454366+00:00",
      "note": "当年生下汉文帝刘恒，八岁时被封为代王。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "aa5edfa5c116e12e",
      "checked_at": "2026-08-08T15:03:34.454367+00:00",
      "note": "自从有了儿子后，薄姬很少见到汉王。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "5874d14f4cce8ec2",
      "checked_at": "2026-08-08T15:03:34.454368+00:00",
      "note": "而薄姬正因为很少被宠幸的缘故，得以出宫跟随儿子到代国，成为代太后。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "6b586adb94c36d8e",
      "checked_at": "2026-08-08T15:03:34.454369+00:00",
      "note": "太后的弟弟薄昭也跟随她到了代国。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "adf9d7812c227c33",
      "checked_at": "2026-08-08T15:03:40.487001+00:00",
      "note": "大臣们商议立皇帝的事，痛恨吕氏外戚的强横暴虐，都称赞薄氏仁厚善良，于是迎立代王为皇帝，尊薄太后为皇太后，封她的弟弟薄昭为轵侯。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "6c4cdb709fd11416",
      "checked_at": "2026-08-08T15:03:40.487012+00:00",
      "note": "太后的母亲此前已经去世，葬在栎阳北边。于是追尊太后父亲为灵文侯，在会稽郡设置园邑三百户，派长丞以下的官员守护陵寝宗庙，按礼法供奉祭祀。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "fcc1d2fdd4f9f2ec",
      "checked_at": "2026-08-08T15:03:40.487015+00:00",
      "note": "在栎阳也为太后母亲设置了灵文夫人园，规格与灵文侯园相同。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "45959814b20bc136",
      "checked_at": "2026-08-08T15:03:40.487018+00:00",
      "note": "太后早年丧父，魏氏家族对她有养育之恩，于是召见并恢复魏氏家族的地位，按亲疏关系分别赏赐。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "b83d446d368f2231",
      "checked_at": "2026-08-08T15:03:40.487021+00:00",
      "note": "薄氏家族中封侯的有一人。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "dc52bd359f785989",
      "checked_at": "2026-08-08T15:03:40.487024+00:00",
      "note": "因为吕后没有与高祖合葬在长陵，所以薄太后特意为自己修建陵墓，靠近文帝的霸陵。"
    }
  }
}
