    },
    "M107": {
      "status": "conveyed",
      "claim_fp": "95dc5d135b054a48",
      "checked_at": "2026-07-26T11:45:17.051614+00:00",
      "note": "卫侯被安置在襄牛"
    },
    "M108": {
      "status": "conveyed",
      "claim_fp": "2ce559968df23a4d",
      "checked_at": "2026-07-26T11:45:17.051616+00:00",
