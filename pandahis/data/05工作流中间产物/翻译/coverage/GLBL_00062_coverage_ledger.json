    },
    "M077": {
      "status": "conveyed",
      "claim_fp": "ad3fd98de1a02e6d",
      "checked_at": "2026-07-26T11:42:04.934470+00:00",
      "note": "履鞮...打听到了吕、郤的阴谋，便想去见文公告密"
    },
    "M078": {
      "status": "conveyed",
      "claim_fp": "20e1570a30d7b910",
      "checked_at": "2026-07-26T11:42:04.934473+00:00",
      "note": "文公不肯见他，派人去数落他...文公于是接见了他，履鞮便将吕省、郤芮等人的密谋一五一十地告发了。"
    },
    "M079–M081": {
      "status": "conveyed",
      "claim_fp": "289416aef590092d",
      "checked_at": "2026-07-26T11:42:04.934475+00:00",
      "note": "完整覆盖了欲召吕郤、党多恐卖、微行会秦、国人莫知、三月己丑反、焚宫不得、卫徒与战、吕郤欲奔、秦诱杀河上、晋复文公归。"
    },
    "M082": {
      "status": "conveyed",
