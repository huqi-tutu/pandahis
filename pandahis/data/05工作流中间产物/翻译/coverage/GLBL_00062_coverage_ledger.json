    },
    "M105": {
      "status": "conveyed",
      "claim_fp": "b567fe7d32a4d4ed",
      "checked_at": "2026-07-26T11:45:17.051609+00:00",
      "note": "卫侯见晋军势大，派人请求与晋国会盟，晋人不许。"
    },
    "M106": {
      "status": "conveyed",
      "claim_fp": "6194a217a86c5fb3",
      "checked_at": "2026-07-26T11:45:17.051612+00:00",
