    "M013–M014": {
      "status": "conveyed",
      "claim_fp": "0d1290a6c635fadd",
      "checked_at": "2026-07-28T00:33:37.219454+00:00",
      "note": "五年，魏王亲自来应亭朝见秦王，秦国又把蒲阪还给了魏国。六年，蜀地出事了——蜀侯名叫煇的举兵造反。秦国立刻派出了最能打的司马错前往平叛，迅速把蜀地定了下来。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "7701a0dedc7c0447",
      "checked_at": "2026-08-05T15:08:47.887833+00:00",
