    },
    "M076–M077": {
      "status": "conveyed",
      "claim_fp": "387a89c1f1a82595",
      "checked_at": "2026-07-28T00:39:12.376970+00:00",
      "note": "译为“蜀地的郡守名叫若，也奉命去讨伐楚国，夺取了巫郡，又沿着长江南下，把江南一带纳入版图，设为黔中郡。三十一年，白起转回头去打魏国，攻占了两座城。”"
    },
    "M078": {
      "status": "conveyed",
      "claim_fp": "a553e66adbca0420",
      "checked_at": "2026-07-28T00:39:12.376973+00:00",
