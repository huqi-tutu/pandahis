  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "0f5764f19ea2ce1b",
      "checked_at": "2026-08-09T08:39:41.939178+00:00",
      "note": "《史记·万石张叔列传》里记了这么一位御史大夫——张叔，名欧，是安丘侯张说的庶子。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "51265a5896bbc666",
      "checked_at": "2026-08-09T08:39:41.939194+00:00",
      "note": "孝文帝时，他靠着研习刑名之学，到太子身边做事。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "ddd748e249d71c52",
      "checked_at": "2026-08-09T08:39:41.939202+00:00",
      "note": "不过有意思的是，张欧虽然学的是刑名那一套，人却是个忠厚长者。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "7a5172f7d8aff3e5",
      "checked_at": "2026-08-09T08:39:41.939209+00:00",
      "note": "到了景帝时，他颇受尊重，常居九卿之位。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "ec4510280589c24a",
      "checked_at": "2026-08-09T08:39:41.939215+00:00",
      "note": "等到武帝元朔四年，韩安国被免了官，天子下诏拜张欧为御史大夫。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "33ea5df5519d31aa",
      "checked_at": "2026-08-09T08:39:41.939221+00:00",
      "note": "张欧做官，从不弹劾人，专以诚厚长者之道处官。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "8085332a02dec12f",
      "checked_at": "2026-08-09T08:39:41.939225+00:00",
      "note": "下属们觉得他是位长者，也不敢过分欺瞒他。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "550a28b36bd10b17",
      "checked_at": "2026-08-09T08:39:41.939241+00:00",
      "note": "遇上要呈报的狱案，能退回重审的就退回去；实在退不了的，他不得已，流着泪当面把文书封好上呈。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "0798ae5fa084fc78",
      "checked_at": "2026-08-09T08:39:41.939245+00:00",
      "note": "他爱护人，就到了这般地步。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "5da3828046499cea",
      "checked_at": "2026-08-09T08:39:41.939249+00:00",
      "note": "后来张欧年老病重，请求免官。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "419c68a39dd6e001",
      "checked_at": "2026-08-09T08:39:41.939254+00:00",
      "note": "天子下诏准了他，按上大夫的俸禄让他回家养老。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "6aef9d06d7dd74b0",
      "checked_at": "2026-08-09T08:39:41.939258+00:00",
      "note": "他家在阳陵，子孙后来都做到了大官。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "17885e31aa6a8e53",
      "checked_at": "2026-08-09T08:39:41.939262+00:00",
      "note": "明确传达了子孙都做大官的信息。"
    }
  }
}
