  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "f9549c46a6074501",
      "checked_at": "2026-08-09T07:16:46.498606+00:00",
      "note": "舞阳侯樊哙，是沛县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "c99cbe1e03a9026e",
      "checked_at": "2026-08-09T07:16:46.498616+00:00",
      "note": "早年间以杀狗卖肉为生，后来与高祖刘邦一起隐藏在芒砀山泽之间。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "e7587e6a66d11397",
      "checked_at": "2026-08-09T07:16:46.498620+00:00",
      "note": "最初，樊哙跟随高祖在丰邑起兵，攻下了沛县。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "c1383d8049d3a697",
      "checked_at": "2026-08-09T07:16:46.498623+00:00",
      "note": "高祖做了沛公，任命樊哙为舍人。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "210443cb99e4608b",
      "checked_at": "2026-08-09T07:16:46.498628+00:00",
      "note": "他跟随沛公攻打胡陵、方与，回师守卫丰邑，在丰邑城下击败了泗水郡监的军队。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "746f74416b03b9a2",
      "checked_at": "2026-08-09T07:16:46.498632+00:00",
      "note": "接着又向东平定沛县，在薛县西边打败了泗水郡守的部队。"
    },
    "M007–M011": {
      "status": "conveyed",
      "claim_fp": "5f565ffb4ce4b7fa",
      "checked_at": "2026-08-09T07:16:46.498637+00:00",
      "note": "与司马（名屖）在砀县东面交战，击退敌军，斩首十五级，被赐爵为国大夫。他常常跟随沛公，在濮阳攻打章邯的军队，攻城时率先登城，斩首二十三级，被赐爵为列大夫。又常常跟随沛公，攻打城阳，率先登城。攻下户牖，击破李由的军队，斩首十六级，被赐予上间爵。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "dac38ad6455ca8a8",
      "checked_at": "2026-08-09T07:16:46.498648+00:00",
      "note": "樊哙跟随沛公攻打秦军，从亳县以南出击。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "4829933f875de48e",
      "checked_at": "2026-08-09T07:16:46.498652+00:00",
      "note": "河间郡守的军队驻扎在杠里，樊哙击败了他们。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "6092a7f6ea8a9c17",
      "checked_at": "2026-08-09T07:16:46.498655+00:00",
      "note": "在开封以北击破赵贲的军队，因为击退敌军、率先登城，斩杀军候一人，斩首六十八级，俘虏二十七人，被赐爵为卿。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "12ceb029115b23c8",
      "checked_at": "2026-08-09T07:16:46.498659+00:00",
      "note": "跟随沛公在曲遇攻破杨熊的军队。"
    },
    "M016–M017": {
      "status": "conveyed",
      "claim_fp": "a7f041827d5a0efd",
      "checked_at": "2026-08-09T07:16:46.498662+00:00",
      "note": "攻打宛陵，率先登城，斩首八级，俘虏四十四人，被赐予封号贤成君。跟随沛公攻打长社、轘辕，断绝黄河渡口，向东在尸乡攻打秦军，向南在犨县攻打秦军。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "33ece63c39864c7f",
      "checked_at": "2026-08-09T07:16:46.498665+00:00",
      "note": "白话译文明确提到在阳城击败南阳郡守吕齮，与母本信息一致。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "b906d743500582cf",
      "checked_at": "2026-08-09T07:17:00.804847+00:00",
      "note": "直接对应"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "2015ff234489c8a2",
      "checked_at": "2026-08-09T07:17:00.804854+00:00",
      "note": "包含却敌、斩首、捕虏、赐重封"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "6e6e1eb7865af3e5",
      "checked_at": "2026-08-09T07:17:00.804857+00:00",
      "note": "直接对应"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "843f1f20fcf99faf",
      "checked_at": "2026-08-09T07:17:00.804860+00:00",
      "note": "包含百馀骑、因项伯、谢无有闭关事"
    },
    "M023–M025": {
      "status": "conveyed",
      "claim_fp": "e63d1fdac7329052",
      "checked_at": "2026-08-09T07:17:00.804863+00:00",
      "note": "包含中酒、亚父谋、项庄舞剑、项伯屏蔽、独沛公与张良得入、樊哙持盾闯入、直撞入立帐下"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "463dfd9bfc3905b2",
      "checked_at": "2026-08-09T07:17:00.804866+00:00",
      "note": "对应项羽目之，问为谁"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "8ef096e72a57d199",
      "checked_at": "2026-08-09T07:17:00.804869+00:00",
      "note": "张良说：「沛公的参乘樊哙。」项羽说：「壮士！」赐给他一卮酒和一条猪腿。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "5520212617cc6673",
      "checked_at": "2026-08-09T07:17:00.804871+00:00",
      "note": "樊哙喝完酒，拔剑切肉吃，全都吃光了。项羽说：「还能再喝吗？」樊哙说：「我连死都不推辞，岂在乎一杯酒！况且沛公先入关平定咸阳，露宿霸上，等待大王到来。大王今天一到，听信小人的话，与沛公有了嫌隙，我担心天下会因此瓦解，人心会怀疑大王啊。」"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "329993deac5fa931",
      "checked_at": "2026-08-09T07:17:00.804874+00:00",
      "note": "项羽沉默不语。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "bd7dfd44307dbf0a",
      "checked_at": "2026-08-09T07:17:00.804878+00:00",
      "note": "刘邦起身去上厕所，招呼樊哙一起出去。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "8c6d9f129c868efd",
      "checked_at": "2026-08-09T07:17:00.804880+00:00",
      "note": "出来后，刘邦留下车骑，独自骑一匹马，与樊哙等四人步行跟随，从小路经山下逃回霸上军营，而让张良留下向项羽辞谢。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "8f2ee8cf30ef8414",
      "checked_at": "2026-08-09T07:17:00.804883+00:00",
      "note": "项羽也就此作罢，没有诛杀刘邦的心思了。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "1b62981dcc8b6289",
      "checked_at": "2026-08-09T07:17:00.804885+00:00",
      "note": "白话译文明确表达了樊哙闯营责备项羽，使刘邦免于危险，与母本信息一致。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "f354abcaf85baf7f",
      "checked_at": "2026-08-09T07:17:00.804888+00:00",
      "note": "译文直接对应母本信息，包括项羽入屠咸阳和立刘邦为汉王。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "99bad758181870e9",
      "checked_at": "2026-08-09T07:17:00.804890+00:00",
      "note": "译文明确提到赐爵列侯和号临武侯，与母本信息一致。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "0ea66917ede204f3",
      "checked_at": "2026-08-09T07:17:12.190488+00:00",
      "note": "又升他做郎中，跟着汉王进了汉中。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "2575f4ca04c8a81e",
      "checked_at": "2026-08-09T07:17:12.190502+00:00",
      "note": "回到关中平定三秦，樊哙分兵在白水北面攻打西县县丞，又在雍县南面击破雍王的轻车骑兵。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "6a89c3407aca0319",
      "checked_at": "2026-08-09T07:17:12.190522+00:00",
      "note": "随后跟着主力攻打雍县和斄城，又是率先登城。"
    },
    "M040–M041": {
      "status": "conveyed",
      "claim_fp": "66d6226fe133d8cf",
      "checked_at": "2026-08-09T07:17:12.190526+00:00",
      "note": "在好畤攻打章平的军队，攻城时率先登城陷阵，斩杀县令、县丞各一人，斩首十一级，俘虏二十人，升为郎中骑将。又跟着在壤东攻击秦军车骑部队，击退敌军，升为将军。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "fa6e89b3a31e76b9",
      "checked_at": "2026-08-09T07:17:12.190529+00:00",
      "note": "攻打赵贲，拿下郿县、槐里、柳中、咸阳；灌废丘时功劳最大。"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "94375f7d6c61c2b7",
      "checked_at": "2026-08-09T07:17:12.190531+00:00",
      "note": "到了栎阳，刘邦把杜县的樊乡赐给他作食邑。"
    },
    "M044": {
      "status": "conveyed",
      "claim_fp": "5188b0f9fcbcdd50",
      "checked_at": "2026-08-09T07:17:12.190534+00:00",
      "note": "跟着攻打项羽，屠了煮枣。"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "fa02200c18f704ed",
      "checked_at": "2026-08-09T07:17:12.190537+00:00",
      "note": "在外黄击破王武、程处的军队。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "b16c8148ca661cd8",
      "checked_at": "2026-08-09T07:17:12.190539+00:00",
      "note": "又攻打邹县、鲁县、瑕丘、薛县。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "a2519d5dd4362a63",
      "checked_at": "2026-08-09T07:17:12.190542+00:00",
      "note": "项羽在彭城打败汉王，把鲁、梁之地又全部夺了回去。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "21044535e768afaf",
      "checked_at": "2026-08-09T07:17:12.190545+00:00",
      "note": "樊哙退回荥阳，增加平阴二千户食邑，以将军身份守广武。"
    },
    "M049": {
      "status": "conveyed",
      "claim_fp": "3948cd9568e38115",
      "checked_at": "2026-08-09T07:17:12.190547+00:00",
