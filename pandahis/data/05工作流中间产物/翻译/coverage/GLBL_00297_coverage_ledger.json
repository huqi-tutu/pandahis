      "claim_fp": "147946be4d425061",
      "checked_at": "2026-07-28T16:17:07.742489+00:00",
      "note": "完全传达"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "b9efa3160105743d",
      "checked_at": "2026-07-28T16:17:07.742493+00:00",
      "note": "完全匹配母本：进嫪毐，诈令人以腐罪告之。"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "0a946c2c1ebc9ce6",
      "checked_at": "2026-07-28T16:17:07.742496+00:00",
      "note": "逐句对应：阴谓太后、可事诈腐得给事中、厚赐主腐者吏、诈论之、拔其须眉、得侍太后。"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "89f2bb879937f274",
      "checked_at": "2026-07-28T16:17:07.742498+00:00",
      "note": "“私与通”即私通，“绝爱之”译为极其宠爱。"
    },
    "M054": {
      "status": "conveyed",
      "claim_fp": "05abcbc3266ce124",
      "checked_at": "2026-07-28T16:17:07.742501+00:00",
      "note": "有身（怀孕）、恐人知、诈卜当避时、徙宫居雍，均覆盖。"
    },
    "M055": {
      "status": "conveyed",
      "claim_fp": "3cf2eb14eb149ec9",
      "checked_at": "2026-07-28T16:18:04.137737+00:00",
      "note": "明确对应“常从，赏赐甚厚，事皆决於嫪毐”。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "f270e52b64967cb0",
      "checked_at": "2026-07-28T16:18:04.137750+00:00",
      "note": "明确对应“家僮数千人，诸客求宦为嫪毐舍人千馀人”。"
    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "336435880a8a3976",
      "checked_at": "2026-07-28T16:18:04.137753+00:00",
      "note": "明确对应“孝文王后曰华阳太后，与孝文王会葬寿陵”。"
    },
    "M058": {
      "status": "conveyed",
      "claim_fp": "a898326dc4d9e6d8",
      "checked_at": "2026-07-28T16:18:04.137757+00:00",
      "note": "完整转述葬地、遗嘱内容，对应母本信息。"
    },
    "M059–M061": {
      "status": "conveyed",
      "claim_fp": "0d717543743bd9d9",
      "checked_at": "2026-07-28T16:18:04.137761+00:00",
      "note": "包含告发非宦者、私通生子匿之，下吏治得实情连相国，九月夷三族杀两子迁太后，完全传达合并信息。"
    },
    "M062": {
      "status": "conveyed",
      "claim_fp": "fd88bf3c325115cb",
      "checked_at": "2026-07-28T16:18:04.137765+00:00",
      "note": "明确对应“诸嫪毐舍人皆没其家而迁之蜀”。"
    },
    "M063": {
      "status": "conveyed",
      "claim_fp": "29ca26bed5c94902",
      "checked_at": "2026-07-28T16:18:04.137769+00:00",
      "note": "秦王本来也打算杀掉相国吕不韦，但念及他侍奉先王劳苦功高，加上又有一大帮宾客和辩士轮番跑来为他说情，秦王最终还是没忍心对他下死手。"
    },
    "M064": {
      "status": "conveyed",
      "claim_fp": "03192a8752027f4e",
      "checked_at": "2026-07-28T16:18:04.137773+00:00",
      "note": "秦王十年十月，吕不韦被免去了相国的职位。"
    },
    "M065": {
      "status": "conveyed",
      "claim_fp": "bc97bf04520a2a8c",
      "checked_at": "2026-07-28T16:18:04.137776+00:00",
      "note": "后来，齐国人茅焦不知用了什么法子成功游说了秦王，秦王这才去雍城把太后接回了咸阳，但同时也下令让文信侯吕不韦离开京城，回到他在河南的封地去。"
    },
    "M066": {
      "status": "conveyed",
      "claim_fp": "7f1ba6df78a8f7a5",
      "checked_at": "2026-07-28T16:18:04.137779+00:00",
      "note": "过了一年多，各国的诸侯和宾客们还是络绎不绝地派出使者，在通往吕不韦封地的道路上往来不绝，争相去拜请这位曾经的权臣。"
    },
    "M067": {
      "status": "conveyed",
      "claim_fp": "dcc40905d7a5aed8",
      "checked_at": "2026-07-28T16:18:04.137788+00:00",
      "note": "秦王赢政开始不安了，他怕吕不韦迟早要生出什么变乱来，便亲自给吕不韦写了一封信，信里毫不留情地诘问：「你对秦国有什么功劳？竟然能被封在河南，享受十万户的食邑。你跟秦国有什么亲缘关系？竟然能被称为『仲父』。你和你全家，都给我迁到蜀地去！」吕不韦拿着这封信，越琢磨越觉得秦王这是在步步紧逼，恐怕自己早晚免不了一死，与其受辱，不如自行了断，便喝下毒酒自尽了。"
    },
    "M068": {
      "status": "conveyed",
      "claim_fp": "0851e879bb580c44",
      "checked_at": "2026-07-28T16:18:04.137791+00:00",
      "note": "吕不韦和嫪毐这两个让秦王恨得牙痒痒的人都死了以后，秦王才下令，把之前流放到蜀地的嫪毐门客们，都召了回来。"
    },
    "M054–M055": {
      "status": "conveyed",
      "claim_fp": "6556512c3a6248ba",
      "checked_at": "2026-07-28T16:18:12.173929+00:00",
      "note": "后来太后怀了孕，怕别人知道，就假装占卜说需要到别的地方去避一避，于是迁居到雍地的宫殿里。嫪毐经常跟随她，得到的赏赐非常丰厚，宫里的各种事情都由嫪毐决断。"
    }
  }
