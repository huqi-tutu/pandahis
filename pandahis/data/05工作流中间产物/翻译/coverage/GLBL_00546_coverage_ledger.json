      "note": "白话译文完整传达了恐惧、醢赐、集结兵力等情节。"
    },
    "M063–M064": {
      "status": "conveyed",
      "claim_fp": "9f5a3860152a44d1",
      "checked_at": "2026-08-09T07:36:43.043311+00:00",
      "note": "黥布有个宠姬生了病，要去看医生。医生家跟中大夫贲赫对门，这位姬妾常去医家，贲赫自以为在朝中任职，便备了厚礼，还跟着姬妾在医家饮酒。姬妾侍奉黥布时，闲谈间随口夸贲赫是个忠厚长者。"
    },
    "M065": {
      "status": "conveyed",
      "claim_fp": "dc21f63d0f1d7a2e",
      "checked_at": "2026-08-09T07:36:43.043314+00:00",
      "note": "黥布一听就火了：「你从哪儿知道的？」姬妾把前后经过说了一遍。"
    },
    "M066": {
      "status": "conveyed",
      "claim_fp": "d69ba85138010b1f",
      "checked_at": "2026-08-09T07:36:43.043318+00:00",
      "note": "黥布怀疑她跟贲赫有私情。"
    },
    "M067": {
      "status": "conveyed",
      "claim_fp": "27d1c4f448d33a3a",
      "checked_at": "2026-08-09T07:36:43.043321+00:00",
      "note": "贲赫害怕了，装病躲着。"
    },
    "M068": {
      "status": "conveyed",
      "claim_fp": "665662b0bd84a21f",
      "checked_at": "2026-08-09T07:36:43.043325+00:00",
      "note": "黥布更怒，要抓贲赫。"
    },
    "M069": {
      "status": "conveyed",
      "claim_fp": "ba4730240ef47cf6",
      "checked_at": "2026-08-09T07:36:43.043328+00:00",
      "note": "贲赫扬言要告发黥布谋反，乘驿车直奔长安。"
    },
    "M070": {
      "status": "conveyed",
      "claim_fp": "59b3af4e38882ee5",
      "checked_at": "2026-08-09T07:36:43.043331+00:00",
      "note": "黥布派人去追，没追上。"
    },
    "M071": {
      "status": "conveyed",
      "claim_fp": "4ba968a96f10ca79",
      "checked_at": "2026-08-09T07:36:43.043334+00:00",
      "note": "贲赫到了长安，上书告变，说黥布谋反已有苗头，建议趁他还没动手先除掉他。"
    },
    "M072": {
      "status": "conveyed",
      "claim_fp": "fcba4ff590e1d584",
      "checked_at": "2026-08-09T07:36:43.043337+00:00",
      "note": "刘邦读了奏书，跟萧相国商量。"
    },
    "M073": {
      "status": "conveyed",
      "claim_fp": "09e03a4fb85b6d30",
      "checked_at": "2026-08-09T07:37:05.501406+00:00",
      "note": "白话译文完整传达了相国建议、英布疑心、汉使查验、族赫家、发兵反等情节。"
