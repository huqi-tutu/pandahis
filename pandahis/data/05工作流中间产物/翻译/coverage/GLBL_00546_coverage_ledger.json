    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "ef5daed8c5f39b30",
      "checked_at": "2026-08-09T07:36:29.639464+00:00",
      "note": "完整传达了随何闯入、坐上位、质问及英布愕然。"
    },
    "M038": {
      "status": "conveyed",
