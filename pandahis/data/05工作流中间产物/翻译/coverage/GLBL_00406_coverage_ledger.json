    "M008": {
      "status": "conveyed",
      "claim_fp": "703aa23b7e191c46",
      "checked_at": "2026-08-09T03:31:47.047517+00:00",
      "note": "译文包含赵午等数十人愤怒，对赵王说“王事上礼备矣，今遇王如是，臣等请为乱”，以及赵王咬指出血说“先人失国，微陛下，臣等当虫出”。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "88ec51dc24554e08",
      "checked_at": "2026-08-09T03:31:47.047530+00:00",
      "note": "译文包含赵王说“公等柰何言若是！毋复出口矣”，以及贯高等人说“王长者，不倍德”，并私下谋划弑上。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "9e4bf3ce19b0be28",
      "checked_at": "2026-08-09T03:31:47.047533+00:00",
      "note": "译文包含“后来事情败露，汉朝下诏逮捕赵王和群臣中谋反的人”。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "4f05687b03abecff",
      "checked_at": "2026-08-09T03:31:47.047536+00:00",
      "note": "译文包含“于是赵午等人都自杀了，只有贯高被捕入狱”。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "9d6eb5552d227d1b",
      "checked_at": "2026-08-09T03:31:47.047539+00:00",
      "note": "译文包含汉下诏书“赵有敢随王者罪三族”，以及孟舒、田叔等十余人赭衣自髡钳，称王家奴，随赵王敖至长安。"
    },
    "M013–M014": {
      "status": "conveyed",
      "claim_fp": "6b4ffc5e5c284e04",
      "checked_at": "2026-08-09T03:31:47.047542+00:00",
      "note": "译文包含贯高事明白，赵王敖得出，废为宣平侯，进言田叔等十余人；上尽召见，与语，汉廷臣毋能出其右者，上说，尽拜为郡守、诸侯相。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "d150399e9917164d",
      "checked_at": "2026-08-09T03:31:47.047545+00:00",
      "note": "对话内容完整呈现。"
    },
    "M016–M017": {
      "status": "conveyed",
      "claim_fp": "64945cb04ac4703a",
      "checked_at": "2026-08-09T03:31:47.047548+00:00",
      "note": "对话和情节完整，包括孟舒的辩解和皇上的最终认可。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "9913d467d0e9b226",
      "checked_at": "2026-08-09T03:31:47.047551+00:00",
      "note": "明确提到田叔犯法失官。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "4e90161e822908d2",
      "checked_at": "2026-08-09T03:32:05.872474+00:00",
      "note": "梁孝王派人杀了从前的吴国丞相袁盎。汉景帝召见田叔，派他去查办梁孝王的案子。田叔把事情的来龙去脉查得清清楚楚，回来向景帝报告。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "57a35ffa6f12ddb7",
      "checked_at": "2026-08-09T03:32:05.872490+00:00",
      "note": "景帝问他：「梁有之乎？」田叔回答：「死罪！有之。」景帝又问：「其事安在？」田叔却说：「上毋以梁事为也。」并分析不杀梁王则汉法不行，杀则太后忧，景帝大贤之，以为鲁相。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "3b0a123d487276a5",
      "checked_at": "2026-08-09T03:32:05.872493+00:00",
      "note": "田叔刚到鲁相任上，就有百姓来告状，说鲁王夺取了他们的财物，来告状的一百多人。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "23ec0f83d7852ebd",
      "checked_at": "2026-08-09T03:32:05.872496+00:00",
      "note": "田叔把带头告状的二十多人抓来，每人打了五十板子，其余的人每人打了二十下，还生气地对他们说：「王非若主邪？何自敢言若主！」鲁王听说后非常惭愧，拿出宫中的钱，让田叔去偿还百姓。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "276a59fe8b387421",
      "checked_at": "2026-08-09T03:32:05.872499+00:00",
      "note": "田叔却说：「王自夺之，使相偿之，是王为恶而相为善也。相毋与偿之。」于是鲁王只好自己把财物全部还给了百姓。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "c616cfeee5a2d611",
      "checked_at": "2026-08-09T03:32:05.872501+00:00",
      "note": "鲁王喜欢打猎，田叔作为相经常跟着他进苑囿。鲁王总是让田叔到馆舍里去休息，可田叔出来以后，常常坐在苑外晒太阳等着鲁王。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "2dd2688fd4a0324e",
      "checked_at": "2026-08-09T03:32:05.872504+00:00",
      "note": "鲁王多次派人请田叔去休息，田叔不肯，说大王还在苑中风吹日晒，我怎么能独自去馆舍休息。鲁王因此不大出去打猎。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "afd165a70ff72bd5",
      "checked_at": "2026-08-09T03:32:05.872506+00:00",
      "note": "几年后田叔死在任上，鲁国用百金祭祀，小儿子田仁不接受，说不能因为百金玷污先父名声。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "5264b6b74d7d8f1f",
      "checked_at": "2026-08-09T03:32:05.872509+00:00",
      "note": "田仁凭壮健体魄做卫将军舍人，多次随军出击匈奴。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "015a4a982023f5e0",
      "checked_at": "2026-08-09T03:32:05.872511+00:00",
      "note": "卫将军向皇帝推荐田仁，田仁做了郎中。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "9e79c97bf51d3a24",
      "checked_at": "2026-08-09T03:32:05.872514+00:00",
      "note": "几年后升到二千石丞相长史，后来丢了官。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "0aae87aeb6b2412b",
      "checked_at": "2026-08-09T03:32:05.872516+00:00",
      "note": "之后被派去督察三河地区。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "8a32c95c87f712d8",
      "checked_at": "2026-08-09T03:32:05.872519+00:00",
      "note": "皇帝东巡时，田仁奏事言辞得体，皇帝很高兴，任命他为京辅都尉。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "244b188d43d84175",
      "checked_at": "2026-08-09T03:32:05.872521+00:00",
      "note": "过了一个多月，皇帝又升他做司直。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "0f5df1e9617ec584",
      "checked_at": "2026-08-09T03:32:05.872523+00:00",
      "note": "几年后，田仁受太子谋反一事牵连。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "3c2c4ec90eb01979",
      "checked_at": "2026-08-09T03:32:05.872526+00:00",
      "note": "当时左丞相亲自带兵，命令司直田仁负责关闭守卫城门，田仁因为放走了太子，被交给司法官吏审讯，处以死刑。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "a5dc99ca7aa2678a",
      "checked_at": "2026-08-09T03:32:05.872528+00:00",
      "note": "田仁曾发兵，长陵令车千秋向皇帝告发田仁谋反，田仁最终被灭族。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "fc58a94465461f07",
      "checked_at": "2026-08-09T03:32:05.872531+00:00",
      "note": "陉城这个地方，如今在中山国境内。"
    }
  }
