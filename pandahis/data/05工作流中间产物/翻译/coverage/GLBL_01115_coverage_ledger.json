  "entries": {
    "M001–M002": {
      "status": "conveyed",
      "claim_fp": "6b771d89a30a0be6",
      "checked_at": "2026-08-09T11:11:45.098906+00:00",
      "note": "译文开头明确说明陈豨是宛朐人，不知最初如何跟从高祖；随后叙述高祖七年冬韩王信反叛入匈奴，高祖至平城还，封陈豨为列侯，以赵相国将监赵、代边兵，边兵皆属焉。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "c4b4b5754cf08a31",
      "checked_at": "2026-08-09T11:11:45.098910+00:00",
      "note": "译文提到陈豨经常请假回乡路过赵国，赵相周昌看到他随行宾客有一千多辆车，邯郸官舍都住满了。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "62956fa77bd534b1",
      "checked_at": "2026-08-09T11:11:45.098912+00:00",
      "note": "译文明确说陈豨对待宾客像平民之交，态度谦卑，居于客人之下。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "1525fff2208c910c",
      "checked_at": "2026-08-09T11:11:45.098913+00:00",
      "note": "译文说陈豨回到代地后，周昌便请求入京朝见。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "2fae77cc3c3aa949",
      "checked_at": "2026-08-09T11:11:45.098914+00:00",
      "note": "译文描述周昌见到高祖，详细禀报陈豨宾客极盛，在外独掌兵权多年，恐怕会有变故。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "db95cee46dbcd87a",
      "checked_at": "2026-08-09T11:11:45.098916+00:00",
      "note": "译文说高祖派人审查陈豨门客在代地的财物和各种不法之事，结果大多牵连到陈豨。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "d206f8dd60a8ce7b",
      "checked_at": "2026-08-09T11:11:45.098917+00:00",
      "note": "陈豨恐惧，暗中派门客到王黄、曼丘臣那里联络。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "45ca7cb83461f9ac",
      "checked_at": "2026-08-09T11:11:45.098924+00:00",
      "note": "九月，陈豨终于与王黄等人反叛，自立为代王，劫掠赵、代两地。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "a4a1061c6ac799c0",
      "checked_at": "2026-08-09T11:11:45.098926+00:00",
      "note": "高祖闻讯，先赦免了赵、代两地被陈豨牵连胁迫的官吏，全部赦免。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "b04b1c3f11b2cf4a",
      "checked_at": "2026-08-09T11:11:45.098927+00:00",
      "note": "随后高祖亲自率军前往，到了邯郸，高兴地说：“陈豨不南据漳水，北守邯郸，我知道他成不了气候。”赵相上奏请求斩杀常山郡的郡守和郡尉，说：“常山二十五座城，陈豨反叛，丢了二十座。”高祖问：“郡守、郡尉反叛了吗？”回答说：“没有反叛。”"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "a0962bb41c9dd1cc",
      "checked_at": "2026-08-09T11:11:45.098928+00:00",
      "note": "高祖说：“这是力量不足啊。”便赦免了他们，恢复他们常山郡守、郡尉的职务。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "79408a2bad112ba8",
      "checked_at": "2026-08-09T11:11:45.098930+00:00",
      "note": "高祖又问周昌：“赵地有没有壮士可以任命为将领的？”周昌回答说：“有四人。”四人前来拜见，高祖破口大骂道：“你们这些小子能当将领吗？”四人羞愧地伏地。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "11b1e5c383ff657f",
      "checked_at": "2026-08-09T11:11:45.098931+00:00",
      "note": "高祖却封他们各千户，任命为将。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "e343ea420c95419d",
      "checked_at": "2026-08-09T11:11:45.098932+00:00",
      "note": "左右近臣劝谏说：“跟随您入蜀、汉，讨伐楚国的功臣，功劳还没普遍封赏，如今这四人有什么功劳而受封？”高祖说：“这不是你们能知道的！陈豨反叛，邯郸以北都是陈豨的地盘，我用羽檄征调天下军队，没有一支到达，如今只有邯郸城中的军队罢了。我何必吝惜四千户封给四人，不用来安抚赵地的子弟！”"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "dc95f4aaa56ab0e9",
      "checked_at": "2026-08-09T11:11:45.098933+00:00",
      "note": "众人都说：“好。”于是高祖问：“陈豨的将领是谁？”回答说：“王黄、曼丘臣，都是过去的商人。”"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "b502f2e329bf05fa",
      "checked_at": "2026-08-09T11:11:45.098934+00:00",
      "note": "高祖说：“我知道了。”于是各用千金悬赏购求王黄、曼丘臣等人。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "c8dc0fbefa71f798",
      "checked_at": "2026-08-09T11:11:45.098936+00:00",
      "note": "十一年冬天，汉军在曲逆城下击斩陈豨的将领侯敞、王黄，在聊城击败陈豨的将领张春，斩首一万多人。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "3d51b66e0dee579f",
      "checked_at": "2026-08-09T11:11:51.427608+00:00",
      "note": "太尉周勃率军进入，平定了太原和代地。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "75a822bd8502d7a4",
      "checked_at": "2026-08-09T11:11:51.427612+00:00",
      "note": "十二月，高祖亲自率军攻打东垣。东垣城一时攻不下来，城里的守卒竟敢辱骂高祖；等到东垣投降后，骂过高祖的士兵全被处斩，没骂的则被处以黥刑。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "81ab5068cb8f7121",
      "checked_at": "2026-08-09T11:11:51.427614+00:00",
      "note": "高祖还下令把东垣改名为真定。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "7428e8aa5c09e577",
      "checked_at": "2026-08-09T11:11:51.427615+00:00",
      "note": "王黄、曼丘臣的部下贪图悬赏，把他们活捉了送来，陈豨的军队就此彻底失败。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "a79adb73fc093393",
      "checked_at": "2026-08-09T11:11:51.427617+00:00",
      "note": "高祖回到洛阳。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "aecf8b4224a83a40",
      "checked_at": "2026-08-09T11:11:51.427618+00:00",
      "note": "说：「代居常山北，赵乃从山南有之，远。」——代地在常山以北，赵国从山南去管辖，路途太远。于是立儿子刘恒为代王，定都中都，代地、雁门都划归代国。"
    }
  }
}
