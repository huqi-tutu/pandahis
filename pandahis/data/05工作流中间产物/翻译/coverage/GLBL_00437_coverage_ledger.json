  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "b44dc8a8b5797c49",
      "checked_at": "2026-08-09T09:17:51.319955+00:00",
      "note": "蔡义是河内郡温县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "d363ae69f1da9658",
      "checked_at": "2026-08-09T09:17:51.319972+00:00",
      "note": "他因为通晓经术，被安排到大将军的幕府里供职。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "bca1fbfb1f2769ad",
      "checked_at": "2026-08-09T09:17:51.319975+00:00",
      "note": "蔡义家里穷，常常步行上班，备下的见面礼也比不上其他门客。有热心人看不过去，凑钱给他买了一头牛拉的车，让他坐着来去。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "834f6398713661b1",
      "checked_at": "2026-08-09T09:17:51.319979+00:00",
      "note": "过了几年，他升补为覆盎城门候，管城门。"
    },
    "M005–M007": {
      "status": "conveyed",
      "claim_fp": "fb312eccb1f378a3",
      "checked_at": "2026-08-09T09:17:51.319983+00:00",
      "note": "又过了很久，朝廷下诏寻找能讲「韩诗」的人，蔡义被征召为待诏，却迟迟没能见到皇帝。他上了一道奏疏，自陈心迹：「臣山东草莱之人，行能亡所比，容貌不及众，然而不弃人伦者，窃以闻道于先师，自托于经术也。愿赐清闲之燕，得尽精思于前。」意思是说，自己是山东草野之人，才能和容貌都不如别人，之所以不敢自弃，是因为从先师那里闻了道，把自己托付给了经术，希望皇帝赐他清闲的机会，好把心思都用在御前。皇帝召见了他，听他讲"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "846006e96dfe90ea",
      "checked_at": "2026-08-09T09:17:51.319986+00:00",
      "note": "后来又因为参与定策、安定宗庙的功劳，增加了封邑，另赐黄金二百斤。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "26fc3bd57b1de295",
      "checked_at": "2026-08-09T09:17:51.319989+00:00",
      "note": "蔡义做丞相的时候已经八十多岁，身材矮小，没有胡须眉毛，相貌像个老妇人，走路弯腰驼背，常常要两个吏员一左一右搀扶着才能走。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "4b39190007cf0635",
      "checked_at": "2026-08-09T09:17:51.319999+00:00",
      "note": "当时大将军霍光执政，有人议论说霍光任命宰相不选贤能，只挑那种能让他专权控制的人。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "90a1ff8b4d4b9522",
      "checked_at": "2026-08-09T09:17:51.320003+00:00",
      "note": "霍光听到这话，对侍中、左右和属官说：「以为人主师当为宰相，何谓云云？此语不可使天下闻也。」——皇帝的老师应当做宰相，这话有什么可说的？这种话不能让天下人听到。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "4faf6d5acf5fb56b",
      "checked_at": "2026-08-09T09:17:51.320006+00:00",
      "note": "蔡义当了四年丞相，去世了，谥号节侯。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "fde28a16a20adede",
      "checked_at": "2026-08-09T09:17:51.320009+00:00",
      "note": "他没有儿子，封国被废除。"
    }
  }
}
