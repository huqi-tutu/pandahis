    "M011": {
      "status": "conveyed",
      "claim_fp": "b0adc3c7a1062528",
      "checked_at": "2026-07-26T13:57:24.147263+00:00",
      "note": "吴王急派使者求情，孙武以将在外君命有所不受为由，坚持斩二人示众"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "9a7db77a1261411f",
      "checked_at": "2026-07-26T13:57:24.147266+00:00",
