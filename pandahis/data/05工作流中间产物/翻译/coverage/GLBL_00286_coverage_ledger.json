    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "1d984dbe0b44c400",
      "checked_at": "2026-08-09T02:04:31.777242+00:00",
      "note": "萧望之上奏说，匡衡经学精熟，讲说有师法传承，值得观览。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "b2ae7c04d1cb8f70",
      "checked_at": "2026-08-09T02:04:31.777253+00:00",
