{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00459",
  "updated_at": "2026-08-09T06:41:22.830082+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "5b47a64d38d02c3b",
      "checked_at": "2026-08-09T04:09:28.383182+00:00",
      "note": "郅都是杨县人"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "bae03ebe8c84e277",
      "checked_at": "2026-08-09T04:09:28.383189+00:00",
      "note": "早年以郎官的身份侍奉孝文帝"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "a982b3425dfc4b65",
      "checked_at": "2026-08-09T04:09:28.383191+00:00",
      "note": "到了孝景帝的时候，他做到了中郎将，为人敢直谏，在朝廷上当面驳斥大臣"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "07c5b04257d2b74c",
      "checked_at": "2026-08-09T04:09:28.383195+00:00",
      "note": "景帝用眼神示意郅都去救人，郅都站着不动"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "04a3e0519e549c92",
      "checked_at": "2026-08-09T04:09:28.383198+00:00",
      "note": "郅都伏在景帝面前拦住他说...景帝听了这话，只好退了回来，那头野猪也没伤着贾姬，自己跑掉了"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "01776a92cd7515a6",
      "checked_at": "2026-08-09T04:09:28.383201+00:00",
      "note": "窦太后听说了这件事，赏赐给郅都黄金百斤，从此对郅都另眼相看"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "58b576bebd12d592",
      "checked_at": "2026-08-09T04:09:28.383203+00:00",
      "note": "济南有一家瞷氏，同宗的有三百多家，在当地强横奸猾，历任二千石的官员都拿他们没办法。于是景帝任命郅都为济南太守。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "9d6795f97b88feb1",
      "checked_at": "2026-08-09T04:09:28.383212+00:00",
      "note": "郅都一到任，就把瞷氏的首恶满门族灭，其余的人吓得大腿直发抖。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "9ba2f57b0e39acf6",
      "checked_at": "2026-08-09T04:09:28.383215+00:00",
      "note": "过了一年多，济南郡里路不拾遗。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "6ef3619e1bc326dd",
      "checked_at": "2026-08-09T04:09:28.383218+00:00",
      "note": "周围十多个郡的太守畏惧郅都，就像畏惧上级官府一样。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "6ed605a2ae9543dc",
      "checked_at": "2026-08-09T04:09:28.383219+00:00",
      "note": "郅都为人勇敢，有气力，公正廉洁，不拆看私人书信，不接受别人的馈赠，也不听凭别人的请托。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "b87263c5976f630d",
      "checked_at": "2026-08-09T04:09:28.383222+00:00",
      "note": "他常常自称：「已倍亲而仕，身固当奉职死节官下，终不顾妻子矣。」——既然已经离开亲人出来做官，本就应当奉公尽职、为节义死在官任上，终究不能顾念妻子儿女了。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "0239ff3217de100e",
      "checked_at": "2026-08-09T04:09:28.383225+00:00",
      "note": "后来郅都升任中尉。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "b6473dd2b4095c5e",
      "checked_at": "2026-08-09T04:09:28.383227+00:00",
      "note": "丞相条侯周亚夫地位尊贵又傲慢，见了谁都不放在眼里，可郅都见了他，只是作个揖，并不下拜。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "262b49d0b2586d5e",
      "checked_at": "2026-08-09T04:09:28.383229+00:00",
      "note": "那时候民风淳朴，百姓都畏惧犯罪、自重自爱，而郅都却独自率先施行严酷之法，执法不回避皇亲国戚。列侯宗室见了郅都，都侧目而视，给他起了个外号叫「苍鹰」。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "2e6dd8fab0845f96",
      "checked_at": "2026-08-09T04:09:28.383231+00:00",
      "note": "临江王被召到中尉府对质，想得到刀笔写信向皇上谢罪，郅都却禁止官吏给他。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "729bfe0d19b3d678",
      "checked_at": "2026-08-09T04:09:28.383234+00:00",
      "note": "魏其侯派人暗中把刀笔送给了临江王。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "f395c7e1da2850a1",
      "checked_at": "2026-08-09T04:09:28.383236+00:00",
      "note": "临江王写完谢罪信，就自杀了。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "207bbf490881891c",
      "checked_at": "2026-08-09T04:09:36.996544+00:00",
      "note": "窦太后听说了临江王自杀的事，勃然大怒，用严苛的法令罗织罪名中伤郅都，郅都因此被免官，回到了家乡。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "248961150638fdb0",
      "checked_at": "2026-08-09T04:09:36.996554+00:00",
      "note": "孝景帝心里还念着这个忠臣，便派使者手持符节，任命郅都为雁门太守，让他从便道直接赴任，并特许他可以自行决断、便宜行事。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "0cf0dfabf60a5791",
      "checked_at": "2026-08-09T04:09:36.996557+00:00",
      "note": "匈奴人素来听闻郅都的气节，他驻守边境时，匈奴竟为此引兵退去，直到郅都去世，都不敢靠近雁门一步。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "14af87d88260dfaa",
      "checked_at": "2026-08-09T04:09:36.996561+00:00",
      "note": "匈奴人甚至做了木偶人像来模拟郅都，让骑兵奔驰射箭，却没有人能射中——郅都被畏惧到这种程度。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "a9e9b7c470968b1c",
      "checked_at": "2026-08-09T04:09:36.996564+00:00",
      "note": "匈奴人深以此为患。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "4c30e8f1f1447b55",
      "checked_at": "2026-08-09T04:09:36.996567+00:00",
      "note": "窦太后最终还是用汉朝的法律罗织罪名，中伤郅都。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "921cede9b5d84412",
      "checked_at": "2026-08-09T04:09:36.996570+00:00",
      "note": "景帝说：「都忠臣。」——郅都是忠臣啊，想要释放他。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "802f4533d27ce0fb",
      "checked_at": "2026-08-09T04:09:36.996573+00:00",
      "note": "窦太后却反问：「临江王独非忠臣邪？」——临江王难道就不是忠臣吗？一句话堵得景帝无话可说。于是，郅都最终被斩首。"
    }
  }
}
