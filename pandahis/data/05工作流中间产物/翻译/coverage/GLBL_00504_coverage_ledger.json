  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00504",
  "updated_at": "2026-07-27T13:09:12.801596+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "a93f9fee21941f19",
      "checked_at": "2026-07-26T14:39:26.308840+00:00",
      "note": "司马穰苴，是田完的后代。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "ba284b0ed67a322e",
      "checked_at": "2026-07-26T14:39:26.308848+00:00",
      "note": "到齐景公的时候，晋国攻打齐国的阿邑和甄邑，燕国也入侵黄河南岸一带，齐国的军队被打得大败。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "921251dabe01c05a",
      "checked_at": "2026-07-26T14:39:26.308852+00:00",
      "note": "齐景公对此非常忧虑。"
    },
    "M004–M005": {
      "status": "conveyed",
      "claim_fp": "7db0f0cd4a3b6a1d",
      "checked_at": "2026-07-26T14:39:26.308856+00:00",
      "note": "涵盖了晏婴推荐、景公与穰苴语兵、大说、以为将军、将兵扞燕晋之师，以及穰苴请求监军、景公许之、使庄贾往"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "4611c960f62ec8c9",
      "checked_at": "2026-07-26T14:39:26.308861+00:00",
      "note": "穰苴辞别了齐景公之后，跟庄贾约定说：「明天正午，在军营大门会合。」第二天，穰苴先骑马赶到军营，竖起测日影的木表，打开计时的漏壶，等着庄贾。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "2a93652996a2263a",
      "checked_at": "2026-07-26T14:39:26.308865+00:00",
      "note": "庄贾向来骄纵显贵，觉得这是率领自己的军队，自己又是监军，就没太当回事；亲戚和身边的人为他饯行，他就留下来喝酒。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "18a55a91d3d10b9d",
      "checked_at": "2026-07-26T14:39:26.308868+00:00",
      "note": "到了正午时分，庄贾却没到。"
    },
    "M009–M011": {
      "status": "conveyed",
      "claim_fp": "7285a7b92a75f914",
      "checked_at": "2026-07-26T14:39:26.308872+00:00",
      "note": "穰苴就让人放倒木表，倒掉漏壶里的水，自己走进军营，巡视军队、整顿士兵，反复申明军中纪律号令。纪律条令已经宣布完毕，一直到了傍晚，庄贾才露面。穰苴问他：“为什么迟到了？”贾道歉说：“大夫们和亲戚朋友给我送行，所以耽搁了。”穰苴说：「将领在接受国君命令的那天起，就该忘记自己的家庭……还谈什么送行呢！」说完，就叫来军中的执法官问道：“按照军法，约定了时间却迟到的人，该当何罪？”回答说：“应当斩首。”庄贾"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "bc0f254959906cc7",
      "checked_at": "2026-07-26T14:39:26.308875+00:00",
      "note": "派去的人走了之后，还没等返回来，穰苴就根据军法斩了庄贾，并提着庄贾的人头在全军面前示众。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "924cbc755c17307f",
      "checked_at": "2026-07-26T14:39:26.308878+00:00",
      "note": "全军的士兵都被吓得浑身发抖。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "780495e5275349f8",
      "checked_at": "2026-07-26T14:39:26.308881+00:00",
      "note": "过了好一阵，齐景公的使者手持符节飞马驰入军营，来赦免庄贾。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "d42086b6d92a13e5",
      "checked_at": "2026-07-26T14:39:26.308884+00:00",
      "note": "穰苴说：「将领在军中，国君的命令有的可以不接受。」又问军正说：“骑着马在军营里横冲直撞，按军法该如何处置？”军正说：“应当斩首。”齐景公的使者吓坏了。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "44475c7761c5a0c1",
      "checked_at": "2026-07-26T14:39:26.308887+00:00",
      "note": "完整传达了母本信息"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "e3b7c97058af021b",
      "checked_at": "2026-07-26T14:39:26.308889+00:00",
      "note": "完整传达了母本信息"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "f0c697fd924b0ac6",
      "checked_at": "2026-07-26T14:39:26.308892+00:00",
      "note": "完整传达了母本信息"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "c69b590df86efcb2",
      "checked_at": "2026-07-27T00:07:18.347447+00:00",
      "note": "生病的士兵全都主动要求随军出征，个个争先恐后地要上阵杀敌。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "d0c7348da63add39",
      "checked_at": "2026-07-27T00:07:18.347453+00:00",
      "note": "晋国军队听说了穰苴治军的这番景象，自己就撤兵回去了。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "f0e160e6390f594a",
      "checked_at": "2026-07-27T00:07:18.347456+00:00",
      "note": "燕国军队听说了，也赶紧渡过黄河向北撤走。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "4dfeadbdafe2121f",
      "checked_at": "2026-07-27T00:07:18.347458+00:00",
      "note": "穰苴趁势率领齐军追击，一举收复了所有沦陷的故土和城池，这才带着得胜之师往回走。"
    },
    "M023–M024": {
      "status": "conveyed",
      "claim_fp": "2f25422c903bdaf6",
      "checked_at": "2026-07-27T00:07:18.347461+00:00",
      "note": "还没到国都城下，队伍就解除了战时的武装，散去了作战队列，在军前誓师盟约之后，才整肃地进入都城。齐景公亲自带着朝中的大夫们到郊外来迎接，犒劳全军，依礼完成了全部的劳军仪式，然后才回宫休息。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "b1103a2db5e841d2",
      "checked_at": "2026-07-27T00:07:18.347464+00:00",
      "note": "正式接见穰苴之后，景公便尊奉他为大司马。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "1f0637253c7a8a8e",
      "checked_at": "2026-07-27T00:07:18.347468+00:00",
      "note": "“从这以后，田氏一族在齐国的地位，就一天比一天尊崇了。”"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "d2e26521ed751c94",
      "checked_at": "2026-07-27T00:07:18.347470+00:00",
      "note": "“可是没过多久，齐国原来的大族——鲍氏、高氏、国氏这帮人，就嫉妒起穰苴的权势来，合伙在齐景公面前诋毁他。”"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "a70516b42b287da7",
      "checked_at": "2026-07-27T00:07:18.347473+00:00",
      "note": "“景公就此罢免了穰苴的官职，让他回了家。穰苴被贬退之后，心情郁结，不久就发病死去了。”"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "6f747f7e6d520993",
      "checked_at": "2026-07-27T00:07:18.347476+00:00",
      "note": "“穰苴的死，让田乞、田豹这些田氏族人从此深深恨上了高氏和国氏。”"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "8789c39274049cfb",
      "checked_at": "2026-07-27T00:07:18.347479+00:00",
      "note": "“再后来，等到田常杀了齐简公，就顺势把高氏、国氏的族人全都灭了门。”"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "9b37500835269b9e",
      "checked_at": "2026-07-27T00:07:18.347481+00:00",
      "note": "“一直到了田常的曾孙田和，他终于自立为齐威王，不论是用兵打仗还是推行政令，都极力推崇和效仿穰苴当年的兵法，齐国因此强盛，诸侯们又都来朝见齐国了。”"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "784693c7f14efc2a",
      "checked_at": "2026-07-27T00:07:18.347484+00:00",
      "note": "白话译文中最后一段：'齐威王还专门指派手下的文官，追溯整理前代的「司马兵法」，把穰苴用兵的理论也附在里面，一起编成了一部兵书，就叫作「司马穰苴兵法」。'"
    }
  }
}
