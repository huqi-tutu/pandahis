  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "64eddae1d11e5393",
      "checked_at": "2026-08-09T08:10:13.439403+00:00",
      "note": "楚地有个叫田仲的，以侠义闻名。他把朱家当父亲一样侍奉，自己总觉得品行赶不上朱家。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "c58f71469bf0416d",
      "checked_at": "2026-08-09T08:10:13.439412+00:00",
      "note": "田仲死后，接替他名声的，是剧孟。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "51586d4c6ce364d5",
      "checked_at": "2026-08-09T08:10:13.439415+00:00",
      "note": "剧孟是洛阳人。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "47a305b582688cca",
      "checked_at": "2026-08-09T08:10:13.439419+00:00",
      "note": "洛阳这地方，周人世代靠经商为生，剧孟却偏偏以侠义出了名。"
    },
    "M005–M006": {
      "status": "conveyed",
      "claim_fp": "d340535f1b055263",
      "checked_at": "2026-08-09T08:10:13.439421+00:00",
      "note": "吴、楚七国叛乱那会儿，条侯周亚夫正做太尉，乘着驿车往东赶，快到河南时，得到了剧孟。他高兴地说：「吴、楚举大事而不求剧孟，吾知其无能为已。」——天下都乱成一锅粥了，大将军得到剧孟，就像得到了一个敌国那么看重。剧孟行事很像朱家，只是爱好博戏，常玩些少年人的游戏。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "84f31964a9f69f11",
      "checked_at": "2026-08-09T08:10:13.439424+00:00",
      "note": "可他母亲去世时，从远方赶来送丧的车驾，足足有上千乘。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "79d0d9f01c8272ee",
      "checked_at": "2026-08-09T08:10:13.439427+00:00",
      "note": "等剧孟自己死了，家里连十金的家产都没有。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "c03458f9e3a81916",
      "checked_at": "2026-08-09T08:10:13.439437+00:00",
      "note": "当时，符离人王孟也以侠义著称于长江、淮河之间。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "e02c50101d6be0ff",
      "checked_at": "2026-08-09T08:10:13.439440+00:00",
      "note": "济南瞷氏、陈地周肤，也以豪强闻名。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "35cccce8ebf87abf",
      "checked_at": "2026-08-09T08:10:13.439443+00:00",
      "note": "景帝听说了这些人，派使者把他们全杀了。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "d678855b45bf1108",
      "checked_at": "2026-08-09T08:10:13.439446+00:00",
      "note": "此后，代地诸白、梁地韩毋辟、阳翟薛况、陕地寒孺，又纷纷冒了出来。"
    }
  }
}
