{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00267",
  "updated_at": "2026-08-10T15:58:14.888882+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "0d31fb0f2dbe51be",
      "checked_at": "2026-08-09T01:53:09.699200+00:00",
      "note": "伏生是济南人"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "ddc461a4f6ffebff",
      "checked_at": "2026-08-09T01:53:09.699214+00:00",
      "note": "从前做过秦朝的博士官"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "9208d0890c359746",
      "checked_at": "2026-08-09T01:53:09.699219+00:00",
      "note": "汉孝文帝的时候，朝廷想找一个能研究「尚书」的人，找遍天下也没找到。后来听说伏生能治「尚书」，便想召他进京"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "363089780776848a",
      "checked_at": "2026-08-09T01:53:09.699224+00:00",
      "note": "可那时伏生已经九十多岁，年老体衰，不能行走，于是文帝下诏让太常派掌故晁错前往济南，跟伏生受学"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "8c6fc8f84c729531",
      "checked_at": "2026-08-09T01:53:09.699227+00:00",
      "note": "秦朝焚书的时候，伏生把书偷偷藏在墙壁里"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "71d026332084ea47",
      "checked_at": "2026-08-09T01:53:09.699232+00:00",
      "note": "后来战乱大起，伏生流亡在外。等到汉朝平定天下，伏生回来寻找藏书，丢失了几十篇，只剩下二十九篇。他就靠着这二十九篇，在齐鲁之间教授生徒"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "6a66af12872a6cd8",
      "checked_at": "2026-08-09T01:53:09.699235+00:00",
      "note": "学者们从此颇能讲述「尚书」，山东一带的经学大师，没有不拿「尚书」来教学的。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "692f2a191223c805",
      "checked_at": "2026-08-09T01:53:09.699247+00:00",
      "note": "伏生教授济南人张生和欧阳生，欧阳生又教授千乘人儿宽。"
    },
    "M009–M010": {
      "status": "conveyed",
      "claim_fp": "bfb682d7990aa3a8",
      "checked_at": "2026-08-09T01:53:09.699251+00:00",
      "note": "儿宽通晓「尚书」之后，凭文学才能应郡举，到博士那里受业，师从孔安国。儿宽家里穷，没有资财，常替弟子们做饭，又抽空给人做佣工，挣点钱来供给衣食。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "fd39ac4df2f5c3be",
      "checked_at": "2026-08-09T01:53:09.699254+00:00",
      "note": "他出门时常带着经书，休息的时候就诵读学习。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "901fa716560e69dc",
      "checked_at": "2026-08-09T01:53:09.699258+00:00",
      "note": "后来凭考试成绩，补任廷尉史。"
    },
    "M013–M014": {
      "status": "conveyed",
      "claim_fp": "c31323a17dacea25",
      "checked_at": "2026-08-09T01:53:09.699261+00:00",
      "note": "当时张汤正倾心儒学，任命儿宽做奏谳掾，用古法议决疑难大案，对儿宽十分宠爱信任。儿宽为人温和善良，有廉洁之智，能自持操守，又善于著书、写奏章，文思敏捷，只是口头表达不太行。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "e6e78237ca5a376a",
      "checked_at": "2026-08-09T01:53:09.699264+00:00",
      "note": "张汤认为他是长者，多次称赞他。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "dd518c864c7fc075",
      "checked_at": "2026-08-09T01:53:09.699268+00:00",
      "note": "等到张汤做了御史大夫，让儿宽做掾属，并把他推荐给天子。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "4bb144d0b9e71142",
      "checked_at": "2026-08-09T01:53:09.699271+00:00",
      "note": "天子召见询问，很喜欢儿宽。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "4f9f378de5b2af34",
      "checked_at": "2026-08-09T01:53:09.699274+00:00",
      "note": "张汤死后六年，儿宽官至御史大夫。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "569b75ce3e4fe0de",
      "checked_at": "2026-08-09T01:53:16.436831+00:00",
      "note": "儿宽身居三公之位，靠的是温和善良、顺承上意，因此能安安稳稳待得长久，但他在位期间没有什么匡正谏诤之举；在官署之中，属官们轻视他，不肯为他尽心尽力。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "dd2d52f181f6f7e6",
      "checked_at": "2026-08-09T01:53:16.436841+00:00",
      "note": "张生后来也做了博士。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "3a384f4ba0c2cbf6",
      "checked_at": "2026-08-09T01:53:16.436845+00:00",
      "note": "而伏生的孙子虽然因为研究「尚书」被朝廷征召，却不能阐明「尚书」之学。"
    },
    "M022–M023": {
      "status": "conveyed",
      "claim_fp": "21d06688f0d601bd",
      "checked_at": "2026-08-09T01:53:16.436848+00:00",
      "note": "自此之后，鲁人周霸、孔安国，雒阳人贾嘉，都颇能讲述「尚书」之事。孔氏家藏有古文「尚书」，孔安国用今文来解读它，由此兴起了孔氏的家学。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "2becae8ae7e45af9",
      "checked_at": "2026-08-09T01:53:16.436850+00:00",
      "note": "散逸的「尚书」又陆续得到十多篇，「尚书」的篇目从此就增多了。"
    }
  }
}
