  "updated_at": "2026-07-28T06:16:27.095910+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "47e4bf06ac8855a5",
      "checked_at": "2026-07-28T06:15:01.381592+00:00",
      "note": "韩宣惠王十六年，秦国在脩鱼击败了韩军，又在浊泽俘虏了韩将鱼叟和申差。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "826327df1b2be4d6",
      "checked_at": "2026-07-28T06:15:01.381605+00:00",
      "note": "韩国上下一片危急，大臣公仲对韩王说：“盟国是靠不住的。秦国早就想收拾楚国了，大王不如借着张仪这条线跟秦国讲和，送一座大城，再准备好军队，跟秦国联手往南打楚国。这是一块地盘换两个好处的买卖。”韩王一听，说了一声“好”，就催促公仲去准备行程，打算向西到秦国求和。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "4810305061a12d27",
      "checked_at": "2026-07-28T06:15:01.381609+00:00",
      "note": "消息传到楚国，楚王吓了一大跳，赶紧把陈轸找来商量。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "586bbe20b5785a6b",
      "checked_at": "2026-07-28T06:15:01.381612+00:00",
      "note": "陈轸分析说：“秦国想打楚国不是一天两天了，现在又得了韩国一座大城和军队支援，秦韩两家合兵来攻，这简直是秦国做梦都在盼的事。如今眼看就要成真，楚国挨打是跑不掉了。”"
    },
    "M005–M007": {
      "status": "conveyed",
      "claim_fp": "b9ab38da88dcb9cd",
      "checked_at": "2026-07-28T06:15:01.381616+00:00",
      "note": "他紧接着献计：“大王按我说的做，在国内全面警戒，大张旗鼓地出兵，说是去救韩国。让战车塞满道路，派出得力使臣，多备车马，带足厚礼，一定得让韩国相信大王是真心来救他们的。就算韩国不听咱们的，他们也必定感激大王，不会替秦国打头阵，这么一来秦韩两家就有了嫌隙。秦军就算打过来，楚国也不至于伤筋动骨。要是韩国真信了咱们，跟秦国断了来往，秦国必然暴怒，狠狠记恨韩国。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "db18ddda779f7ccc",
      "checked_at": "2026-07-28T06:15:01.381619+00:00",
      "note": "韩国往南靠拢楚国，自然就轻视秦国；一轻视秦国，跟他们打交道就不会客气——咱们这是借着秦、韩两家的兵马来化解楚国的祸患。”"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "f673b50ce258f280",
      "checked_at": "2026-07-28T06:15:01.381622+00:00",
      "note": "楚王听完也说了声“好”，马上下令全国警戒，兴师动众地说要救韩国"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "3cf49ec14d099ebb",
      "checked_at": "2026-07-28T06:15:01.381626+00:00",
      "note": "战车塞满了道路，使臣一批批派出去，车马排场和礼物分量都往大里搞"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "2e6ce5e636a88c14",
      "checked_at": "2026-07-28T06:15:01.381629+00:00",
      "note": "楚使对韩王说：“我们楚国虽小，已经把家底全掏出来了。贵国只管放开手脚对付秦国，我们楚国拿命陪着。”"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "7b63d5b10fb092fc",
      "checked_at": "2026-07-28T06:15:01.381632+00:00",
      "note": "韩王听完这话高兴坏了，立刻叫停了公仲去秦国的事"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "c960adce0ec4a410",
      "checked_at": "2026-07-28T06:15:01.381635+00:00",
      "note": "公仲急了，说：“不行。实实在在出兵打咱们的是秦国...大王一定要后悔的”。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "46dfc9c961dea550",
      "checked_at": "2026-07-28T06:15:01.381638+00:00",
      "note": "韩王没听进去，到底还是跟秦国绝交了"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "e0072599822a3b0f",
      "checked_at": "2026-07-28T06:15:01.381642+00:00",
      "note": "“秦国因此大怒，增兵猛攻韩国，两边大打出手。楚国那边，救兵连影子都没有。”"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "616af01a9b793a55",
      "checked_at": "2026-07-28T06:15:01.381645+00:00",
      "note": "“韩宣惠王十九年，秦军在岸门大破韩军。”"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "82fdf5d9ab514425",
      "checked_at": "2026-07-28T06:15:01.381647+00:00",
      "note": "“韩国只好把太子仓送到秦国当人质，这才换来了暂时的和解。”"
    }
  }
}
