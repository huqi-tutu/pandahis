    },
    "M040–M041": {
      "status": "conveyed",
      "claim_fp": "d70f901eac272fc0",
      "checked_at": "2026-08-08T15:18:22.165581+00:00",
      "note": "张骞详细叙述了乌孙的历史，包括昆莫的出生、大月氏攻杀其父、单于收养、昆莫复仇、月氏西迁、昆莫留居、匈奴攻之不克等情节。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "67777ff5b83252db",
      "checked_at": "2026-08-08T15:18:22.165585+00:00",
