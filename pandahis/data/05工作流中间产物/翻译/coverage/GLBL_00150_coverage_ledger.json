  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "e576c1e15a2e7779",
      "checked_at": "2026-07-26T13:15:32.812163+00:00",
      "note": "太公望吕尚是东海边上的人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "c60aa1ca53f10040",
      "checked_at": "2026-07-26T13:15:32.812181+00:00",
      "note": "他的先祖曾经做过四岳，辅佐大禹治理水土，功劳很大。"
    },
    "M003–M005": {
      "status": "conveyed",
      "claim_fp": "3ec658ae56bd0e44",
      "checked_at": "2026-07-26T13:15:32.812186+00:00",
      "note": "涵盖了封吕、封申、姓姜、枝庶、庶人、苗裔、从封姓等信息。"
    },
    "M006–M008": {
      "status": "conveyed",
      "claim_fp": "daf88d6e77545590",
      "checked_at": "2026-07-26T13:15:32.812189+00:00",
      "note": "完整包含了穷困、年老、钓鱼、卜辞、遇于渭阳、对话、号太公望、载归立师。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "679528858b8c9f8e",
      "checked_at": "2026-07-26T13:15:32.812193+00:00",
      "note": "还有一种说法，说太公学问广博，曾经在纣王手下做过事。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "0f1e93ea0fc20825",
      "checked_at": "2026-07-26T13:15:32.812197+00:00",
      "note": "后来纣王无道，他就离开了。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "fd01ee62654a4c1e",
      "checked_at": "2026-07-26T13:15:32.812200+00:00",
      "note": "另有一种传闻，说吕尚是个隐士，隐居在海滨。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "f83102dfead2ee57",
      "checked_at": "2026-07-26T13:15:32.812205+00:00",
      "note": "周西伯被商纣囚禁在羑里时，散宜生、闳夭一直知道吕尚的本事，所以去请吕尚出山。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "7da04108a052d515",
      "checked_at": "2026-07-26T13:15:32.812207+00:00",
      "note": "吕尚也说「吾闻西伯贤，又善养老，盍往焉」。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "7f7681d702a5fb85",
      "checked_at": "2026-07-26T13:15:32.812210+00:00",
      "note": "这三个人就替西伯寻找美女和奇珍异宝，献给纣王，以此来为西伯赎身。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "ca2ef2a15e0d4597",
      "checked_at": "2026-07-26T13:15:32.812212+00:00",
      "note": "西伯因此得以出狱，返回了封国。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "58561735d9b08fb9",
      "checked_at": "2026-07-26T13:15:32.812215+00:00",
      "note": "这些关于吕尚为何事周的传闻虽然有差异，但结论是一致的：他成为了文王和武王的老师。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "f5ff78495e1a0284",
      "checked_at": "2026-07-26T13:15:32.812218+00:00",
      "note": "完整传达了与吕尚阴谋倾商、重兵权奇计及后世宗太公为本谋的信息。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "a36a4d0332cf3f2c",
      "checked_at": "2026-07-26T13:15:32.812221+00:00",
      "note": "完整传达了周西伯政平、断虞芮之讼及诗人称受命为文王的信息。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "290c6e5650c5f0ac",
      "checked_at": "2026-07-26T13:16:34.054597+00:00",
      "note": "伐崇、伐密须、伐犬夷，打完仗又大兴土木建丰邑"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "35c734bb3e0f3c18",
      "checked_at": "2026-07-26T13:16:34.054613+00:00",
      "note": "天下三分，其二归周者，太公之谋计居多。天下被切成三块，周家独占两块，这背后靠的是什么？大半是太公的谋划。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "40079bc3a72d15fe",
      "checked_at": "2026-07-26T13:16:34.054628+00:00",
      "note": "前九年，武王想继承文王的事业，决定往东边打一打，试试诸侯们的反应——看他们到底跟不跟。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "aefb56d462e999ce",
      "checked_at": "2026-07-26T13:16:34.054639+00:00",
      "note": "左手握着黄钺，右手举着白旄，对全军发令：「苍兕苍兕，总尔众庶，与尔舟楫，后至者斩！」"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "a947e491949b7a1b",
      "checked_at": "2026-07-26T13:16:34.054642+00:00",
      "note": "大军到了盟津。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "cc260215968ec479",
      "checked_at": "2026-07-26T13:16:34.054645+00:00",
      "note": "各路诸侯连招呼都不用打，自发赶过来的足足有八百诸侯。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "80a3dc7a75c4539e",
      "checked_at": "2026-07-26T13:16:34.054663+00:00",
      "note": "诸侯们纷纷说：「纣可以打了。」但武王很冷静，只回了两个字：「未可。」不行。于是全军撤回，回来之后，武王和太公一起作了这篇「太誓」。"
    },
    "M026–M027": {
      "status": "conveyed",
      "claim_fp": "421cdaa64cab9280",
      "checked_at": "2026-07-26T13:16:34.054666+00:00",
      "note": "又过了两年。纣杀王子比干，囚箕子。武王将伐纣，卜龟兆，不吉，风雨暴至。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "e6a498ed54f5b67a",
      "checked_at": "2026-07-26T13:16:34.054669+00:00",
      "note": "群公尽惧，唯太公彊之劝武王，武王於是遂行。十一年正月甲子，誓於牧野，伐商纣。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "6aae7b91790335cc",
      "checked_at": "2026-07-26T13:16:34.054672+00:00",
      "note": "纣王的军队一触即溃，全线崩盘。"
    },
    "M031–M033": {
      "status": "conveyed",
      "claim_fp": "9e95511b595602bb",
      "checked_at": "2026-07-26T13:16:34.054676+00:00",
      "note": "纣反走，登鹿台，遂追斩纣。明日，武王立于社，群公奉明水，卫康叔封布采席，师尚父牵牲，史佚策祝，以告神讨纣之罪。散鹿台之钱，发钜桥之粟，以振贫民。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "1e0d9e3732626f23",
      "checked_at": "2026-07-26T13:16:34.054679+00:00",
      "note": "封比干墓，释箕子囚。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "51bc2911abda23b0",
      "checked_at": "2026-07-26T13:16:34.054681+00:00",
      "note": "直接复述并扩展解释了该句母本信息。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "19d89537b886706a",
      "checked_at": "2026-07-26T13:16:34.054688+00:00",
      "note": "直接引用了母本原句并加以强调。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "f3c6ee63fdf0d433",
      "checked_at": "2026-07-26T13:17:19.751491+00:00",
      "note": "武王平定商朝、做了天下之主以后，把师尚父封在了齐地的营丘。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "223ab9d2ba4e7369",
      "checked_at": "2026-07-26T13:17:19.751513+00:00",
      "note": "吕尚领了封命就往东边自己的封国去，一路上走得不紧不慢，住宿歇息，慢慢悠悠地赶路。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "5b10dd79cfb06670",
      "checked_at": "2026-07-26T13:17:19.751519+00:00",
      "note": "旅店的主人看了，忍不住对他说：「吾闻时难得而易失。客寝甚安，殆非就国者也。」——我听说时机这东西，难得却容易丢，您这位客人睡得这么踏实，大概不像是赶着去封国上任的吧？吕尚一听这话，顿时醒悟，连夜穿上衣服就启程，黎明时分赶到了营丘。"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "15c14028e44e030c",
      "checked_at": "2026-07-26T13:17:19.751522+00:00",
      "note": "果然，他刚到，莱侯就带兵打过来了，要跟他争夺营丘。"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "fc34497cd767a190",
      "checked_at": "2026-07-26T13:17:19.751525+00:00",
      "note": "营丘这地方紧挨着莱国"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "82d494a992eedb20",
      "checked_at": "2026-07-26T13:17:19.751528+00:00",
      "note": "莱人是东夷的一支，趁着商纣之乱和周朝刚刚平定、还来不及管远方的事，所以才敢跟太公抢地盘。"
    },
    "M043–M044": {
      "status": "conveyed",
      "claim_fp": "8e7eafc071bfad78",
      "checked_at": "2026-07-26T13:17:19.751531+00:00",
      "note": "完整传达了脩政、因其俗、简其礼、通商工、便鱼盐、人民归齐、齐为大国；成王少时管蔡作乱淮夷畔周、召康公命征伐范围、齐得征伐为大国等所有要点。"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "2cc09b5e5db8a15a",
      "checked_at": "2026-07-26T13:17:19.751535+00:00",
      "note": "明确指出了都城是营丘。"
    }
  }
