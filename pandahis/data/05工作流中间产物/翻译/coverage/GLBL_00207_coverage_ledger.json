{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00207",
  "updated_at": "2026-08-09T06:41:20.958715+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "efba0fc9d83964a1",
      "checked_at": "2026-08-08T14:54:13.838659+00:00",
      "note": "王太后是槐里人，母亲叫臧儿。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "9b2e029d37c5248b",
      "checked_at": "2026-08-08T14:54:13.838669+00:00",
      "note": "这位臧儿来头不小，她是原燕王臧荼的孙女。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "fe0bd651d90b7682",
      "checked_at": "2026-08-08T14:54:13.838670+00:00",
      "note": "臧儿嫁给槐里人王仲为妻，生下儿子王信和两个女儿。"
    },
    "M004–M005": {
      "status": "conveyed",
      "claim_fp": "29c34f4ef6763b29",
      "checked_at": "2026-08-08T14:54:13.838672+00:00",
      "note": "王仲死后，臧儿改嫁长陵田氏，又生下儿子田蚡、田胜。臧儿的长女嫁给金王孙为妻，已经生了一个女儿。可臧儿一占卜，算出两个女儿都该大贵。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "18e57e2864f1b28a",
      "checked_at": "2026-08-08T14:54:13.838673+00:00",
      "note": "于是打定主意要让女儿们显贵，硬是把长女从金家夺了回来。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "fe66ee4bbab46992",
      "checked_at": "2026-08-08T14:54:13.838674+00:00",
      "note": "金家愤怒，不肯断绝关系，臧儿索性把女儿送进了太子宫。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "7629c7f169f08e11",
      "checked_at": "2026-08-08T14:54:13.838676+00:00",
      "note": "太子宠幸喜爱她，她生下三个女儿一个儿子。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "4581f72345449c51",
      "checked_at": "2026-08-08T14:54:13.838682+00:00",
      "note": "怀这个儿子的时候，王美人梦见太阳落入自己怀中。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "ab23608e352f828b",
      "checked_at": "2026-08-08T14:54:13.838683+00:00",
      "note": "她把梦告诉太子，太子说：「此贵徵也。」——这是显贵的征兆。孩子还没出生，孝文帝驾崩，孝景帝即位，王夫人生下了这个男孩。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "be2f89c9c2715d51",
      "checked_at": "2026-08-08T14:54:13.838684+00:00",
      "note": "此前，臧儿又把小女儿儿姁也送进了宫，儿姁生下四个男孩。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "e5273a1db3f05415",
      "checked_at": "2026-08-08T14:54:13.838690+00:00",
      "note": "景帝做太子时，薄太后把薄氏女子立为太子妃。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "6918189082ef75a8",
      "checked_at": "2026-08-08T14:54:13.838692+00:00",
      "note": "到景帝即位，立这位薄妃为薄皇后。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "e219636a200d4b8f",
      "checked_at": "2026-08-08T14:54:13.838693+00:00",
      "note": "薄皇后没有儿子，也不受宠。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "a3865562c27770a6",
      "checked_at": "2026-08-08T14:54:13.838698+00:00",
      "note": "薄太后去世后，薄皇后被废。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "40842751bf9ccd2a",
      "checked_at": "2026-08-08T14:54:13.838699+00:00",
      "note": "景帝的长子刘荣，母亲是栗姬。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "84cf16b768ec4e6f",
      "checked_at": "2026-08-08T14:54:13.838700+00:00",
      "note": "栗姬是齐地人。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "09ba3844fcdf8844",
      "checked_at": "2026-08-08T14:54:13.838701+00:00",
      "note": "刘荣被立为太子。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "549200c1a61e5825",
      "checked_at": "2026-08-08T14:54:27.888453+00:00",
      "note": "长公主刘嫖有个女儿，想嫁给太子刘荣做妃子。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "9ed953cf90a597ec",
      "checked_at": "2026-08-08T14:54:27.888456+00:00",
      "note": "栗姬嫉妒，而景帝的众多美人都通过长公主引见得以见到景帝，获得尊贵宠幸，风头都盖过了栗姬。栗姬日益怨恨愤怒，便谢绝了长公主，不答应这门婚事。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "beadcb906066dc81",
      "checked_at": "2026-08-08T14:54:27.888457+00:00",
      "note": "长公主转而想把女儿许配给王夫人的儿子，王夫人答应了。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "17cb4c69b1edd5f3",
      "checked_at": "2026-08-08T14:54:27.888458+00:00",
      "note": "长公主由此恼怒，天天在景帝面前说栗姬的坏话：「栗姬与诸贵夫人幸姬会，常使侍者祝唾其背，挟邪媚道。」——说栗姬跟那些贵夫人、宠姬聚会时，常常让侍从在背后诅咒唾骂，搞歪门邪道的媚术。景帝因此对栗姬心生不满。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "1ae94c2201492474",
      "checked_at": "2026-08-08T14:54:27.888459+00:00",
      "note": "景帝曾身体不适，心中不乐，把封为王的儿子们托付给栗姬，说：「百岁后，善视之。」——我死后，好好照顾他们。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "be9da7902047dd44",
      "checked_at": "2026-08-08T14:54:27.888460+00:00",
      "note": "栗姬发怒，不肯答应，出言不逊。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "c32fcb9f365c5c61",
      "checked_at": "2026-08-08T14:54:27.888460+00:00",
      "note": "景帝愤怒，心中怀恨但没有发作。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "4e64fba1411e23b9",
      "checked_at": "2026-08-08T14:54:27.888461+00:00",
      "note": "长公主每天称赞王夫人儿子的美德，景帝也认为他贤能，又有从前梦日入怀的符兆，但主意还未定下来。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "3e5ae16ca8689bc1",
      "checked_at": "2026-08-08T14:54:27.888462+00:00",
      "note": "王夫人知道景帝怨恨栗姬，趁怒气未消，暗中派人催促大臣奏请立栗姬为皇后。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "d3aeb47eb9c1eb3d",
      "checked_at": "2026-08-08T14:54:27.888463+00:00",
      "note": "大行奏事完毕，说：『子以母贵，母以子贵』，今太子母无号，宜立为皇后。景帝怒道：『是而所宜言邪！』于是追究大行的罪责并诛杀了他，又废太子刘荣为临江王。栗姬更加愤怒怨恨，无法见到景帝，最终忧愁而死。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "3289020c32665701",
      "checked_at": "2026-08-08T14:54:27.888464+00:00",
      "note": "最终立王夫人为皇后，她的儿子为太子，封皇后兄长王信为盖侯。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "d10552231c750e7a",
      "checked_at": "2026-08-08T14:54:27.888465+00:00",
      "note": "尊封皇太后母亲臧儿为平原君。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "eb7a529a8ee1d11b",
      "checked_at": "2026-08-08T14:54:27.888466+00:00",
      "note": "译文明确提到“封田蚡为武安侯，田胜为周阳侯。”"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "710fbc8b67ce9cd1",
      "checked_at": "2026-08-08T14:54:27.888467+00:00",
      "note": "译文明确提到“景帝有十三个儿子，一个做了皇帝，十二个都封为王。”"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "b647aede5dcf8892",
      "checked_at": "2026-08-08T14:54:27.888468+00:00",
      "note": "译文明确提到“王太后长女封号平阳公主，次女南宫公主，再次林虑公主。”"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "9ca874be0d1f4515",
      "checked_at": "2026-08-08T14:54:27.888469+00:00",
      "note": "译文明确提到“盖侯王信喜好喝酒。”"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "4c2e789196a80642",
      "checked_at": "2026-08-08T14:54:27.888470+00:00",
      "note": "译文明确提到“田蚡、田胜贪婪，善于文辞。”"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "c05387bfe23c3905",
      "checked_at": "2026-08-08T14:54:32.088111+00:00",
      "note": "王仲死得早，葬在槐里，后来被追尊为共侯，朝廷还专门给他设置了二百家的园邑来守陵。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "a93b54cf4fb326b5",
      "checked_at": "2026-08-08T14:54:32.088123+00:00",
      "note": "算下来，王太后一家前后共有三人封侯。"
    }
  }
}
