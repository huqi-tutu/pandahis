  "updated_at": "2026-07-26T12:58:38.274710+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "2636f8324b0439ce",
      "checked_at": "2026-07-26T12:10:57.876872+00:00",
      "note": "明确陈述了唐叔虞是周武王之子、成王之弟。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "fef25e0e631482c3",
      "checked_at": "2026-07-26T12:10:57.876891+00:00",
      "note": "完整传达了武王梦天赐名、手纹为虞、因而命名的全部要素。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "05f99fe645d74a98",
      "checked_at": "2026-07-26T12:10:57.876895+00:00",
      "note": "包含了成王与叔虞游戏、削桐叶为珪、史佚请择日立叔虞的信息。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "1a015a36d55826a0",
      "checked_at": "2026-07-26T12:10:57.876915+00:00",
      "note": "完整表达了成王以戏言回应、史佚论天子无戏言，最终封叔虞于唐。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "4e4f76752205a408",
      "checked_at": "2026-07-26T12:10:57.876918+00:00",
      "note": "给出了唐地的位置（河、汾之东）和面积（方圆百里），并解释了唐叔虞称呼的由来。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "f1d07deb41840c50",
      "checked_at": "2026-07-26T12:10:57.876921+00:00",
      "note": "明确写出姓姬，字子于。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "34a9ff50985b3300",
      "checked_at": "2026-07-26T12:10:57.876924+00:00",
      "note": "明确提到燮即位为晋侯，信息完整。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "9f51ea473e151d3d",
      "checked_at": "2026-07-26T12:10:57.876927+00:00",
      "note": "明确提到宁族为武侯，信息完整。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "2ecafa84a2d39a00",
      "checked_at": "2026-07-26T12:10:57.876930+00:00",
      "note": "明确提到服人为成侯，信息完整。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "d53767e4d328c9e1",
      "checked_at": "2026-07-26T12:10:57.876934+00:00",
      "note": "明确提到福为厉侯，信息完整。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "edc363a9acb1b616",
      "checked_at": "2026-07-26T12:10:57.876936+00:00",
      "note": "明确提到宜臼为靖侯，信息完整。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "607462d1a057bb3a",
      "checked_at": "2026-07-26T12:10:57.876939+00:00",
      "note": "明确提到从靖侯开始纪年可考，信息完整。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "865ed3953fa37954",
      "checked_at": "2026-07-26T12:10:57.876941+00:00",
      "note": "从唐叔虞传到靖侯，一共五代，但这五代的在位年数，史料已经说不清楚了。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "232621b3d24c9093",
      "checked_at": "2026-07-26T12:10:57.876944+00:00",
      "note": "靖侯十七年这一年，天下发生了一件大事——周厉王暴虐无道，国都的老百姓忍无可忍起来造反，厉王狼狈出逃到了彘地。天子跑了，就由大臣们共同执掌朝政，史称「共和」。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "6b7d2c40e471a6bb",
      "checked_at": "2026-07-26T12:10:57.876947+00:00",
      "note": "又过了一些年，到晋釐侯十四年的时候，周宣王即位。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "f3c84568ee447948",
      "checked_at": "2026-07-26T12:10:57.876950+00:00",
      "note": "穆侯四年，娶了齐国姜氏女子做夫人。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "915f26a26deec0f6",
      "checked_at": "2026-07-26T12:10:57.876952+00:00",
      "note": "七年，讨伐条地。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "7358110a7cef0dcb",
      "checked_at": "2026-07-26T12:10:57.876959+00:00",
      "note": "这一年，夫人生下了太子仇。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "53e2ef08440298b4",
      "checked_at": "2026-07-26T12:11:49.464797+00:00",
      "note": "穆侯十年，征伐千亩，打了胜仗。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "d36b491501b2a523",
      "checked_at": "2026-07-26T12:11:49.464811+00:00",
      "note": "就在这一年，他的小儿子出生了，取名叫作成师。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "032e3a9af3490c46",
      "checked_at": "2026-07-26T12:11:49.464821+00:00",
      "note": "师服的话完整复述，事件齐全"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "1dc1b1f97bd995d9",
      "checked_at": "2026-07-26T12:11:49.464824+00:00",
      "note": "穆侯太子仇带着自己的人马杀了回来，袭击殇叔，夺回了君位，这就是晋文侯。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "ad58758a0c231a26",
      "checked_at": "2026-07-26T12:11:49.464827+00:00",
      "note": "文侯十年，周幽王无道，犬戎攻入镐京，杀了幽王，周王室被迫往东迁徙。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "f2f4a27144b2ca64",
      "checked_at": "2026-07-26T12:11:49.464831+00:00",
      "note": "秦襄公因为护送周平王东迁有功，开始正式被列为诸侯。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "12df8b869f92ef51",
      "checked_at": "2026-07-26T12:11:49.464833+00:00",
      "note": "文侯之后，他的儿子昭侯继位。昭侯元年，把叔叔成师封到了曲沃。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "5393090470ce7097",
      "checked_at": "2026-07-26T12:11:49.464836+00:00",
      "note": "曲沃城比翼都还要大。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "414946e62817f47e",
      "checked_at": "2026-07-26T12:11:49.464839+00:00",
      "note": "翼，是晋国国君的都城。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "bff0479d607b9d8f",
      "checked_at": "2026-07-26T12:11:49.464842+00:00",
      "note": "成师被封到曲沃之后，称号叫作桓叔。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "6c826cf2abdff2d1",
      "checked_at": "2026-07-26T12:11:49.464845+00:00",
      "note": "靖侯的庶孙栾宾做他的辅相。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "d31fd6a18ae2713d",
      "checked_at": "2026-07-26T12:11:49.464848+00:00",
      "note": "桓叔这时候已经五十八岁了，为人好德，晋国的民众都愿意归附他。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "8717bfc187e6e4dc",
      "checked_at": "2026-07-26T12:11:49.464851+00:00",
      "note": "当时就有明白人说了：「晋国的祸乱大概要从曲沃起来了。枝末比根本还大，还深得民心，想不乱，可能吗！」"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "bb195f8e6534f836",
      "checked_at": "2026-07-26T12:11:49.464854+00:00",
      "note": "昭侯七年，晋国的大臣潘父杀了国君昭侯，派人去迎接曲沃桓叔。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "de04715c30ad4b55",
      "checked_at": "2026-07-26T12:11:49.464856+00:00",
      "note": "桓叔想趁机进入晋都，晋人却发兵攻打他。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "7e18fa9ba159093b",
      "checked_at": "2026-07-26T12:11:49.464858+00:00",
      "note": "桓叔战败，只好退回曲沃。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "c3863ad759439cb4",
      "checked_at": "2026-07-26T12:11:49.464860+00:00",
      "note": "晋人共同拥立昭侯的儿子平为国君，这就是孝侯。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "57363db28037e308",
      "checked_at": "2026-07-26T12:11:49.464863+00:00",
      "note": "孝侯即位之后，立即杀了潘父。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "200c3e7c815c1cfb",
      "checked_at": "2026-07-26T12:12:43.126728+00:00",
      "note": "孝侯在位的第十五年，曲沃庄伯带兵杀入晋国都城翼，把自己的国君晋孝侯给杀了。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "f388015f818f7af3",
      "checked_at": "2026-07-26T12:12:43.126741+00:00",
      "note": "晋国人群起而攻之，庄伯力不能支，只好又退回曲沃老巢。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "2b1ac632833f1a71",
      "checked_at": "2026-07-26T12:12:43.126744+00:00",
      "note": "晋人于是拥立孝侯的儿子郄为国君，这就是鄂侯。"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "99f2fd8e8e909db9",
      "checked_at": "2026-07-26T12:12:43.126747+00:00",
      "note": "鄂侯二年，鲁国那边，鲁隐公刚刚即位。"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "64559b2da335aad4",
      "checked_at": "2026-07-26T12:12:43.126750+00:00",
      "note": "周平王见曲沃一脉屡屡犯上作乱，便派虢公统率王师讨伐曲沃庄伯。庄伯抵挡不住王师的威势，退保曲沃城。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "d18c698ab2c2f669",
      "checked_at": "2026-07-26T12:12:43.126753+00:00",
      "note": "此役过后，晋国人共同拥立鄂侯的儿子光为君，这就是哀侯。"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "32610a500fc80a04",
      "checked_at": "2026-07-26T12:12:43.126755+00:00",
      "note": "哀侯六年，鲁国发生了弑君事件，鲁隐公被杀。"
    },
    "M044": {
      "status": "conveyed",
      "claim_fp": "bb91f17eb12e422b",
      "checked_at": "2026-07-26T12:12:43.126757+00:00",
      "note": "哀侯八年，晋国出兵侵伐一个叫陉廷的地方。"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "d2bb62a3977196a9",
      "checked_at": "2026-07-26T12:12:43.126760+00:00",
      "note": "陉廷人咽不下这口气，转头就跟曲沃武公合谋。九年，双方联手在汾水旁大举伐晋，结果晋军大败，连哀侯本人也被俘虏了。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "938f5325e826d6d7",
      "checked_at": "2026-07-26T12:12:43.126763+00:00",
      "note": "国君都被抓了，晋国人没办法，只好立哀侯的儿子小子为君，这就是小子侯。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "87317b22dc05757f",
      "checked_at": "2026-07-26T12:12:43.126765+00:00",
      "note": "小子侯元年，曲沃武公派了一个叫韩万的人，把之前俘虏的晋哀侯给杀了。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "ead3ed3a210f2fe3",
      "checked_at": "2026-07-26T12:12:43.126767+00:00",
      "note": "自此曲沃益彊，晋国方面却是无可奈何。"
    },
    "M049": {
      "status": "conveyed",
      "claim_fp": "74bf2db7c7bf8dc0",
      "checked_at": "2026-07-26T12:12:43.126770+00:00",
      "note": "小子侯在位的第四年，曲沃武公设计把他诱骗出来召见，趁势杀掉。"
    },
    "M050": {
      "status": "conveyed",
      "claim_fp": "b13ea7a410af17b8",
      "checked_at": "2026-07-26T12:12:43.126772+00:00",
      "note": "周桓王再次出手干预，派虢仲领兵讨伐曲沃武公，武公再次退入曲沃老巢。周王室于是立了晋哀侯的弟弟缗为晋侯。"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "103fe579f6e1ff6c",
      "checked_at": "2026-07-26T12:12:43.126774+00:00",
      "note": "晋侯缗四年，宋国逮住了郑国的祭仲，强行立了突做郑国的国君。"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "250d1fc67b7771bd",
      "checked_at": "2026-07-26T12:12:43.126776+00:00",
      "note": "晋侯缗十九年，齐国的管至父弑杀了他的国君齐襄公。"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "c03fb390e678e6ad",
      "checked_at": "2026-07-26T12:12:43.126778+00:00",
      "note": "晋侯缗二十八年，齐桓公开始称霸诸侯。"
    },
    "M054": {
      "status": "conveyed",
      "claim_fp": "4c0e6e45fec9e0b2",
      "checked_at": "2026-07-26T12:12:43.126780+00:00",
      "note": "同年，曲沃武公大举伐晋，攻灭晋侯缗，把晋室的全部宝器搜集起来，尽数贿赂献给了周釐王。"
    },
    "M055": {
      "status": "conveyed",
      "claim_fp": "0fc0df626b331035",
      "checked_at": "2026-07-26T12:13:14.312608+00:00",
      "note": "明确写出周釐王任命武公为晋君，列为诸侯，吞并晋地。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "26e67eeaefad9181",
      "checked_at": "2026-07-26T12:13:14.312629+00:00",
      "note": "明确即位37年改称晋武公。"
    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "506a27823b2c4b4c",
      "checked_at": "2026-07-26T12:13:14.312633+00:00",
      "note": "明确开始以晋都为都，之前即位曲沃，总共38年。"
    },
    "M058": {
      "status": "conveyed",
      "claim_fp": "e9da2303908d7f24",
      "checked_at": "2026-07-26T12:13:14.312636+00:00",
      "note": "明确名称，穆侯曾孙，桓叔之孙。"
    },
    "M059": {
      "status": "conveyed",
      "claim_fp": "a14f309393b01c02",
      "checked_at": "2026-07-26T12:13:14.312639+00:00",
      "note": "明确桓叔开始受封曲沃。"
    },
    "M060": {
      "status": "conveyed",
      "claim_fp": "bb0b9f0f0d00daa9",
      "checked_at": "2026-07-26T12:13:14.312642+00:00",
      "note": "明确武公是庄伯之子。"
    },
    "M061": {
      "status": "conveyed",
      "claim_fp": "df1a0724534c7b66",
      "checked_at": "2026-07-26T12:13:14.312644+00:00",
      "note": "武公取代晋国之后两年，就去世了。"
    },
    "M062": {
      "status": "conveyed",
      "claim_fp": "b75560dca370c394",
      "checked_at": "2026-07-26T12:13:14.312647+00:00",
      "note": "他的儿子献公诡诸即位。"
    }
  }
}
