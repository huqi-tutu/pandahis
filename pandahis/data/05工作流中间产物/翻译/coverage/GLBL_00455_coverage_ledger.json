  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "d3de2907d2a05c91",
      "checked_at": "2026-08-09T04:08:22.931616+00:00",
      "note": "辕固生是齐地人，后来做过清河王的太傅。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "b9d1aee5f9729962",
      "checked_at": "2026-08-09T04:08:22.931620+00:00",
      "note": "他专攻「诗经」，在汉景帝时期担任博士。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "5b9289207906f912",
      "checked_at": "2026-08-09T04:08:22.931622+00:00",
      "note": "有一次，他在景帝面前和黄生争论起来。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "70bbe116c5a8d1b9",
      "checked_at": "2026-08-09T04:08:22.931623+00:00",
      "note": "黄生说：「商汤和周武王并不是承受天命，而是弑君篡位。」辕固生反驳道：「不对。夏桀和商纣暴虐昏乱，天下人心都归向汤武。汤武顺应天下人心去诛讨桀纣，桀纣的百姓不肯为他们效力，反而归附汤武。汤武是不得已才即位的，这不是承受天命又是什么？」黄生又说：「帽子再破，也得戴在头上；鞋子再新，也得穿在脚下。为什么？因为上下尊卑的名分摆在那里。如今桀纣虽然失道，但终究是君上；汤武虽然圣明，但终究是臣下。君主有过失，"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "bd81d1e720a590c9",
      "checked_at": "2026-08-09T04:08:22.931625+00:00",
      "note": "从此以后，学者们再没有人敢公开谈论商汤、周武王承受天命、放伐弑君的事了。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "814e020d3d723834",
      "checked_at": "2026-08-09T04:08:22.931627+00:00",
      "note": "窦太后喜好「老子」一书，召来辕固生问他对这部书的看法。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "5cef01b234bcd673",
      "checked_at": "2026-08-09T04:08:22.931628+00:00",
      "note": "白话译文明确提到辕固生称《老子》为“家人奴仆之言”，太后大怒，反问“哪里来的刑徒之书”，并命其入兽圈刺野猪。"
    },
    "M008–M009": {
      "status": "conveyed",
      "claim_fp": "979681b814797b08",
      "checked_at": "2026-08-09T04:08:22.931635+00:00",
      "note": "译文描述景帝借给辕固生利兵，他刺中野猪心脏，野猪应手而倒，太后默然，无法再治罪。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "f520bcc93d3bc8dc",
      "checked_at": "2026-08-09T04:08:22.931637+00:00",
      "note": "译文提到“过了不久，景帝认为辕固生廉洁正直，任命他为清河王太傅。”"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "bc8d579242ac8b0a",
      "checked_at": "2026-08-09T04:08:22.931638+00:00",
      "note": "译文提到“又过了很久，他因病免官。”"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "1becff8430aa2769",
      "checked_at": "2026-08-09T04:08:22.931640+00:00",
      "note": "译文提到“汉武帝刚即位时，又以贤良方正的名义征召辕固生。”"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "7d843cf749f6fb08",
      "checked_at": "2026-08-09T04:08:22.931641+00:00",
      "note": "译文提到“那些阿谀逢迎的儒生嫉妒他、诋毁他，说他‘太老了’，于是他被罢免遣归。”"
    },
