{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00202",
  "updated_at": "2026-08-09T06:41:20.910517+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "08be2954a9da505c",
      "checked_at": "2026-08-08T14:49:36.731096+00:00",
      "note": "明确说明刘武是文帝之子，与景帝同母。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "3e7ee3db779e1242",
      "checked_at": "2026-08-08T14:49:36.731105+00:00",
      "note": "直接指出母亲是窦太后。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "3ffd95fb44c2fe86",
      "checked_at": "2026-08-08T14:49:36.731108+00:00",
      "note": "列出了四个儿子的顺序和名字。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "2916337eba09bf86",
      "checked_at": "2026-08-08T14:49:36.731111+00:00",
      "note": "明确封王时间和封地。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "17b4d1a7ff30957b",
      "checked_at": "2026-08-08T14:49:36.731113+00:00",
      "note": "明确改封为淮阳王。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "8c2b6415b9b978d9",
      "checked_at": "2026-08-08T14:49:36.731115+00:00",
      "note": "说明代地划给太原王，太原王改称代王。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "f7c6735758542685",
      "checked_at": "2026-08-08T14:49:36.731117+00:00",
      "note": "他的儿子刘登继位，这就是代共王。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "b7f08ca766d9b0ce",
      "checked_at": "2026-08-08T14:49:36.731126+00:00",
      "note": "刘登的儿子刘义继位，这就是代王。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "dc397302e3557d93",
      "checked_at": "2026-08-08T14:49:36.731128+00:00",
      "note": "代王十九年，汉朝扩大关隘，以常山为界，把代王改封到清河。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "015d5e9b1f2fabbb",
      "checked_at": "2026-08-08T14:49:36.731130+00:00",
      "note": "清河王改封，是在元鼎三年。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "8b56d27e932e3ad0",
      "checked_at": "2026-08-08T14:49:36.731132+00:00",
      "note": "梁怀王刘胜是文帝最小的儿子，受到的宠爱超过其他儿子。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "e8be9758cbdbb6a1",
      "checked_at": "2026-08-08T14:49:36.731134+00:00",
      "note": "第二年，朝廷把淮阳王刘武改封为梁王。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "414d3171b5213c0a",
      "checked_at": "2026-08-08T14:49:36.731136+00:00",
      "note": "梁王初封到梁地，是在文帝十二年。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "a16b967369330b3a",
      "checked_at": "2026-08-08T14:49:36.731138+00:00",
      "note": "梁王从最初封王算起，到这时已经历十一年了。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "3243f4018d3bf98a",
      "checked_at": "2026-08-08T14:49:36.731139+00:00",
      "note": "梁王十四年，入朝觐见。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "249608231d5ea96f",
      "checked_at": "2026-08-08T14:49:36.731141+00:00",
      "note": "十七年、十八年，接连两年入朝，留在长安，第二年才回到封国。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "91490c5368b90e55",
      "checked_at": "2026-08-08T14:49:36.731143+00:00",
      "note": "二十一年，入朝。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "8893cfa5922f5024",
      "checked_at": "2026-08-08T14:49:36.731145+00:00",
      "note": "二十四年，入朝。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "5d4b0399e2247f4b",
      "checked_at": "2026-08-08T14:49:50.027414+00:00",
      "note": "到了二十五年，梁王又一次入朝。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "dd47144b82631ba7",
      "checked_at": "2026-08-08T14:49:50.027421+00:00",
      "note": "这时候，景帝还没有册立太子。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "becef9e737319b84",
      "checked_at": "2026-08-08T14:49:50.027425+00:00",
      "note": "景帝与梁王在一起宴饮，闲谈间随口说道：「千秋万岁后传於王。」——等我百年之后，把皇位传给你。梁王连忙辞谢。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "10da57bec3079acd",
      "checked_at": "2026-08-08T14:49:50.027428+00:00",
      "note": "虽然心里明白这不是什么深思熟虑的正经话，但内心还是暗暗高兴。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "1c0289004c621df3",
      "checked_at": "2026-08-08T14:49:50.027431+00:00",
      "note": "窦太后也是如此。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "3c0b6f87ce405bce",
      "checked_at": "2026-08-08T14:49:50.027434+00:00",
      "note": "这年春天，吴、楚、齐、赵等七国联合造反。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "8320a94c2c482a7d",
      "checked_at": "2026-08-08T14:49:50.027437+00:00",
      "note": "吴楚联军先攻打梁国的棘壁，杀了数万人。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "fe1e877b10fcaee1",
      "checked_at": "2026-08-08T14:49:50.027440+00:00",
      "note": "梁孝王据守睢阳城，派韩安国、张羽等人为大将军，抵御吴楚。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "474b7bc0fb806c7c",
      "checked_at": "2026-08-08T14:49:50.027443+00:00",
      "note": "吴楚联军被梁国挡住，不敢越过梁国向西进兵，与太尉周亚夫等人相持了三个月。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "b551d65d786f7963",
      "checked_at": "2026-08-08T14:49:50.027450+00:00",
      "note": "吴楚被击破后，梁国所斩杀、俘虏的敌军，与汉朝中央军大致相当。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "06e78f99d46d7fc8",
      "checked_at": "2026-08-08T14:49:50.027453+00:00",
      "note": "第二年，汉朝立了太子。"
    },
    "M030–M031": {
      "status": "conveyed",
      "claim_fp": "a97ceb6b8de9a2a7",
      "checked_at": "2026-08-08T14:49:50.027457+00:00",
      "note": "此后，梁王与皇帝关系最亲，又有大功，又是大国，占据天下最肥沃的土地。领地北到泰山，西到高阳，有四十多座城，大多是大的县。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "f18cebe65fc65caf",
      "checked_at": "2026-08-08T14:49:50.027461+00:00",
      "note": "梁孝王是窦太后的幼子，太后疼爱他，赏赐多得说不完。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "466b643247ebced3",
      "checked_at": "2026-08-08T14:49:50.027464+00:00",
      "note": "于是孝王修筑东苑，方圆三百多里。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "4d214b85dc5d48b5",
      "checked_at": "2026-08-08T14:49:50.027467+00:00",
      "note": "扩建睢阳城达七十里。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "6f8fa72f5200d7e8",
      "checked_at": "2026-08-08T14:49:50.027471+00:00",
      "note": "大修宫室，修建复道，从宫殿一直连接到平台，长达三十多里。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "6bb87dbd566536cc",
      "checked_at": "2026-08-08T14:49:50.027474+00:00",
      "note": "他被赐予天子的旌旗，出行时有千乘万骑随从。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "8aaf6ff405435c9b",
      "checked_at": "2026-08-08T14:50:11.406179+00:00",
      "note": "东西驰骋打猎，排场比照天子。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "684d90d1fa7c8d28",
      "checked_at": "2026-08-08T14:50:11.406191+00:00",
      "note": "「出言跸，入言警。」——外出清道戒严，入内警戒护卫。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "469a530ce9da4936",
      "checked_at": "2026-08-08T14:50:11.406195+00:00",
      "note": "招揽四方豪杰，崤山以东的游说之士，没有不来的"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "983328b89286ff92",
      "checked_at": "2026-08-08T14:50:11.406198+00:00",
      "note": "齐人羊胜、公孙诡、邹阳之流都在其中"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "87af469fdc3d1436",
      "checked_at": "2026-08-08T14:50:11.406201+00:00",
      "note": "公孙诡多奇邪之计，初次见王，就赏赐千金，官做到中尉，梁国人称他为公孙将军。梁国大量制造兵器弩弓矛，有数十万件，府库金钱将近百万万，珠玉宝器比京师还多。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "4151ffff1236e573",
      "checked_at": "2026-08-08T14:50:11.406203+00:00",
      "note": "二十九年十月，梁孝王入朝。"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "e5c8157b08affed1",
      "checked_at": "2026-08-08T14:50:11.406206+00:00",
      "note": "景帝派使者持节，驾着天子专用的四匹马拉的车，到关下迎接梁王。"
    },
    "M044–M045": {
      "status": "conveyed",
      "claim_fp": "7c223091c9088ce2",
      "checked_at": "2026-08-08T14:50:11.406209+00:00",
      "note": "朝见之后，梁王上疏请求留在京城，因为太后亲近的缘故。梁王入宫就跟景帝同乘一辇，出宫就同车游猎，在上林苑射杀禽兽。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "b219f6af45dfe6a8",
      "checked_at": "2026-08-08T14:50:11.406212+00:00",
      "note": "梁国的侍中、郎、谒者登记名籍，出入天子殿门，跟汉朝宦官没有区别。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "1c2ce3fa96641f17",
      "checked_at": "2026-08-08T14:50:11.406215+00:00",
      "note": "十一月，皇上废了栗太子，窦太后心里想让孝王做继承人。"
    },
    "M048": {
      "status": "conveyed",
      "claim_fp": "5073dd18f3640b8a",
      "checked_at": "2026-08-08T14:50:11.406218+00:00",
      "note": "大臣和袁盎等人向景帝进言劝阻，窦太后的想法被搁置，也就不再提让梁王做继承人的事了。"
    },
    "M049": {
      "status": "conveyed",
      "claim_fp": "6f3970a0d6093d60",
      "checked_at": "2026-08-08T14:50:11.406220+00:00",
      "note": "因为事情隐秘，世人不知道。"
    },
    "M050": {
      "status": "conveyed",
      "claim_fp": "3fd3496d0fa7fd99",
      "checked_at": "2026-08-08T14:50:11.406223+00:00",
      "note": "梁王于是告辞回国。"
    },
    "M051": {
      "status": "conveyed",
      "claim_fp": "44ae95d0a5b00490",
      "checked_at": "2026-08-08T14:50:11.406226+00:00",
      "note": "那年夏天四月，皇上立胶东王为太子。"
    },
    "M052": {
      "status": "conveyed",
      "claim_fp": "04796b6178a15865",
      "checked_at": "2026-08-08T14:50:11.406228+00:00",
      "note": "梁王怨恨袁盎和那些议事的大臣，就跟羊胜、公孙诡等人暗中派人刺杀袁盎和其他议事大臣十多人。"
    },
    "M053": {
      "status": "conveyed",
      "claim_fp": "1ec02700f869970c",
      "checked_at": "2026-08-08T14:50:11.406231+00:00",
      "note": "追捕刺客，没有抓到。"
    },
    "M054": {
      "status": "conveyed",
      "claim_fp": "c14301494b53a05a",
      "checked_at": "2026-08-08T14:50:11.406234+00:00",
      "note": "于是天子怀疑梁王，追查刺客，果然是梁王指使的。"
    },
    "M055": {
      "status": "conveyed",
      "claim_fp": "0f5d2aa7b9a370c4",
      "checked_at": "2026-08-08T14:50:24.494954+00:00",
      "note": "使者一批接一批地派往梁国，车盖在路上连绵相望，反复审查梁国之事，要逮捕公孙诡和羊胜。"
    },
    "M056": {
      "status": "conveyed",
      "claim_fp": "17153e8dba3550d0",
      "checked_at": "2026-08-08T14:50:24.494963+00:00",
      "note": "公孙诡、羊胜躲藏在梁王的后宫里。"
    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "73a3dd0163cdf095",
      "checked_at": "2026-08-08T14:50:24.494966+00:00",
      "note": "使者催逼梁国二千石官员催得很急，梁相轩丘豹和内史韩安国一同进宫劝谏梁王，梁王这才命令羊胜、公孙诡都自杀，把尸体交了出来。"
    },
    "M058": {
      "status": "conveyed",
      "claim_fp": "bd10963d9e29c680",
      "checked_at": "2026-08-08T14:50:24.494969+00:00",
      "note": "景帝从此对梁王心怀怨恨。"
    },
    "M059": {
      "status": "conveyed",
      "claim_fp": "0fd2c016316998ab",
      "checked_at": "2026-08-08T14:50:24.494972+00:00",
      "note": "梁王害怕了，便派韩安国通过长公主向太后谢罪，这才得以解脱。"
    },
    "M060": {
      "status": "conveyed",
      "claim_fp": "1647339679ff47d0",
      "checked_at": "2026-08-08T14:50:24.494975+00:00",
      "note": "景帝的怒气稍稍消解，梁王趁机上书请求入朝。"
    },
    "M061–M062": {
      "status": "conveyed",
      "claim_fp": "83dc2a294316c86c",
      "checked_at": "2026-08-08T14:50:24.494978+00:00",
      "note": "到了函谷关，茅兰劝说梁王，让他乘坐布车，只带两名骑兵随从入关，躲藏在长公主的园子里。汉朝派使者迎接梁王，梁王已经入关，车马随从都留在关外，没人知道梁王在哪里。"
    },
    "M063": {
      "status": "conveyed",
      "claim_fp": "da664db6f9800ddb",
      "checked_at": "2026-08-08T14:50:24.494981+00:00",
      "note": "太后哭着说：“皇帝杀了我的儿子！”景帝又忧又怕。"
    },
    "M064": {
      "status": "conveyed",
      "claim_fp": "468b2cfcb34a66ef",
      "checked_at": "2026-08-08T14:50:24.494984+00:00",
      "note": "于是梁王在宫阙之下伏着斧质请罪，然后太后、景帝都非常高兴，相对而泣，关系恢复如初。"
    },
    "M065": {
      "status": "conveyed",
      "claim_fp": "ce04ddd57a438255",
      "checked_at": "2026-08-08T14:50:24.494986+00:00",
      "note": "景帝把梁王的随从官员全部召入关内。"
    },
    "M066": {
      "status": "conveyed",
      "claim_fp": "9ff0a3e8fe4902ee",
      "checked_at": "2026-08-08T14:50:24.494989+00:00",
      "note": "但景帝从此更加疏远梁王，不再与他同乘一辆车辇了。"
    },
    "M067": {
      "status": "conveyed",
      "claim_fp": "d2d7079ea1aecf85",
      "checked_at": "2026-08-08T14:50:24.494992+00:00",
      "note": "三十五年冬天，梁王再次入朝。"
    },
    "M068": {
      "status": "conveyed",
      "claim_fp": "cfcc0c70ff73d80d",
      "checked_at": "2026-08-08T14:50:24.494995+00:00",
      "note": "上疏想留在长安，景帝没有答应。"
    },
    "M069": {
      "status": "conveyed",
      "claim_fp": "00d6b40ae5001472",
      "checked_at": "2026-08-08T14:50:24.494997+00:00",
      "note": "回到封国后，梁王心情郁郁不乐。"
    },
    "M070": {
      "status": "conveyed",
      "claim_fp": "6a56ed18f339ce07",
      "checked_at": "2026-08-08T14:50:24.495000+00:00",
      "note": "到北边的良山打猎，有人献上一头牛，牛脚从背上长出来，梁王很厌恶这件事。"
    },
    "M071": {
      "status": "conveyed",
      "claim_fp": "871ac388e7bcf279",
      "checked_at": "2026-08-08T14:50:24.495003+00:00",
      "note": "梁孝王为人慈孝，每当听说太后生病，就吃不下东西，住不安稳，总想留在长安侍奉太后。"
    },
    "M072": {
      "status": "conveyed",
      "claim_fp": "7a5b33f80bc5baa9",
      "checked_at": "2026-08-08T14:50:24.495006+00:00",
      "note": "太后也疼爱他。"
    },
    "M073": {
      "status": "conveyed",
      "claim_fp": "9e698290c2e6bc5a",
      "checked_at": "2026-08-08T14:50:39.114259+00:00",
      "note": "窦太后与长公主商量之后，决定把梁国一分为五，将孝王的五个儿子全部封为王，五个女儿也都赐予汤沐邑作为食邑。"
