    },
    "M057": {
      "status": "conveyed",
      "claim_fp": "cc5b9424afd2b5eb",
      "checked_at": "2026-07-28T05:36:46.807565+00:00",
      "note": "他去平原君家收租税，平原君家里人不肯交，赵奢就搬出法律来办事，一口气杀了平原君家九个管事的人。"
    },
    "M058": {
      "status": "conveyed",
      "claim_fp": "34a45ea9af1f8fa6",
      "checked_at": "2026-07-28T05:36:46.807568+00:00",
