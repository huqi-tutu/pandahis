{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00314",
  "updated_at": "2026-07-26T13:24:28.927581+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "5d76af591204ef0f",
      "checked_at": "2026-07-26T13:22:50.671850+00:00",
      "note": "他本名叫仲由，字子路，卞地人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "a7b7d35ee2b1181e",
      "checked_at": "2026-07-26T13:22:50.671874+00:00",
      "note": "比孔子小九岁。"
    },
    "M003–M004": {
      "status": "conveyed",
      "claim_fp": "e43d3de3b64a1612",
      "checked_at": "2026-07-26T13:22:50.671878+00:00",
      "note": "年轻时的子路...《史记》原文对他的形容是「子路性鄙，好勇力，志伉直，冠雄鸡，佩豭豚」...「陵暴孔子」...「设礼稍诱子路」...「儒服委质」...正式请求成为孔子的弟子。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "59f960d97d23ac01",
      "checked_at": "2026-07-26T13:22:50.671939+00:00",
      "note": "他跑去「问政」...孔子回答他：「先之，劳之。」...又「请益」"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "72690fd2dbf4fedf",
      "checked_at": "2026-07-26T13:22:50.671968+00:00",
      "note": "孔子也就多送了两个字：「无倦。」——别偷懒，一直干下去。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "b1b12ab0e3f66c57",
      "checked_at": "2026-07-26T13:22:50.671970+00:00",
      "note": "子路又问孔子：「君子尚勇乎？」...「义之为上。君子好勇而无义则乱，小人好勇而无义则盗。」"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "115669253af78441",
      "checked_at": "2026-07-26T13:22:50.671973+00:00",
      "note": "明确传达了听到道理未及践行害怕再闻"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "76e346806bbf3541",
      "checked_at": "2026-07-26T13:22:50.672084+00:00",
      "note": "包含了单方面言辞断案和好勇过我缺乏裁度"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "29e2d276f7ae403e",
      "checked_at": "2026-07-26T13:22:50.672088+00:00",
      "note": "既预言不得善终，又赞扬穿破旧与华服者列而不耻"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "df884544d1f942c8",
      "checked_at": "2026-07-26T13:22:50.672090+00:00",
      "note": "升堂未入室，即已达正大高明未入精微"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "119c23490c06f505",
      "checked_at": "2026-07-26T13:22:50.672133+00:00",
      "note": "季康子问仁，孔子答可管理大国赋税但不知其仁"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "92ad7b30f9acdfcc",
      "checked_at": "2026-07-26T13:22:50.672136+00:00",
      "note": "喜从游，遇长沮、桀溺、荷蓧丈人"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "c116afb3a20c00dd",
      "checked_at": "2026-07-26T13:22:50.672139+00:00",
      "note": "后来子路出来做官，当了季氏的家臣总管。季孙问孔子：「子路可谓大臣与？」——您看他算得上大臣吗？孔子只回了四个字：「可谓具臣矣。」——具臣，就是凑数办事的臣子"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "a9d40697a17c28ba",
      "checked_at": "2026-07-26T13:22:50.672173+00:00",
      "note": "再后来，子路要去蒲地当大夫了，临走前来向孔子辞行。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "3991e982f9ff3064",
      "checked_at": "2026-07-26T13:22:50.672176+00:00",
      "note": "孔子知蒲地民风彪悍，就叮嘱他：「蒲多壮士，又难治。然吾语汝：恭以敬，可以执勇；宽以正，可以比众；恭正以静，可以报上。」"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "265d253dfcf92a34",
      "checked_at": "2026-07-26T13:22:50.672179+00:00",
      "note": "事情的根源在卫国。此前，卫灵公有个宠姬叫南子。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "4fca6a7d63e8423a",
      "checked_at": "2026-07-26T13:22:50.672197+00:00",
      "note": "太子蒯聩得罪了南子，怕被老爹杀掉，吓得逃出了卫国。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "1fb0a2e971f2d8de",
      "checked_at": "2026-07-26T13:23:48.017581+00:00",
      "note": "灵公去世，卫国人想让公子郢继位，但郢不肯，说'亡人太子之子辄在'，于是立了辄为出公。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "978dc59c0f5da169",
      "checked_at": "2026-07-26T13:23:48.017593+00:00",
      "note": "出公这一坐就是十二年，而他的父亲蒯聩却一直流亡在外国，回不了自己的家。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "70c4353e8e91ca16",
      "checked_at": "2026-07-26T13:23:48.017607+00:00",
      "note": "子路在卫国担任孔悝的邑宰。孔悝是当时卫国的权臣。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "7b3efdf4359e7af9",
      "checked_at": "2026-07-26T13:23:48.017610+00:00",
      "note": "蒯聩为了夺回君位，就暗中与孔悝合谋发动政变。他们的计划是潜入孔悝家，然后召集人马，突袭出公。"
    },
    "M023–M025": {
      "status": "conveyed",
      "claim_fp": "ed7cdff6f3629a60",
      "checked_at": "2026-07-26T13:23:48.017613+00:00",
      "note": "出公无力抵抗，只好逃亡鲁国，蒯聩则顺利回卫即位，这就是卫庄公。政变发生的那一刻，子路恰好在城外。他一听到消息，立马就往回赶。半路上正撞见从城里逃出来的子羔。子羔拉住他说：'出公去矣，而门已闭，子可还矣，毋空受其祸。'子路只回了一句：'食其食者不避其难。'"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "c6835a1f49190705",
      "checked_at": "2026-07-26T13:23:48.017629+00:00",
      "note": "正好有个使者要进城，城门一开，子路便趁机跟了进去。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "8989cb70e9dfdb4a",
      "checked_at": "2026-07-26T13:23:48.017633+00:00",
      "note": "他径直冲到蒯聩面前，当时蒯聩正和孔悝一起待在高台上。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "53624cd1ee759317",
      "checked_at": "2026-07-26T13:23:48.017671+00:00",
      "note": "子路毫不畏惧，上前质问并请求：「君焉用孔悝？请得而杀之。」你干嘛要用孔悝这种人？请让我替您杀掉他。蒯聩当然不会听。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "e9e933c1bb187a93",
      "checked_at": "2026-07-26T13:23:48.017681+00:00",
      "note": "情急之下，子路决定放火烧台，逼他们下来。蒯聩这下真的怕了，赶紧派石乞、壶黡两名武士跳下台去攻击子路。混战之中，子路的帽带被斩断了。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "dbe20d1d0f55d75f",
      "checked_at": "2026-07-26T13:23:48.017685+00:00",
      "note": "他停下搏斗，平静地说了一句：「君子死而冠不免。」——君子就是死，帽子也不能歪、不能掉。说完，他从容不迫地系好自己的帽带，坦然迎接死亡。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "8b8e1a120b6805fb",
      "checked_at": "2026-07-26T13:23:48.017687+00:00",
      "note": "消息传回鲁国，孔子听到卫国发生了动乱，立刻发出一声悲叹：「嗟乎，由死矣！」——唉，子路这下死了！果然，不久就传来了子路殉难的噩耗。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "1d24708d8b40dc94",
      "checked_at": "2026-07-26T13:23:48.017690+00:00",
      "note": "后来孔子追忆起这个徒弟时，总会感慨地说：「自吾得由，恶言不闻於耳。」自从我有了子路，那些难听的话就再也传不进我的耳朵了。就在这段时间，子贡正作为鲁国的使者出使齐国。"
    }
  }
}
