  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "ad1416f6408077bc",
      "checked_at": "2026-07-26T17:50:26.927620+00:00",
      "note": "齐顷公元年，南边的楚庄王正强横，出兵伐陈。到了第二年，楚军又围了郑国，郑伯投降。不过楚庄王倒也没赶尽杀绝，后来又让郑伯复了国。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "b76a3d9c8f40d910",
      "checked_at": "2026-07-26T17:50:26.927627+00:00",
      "note": "一晃到了六年春天，晋国派大夫郤克出使齐国。齐顷公不知怎么想的，让他母亲在帷幕后头偷偷观看使臣登阶的场面。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "581b35256db31325",
      "checked_at": "2026-07-26T17:50:26.927631+00:00",
      "note": "郤克刚一上殿，帷幕后头就传出了女人的笑声。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "dc26095ca5de2101",
      "checked_at": "2026-07-26T17:50:26.927634+00:00",
      "note": "郤克怒火中烧，咬牙发誓：「此辱不报，绝不再渡黄河！」回到晋国后，他立刻请求攻打齐国，但晋景公没有答应。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "db1de39eabbff6dd",
      "checked_at": "2026-07-26T17:50:26.927638+00:00",
      "note": "后来齐国使者到晋国，郤克竟在河内把四个齐使抓起来全杀了。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "d7ff6eb44fdd579f",
      "checked_at": "2026-07-26T17:50:26.927641+00:00",
      "note": "到顷公八年，晋国出兵伐齐..."
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "c2e32f5a2ffbce0f",
      "checked_at": "2026-07-26T17:50:26.927644+00:00",
      "note": "明确写出了晋国攻打齐国，齐国派公子强为人质，晋军撤退，完全对应主张。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "9096319939b4a2c9",
      "checked_at": "2026-07-26T17:50:26.927648+00:00",
      "note": "明确写出了齐顷公十年春攻打鲁、卫。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "a6a9291f41fd40ef",
      "checked_at": "2026-07-26T17:50:26.927652+00:00",
      "note": "完全传达了鲁卫大夫通过郤克请求晋国出兵。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "0a902eaa3b7cbd54",
      "checked_at": "2026-07-26T17:50:26.927655+00:00",
      "note": "包含了郤克率八百乘，士燮、栾书分领上、下军，救援鲁卫并攻打齐国的全部要素。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "4d1b635c7ef8137d",
      "checked_at": "2026-07-26T17:50:26.927659+00:00",
      "note": "译文中的“六月壬申”和“靡笄山下”与主张完全一致。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "e0dbd0456e5629ad",
      "checked_at": "2026-07-26T17:50:26.927662+00:00",
      "note": "“癸酉”和“鞍地”都出现了，传达了列阵信息。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "5a2002ea8ca0d97c",
      "checked_at": "2026-07-26T17:50:26.927665+00:00",
      "note": "逄丑父担任齐顷公的车右护卫。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "dbd860ec8e0224f9",
      "checked_at": "2026-07-26T17:50:26.927669+00:00",
      "note": "齐顷公豪气得很，下令说：「冲过去，打完晋军再吃早饭！」齐军箭如雨下，射伤了郤克，血一直淌到鞋上。"
    },
    "M015–M016": {
      "status": "conveyed",
      "claim_fp": "96ffaf4063bd98af",
      "checked_at": "2026-07-26T17:50:26.927671+00:00",
      "note": "郤克疼得想退回营垒，给他驾车的御者劝道：「我从刚接战就受了伤，现在还带着第二处箭伤，一直不敢喊疼，就是怕动摇军心，请您也忍一忍。」郤克一听，咬牙继续作战。战斗越来越激烈，齐军渐渐顶不住了。逄丑父怕齐顷公落到晋军手里，赶紧跟他互换位置，让国君扮作车右。没多会儿，他们的战车被树挂住停下来了。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "7568534d88e89787",
      "checked_at": "2026-07-26T17:50:26.927674+00:00",
      "note": "晋国小将韩厥追到车前，对着假扮齐侯的逄丑父戏弄道：「敝国国君派我来的，是为了救鲁国和卫国。」"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "53bc3e6be713d6e6",
      "checked_at": "2026-07-26T17:50:26.927677+00:00",
      "note": "逄丑父急中生智，使唤假车右齐顷公下车去找水喝，齐顷公趁机脱身，逃回了自己的部队。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "c4c8775aa6ae1dbc",
      "checked_at": "2026-07-26T17:51:17.409914+00:00",
      "note": "晋国的主帅郤克咽不下这口气，转过头来就想要杀掉逄丑父。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "b342c945f4d925a5",
      "checked_at": "2026-07-26T17:51:17.409938+00:00",
      "note": "逄丑父开口了，他说：「代君死而见僇，后人臣无忠其君者矣。」...郤克听了之后...便放了他。就这样，逄丑父也得以脱身，逃回了齐军之中。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "6d13e0eeb447afa5",
      "checked_at": "2026-07-26T17:51:17.409942+00:00",
      "note": "大军继续推进，一直追到了马陵。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "b7f903262e312d01",
      "checked_at": "2026-07-26T17:51:17.409945+00:00",
      "note": "齐顷公只好派人去求和...晋国那边不答应，郤克态度很强硬...必须答应两个条件：第一，要把那个嘲笑郤克的罪魁祸首萧桐叔子交出来；第二，要让齐国把田间的道路全部改成东西走向。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "f957e42709fc08eb",
      "checked_at": "2026-07-26T17:51:17.409955+00:00",
      "note": "齐国的使者...回应道：「叔子，齐君母。齐君母亦犹晋君母，子安置之？且子以义伐而以暴为后，其可乎？」...晋国方面听后...这才终于答应了讲和，不再坚持要萧桐叔子，转而命令齐国把之前侵占鲁国和卫国的土地都退还回去。"
    },
    "M024–M026": {
      "status": "conveyed",
      "claim_fp": "245eb1c1aed45d97",
      "checked_at": "2026-07-26T17:51:17.409962+00:00",
      "note": "三段分别对应设置六卿赏功、朝晋欲尊王不敢受归、归国后施仁政民悦。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "0db3ba490cde64d2",
      "checked_at": "2026-07-26T17:51:17.409966+00:00",
      "note": "译文明确表达了齐顷公用丰厚的礼节对待诸侯，与母本信息一致。"
    }
  }
}
