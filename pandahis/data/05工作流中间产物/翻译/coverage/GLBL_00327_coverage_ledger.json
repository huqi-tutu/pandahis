      "status": "conveyed",
      "claim_fp": "162011acc4d6d89a",
      "checked_at": "2026-08-09T08:39:01.276835+00:00",
      "note": "信息完整传达，包括明察、记录、缓急、逮捕定罪等细节。"
    }
  }
