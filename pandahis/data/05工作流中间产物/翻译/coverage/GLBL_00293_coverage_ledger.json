    },
    "M059": {
      "status": "conveyed",
      "claim_fp": "908f40646997cee0",
      "checked_at": "2026-08-09T02:15:21.973328+00:00",
      "note": "白话译文明确说箭不轻易射出，一旦射出就穿透脖颈、射入脑袋；弓不虚发，应声而倒，与母本信息一致。"
    },
