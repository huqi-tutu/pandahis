  "updated_at": "2026-08-10T15:57:43.223004+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "fa5ce7f36d78aa9d",
      "checked_at": "2026-08-09T02:29:21.203660+00:00",
      "note": "孔家藏有一部用先秦古文字写成的「尚书」……孔安国用当时通行的今文字（隶书）去解读它，由此把他家传的这部逸「书」整理出来，一共得到十多篇。从这以后，「尚书」的篇目就比原来多出不少了。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "49cf36178fb9b736",
      "checked_at": "2026-08-09T02:29:21.203670+00:00",
      "note": "可惜后来遭遇了巫蛊之祸，这部古文「尚书」始终没能立于学官，成为官方承认的博士之学。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "bccbf46a08fdc345",
      "checked_at": "2026-08-09T02:29:21.203676+00:00",
      "note": "孔安国本人官做到谏大夫，他把学问传授给都尉朝。当时的大史学家司马迁，也曾向孔安国请教过古文「尚书」的故训古义。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "1c57a4582108e4c8",
      "checked_at": "2026-08-09T02:29:21.203679+00:00",
      "note": "司马迁写的《史记》里，记载「尧典」「禹贡」「洪范」「微子」「金縢」这些篇目时，采用的多半是古文「尚书」的说法。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "d67cd7b33340b2c3",
      "checked_at": "2026-08-09T02:29:21.203682+00:00",
      "note": "都尉朝传授给胶东人庸生。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "c0449a66b1e53015",
      "checked_at": "2026-08-09T02:29:21.203685+00:00",
      "note": "庸生传授给清河人胡常，字少子。胡常因为通晓「谷梁春秋」，官做到博士、部刺史，同时又传授「左氏传」。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "609980e2d114b035",
      "checked_at": "2026-08-09T02:29:21.203689+00:00",
      "note": "胡常传授给虢地人徐敖。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "602de76513a9a9fa",
      "checked_at": "2026-08-09T02:29:21.203701+00:00",
      "note": "徐敖做过右扶风掾，又传授「毛诗」，教给王璜和平陵人涂恽，字子真。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "9d57ae7d972e63c5",
      "checked_at": "2026-08-09T02:29:21.203718+00:00",
      "note": "子真又传授给河南人桑钦，字君长。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "9b890a57e47fb509",
      "checked_at": "2026-08-09T02:29:21.203721+00:00",
      "note": "到了王莽当政的时候，各家学说都被立于学官。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "74e0bdb116cb0d4b",
      "checked_at": "2026-08-09T02:29:21.203724+00:00",
      "note": "刘歆做了国师，王璜、涂恽这些人也都显贵起来。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "c9f1257ff54be4bd",
      "checked_at": "2026-08-09T02:29:21.203727+00:00",
      "note": "当时世间还流传着一部所谓的「百两篇」，出自东莱人张霸之手。他把「尚书」二十九篇拆开、合并，凑成几十篇，又采撷「左氏传」和「书叙」的内容来作首尾，一共凑成一百零二篇。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "877d35be19b47dc3",
      "checked_at": "2026-08-09T02:29:21.203730+00:00",
      "note": "这些篇章有的只有几根竹简，文意浅薄粗陋。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "4c6633018c6a6732",
      "checked_at": "2026-08-09T02:29:21.203733+00:00",
      "note": "汉成帝时访求能通古文的人，张霸因为能讲「百两篇」被征召入朝。朝廷拿宫中的藏书来校对，发现根本不是那么回事。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "3c78f02bc4b1d5f1",
      "checked_at": "2026-08-09T02:29:21.203736+00:00",
      "note": "张霸辩解说，他的学问是受自父亲，他父亲有个弟子叫尉氏人樊并。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "ed7a99240bf6c0f9",
      "checked_at": "2026-08-09T02:29:21.203739+00:00",
      "note": "当时，太中大夫平当、侍御史周敞还劝皇上把这部书保留下来。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "ff642a0a5d01bc8c",
      "checked_at": "2026-08-09T02:29:21.203742+00:00",
      "note": "后来樊并谋反，朝廷这才把「百两篇」废黜了。"
    }
  }
}
