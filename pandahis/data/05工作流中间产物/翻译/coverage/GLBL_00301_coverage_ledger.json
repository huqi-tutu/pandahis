{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00301",
  "updated_at": "2026-08-09T06:41:22.021610+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "4f899e034e166152",
      "checked_at": "2026-08-09T02:22:38.700767+00:00",
      "note": "周昌是沛县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "32666d54261aadb7",
      "checked_at": "2026-08-09T02:22:38.700775+00:00",
      "note": "早年间跟着刘邦一路打进关中，灭了秦朝。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "9705ce0aca68ba5f",
      "checked_at": "2026-08-09T02:22:38.700778+00:00",
      "note": "后来刘邦被封为汉王，任命周昌的堂兄周苛做御史大夫，周昌自己做中尉。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "bb57c98e9779a475",
      "checked_at": "2026-08-09T02:22:38.700782+00:00",
      "note": "汉王四年，楚军在荥阳把刘邦围得水泄不通，形势十分危急。刘邦瞅准机会逃了出去，留下周苛守荥阳城。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "c74b8ff74494a13e",
      "checked_at": "2026-08-09T02:22:38.700785+00:00",
      "note": "项羽想劝周苛投降，让他给自己带兵。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "f5a5dbb80cd7fe8e",
      "checked_at": "2026-08-09T02:22:38.700788+00:00",
      "note": "周苛破口大骂：「若趣降汉王！不然，今为虏矣！」——你赶紧投降汉王！不然的话，马上就是阶下囚了！项羽气得暴跳如雷，当场把周苛烹杀了。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "245781a1aae39641",
      "checked_at": "2026-08-09T02:22:38.700791+00:00",
      "note": "周苛一死，刘邦就任命周昌接替御史大夫的位子。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "65015e11fc9f6d59",
      "checked_at": "2026-08-09T02:22:38.700803+00:00",
      "note": "此后周昌常常跟着刘邦出征，最终击败了项羽。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "f648ade863019fe6",
      "checked_at": "2026-08-09T02:22:38.700806+00:00",
      "note": "汉六年大封功臣，周昌和萧何、曹参等人一起受封：周昌被封为汾阴侯；周苛的儿子周成因为父亲为国捐躯，被封为高景侯。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "4dcae008011e664c",
      "checked_at": "2026-08-09T02:22:38.700809+00:00",
      "note": "周昌这个人，性格刚强，敢说敢讲，连萧何、曹参这些开国元勋见了他都自觉矮三分。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "4346f3b6e5bd9c24",
      "checked_at": "2026-08-09T02:22:38.700813+00:00",
      "note": "有一回，周昌趁刘邦休息的时候进宫奏事，正撞见刘邦搂着戚姬亲热。周昌扭头就跑，刘邦追上去一把逮住他，骑在他脖子上问...周昌仰起头，硬邦邦地回了一句：'您就是夏桀商纣那样的君主。'刘邦听了哈哈大笑，但心里对周昌越发忌惮。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "cf917abdd22fce6b",
      "checked_at": "2026-08-09T02:22:38.700816+00:00",
      "note": "后来刘邦想废掉太子刘盈，改立戚姬的儿子如意为太子。大臣们拼死劝谏，都没能改变他的主意；最后是靠留侯张良的计策，刘邦才打消了这个念头。"
    },
    "M013–M014": {
      "status": "conveyed",
      "claim_fp": "a7584e56c2043eb3",
      "checked_at": "2026-08-09T02:22:38.700819+00:00",
      "note": "白话译文中有周昌在朝廷上力争、口吃、说“臣口不能言，然臣期期知其不可。陛下虽欲废太子，臣期期不奉诏。”以及吕后跪谢“微君，太子几废。”的完整描述。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "5c48546b33164912",
      "checked_at": "2026-08-09T02:22:38.700822+00:00",
      "note": "白话译文中有“这之后，戚姬的儿子如意被封为赵王，才十岁。刘邦担心自己百年之后，这个年幼的儿子保不住。”"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "1824c405df00cae6",
      "checked_at": "2026-08-09T02:22:38.700825+00:00",
      "note": "白话译文中有“当时有个年轻人叫赵尧，做符玺御史。”"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "111409c2bf4f2730",
      "checked_at": "2026-08-09T02:22:38.700828+00:00",
      "note": "白话译文中有赵人方与公对周昌说“君之史赵尧，年虽少，然奇才也，君必异之，是且代君之位。”以及周昌笑答“尧年少，刀笔吏耳，何能至是乎！”"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "097733842027e624",
      "checked_at": "2026-08-09T02:22:38.700831+00:00",
      "note": "白话译文中有“过了不久，赵尧去侍奉刘邦。”"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "84137dcbe2b6713b",
      "checked_at": "2026-08-09T02:22:50.620871+00:00",
      "note": "高祖独自闷闷不乐，唱着悲歌，群臣都不知道皇上为什么这样。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "a41d171a4fde6cd1",
      "checked_at": "2026-08-09T02:22:50.620880+00:00",
      "note": "赵尧上前请问说：“陛下不高兴，莫不是因为赵王年纪小，而戚夫人与吕后有仇怨吗？是担心您百年之后赵王不能保全自己吗？”高祖说：“是的。我私下里担忧这件事，不知该怎么办。”赵尧说：“陛下最好为赵王安排一位尊贵而强干的相国，而且是吕后、太子、群臣平时都敬畏的人才行。”高祖说：“对。我想的正是这样，可群臣里有谁行呢？”赵尧说：“御史大夫周昌，这个人坚忍质朴正直，而且从吕后、太子到大臣，平时都敬重怕他。只有周"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "b8f0697eb280b3e8",
      "checked_at": "2026-08-09T02:22:50.620883+00:00",
      "note": "周昌走了很久之后，高祖拿着御史大夫的官印把玩，说：“谁能当御史大夫呢？”仔细端详赵尧，说：“没有比赵尧更合适的了。”于是任命赵尧为御史大夫。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "2336a26b1c3ba634",
      "checked_at": "2026-08-09T02:22:50.620886+00:00",
      "note": "赵尧此前已有军功和食邑，后来又以御史大夫的身份跟随高祖攻打陈豨有功，被封为江邑侯。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "4a72b4ca859d5ffe",
      "checked_at": "2026-08-09T02:22:50.620889+00:00",
      "note": "使者多次往返，周昌坚决不肯送赵王去长安。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "8fd9ca37842d7874",
      "checked_at": "2026-08-09T02:22:50.620891+00:00",
      "note": "于是吕后对此很忧虑，就派使者召周昌进京。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "e9a27a8e02ef3d83",
      "checked_at": "2026-08-09T02:22:50.620894+00:00",
      "note": "周昌到了，拜见吕后，吕后大怒，骂周昌说：“你不知道我怨恨戚氏吗？却不打发赵王来，为什么？”周昌被征召之后，吕后派使者召赵王，赵王果然来了。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "21ea4333f8454738",
      "checked_at": "2026-08-09T02:22:50.620897+00:00",
      "note": "到长安一个多月，喝毒药死了。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "fa94a50e641e70a6",
      "checked_at": "2026-08-09T02:22:50.620899+00:00",
      "note": "周昌因此称病不再上朝，三年后去世。"
    }
  }
}
