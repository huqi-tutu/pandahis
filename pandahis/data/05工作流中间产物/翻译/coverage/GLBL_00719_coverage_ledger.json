  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "5a6fbfa8456ae53c",
      "checked_at": "2026-07-28T05:56:56.085669+00:00",
      "note": "译文开头：‘楚顷襄王十八年，楚国出了个奇人——这人有个冷门本事，能用很弱的弓、很细的丝线，把天上飞着的归雁给射下来。这事传到了顷襄王耳朵里，觉得新鲜，就把他叫来问话。’"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "f02308e827b8e218",
      "checked_at": "2026-08-05T15:53:02.296688+00:00",
      "note": "原文引用与白话解释结合，完整传达了母本信息。"
    },
    "M003–M005": {
      "status": "conveyed",
      "claim_fp": "e3454485cc43b13c",
      "checked_at": "2026-07-28T05:56:56.085686+00:00",
      "note": "译文分别引用了‘若夫泗上十二诸侯…’、‘今秦破韩以为长忧…’、‘王出宝弓…’三段原文，并附白话解释，信息完整传达。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "98e1444d2b7a1a6a",
      "checked_at": "2026-07-28T05:56:56.085690+00:00",
      "note": "译文：‘「劳民休众，南面称王矣。」让百姓休养生息，然后面南而坐，称王于天下。’"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "a1fabff990aca9dd",
      "checked_at": "2026-08-05T15:53:02.296701+00:00",
      "note": "原文引用与白话解释结合，完整传达了母本信息。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "967650a25e86fe6f",
      "checked_at": "2026-07-28T05:56:56.085698+00:00",
      "note": "译文：‘《史记》在此处插了一笔——这番话是为了激怒楚顷襄王，故意这么说的。’"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "ddc060f6f9a21e29",
      "checked_at": "2026-08-05T15:53:02.296706+00:00",
      "note": "M009要求并列句群先引用原文再白话解释，译文对M002的处理符合此要求。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "931c7e3eadc812fb",
      "checked_at": "2026-07-28T05:56:56.085706+00:00",
      "note": "秦国一听这消息，立刻发兵来伐楚。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "479145fb7acd1b5b",
      "checked_at": "2026-07-28T05:56:56.085709+00:00",
      "note": "楚国这边呢，一方面想要和齐国、韩国联合伐秦，另一面又顺带打起了周王室的主意。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "30e35c789fbaba54",
      "checked_at": "2026-08-05T15:53:02.296709+00:00",
      "note": "M012要求对称句群整段引用后作一段品评，译文对武公的话的处理符合此要求。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "ccd2e5cdf93de001",
      "checked_at": "2026-07-28T05:56:56.085716+00:00",
      "note": "接着又补了一句大白话：‘虽无攻之，名为弑君。’就算你没真动兵，天下人都已经把弑君这顶帽子扣你头上了。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "45a755e2b3db694d",
      "checked_at": "2026-07-28T05:56:56.085718+00:00",
      "note": "‘然而好事之君，喜攻之臣，发号用兵，未尝不以周为终始。’但问题是，那些好事的君主和喜欢打仗的臣子，每次用兵发号，总是绕着周王室打主意。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "5f9273aceb436780",
      "checked_at": "2026-07-28T05:56:56.085721+00:00",
      "note": "为什么呢？就是因为看到王室的祭器摆在那里，光想着把宝器弄到手，忘了弑君会带来的祸乱。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "ef62b615f4509e11",
      "checked_at": "2026-07-28T05:56:56.085724+00:00",
      "note": "如今韩国因为祭器在楚国的缘故——武公话锋一转——我担心天下各国会因为贪图祭器而仇视楚国啊。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "b98196de423835df",
      "checked_at": "2026-08-05T15:53:02.296712+00:00",
      "note": "M017要求专名与数字融入白话叙述，且「」用于完整摘句、对话或并列句群，译文符合。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "62fd4e5fca1feaa0",
      "checked_at": "2026-08-05T15:53:02.296716+00:00",
      "note": "M018与M009要求相同，译文对M007的处理符合。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "3bd1d478b8d5e4ce",
      "checked_at": "2026-08-05T15:53:23.471075+00:00",
      "note": "专名与数字已融入白话叙述，「」用于完整摘句和对话。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "14cc192b72002e97",
      "checked_at": "2026-07-28T05:57:41.199629+00:00",
      "note": "裂楚之地，足以肥国；诎楚之名，足以尊主。——分裂楚国的土地，足够让一个国家变得富得流油；折辱楚国的名声，足够让一位君主声威大震。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "adfa1e6c96c9d82b",
      "checked_at": "2026-08-05T15:53:23.471087+00:00",
      "note": "先整簇引用原文，再作白话解释。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "2d9a53a12bdf15f3",
      "checked_at": "2026-07-28T05:57:41.199638+00:00",
      "note": "图谋周室这件事，楚国就此罢手，不再提了。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "a4cf7fd94d098c22",
      "checked_at": "2026-07-28T05:57:41.199641+00:00",
      "note": "十九年，秦军大举伐楚，楚军战败，被迫割让了上庸和汉水以北的大片土地给秦国。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "030e4fa8615e4623",
      "checked_at": "2026-07-28T05:57:41.199645+00:00",
      "note": "二十年，秦将白起攻陷了楚国的西陵。"
    },
    "M025–M026": {
      "status": "conveyed",
      "claim_fp": "3fb3a7e936b0cc60",
      "checked_at": "2026-07-28T05:57:41.199648+00:00",
      "note": "二十一年，白起的兵锋直指郢都，这座楚国的核心都城被攻破，更让楚人痛心的是，先王陵墓所在的夷陵也被秦军一把火烧了。楚顷襄王的军队完全被打散，再也没能力组织起像样的抵抗，只能带着残存的力量往东北方向撤退，最后退守到陈城，在那里勉强站住脚。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "0efbc09b30cec62f",
      "checked_at": "2026-07-28T05:57:41.199651+00:00",
      "note": "二十二年，秦国继续推进，又攻占了楚国的巫郡和黔中郡。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "3893976303a556c0",
      "checked_at": "2026-07-28T05:57:41.199654+00:00",
      "note": "到二十三年，楚顷襄王总算缓过一口气来。他在东部地区收拢残兵，凑了十多万人，趁着秦军战线拉长、后方不稳的机会，向西发起反击，收复了长江沿岸被秦军占去的十五座城邑，把它们重新整合为郡，以此作为抗拒秦国的前线据点。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "090a6e16a73a3b83",
      "checked_at": "2026-07-28T05:57:41.199657+00:00",
      "note": "到了二十七年，楚国派出三万人马帮助韩、赵、魏三国攻打燕国。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "4fea4fa1e0e32882",
      "checked_at": "2026-07-28T05:57:41.199660+00:00",
      "note": "在这之后，楚国再次选择和秦国讲和，代价是把太子送到秦国去当人质。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "19495ad6928a5e2b",
      "checked_at": "2026-07-28T05:57:41.199662+00:00",
      "note": "楚国又派了左徒到秦国去陪侍太子。"
    }
  }
}
