    },
    "M065": {
      "status": "conveyed",
      "claim_fp": "32dbd0300cf9d887",
      "checked_at": "2026-08-08T15:12:04.930251+00:00",
      "note": "人活着靠的是精神，精神所寄托的是形体。"
    },
    "M066–M067": {
      "status": "conveyed",
      "claim_fp": "7367595c47cf1a47",
      "checked_at": "2026-08-08T15:12:04.930254+00:00",
      "note": "精神用得太过就会衰竭，形体劳苦太过就会疲惫，形神分离人就得死。死了不能复生，离了不能复合，所以圣人特别看重保养形神。"
    },
    "M068": {
      "status": "conveyed",
      "claim_fp": "74da3bad7b7cd9af",
      "checked_at": "2026-08-08T15:12:04.930256+00:00",
