      "claim_fp": "d7680200bdabf0f1",
      "checked_at": "2026-08-09T09:46:23.417581+00:00",
      "note": "译文明确说“玄成兄弘为太常丞，职奉宗庙，典诸陵邑，烦剧多罪过。”"
    },
    "M063": {
      "status": "conveyed",
