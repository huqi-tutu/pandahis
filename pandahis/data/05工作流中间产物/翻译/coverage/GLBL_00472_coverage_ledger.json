      "checked_at": "2026-08-09T09:46:23.417584+00:00",
      "note": "译文说“父贤以弘当为嗣，故敕令自免。”"
    },
    "M064": {
      "status": "conveyed",
      "claim_fp": "249cd1f2cbbd3e9c",
      "checked_at": "2026-08-09T09:46:23.417587+00:00",
