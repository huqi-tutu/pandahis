{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00470",
  "updated_at": "2026-08-09T06:57:25.011818+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "b50a555bd9186ba2",
      "checked_at": "2026-08-09T06:56:59.425805+00:00",
      "note": "隽不疑，字曼倩，勃海人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "7b1cde3c38d84777",
      "checked_at": "2026-08-09T06:56:59.425814+00:00",
      "note": "他研治「春秋」，在郡里担任文学之职，进退举止必定遵循礼法，名声传遍州郡。"
    },
    "M003–M008": {
      "status": "conveyed",
      "claim_fp": "b83724f13cc4eb7c",
      "checked_at": "2026-08-09T06:56:59.425818+00:00",
      "note": "汉武帝末年，郡国盗贼蜂拥而起。朝廷派暴胜之担任直指使者，身穿绣衣，手持斧头，追捕盗贼，督察郡国，一路东至海边，以军兴法诛杀不服从命令的人，威震州郡。暴胜之一向听说隽不疑贤能，到了勃海，便派属吏去邀请他相见。隽不疑头戴进贤冠，腰佩櫑具剑，身佩环玦，宽衣大带，盛装来到府门求见。守门人想让他解下佩剑，隽不疑说：「剑者，君子武备，所以卫身，不可解。请退。」——剑是君子的武备，用来护身的，不能解下，请让我退"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "f1bbcf3f4ecbd39e",
      "checked_at": "2026-08-09T06:56:59.425822+00:00",
      "note": "暴胜之门下的诸位从事都是州郡选拔的官吏，在旁边侧耳倾听隽不疑的言论，无不惊骇。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "a6b3fa3a4db3cbff",
      "checked_at": "2026-08-09T06:56:59.425825+00:00",
      "note": "直到天黑，才结束离去。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "d432d0742e23d3f6",
      "checked_at": "2026-08-09T06:56:59.425829+00:00",
      "note": "暴胜之于是上表举荐隽不疑，征召至公车，任命为青州刺史。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "e7d895d76a19236f",
      "checked_at": "2026-08-09T06:56:59.425833+00:00",
      "note": "隽不疑在青州刺史任上发觉奸邪之事，收捕相关人犯，都伏法认罪。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "d9a9473cf7a2bdda",
      "checked_at": "2026-08-09T06:56:59.425845+00:00",
      "note": "因此升任京兆尹，赏赐钱百万。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "de193a7810ad075f",
      "checked_at": "2026-08-09T06:56:59.425848+00:00",
      "note": "京城官吏百姓都敬重他的威信。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "1eb2e8738027d1f2",
      "checked_at": "2026-08-09T06:56:59.425851+00:00",
      "note": "每次巡视属县、审录囚徒回来，他的母亲总要问他：「有所平反，活几何人？」——有没有平反冤狱，救活了几个人？如果隽不疑多有平反，母亲就喜笑颜开，饮食言谈都不同于平时；如果没有什么人获释，母亲就发怒，为此不吃饭。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "efcc805e0b71b3b7",
      "checked_at": "2026-08-09T06:56:59.425854+00:00",
      "note": "所以隽不疑为官，严厉而不残暴。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "864691f38f7d13b2",
      "checked_at": "2026-08-09T06:56:59.425857+00:00",
      "note": "始元五年，有一个男子乘坐黄牛车，竖着黄旗，穿着黄衣，戴着黄帽，来到皇宫北门，自称是卫太子。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "efdd7b08feb9a596",
      "checked_at": "2026-08-09T06:56:59.425860+00:00",
      "note": "白话译文明确传达了公车令上报和皇帝下诏让官员辨认的信息。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "525fa5a7c2142aff",
      "checked_at": "2026-08-09T06:57:11.853936+00:00",
      "note": "长安城中的官吏百姓闻讯赶来围观，聚集了数万人。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "5e1826b5628f8e94",
      "checked_at": "2026-08-09T06:57:11.853943+00:00",
      "note": "右将军率兵驻守在宫阙之下，以防发生意外。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "4db7063e433036e4",
      "checked_at": "2026-08-09T06:57:11.853946+00:00",
      "note": "丞相、御史、中二千石等官员到场后，一个个面面相觑，都不敢开口发言。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "b111113ec5aa6a95",
      "checked_at": "2026-08-09T06:57:11.853949+00:00",
      "note": "京兆尹隽不疑最后才到，见此情形，当即喝令随从官吏将那名男子捆绑起来。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "caa93abe98d8e821",
      "checked_at": "2026-08-09T06:57:11.853952+00:00",
      "note": "有人劝他说：“是非尚未可知，暂且先稳住他再说。”隽不疑答道：“诸位何必担心他是卫太子！从前蒯聩违抗父命出奔，蒯辄拒绝接纳他，「春秋」对此是肯定的。卫太子得罪了先帝，逃亡在外而不肯死，如今自己送上门来，这正是个罪人。”于是命人将他送进了诏狱。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "2bc2f6e9fa2d3bc5",
      "checked_at": "2026-08-09T06:57:11.853954+00:00",
      "note": "天子与大将军霍光听说此事后，对隽不疑大加赞赏，说：“公卿大臣应当任用通晓经术、明白大义的人。”从此，隽不疑的名声在朝廷中更加显赫，朝中在位的大臣都自认为比不上他。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "5d1b17eed88cd189",
      "checked_at": "2026-08-09T06:57:11.853958+00:00",
      "note": "大将军霍光想把女儿嫁给他，隽不疑坚决推辞，不肯接受。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "b23b8311d139b12e",
      "checked_at": "2026-08-09T06:57:11.853961+00:00",
      "note": "过了很久，他因病免官，最终在家中去世。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "d8e1ae98d9e0696b",
      "checked_at": "2026-08-09T06:57:11.853963+00:00",
      "note": "京城的人至今仍记念着他。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "6d335e7d7110886a",
      "checked_at": "2026-08-09T06:57:11.853966+00:00",
      "note": "后来赵广汉担任京兆尹，曾说：“我禁奸止邪，在官吏百姓中尚能施行，但若论朝廷大事，我比隽不疑差得太远了。”廷尉后来审讯查验那个假冒者，终于查明了其中的奸诈。此人本是夏阳人，姓成，名方遂，居住在湖县，以占卜为业。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "a8e4c3ec9fb12b59",
      "checked_at": "2026-08-09T06:57:11.853969+00:00",
      "note": "曾有一位已故太子的舍人找他占卜，对他说：“你的相貌很像卫太子。”方遂心里贪图这句话，指望借此得以富贵，便诈称自己是卫太子，前往宫阙自首。廷尉召来他乡里相识的张宗禄等人作证，方遂最终因犯下诬罔不道之罪，被判处腰斩，在东市行刑。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "6ec67db462226df6",
      "checked_at": "2026-08-09T06:57:11.853971+00:00",
      "note": "另有一种说法称此人姓张，名延年。"
    }
  }
}
