  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "239527f576dfff57",
      "checked_at": "2026-07-26T15:00:42.088680+00:00",
      "note": "宋湣公在位第七年，国际局势发生了大变化——那位后来号令诸侯的齐桓公正式即位了。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "fbf1188f453c1f3b",
      "checked_at": "2026-07-26T15:00:42.088690+00:00",
      "note": "到了第九年，宋国遭遇了一场大水灾。按当时的外交规矩，鲁国派大夫臧文仲前来慰问灾情。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "9717bd6a8b140a78",
      "checked_at": "2026-07-26T15:00:42.088694+00:00",
      "note": "湣公对这场灾难相当自责，主动在臧文仲面前检讨，说了一番话：『我身为国君，没能尽心事奉鬼神，国家政事也没整顿好，所以老天爷才降下这场水灾。』臧文仲听了，觉得这番话说得很有水平，私下表示赞赏。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "0077b8523d00f683",
      "checked_at": "2026-07-26T15:00:42.088708+00:00",
      "note": "不过，这套漂亮话真正的起草者另有其人——是宋国的公子子鱼在背后一句一句教湣公说的。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "5d07d34b33a1cb92",
      "checked_at": "2026-07-26T15:00:42.088712+00:00",
      "note": "第十年的夏天，宋国和鲁国翻了脸，出兵攻打鲁国。双方在一个叫乘丘的地方交战，宋国没讨到便宜，反而让鲁国活捉了宋国的大将南宫万。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "3ba9ccf884e1f53a",
      "checked_at": "2026-07-26T15:00:42.088714+00:00",
      "note": "事后宋国想办法交涉，这才把南宫万要了回来。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "94fda8731bc63d06",
      "checked_at": "2026-07-26T15:00:42.088717+00:00",
      "note": "湣公十一年秋天，湣公带着南宫万外出打猎。猎场休息时，两人对坐下棋博弈，却因为抢着走子争执起来。湣公火气上头，当着手下人开骂，专往南宫万的痛处戳：『以前我敬你是条汉子；可如今，你不过是个被鲁国人绑过的俘虏罢了！』南宫万本就有一身惊人的力气，哪里受得了这种羞辱？他盯着湣公，越听越恨，随即一把抄起棋盘，当场就将湣公砸死在蒙泽。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "aa0e3b25687594e3",
      "checked_at": "2026-07-26T15:00:42.088721+00:00",
      "note": "消息传回都城，大夫仇牧最先反应过来，立刻带兵冲向宫门，准备镇压叛乱。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "d7fd4e3bea99b706",
      "checked_at": "2026-07-26T15:00:42.088725+00:00",
      "note": "南宫万迎面撞上仇牧，一顿徒手搏杀，竟把仇牧打死——牙都崩飞，嵌死在了门扇上。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "a2cf724e19aa02b6",
      "checked_at": "2026-07-26T15:00:42.088727+00:00",
      "note": "紧跟着南宫万又杀了太宰华督，干脆改立另一位宗室公子游做了宋国国君。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "bb947af5ecc3124f",
      "checked_at": "2026-07-26T15:00:42.088731+00:00",
      "note": "政变之下，宋国诸公子纷纷出逃。一群公子逃到了萧地，一位叫御说的公子逃去了亳邑。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "f408da2412fde512",
      "checked_at": "2026-07-26T15:00:42.088742+00:00",
      "note": "南宫万让自己的弟弟南宫牛带兵包围了亳城，想斩草除根。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "250d2469d138f067",
      "checked_at": "2026-07-26T15:00:42.088745+00:00",
      "note": "到了这年冬天，局势出现反转。逃到萧地的那些人联合其他逃散的公子，一块反攻，先是合力击杀了南宫牛，接着又冲入国都，杀死了刚被立为国君的公子游，转而拥立湣公的弟弟御说。这就是后来的宋桓公。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "df182b2c2d849aa6",
      "checked_at": "2026-07-26T15:00:42.088747+00:00",
      "note": "南宫万在宋国站不住脚，一路狂奔逃往陈国。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "a767683ab3a96b94",
      "checked_at": "2026-07-26T15:00:42.088750+00:00",
      "note": "宋国方面不肯罢休，向陈国开出重金贿赂，要求把人交出来。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "dda144ea81b1e42b",
      "checked_at": "2026-07-26T15:00:42.088752+00:00",
      "note": "陈国人想了个精细法子。他们安排了一群女人给南宫万劝酒，使他喝得大醉，不省人事，然后趁这猛将无力挣扎，用犀牛皮把他裹了个严严实实，送回宋国。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "69af5aff4a14e463",
      "checked_at": "2026-07-26T15:00:42.088754+00:00",
      "note": "南宫万被押回宋国后，等待他的是最残酷的刑罚。宋人将他就地剁成了肉酱。"
    }
  }
}
