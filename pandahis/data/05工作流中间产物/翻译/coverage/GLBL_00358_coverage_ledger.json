  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "b23ee5571978419a",
      "checked_at": "2026-08-08T15:21:48.361839+00:00",
      "note": "平阳侯曹参，是沛县人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "f3419426d47100a5",
      "checked_at": "2026-08-08T15:21:48.361841+00:00",
      "note": "秦朝的时候，他在沛县做狱掾——就是管监狱的小吏，而萧何当时是主吏，两人在县里都算得上是有头脸的豪吏了。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "3dbd6180cec49081",
      "checked_at": "2026-08-08T15:21:48.361842+00:00",
      "note": "高祖刘邦起兵做了沛公的时候，曹参就以中涓的身份跟随他——中涓是近侍之臣，相当于贴身的随从。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "3b68a887989844b6",
      "checked_at": "2026-08-08T15:21:48.361843+00:00",
      "note": "曹参领兵攻打胡陵、方与，又进攻秦朝监公的军队，大破敌军。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "a82c21d58ccabdf6",
      "checked_at": "2026-08-08T15:21:48.361844+00:00",
      "note": "接着向东攻下薛县，在薛城西边攻打泗水郡守的军队。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "a92f1add9b40e571",
      "checked_at": "2026-08-08T15:21:48.361845+00:00",
      "note": "回头再攻胡陵，拿下了。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "2eb45264f4e1fb52",
      "checked_at": "2026-08-08T15:21:48.361846+00:00",
      "note": "随后调防驻守方与。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "31a6940bb79b65d3",
      "checked_at": "2026-08-08T15:21:48.361851+00:00",
      "note": "方与反叛归了魏，曹参又去打它。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "75c8887613a7f502",
      "checked_at": "2026-08-08T15:21:48.361852+00:00",
      "note": "丰邑也反叛归魏，曹参再攻丰邑。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "e429f1f35daa0ae6",
      "checked_at": "2026-08-08T15:21:48.361853+00:00",
      "note": "因功被赐爵为七大夫。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "a2c34583c5bcd795",
      "checked_at": "2026-08-08T15:21:48.361854+00:00",
      "note": "又攻打秦将司马𠂉的军队于砀县以东，击破了他，夺取了砀县、狐父、祁善置三地。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "964398380a842c0b",
      "checked_at": "2026-08-08T15:21:48.361855+00:00",
      "note": "再攻下邑以西，一路打到虞县，迎击章邯的车骑部队。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "91dd9ff6e5513d00",
      "checked_at": "2026-08-08T15:21:48.361855+00:00",
      "note": "攻打爰戚和亢父，曹参率先登城"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "2eeca43cd019570d",
      "checked_at": "2026-08-08T15:21:48.361856+00:00",
      "note": "升为五大夫"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "a4f4980dc658eec1",
      "checked_at": "2026-08-08T15:21:48.361857+00:00",
      "note": "北上救援东阿，攻打章邯的军队，冲陷敌阵，一路追到濮阳"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "d738a8b4a719f456",
      "checked_at": "2026-08-08T15:21:48.361858+00:00",
      "note": "攻定陶，取临济"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "09d5c014de1d4593",
      "checked_at": "2026-08-08T15:21:48.361859+00:00",
      "note": "南下救雍丘"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "124e874c06e0c208",
      "checked_at": "2026-08-08T15:21:48.361860+00:00",
      "note": "攻打李由的军队，击破之，杀了李由，还俘虏了秦军的一个侯"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "82ec7a51c73f5b4b",
      "checked_at": "2026-08-08T15:22:02.510971+00:00",
      "note": "秦将章邯在定陶一战中击败并杀死了项梁，沛公刘邦和项羽只得率军向东撤退。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "6af84f019b1a4bec",
      "checked_at": "2026-08-08T15:22:02.510985+00:00",
      "note": "楚怀王任命沛公为砀郡长，统领砀郡的军队。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "c672939b8a49fabe",
      "checked_at": "2026-08-08T15:22:02.510989+00:00",
      "note": "楚怀王封曹参为执帛，号称建成君。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "14432b0eacfd6074",
      "checked_at": "2026-08-08T15:22:02.510992+00:00",
      "note": "后来曹参又升为戚公，隶属于砀郡。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "6d7c4f79b3823402",
      "checked_at": "2026-08-08T15:22:02.510996+00:00",
      "note": "此后，曹参跟随沛公攻打东郡尉的军队，在成武以南将其击破。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "d5626feb63ebab07",
      "checked_at": "2026-08-08T15:22:02.511000+00:00",
      "note": "又在成阳以南攻击王离的军队，随后在杠里再次进攻，大破敌军。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "5a34fddeb0120aa4",
      "checked_at": "2026-08-08T15:22:02.511004+00:00",
      "note": "曹参率军追击败逃的敌军，向西一直追到开封，攻击赵贲的军队并将其击破，把赵贲围困在开封城中。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "192c0ce89893b821",
      "checked_at": "2026-08-08T15:22:02.511008+00:00",
      "note": "接着向西在曲遇攻击秦将杨熊的军队，大破之，俘虏了秦军的司马和御史各一人。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "2ebfaedc1824e796",
      "checked_at": "2026-08-08T15:22:02.511012+00:00",
