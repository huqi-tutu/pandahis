  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "6c75c39f49ab46d6",
      "checked_at": "2026-08-09T07:11:10.875174+00:00",
      "note": "彭越是昌邑人，字仲。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "ea4963af644fcff7",
      "checked_at": "2026-08-09T07:11:10.875181+00:00",
      "note": "常在钜野泽里打鱼，跟一帮人混在一起，说白了就是群盗。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "17324d4e434d3667",
      "checked_at": "2026-08-09T07:11:10.875184+00:00",
      "note": "白话译文完整传达了劝言和彭越的回应。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "21999960afef7d96",
      "checked_at": "2026-08-09T07:11:10.875187+00:00",
      "note": "过了一年多，泽里的年轻人聚了一百多号人，跑来找彭越，说...请您来当我们的头领。彭越推辞...年轻人硬是坚持，彭越这才答应。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "08ec9bc7c8fe97e2",
      "checked_at": "2026-08-09T07:11:10.875191+00:00",
      "note": "他跟大家约好，第二天日出时分集合，迟到的杀头。"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "6a7c088fca83ae4c",
      "checked_at": "2026-08-09T07:11:10.875193+00:00",
      "note": "第二天日出，有十多人迟到，最晚的到中午才来。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "a4e531ac25463494",
      "checked_at": "2026-08-09T07:11:10.875196+00:00",
      "note": "白话译文直接引用了原文，并说明了下令校长斩杀最后一人。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "c03f06d4d612d720",
      "checked_at": "2026-08-09T07:11:10.875206+00:00",
      "note": "译文包含了众人的笑言、彭越斩杀最后一人、设坛祭祀和号令部众。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "15b56e03c33b72cb",
      "checked_at": "2026-08-09T07:11:10.875210+00:00",
      "note": "译文明确表达了众人畏惧彭越，不敢仰视。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "2daaabc168b68ac2",
      "checked_at": "2026-08-09T07:11:10.875222+00:00",
      "note": "译文直接对应母本信息。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "fb83c2be3aeea9c6",
      "checked_at": "2026-08-09T07:11:10.875225+00:00",
      "note": "译文明确说明昌邑未下，沛公西去。"
    },
    "M012–M013": {
      "status": "conveyed",
      "claim_fp": "0e854ab5a4bbf263",
      "checked_at": "2026-08-09T07:11:10.875228+00:00",
      "note": "译文涵盖了彭越无所归属、田荣赐印、下济阴击楚等信息。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "5cc4ee47cacbffbe",
      "checked_at": "2026-08-09T07:11:10.875230+00:00",
      "note": "楚王派萧公角带兵迎击，彭越大破楚军。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "f950aa4280c3f1ba",
      "checked_at": "2026-08-09T07:11:10.875233+00:00",
      "note": "汉王二年春，彭越与魏王豹及诸侯一起东进攻楚，带着三万多人在外黄归附汉王。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "32aacfa6ee13991b",
      "checked_at": "2026-08-09T07:11:10.875235+00:00",
      "note": "汉王说：彭将军收复魏地十几座城，急着要立魏王的后代。如今西魏王豹是魏王咎的堂弟，是真正的魏国后人。于是拜彭越为魏相国，让他全权统兵，平定梁地。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "d92fdf2d28fa3d1e",
      "checked_at": "2026-08-09T07:11:10.875237+00:00",
      "note": "汉王在彭城战败，解围西撤，彭越先前攻下的城池又都丢了，只好独自带兵北上，驻扎在黄河边上。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "6a9ec49dcf9baf1a",
      "checked_at": "2026-08-09T07:11:10.875240+00:00",
      "note": "汉王三年，彭越常常往来游击，作为汉军的游兵袭击楚军，在梁地截断楚军的粮道。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "50c8c501bdc976ae",
      "checked_at": "2026-08-09T07:11:27.896429+00:00",
      "note": "汉四年冬天，项王与汉王在荥阳对峙，彭越趁这个机会攻下了睢阳、外黄等十七座城。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "5c45e1f9fea28ddc",
      "checked_at": "2026-08-09T07:11:27.896436+00:00",
      "note": "项王听说后方被端了，赶紧派曹咎守成皋，自己带兵东进去收复彭越打下的城邑——这些城又都回到了楚军手里。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "e298b2aa817d2ae0",
      "checked_at": "2026-08-09T07:11:27.896440+00:00",
      "note": "彭越打不过，只好带着队伍往北撤到穀城。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "1ce26642ff0d6055",
      "checked_at": "2026-08-09T07:11:27.896443+00:00",
      "note": "汉五年秋天，项王向南退到阳夏，彭越又卷土重来，拿下昌邑周边二十多座城，还缴获了十多万斛粮食，全数供给汉王军队当军粮。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "94b41b8976cea67f",
      "checked_at": "2026-08-09T07:11:27.896446+00:00",
      "note": "汉王打了败仗，派人去叫彭越发兵合力攻楚。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "4d22dbe4e5f30266",
      "checked_at": "2026-08-09T07:11:27.896449+00:00",
      "note": "彭越推辞说：「魏地刚刚平定，还怕楚军反扑，现在走不开。」汉王只好自己追楚军，结果在固陵被项籍打得大败。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "e874601038abebe1",
      "checked_at": "2026-08-09T07:11:27.896452+00:00",
      "note": "信息完整传达。"
    },
