{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00343",
  "updated_at": "2026-08-09T06:41:22.216791+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "1a2c8eee49e899ed",
      "checked_at": "2026-08-09T02:50:17.003814+00:00",
      "note": "张苍是阳武人"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "ebf353a3d6f0bfe5",
      "checked_at": "2026-08-09T02:50:17.003831+00:00",
      "note": "喜好书籍、律令和历法"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "212f6ec1d5bb9bc6",
      "checked_at": "2026-08-09T02:50:17.003835+00:00",
      "note": "秦朝时他担任御史，主管柱下方书——也就是宫中的文书档案"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "52036017b6ab1c89",
      "checked_at": "2026-08-09T02:50:17.003839+00:00",
      "note": "后来他犯了罪，便逃亡回家"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "13c66adc30b2edb0",
      "checked_at": "2026-08-09T02:50:17.003843+00:00",
      "note": "等到沛公刘邦攻占地盘经过阳武时，张苍以宾客身份跟随他攻打南阳"
    },
    "M006": {
      "status": "conveyed",
      "claim_fp": "e99d86f8ffa3d049",
      "checked_at": "2026-08-09T02:50:17.003847+00:00",
      "note": "张苍犯法当斩，脱了衣服伏在砧板上，身材高大，又白又胖，像个大葫芦。当时王陵见了，觉得他是个美士，便向沛公说情，赦免了他，没有斩首"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "5e47d961329eccf2",
      "checked_at": "2026-08-09T02:50:17.003851+00:00",
      "note": "于是张苍随军西入武关，到达咸阳。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "1fbb438fcd689a2d",
      "checked_at": "2026-08-09T02:50:17.003865+00:00",
      "note": "沛公被封为汉王，进入汉中，回师平定三秦。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "195790b7d9deff8c",
      "checked_at": "2026-08-09T02:50:17.003869+00:00",
      "note": "陈馀击走了常山王张耳，张耳归附汉朝，汉便任命张苍为常山郡守。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "e50dd9539de694c9",
      "checked_at": "2026-08-09T02:50:17.003872+00:00",
      "note": "张苍跟随淮阴侯韩信攻打赵国，擒获了陈馀。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "4723473d4f3e7f59",
      "checked_at": "2026-08-09T02:50:17.003876+00:00",
      "note": "赵地平定后，汉王任命张苍为代国相，防备边寇。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "cc36f5cfcab951c0",
      "checked_at": "2026-08-09T02:50:17.003879+00:00",
      "note": "不久又调任赵相，辅佐赵王张耳。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "3f4f8f0abb66d9ae",
      "checked_at": "2026-08-09T02:50:17.003883+00:00",
      "note": "后来又调去辅佐代王。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "ab1e67b6edc7f9d5",
      "checked_at": "2026-08-09T02:50:17.003886+00:00",
      "note": "燕王臧荼反叛，高祖前往讨伐。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "a6ce12e1c79dc3ad",
      "checked_at": "2026-08-09T02:50:17.003889+00:00",
      "note": "张苍以代相身份随军攻打臧荼有功，在汉六年被封为北平侯，食邑一千二百户。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "fb0bc7a04c167f86",
      "checked_at": "2026-08-09T02:50:17.003893+00:00",
      "note": "张苍升任计相，一个月后，改以列侯身份担任主计四年。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "773e0a1b9b7ae4e6",
      "checked_at": "2026-08-09T02:50:17.003896+00:00",
      "note": "当时萧何为相国，而张苍从秦朝时就担任柱下史，熟悉天下图书、计簿、户籍。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "73eff98ea452f62a",
      "checked_at": "2026-08-09T02:50:17.003899+00:00",
      "note": "张苍又擅长计算、律令、历法，因此让他以列侯身份住在相府，主管各郡国上报的计簿。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "d85da00a5cdb0d9a",
      "checked_at": "2026-08-09T02:50:30.495532+00:00",
      "note": "黥布反叛败亡之后，汉朝立皇子刘长为淮南王，张苍便出任淮南国相。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "476cdf857a6320ff",
      "checked_at": "2026-08-09T02:50:30.495548+00:00",
      "note": "到了汉十四年，张苍升任御史大夫。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "f42bcb1105b68f2c",
      "checked_at": "2026-08-09T02:50:30.495553+00:00",
      "note": "张苍与绛侯周勃等人一同尊立代王为孝文皇帝。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "ac6971658f169721",
      "checked_at": "2026-08-09T02:50:30.495557+00:00",
      "note": "从汉朝建立到孝文帝时期，二十多年间，天下刚刚安定，朝中的将相公卿大多是军人出身。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "67083ee710c1a32d",
      "checked_at": "2026-08-09T02:50:30.495561+00:00",
      "note": "张苍担任计相时，着手整理订正律令历法。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "4c5ebf7426b83398",
      "checked_at": "2026-08-09T02:50:30.495566+00:00",
      "note": "因为高祖是在十月到达霸上的，而秦朝本来就以十月为一年的开始，所以汉朝沿用了这一历法，没有更改。"
    },
    "M025–M026": {
      "status": "conveyed",
      "claim_fp": "593f1697aa0a48e4",
      "checked_at": "2026-08-09T02:50:30.495569+00:00",
      "note": "张苍推算五德之运，认为汉朝正当水德之时，崇尚黑色一如旧制。他又吹律管调谐乐音，纳入音声，并据此比照制定律令。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "e3400eb04b917561",
      "checked_at": "2026-08-09T02:50:30.495573+00:00",
      "note": "至于百工技艺，天下都以他制定的标准为程式。"
    },
    "M028–M029": {
      "status": "conveyed",
      "claim_fp": "1efb19fbe814ae60",
      "checked_at": "2026-08-09T02:50:30.495577+00:00",
      "note": "到张苍担任丞相时，终于完成了这些事业，所以汉朝谈论律历的人，都以张苍为本。张苍本就喜好读书，无所不看，无所不通，而尤其擅长律历之学。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "d1a307402f919806",
      "checked_at": "2026-08-09T02:50:30.495580+00:00",
      "note": "张苍感激王陵的恩德。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "ee723e3757fd4a0e",
      "checked_at": "2026-08-09T02:50:30.495583+00:00",
      "note": "王陵是安国侯。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "92f82057e6db14be",
      "checked_at": "2026-08-09T02:50:30.495586+00:00",
      "note": "等到张苍显贵之后，常常像对待父亲一样侍奉王陵。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "58043b3978ddbee9",
      "checked_at": "2026-08-09T02:50:30.495590+00:00",
      "note": "王陵死后，张苍已任丞相，每逢洗沐日，总是先到王陵夫人那里请安送饭，然后才敢回家。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "9a4c1fac8ff6075c",
      "checked_at": "2026-08-09T02:50:30.495593+00:00",
      "note": "张苍任丞相十多年时，鲁地人公孙臣上书，说汉朝当属土德之时，其征兆是黄龙将要出现。"
    },
    "M035–M036": {
      "status": "conveyed",
      "claim_fp": "c82a1bd4098a6c51",
      "checked_at": "2026-08-09T02:50:30.495597+00:00",
      "note": "文帝下诏将此事交给张苍审议，张苍认为不对，便搁置了。后来黄龙果然在成纪出现，于是文帝召公孙臣为博士，起草土德历法制度，更改元年。"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "0bcf6798b204ebfa",
      "checked_at": "2026-08-09T02:50:38.775744+00:00",
      "note": "张苍由此自我贬退，称病告老。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "44a30c9d4d9609a3",
      "checked_at": "2026-08-09T02:50:38.775757+00:00",
      "note": "他任用一个亲信做中候，此人借机大肆谋取奸利，文帝拿这事责备张苍，张苍于是称病免职。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "3b7615703252e1b1",
      "checked_at": "2026-08-09T02:50:38.775760+00:00",
      "note": "算下来，张苍任丞相十五年而被免。"
    },
    "M040–M041": {
      "status": "conveyed",
      "claim_fp": "3cecbc0f23b03d2b",
      "checked_at": "2026-08-09T02:50:38.775763+00:00",
      "note": "孝景帝前元五年，张苍去世，谥号为文侯。他的儿子张类继承侯位，八年后，因参加诸侯丧礼后就位不敬，封国被废除。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "478b48d8fc4ecdb1",
      "checked_at": "2026-08-09T02:50:38.775766+00:00",
      "note": "当初，张苍的父亲身高不满五尺，等到生下张苍，张苍却身高八尺多，官至侯、丞相。"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "a5f41d65ad7c5a0b",
      "checked_at": "2026-08-09T02:50:38.775769+00:00",
      "note": "张苍的儿子也很高。"
    },
    "M044–M045": {
      "status": "conveyed",
      "claim_fp": "263ddaad00214d7f",
      "checked_at": "2026-08-09T02:50:38.775772+00:00",
      "note": "到孙子张类，身高六尺多，因犯法失去侯位。张苍免相之后，年老，口中没有牙齿，只能吃奶，让女子做乳母。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "4a8b3184e80fe6ff",
      "checked_at": "2026-08-09T02:50:38.775775+00:00",
      "note": "他的妻妾数以百计，曾经怀孕的不再宠幸。"
    }
  }
}
