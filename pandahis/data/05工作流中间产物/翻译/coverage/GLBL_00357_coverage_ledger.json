  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "8fa7d864b096b198",
      "checked_at": "2026-07-26T14:11:41.011456+00:00",
      "note": "管仲当年的财富排场可以跟齐国公室掰手腕——家里建了气派的“三归”高台，堂上摆着诸侯级别才有的“反坫”礼器，但齐国人谁也不觉得他奢侈。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "35fd127d2a2a403d",
      "checked_at": "2026-07-26T14:11:41.011467+00:00",
      "note": "管仲死后一百多年，齐国又出了一位奇人——晏婴。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "79b05db1f8987ce7",
      "checked_at": "2026-07-26T14:11:41.011472+00:00",
      "note": "晏婴，字平仲，是莱地夷维人。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "8a3797593770e335",
      "checked_at": "2026-07-26T14:11:41.011474+00:00",
      "note": "“站稳脚跟”意译了“受到齐国人敬重”"
    },
    "M005–M006": {
      "status": "conveyed",
      "claim_fp": "279ed036d9d87626",
      "checked_at": "2026-07-26T14:11:41.011483+00:00",
      "note": "「食不重肉，妾不衣帛」——吃饭从来不上第二道荤菜，家里姬妾穿的也都是粗布衣裳，绝不碰丝绸。…「君语及之，即危言；语不及之，即危行。」…国君有话问到头上，他就大大方方地直言不讳；国君没问到他，他就端端正正地把自己手头的事做好。"
    },
    "M007": {
      "status": "conveyed",
      "claim_fp": "6e946354f0515915",
      "checked_at": "2026-07-26T14:11:41.011486+00:00",
      "note": "「国有道，即顺命；无道，即衡命」——碰上政治清明的年头，他就老老实实奉行命令；遇到国君犯浑、朝政混乱的时候，他就把命令放在心里掂量掂量，权衡利害之后再去执行，绝不盲目跟从。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "69f0b696e2d93d01",
      "checked_at": "2026-07-26T14:11:41.011489+00:00",
      "note": "明确提到历经三朝，名声在诸侯间显赫"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "ec2169f6d0b4a449",
      "checked_at": "2026-07-26T14:11:41.011499+00:00",
      "note": "明确提到贤德之人越石父被关押"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "b55d7aba8f4f3ac1",
      "checked_at": "2026-07-26T14:11:41.011502+00:00",
      "note": "完全对应：外出遇见、解左马赎人、同车带回"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "f3c57687841bcac9",
      "checked_at": "2026-07-26T14:11:41.011505+00:00",
      "note": "带回家后未打招呼就入内室"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "a112af3751133494",
      "checked_at": "2026-07-26T14:11:41.011507+00:00",
      "note": "过了很久，提出绝交"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "d343b4ac0af5dc99",
      "checked_at": "2026-07-26T14:11:41.011509+00:00",
      "note": "完整传达了对话和结局"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "204472ccf39130f0",
      "checked_at": "2026-07-26T14:11:41.011512+00:00",
      "note": "晏婴当齐相的时候，还出过一档子事儿，主角不是他本人，而是给他驾车的车夫。有一回晏婴坐着马车出门，车夫的妻子从门缝里偷偷往外看，盯着自家老公怎么给国相赶车。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "95576eb33627da7e",
      "checked_at": "2026-07-26T14:11:41.011515+00:00",
      "note": "好家伙，「拥大盖，策驷马，意气扬扬，甚自得也」——那排场可不小，头顶是华丽的大车盖，手里鞭子赶着四匹健壮的高头大马，这车夫坐在前头，满脸写着“牛气”二字，那份得意劲儿简直是溢于言表。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "0ed82cc674c9e1cd",
      "checked_at": "2026-07-26T14:11:41.011517+00:00",
      "note": "结果呢，等车夫收工回到家，他妻子当场就撂下一句冷冰冰的话：我不跟你过了，我要走。"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "929bbf4a4e4d18d1",
      "checked_at": "2026-07-26T14:11:41.011519+00:00",
      "note": "车夫一头雾水，赶紧问为什么。"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "cd262ead44f30ebf",
      "checked_at": "2026-07-26T14:11:41.011522+00:00",
      "note": "妻子原话引用与解释完全对应，并补充“从那以后，车夫像换了个人，处处收敛自己，再不敢张扬。”传达了夫自抑损。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "66bbfb4ca908f092",
      "checked_at": "2026-07-26T14:12:02.550017+00:00",
      "note": "这事儿让晏子觉得奇怪，找了个空儿问他怎么回事，车夫就把实情一五一十说了。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "fc437581a66ca18b",
      "checked_at": "2026-07-26T14:12:02.550028+00:00",
      "note": "晏子听了，觉得这车夫能听进劝、知道改，是个可造之材，就推荐他做了大夫。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "8ce7656d66d708f4",
      "checked_at": "2026-07-26T14:12:02.550031+00:00",
      "note": "《史记》写到这里，作者司马迁在篇末加了一段自己的话，说：『吾读管氏牧民、山高、乘马、轻重、九府，及晏子春秋，详哉其言之也。』"
    },
    "M022–M023": {
      "status": "conveyed",
      "claim_fp": "a13737d78821f9ab",
      "checked_at": "2026-07-26T14:12:02.550041+00:00",
      "note": "既见其著书，欲观其行事，故次其传。至其书，世多有之，是以不论，论其轶事。后面白话解释进一步确认。"
    }
  }
}
