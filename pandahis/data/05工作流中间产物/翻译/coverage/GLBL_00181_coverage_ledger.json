{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00181",
  "updated_at": "2026-08-09T08:02:41.339896+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "6ac8fb2a8e5db010",
      "checked_at": "2026-08-09T08:01:20.444130+00:00",
      "note": "淮南厉王刘长，是汉高祖的小儿子。他的母亲，原本是赵王张敖宫中的美人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "884ab0b135460360",
      "checked_at": "2026-08-09T08:01:20.444142+00:00",
      "note": "高祖八年，刘邦从东垣经过赵国，赵王张敖把这位美人献给了高祖。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "de98fe2621540a7d",
      "checked_at": "2026-08-09T08:01:20.444144+00:00",
      "note": "刘长的母亲得到高祖宠幸，怀了身孕。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "f0e785645bc34317",
      "checked_at": "2026-08-09T08:01:20.444147+00:00",
      "note": "赵王张敖不敢再让她住在王宫里，便在外面另筑宫室让她居住。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "f44cdf3813e4f76e",
      "checked_at": "2026-08-09T08:01:20.444150+00:00",
      "note": "后来，贯高等人在柏人谋反的事被发觉，朝廷一并追查惩治赵王张敖，把他的母亲、兄弟和宫中美人全部收捕，关押在河内郡。"
    },
    "M006–M007": {
      "status": "conveyed",
      "claim_fp": "5d3e92299c054995",
      "checked_at": "2026-08-09T08:01:20.444153+00:00",
      "note": "刘长的母亲也被关押，她向看守的官吏报告说：“我曾得到皇上的宠幸，如今怀有身孕。”官吏把这事上报给高祖，高祖正在恼怒赵王，便没有理会刘长的母亲。刘长的母亲的弟弟赵兼，托辟阳侯审食其向吕后求情，吕后心怀嫉妒，不肯替她向高祖说明，辟阳侯也没有尽力去争辩。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "d5e1ccd4c458f3ce",
      "checked_at": "2026-08-09T08:01:20.444156+00:00",
      "note": "等到刘长的母亲生下刘长之后，心中怨恨，便自杀了。"
    },
    "M009–M010": {
      "status": "conveyed",
      "claim_fp": "f134e7f39f94d20f",
      "checked_at": "2026-08-09T08:01:20.444158+00:00",
      "note": "官吏把刘长送到高祖面前，高祖后悔了，让吕后以母亲的身份抚养他，并把刘长的母亲安葬在真定。真定，是刘长母亲娘家的所在，也是她父辈世居的县邑。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "b25655036df371e5",
      "checked_at": "2026-08-09T08:01:20.444161+00:00",
      "note": "高祖十一年七月，淮南王黥布反叛，高祖便封儿子刘长为淮南王，统辖黥布原来的封地，一共四个郡。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "c29bfb6834444fdb",
      "checked_at": "2026-08-09T08:01:20.444163+00:00",
      "note": "高祖亲自率兵击败并消灭了黥布，刘长于是正式即位为王。"
    },
    "M013–M014": {
      "status": "conveyed",
      "claim_fp": "0311792bd4fdb383",
      "checked_at": "2026-08-09T08:01:20.444166+00:00",
      "note": "刘长自幼失去母亲，一直依附吕后，因此在孝惠帝和吕后当政时期得以受到宠爱，没有遭遇祸患，但他心里一直怨恨辟阳侯审食其，只是不敢发作。等到孝文帝刚刚即位时，淮南王刘长自认为与皇帝关系最亲，便骄横傲慢，屡次不遵行法令。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "22885510b9270cea",
      "checked_at": "2026-08-09T08:01:20.444169+00:00",
      "note": "文帝因为亲情的缘故，常常宽恕赦免他。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "6f5a6ab6b787941c",
      "checked_at": "2026-08-09T08:01:20.444171+00:00",
      "note": "文帝三年，刘长入京朝见"
    },
    "M017": {
      "status": "conveyed",
      "claim_fp": "b852386f5c5c7384",
      "checked_at": "2026-08-09T08:01:20.444174+00:00",
      "note": "表现得十分骄横"
    },
    "M018": {
      "status": "conveyed",
      "claim_fp": "0d90784888d95925",
      "checked_at": "2026-08-09T08:01:20.444176+00:00",
      "note": "他跟随皇上前去苑囿打猎，与皇上同乘一辆车，还常常称呼皇上为“大兄”"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "4c29ec1471d87653",
      "checked_at": "2026-08-09T08:01:51.903020+00:00",
      "note": "厉王力气很大，力能扛鼎，于是亲自登门去请辟阳侯审食其。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "0b659d6e6479d8cc",
      "checked_at": "2026-08-09T08:01:51.903032+00:00",
      "note": "辟阳侯出来见他，厉王当即从袖子里掏出铁椎，一椎砸向辟阳侯，又命随从魏敬割下他的首级。"
    },
    "M021–M022": {
      "status": "conveyed",
      "claim_fp": "c165c28dc89e22d6",
      "checked_at": "2026-08-09T08:01:51.903036+00:00",
      "note": "厉王随即策马直奔宫阙之下，袒露上身请罪，说：……他列了三条罪状……孝文帝感伤他的用心，又念在至亲的份上，没有治他的罪，赦免了厉王。当是时，薄太后及太子诸大臣皆惮厉王……厉王因此回到封国后更加骄纵放肆，不用汉法，出入称警跸，称制，自为法令，拟於天子。"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "f20adf701be89e7e",
      "checked_at": "2026-08-09T08:01:51.903039+00:00",
      "note": "文帝六年，厉王让男子但等七十人与棘蒲侯柴武的太子柴奇合谋，准备用四十辆辇车在谷口造反，还派人联络闽越和匈奴。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "9484d8963cb9e76a",
      "checked_at": "2026-08-09T08:01:51.903043+00:00",
      "note": "事觉，治之，使使召淮南王——事情败露，朝廷追查此案，派使者召淮南王进京。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "26109f2293cf9122",
      "checked_at": "2026-08-09T08:01:51.903046+00:00",
      "note": "淮南王到了长安。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "f66b29df7809ce74",
      "checked_at": "2026-08-09T08:01:51.903049+00:00",
      "note": "白话译文详细列出了刘长的罪状，包括废先帝法、不听天子诏、居处无度、黄屋盖乘舆、出入拟於天子、擅为法令、不用汉法、任郎中春为丞相、聚收亡命、赐爵禄田宅、与开章等谋反、联络闽越匈奴、杀开章灭口、擅杀无罪、赦免罪人、赐爵等，与母本信息一致。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "2c010557a1dec527",
      "checked_at": "2026-08-09T08:01:51.903052+00:00",
      "note": "白话译文有“文帝下制书说：‘朕不忍致法於王，其与列侯二千石议。’”直接对应。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "87a21f84be724198",
      "checked_at": "2026-08-09T08:01:51.903054+00:00",
      "note": "白话译文有“群臣再次上奏：‘臣仓、臣敬、臣逸、臣福、臣贺昧死言：臣谨与列侯吏二千石臣婴等四十三人议，皆曰‘长不奉法度，不听天子诏，乃阴聚徒党及谋反者，厚养亡命，欲以有为’。臣等议论如法。’”直接对应。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "ae0e1f2b99f6dff5",
      "checked_at": "2026-08-09T08:01:51.903057+00:00",
      "note": "白话译文有“文帝又下制书：‘朕不忍致法於王，其赦长死罪，废勿王。’”直接对应。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "a40774eab988b9c3",
      "checked_at": "2026-08-09T08:01:51.903060+00:00",
      "note": "白话译文有“群臣再奏：‘臣仓等昧死言：长有大死罪，陛下不忍致法，幸赦，废勿王。臣请处蜀郡严道邛邮，遣其子母从居，县为筑盖家室，皆廪食给薪菜盐豉炊食器席蓐。臣等昧死请，请布告天下。’”直接对应。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "266cc769b56a0591",
      "checked_at": "2026-08-09T08:01:51.903063+00:00",
      "note": "白话译文有“文帝制书批复：‘计食长给肉日五斤，酒二斗。令故美人才人得幸者十人从居。他可。’”直接对应。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "c61e6be13030c04a",
      "checked_at": "2026-08-09T08:01:51.903065+00:00",
      "note": "于是尽诛所与谋者——所有参与谋反的人全部处死。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "5ea8795328b4a8f9",
      "checked_at": "2026-08-09T08:01:51.903068+00:00",
      "note": "随后遣送淮南王上路，用辎车载着他，命令沿途各县依次押送传递。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "b70428b1cd331c38",
      "checked_at": "2026-08-09T08:01:51.903070+00:00",
      "note": "袁盎劝谏文帝说：「上素骄淮南王，弗为置严傅相，以故至此。且淮南王为人刚，今暴摧折之。臣恐卒逢雾露病死。陛下为有杀弟之名，柰何！」文帝说：「吾特苦之耳，今复之。」"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "735072754f04315d",
      "checked_at": "2026-08-09T08:01:51.903073+00:00",
      "note": "沿途各县押送淮南王的人都不敢打开囚车的封条。"
    },
    "M036": {
      "status": "conveyed",
      "claim_fp": "19c3ce0e1bf7ec8e",
      "checked_at": "2026-08-09T08:01:51.903075+00:00",
      "note": "淮南王对侍者说：「谁谓乃公勇者？吾安能勇！吾以骄故不闻吾过至此。人生一世间，安能邑邑如此！」"
    },
    "M037": {
      "status": "conveyed",
      "claim_fp": "98d04b096b827f09",
      "checked_at": "2026-08-09T08:02:04.988866+00:00",
      "note": "我正是因为骄纵惯了，听不到自己的过错，才落到今天这步田地。"
    },
    "M038": {
      "status": "conveyed",
      "claim_fp": "d375c7d21163578a",
      "checked_at": "2026-08-09T08:02:04.988875+00:00",
      "note": "人生在世一辈子，怎么能这样窝窝囊囊地活着！说完，他绝食而死。"
    },
    "M039": {
      "status": "conveyed",
      "claim_fp": "1e34bf1b8d5b9976",
      "checked_at": "2026-08-09T08:02:04.988879+00:00",
      "note": "车队到了雍县，雍县的县令这才打开封条，把淮南王已死的消息上报朝廷。"
    },
    "M040": {
      "status": "conveyed",
      "claim_fp": "8f1ef3379bf3a3bd",
      "checked_at": "2026-08-09T08:02:04.988883+00:00",
      "note": "文帝听到消息，哭得非常伤心，对袁盎说...袁盎劝道...文帝问...袁盎说...文帝当即下令丞相、御史追查各县押送淮南王时不敢打开囚车封条、也不给食物侍候的人，全部处以弃市之刑。"
    },
    "M041": {
      "status": "conveyed",
      "claim_fp": "c7c8b5537e80079f",
      "checked_at": "2026-08-09T08:02:04.988887+00:00",
      "note": "随后，朝廷按列侯的礼仪把淮南王安葬在雍县，并安排三十户人家为他守墓。"
    },
    "M042": {
      "status": "conveyed",
      "claim_fp": "7ad12d29658109cb",
      "checked_at": "2026-08-09T08:02:04.988890+00:00",
      "note": "孝文八年，文帝怜惜淮南王，见他有四个儿子，都才七八岁，便封刘安为阜陵侯，刘勃为安阳侯，刘赐为阳周侯，刘良为东成侯。"
    },
    "M043": {
      "status": "conveyed",
      "claim_fp": "dafe1e9dc002ff4b",
      "checked_at": "2026-08-09T08:02:04.988893+00:00",
      "note": "孝文十二年，民间有人编了首歌谣唱淮南厉王的事：「一尺布，尚可缝；一斗粟，尚可舂。"
    },
    "M044": {
      "status": "conveyed",
      "claim_fp": "cd7a5a1b0630948a",
      "checked_at": "2026-08-09T08:02:04.988896+00:00",
      "note": "兄弟二人不能相容。"
    },
    "M045": {
      "status": "conveyed",
      "claim_fp": "9270b791d94e4251",
      "checked_at": "2026-08-09T08:02:04.988899+00:00",
      "note": "文帝听到这首歌，叹息道：「尧舜放逐骨肉，周公杀掉管叔蔡叔，天下人仍称他们圣明。为什么呢？因为不因私情损害公义。天下人难道以为我是贪图淮南王的地盘吗？」于是，他把城阳王迁到淮南故地为王，又追尊淮南王谥号为厉王，并按诸侯王的礼仪为他设置陵园。"
    },
    "M046": {
      "status": "conveyed",
      "claim_fp": "bc787c6e50f70ef7",
      "checked_at": "2026-08-09T08:02:04.988901+00:00",
      "note": "孝文十六年，文帝把淮南王刘喜迁回城阳故地。"
    },
    "M047": {
      "status": "conveyed",
      "claim_fp": "b401bec756343207",
      "checked_at": "2026-08-09T08:02:04.988904+00:00",
      "note": "他怜惜淮南厉王因不守法度、图谋不轨而自取失国早亡，便封立他的三个儿子：阜陵侯刘安为淮南王，安阳侯刘勃为衡山王，阳周侯刘赐为庐江王，三人都重新得到厉王当年的封地，一分为三。"
    },
    "M018–M019": {
      "status": "conveyed",
      "claim_fp": "fcbe7ec220ecadb9",
      "checked_at": "2026-08-09T08:02:06.783537+00:00",
      "note": "该句完整传达了母本信息，包括同车、称大兄、力能扛鼎、拜访辟阳侯。"
    }
  }
}
