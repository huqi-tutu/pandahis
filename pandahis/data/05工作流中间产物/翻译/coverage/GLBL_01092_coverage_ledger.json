    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "ea2012001e6750e3",
      "checked_at": "2026-08-09T10:47:41.710428+00:00",
      "note": "丁、傅两家败了之后，孔乡侯傅晏带着家属迁去合浦，宗族都回了原郡。"
    },
    "M026": {
      "status": "conveyed",
