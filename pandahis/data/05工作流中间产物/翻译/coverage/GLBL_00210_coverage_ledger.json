{
  "schema": "translate-coverage-ledger/v1",
  "史略ID": "GLBL_00210",
  "updated_at": "2026-08-09T06:41:21.004452+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "3058e3f07cd9ab55",
      "checked_at": "2026-08-08T15:01:27.937969+00:00",
      "note": "孝文窦皇后，是汉景帝的母亲。吕太后当政的时候，她以良家子的身份被选入宫中。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "5eaab87199ea7180",
      "checked_at": "2026-08-08T15:01:27.938002+00:00",
      "note": "后来吕太后把宫人遣散出宫，赐给各位诸侯王，每位诸侯王分到五人，窦姬也在这次遣散的名单里。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "3b744671d1b83aab",
      "checked_at": "2026-08-08T15:01:27.938007+00:00",
      "note": "窦姬家在清河郡，她心里盼着能去赵国，因为赵国离家乡近。于是她恳求负责遣送的宦者官吏，说：“一定要把我登记在去赵国的名册里。”"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "5cec5a9824546484",
      "checked_at": "2026-08-08T15:01:27.938012+00:00",
      "note": "那宦者转头就把这事忘了，稀里糊涂地把她登记到了去代国的名册里。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "7874fc753c316276",
      "checked_at": "2026-08-08T15:01:27.938016+00:00",
      "note": "名册奏报上去，诏令批准，事情就这么定了下来。"
    },
    "M006–M007": {
      "status": "conveyed",
      "claim_fp": "8a7b1ec12705dfd9",
      "checked_at": "2026-08-08T15:01:27.938020+00:00",
      "note": "临出发那天，窦姬哭得泪人一般，心里怨恨那个宦者，死活不肯去代国。可名册已定，由不得她，被人硬逼着才上了路。……到了代国，代王偏偏独独宠幸窦姬，她先为代王生下一个女儿，取名刘嫖。"
    },
    "M008": {
      "status": "conveyed",
      "claim_fp": "84e6cfb48d2ba3d7",
      "checked_at": "2026-08-08T15:01:27.938023+00:00",
      "note": "孝惠帝七年，又生下后来的汉景帝。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "d683c78658adfdf8",
      "checked_at": "2026-08-08T15:01:27.938035+00:00",
      "note": "汉文帝即位几个月后，公卿大臣们请求立太子。窦姬的儿子年纪最长，顺理成章被立为太子。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "e050dd2b3b300df2",
      "checked_at": "2026-08-08T15:01:27.938038+00:00",
      "note": "窦姬被立为皇后，女儿刘嫖被封为馆陶长公主。"
    },
    "M011": {
      "status": "conveyed",
      "claim_fp": "592b6e05c1f42f6e",
      "checked_at": "2026-08-08T15:01:27.938041+00:00",
      "note": "第二年，又封她的小儿子刘武为代王，后来改封到梁国，这就是梁孝王。"
    },
    "M012": {
      "status": "conveyed",
      "claim_fp": "8755ab0c738f56b0",
      "checked_at": "2026-08-08T15:01:27.938044+00:00",
      "note": "薄太后下诏，命有关官员追封窦皇后的父亲为安成侯，母亲为安成夫人，又下令在清河郡设置园邑二百家，派长丞专门奉守，一切规制比照灵文园。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "9f22818a2b4fd021",
      "checked_at": "2026-08-08T15:01:27.938046+00:00",
      "note": "窦皇后的哥哥叫窦长君。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "e63167d51028aa31",
      "checked_at": "2026-08-08T15:01:27.938066+00:00",
      "note": "她的弟弟窦广国，字少君，四五岁那年，家里穷得揭不开锅，被人拐走卖掉，家里人从此不知他的下落。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "afdf8f16a5b59554",
      "checked_at": "2026-08-08T15:01:27.938069+00:00",
      "note": "他辗转被转卖了十多家，最后到了宜阳，给主人家进山烧炭。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "94c5da683b8f3082",
      "checked_at": "2026-08-08T15:01:27.938072+00:00",
      "note": "有一天，他自己占了一卦，卦象显示，几天之内他就要封侯。"
    },
    "M017–M018": {
      "status": "conveyed",
      "claim_fp": "174b67c14da00fd9",
      "checked_at": "2026-08-08T15:01:27.938075+00:00",
      "note": "后来他跟着主人家来到长安，听说新立的皇后家在观津，姓窦氏。窦广国离开家时虽然年纪小，却还记得家乡的县名和自家的姓氏，又记得当年曾和姐姐一起采桑，从树上摔下来过——这些细节，他都拿来当作认亲的凭证，上书自述身世。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "2f920aec4c766587",
      "checked_at": "2026-08-08T15:01:42.692159+00:00",
      "note": "窦皇后把这事告诉了文帝，文帝召见窦广国，当面询问。窦广国把当年的事一五一十说了出来"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "516b4e78bd92e11a",
      "checked_at": "2026-08-08T15:01:42.692171+00:00",
      "note": "对得上号——「果是」，确实就是她失散多年的弟弟"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "a83c80011c4b2bff",
      "checked_at": "2026-08-08T15:01:42.692175+00:00",
      "note": "窦广国说：「姊去我西时，与我决传舍中，匄沐沐我，已，饭我，乃去。」——姐姐当年离开我往西边去的时候，在驿站里跟我诀别，她讨来水给我洗头，洗完又喂我吃饭，然后才走。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "8af2e4661484781b",
      "checked_at": "2026-08-08T15:01:42.692178+00:00",
      "note": "窦皇后厚赐这个弟弟，让他定居在长安"
    },
    "M023": {
      "status": "conveyed",
      "claim_fp": "0125a8220b854a3e",
      "checked_at": "2026-08-08T15:01:42.692182+00:00",
      "note": "绛侯周勃、灌将军灌婴等人私下议论：「吾属不死，命乃且县此两人。此两人所出微，不可不为择师傅，又复放吕氏大事也。」——意思是说，咱们这些人能不能保住命，恐怕就悬在这姐弟俩身上了。这两人出身微贱，可不能不为他们挑几个好师傅，否则又要重演吕氏专权那样的大祸。于是挑选了一批年长有德、品行端正的人，跟窦长君、窦少君住在一起，时时教导。"
    },
    "M024": {
      "status": "conveyed",
      "claim_fp": "13f8c5cdadff510c",
      "checked_at": "2026-08-08T15:01:42.692198+00:00",
      "note": "窦长君、窦少君从此成了谦逊退让的君子，不敢仗着富贵对人傲慢。"
    },
    "M025": {
      "status": "conveyed",
      "claim_fp": "8da9f57fd3dcc596",
      "checked_at": "2026-08-08T15:01:42.692201+00:00",
      "note": "窦皇后后来生了病，双目失明。"
    },
    "M026": {
      "status": "conveyed",
      "claim_fp": "a032ea43b1bcd73f",
      "checked_at": "2026-08-08T15:01:42.692204+00:00",
      "note": "文帝转而宠幸邯郸的慎夫人和尹姬，但两人都没生下儿子。"
    },
    "M027": {
      "status": "conveyed",
      "claim_fp": "03db504f1963de29",
      "checked_at": "2026-08-08T15:01:42.692207+00:00",
      "note": "窦长君先去世，朝廷封他的儿子窦彭祖为南皮侯。"
    },
    "M028": {
      "status": "conveyed",
      "claim_fp": "a020927fe31689b2",
      "checked_at": "2026-08-08T15:01:42.692209+00:00",
      "note": "太后的堂侄窦婴行侠仗义、喜好宾客，被任命为大将军，率军平定了吴、楚之乱，封为魏其侯。"
    },
    "M029": {
      "status": "conveyed",
      "claim_fp": "0e7d5df0391926f2",
      "checked_at": "2026-08-08T15:01:42.692212+00:00",
      "note": "窦氏一门封侯的，一共三人。"
    },
    "M030": {
      "status": "conveyed",
      "claim_fp": "b6011e5b71cbed2f",
      "checked_at": "2026-08-08T15:01:42.692215+00:00",
      "note": "窦太后喜好黄帝、老子的学说，景帝和窦家子弟们不得不读「老子」，尊奉黄老之术。"
    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "55084f8664c42a62",
      "checked_at": "2026-08-08T15:01:42.692217+00:00",
      "note": "窦太后留下遗诏，把东宫所有的金钱财物都赐给了长公主刘嫖。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "1d41ed28f9e2ca65",
      "checked_at": "2026-08-08T15:01:42.692219+00:00",
      "note": "到汉武帝时，魏其侯窦婴做了丞相，后来被处死。"
    },
    "M017–M019": {
      "status": "conveyed",
      "claim_fp": "fb1461351e9d74f9",
      "checked_at": "2026-08-08T15:01:44.690310+00:00",
      "note": "译文提到窦广国来到长安，听说新立的皇后家在观津，姓窦氏；他记得县名和姓氏，以及曾与姐姐采桑堕树，以此上书自陈；皇后告知文帝，召见询问，广国具言其故。"
    }
  }
}
