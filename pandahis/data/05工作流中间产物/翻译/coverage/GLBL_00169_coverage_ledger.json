      "claim_fp": "fed71b763f1f00d9",
      "checked_at": "2026-08-08T14:40:26.459772+00:00",
      "note": "明确提到赵王有罪削河间郡。"
    },
    "M035": {
      "status": "conveyed",
      "claim_fp": "33c13414229a127a",
      "checked_at": "2026-08-08T14:40:26.459775+00:00",
