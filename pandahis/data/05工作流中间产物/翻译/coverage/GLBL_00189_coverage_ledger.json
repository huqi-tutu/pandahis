    },
    "M031": {
      "status": "conveyed",
      "claim_fp": "a52e2c018e6e5b06",
      "checked_at": "2026-08-09T08:05:31.509782+00:00",
      "note": "中叔的儿子傅晏也是大司马，封孔乡侯。"
    },
    "M032": {
      "status": "conveyed",
      "claim_fp": "01303876f9b19a4d",
      "checked_at": "2026-08-09T08:05:31.509784+00:00",
      "note": "幼君的儿子傅商封汝昌侯，作为太后父亲崇祖侯的后嗣，改崇祖侯号为汝昌哀侯。"
    },
    "M033": {
      "status": "conveyed",
      "claim_fp": "e2860c68d913e76e",
      "checked_at": "2026-08-09T08:05:31.509787+00:00",
      "note": "太后同母弟弟郑恽已死，封郑恽的儿子郑业为阳信侯，追尊郑恽为阳信节侯。"
    },
    "M034": {
      "status": "conveyed",
      "claim_fp": "0e228fe35250544e",
      "checked_at": "2026-08-09T08:05:31.509790+00:00",
      "note": "郑氏、傅氏封侯的共六人，大司马二人，九卿二千石六人，侍中诸曹十余人。"
    },
    "M035–M036": {
      "status": "conveyed",
      "claim_fp": "5a0f1920a5e878fa",
      "checked_at": "2026-08-09T08:05:31.509793+00:00",
      "note": "傅太后尊贵之后更加骄横，与成帝母亲说话时，甚至称她为老太婆。她与中山孝王的母亲冯太后曾一同侍奉元帝，追念旧怨，便以祝诅之罪陷害冯太后，逼她自杀。"
    }
