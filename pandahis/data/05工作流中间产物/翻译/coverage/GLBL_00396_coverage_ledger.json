  "updated_at": "2026-08-09T09:04:25.529504+00:00",
  "entries": {
    "M001": {
      "status": "conveyed",
      "claim_fp": "a0be33e153e57ab5",
      "checked_at": "2026-08-09T09:04:07.891924+00:00",
      "note": "王温舒是阳陵人。"
    },
    "M002": {
      "status": "conveyed",
      "claim_fp": "f104848219592b0f",
      "checked_at": "2026-08-09T09:04:07.891935+00:00",
      "note": "年轻时干过椎埋的勾当——盗墓杀人，无恶不作。"
    },
    "M003": {
      "status": "conveyed",
      "claim_fp": "f06ea4ce1270dc49",
      "checked_at": "2026-08-09T09:04:07.891939+00:00",
      "note": "后来试补为县里的亭长，干不了几回就被废免，反反复复好几次。"
    },
    "M004": {
      "status": "conveyed",
      "claim_fp": "eaade29f19653eed",
      "checked_at": "2026-08-09T09:04:07.891942+00:00",
      "note": "做官之后，凭着审理刑狱的本事一路升到廷史。"
    },
    "M005": {
      "status": "conveyed",
      "claim_fp": "2d112889613c13bb",
      "checked_at": "2026-08-09T09:04:07.891945+00:00",
      "note": "他投靠了张汤，在张汤手下做事，升为御史。"
    },
    "M006–M008": {
      "status": "conveyed",
      "claim_fp": "9ac8de4851abd196",
      "checked_at": "2026-08-09T09:04:07.891949+00:00",
      "note": "到了广平，他挑选郡中豪强果敢的官吏十余人做自己的爪牙，把这些人的隐秘重罪都捏在手里，然后放手让他们去督捕盗贼，只要合他心意、能抓到人就行。这些人就算犯下百般罪过，他也不依法惩处；可要是谁敢回避躲闪、不卖力办事，他就借别的事由把那人灭族。"
    },
    "M009": {
      "status": "conveyed",
      "claim_fp": "634397a9a2e05860",
      "checked_at": "2026-08-09T09:04:07.891953+00:00",
      "note": "齐、赵一带的盗贼都不敢靠近广平，广平号称路不拾遗。"
    },
    "M010": {
      "status": "conveyed",
      "claim_fp": "2486cd238a64271c",
      "checked_at": "2026-08-09T09:04:07.891963+00:00",
      "note": "皇帝听说了他的政绩，升他做河内太守。"
    },
    "M011–M012": {
      "status": "conveyed",
      "claim_fp": "330a2ddef0f6bd69",
      "checked_at": "2026-08-09T09:04:07.891965+00:00",
      "note": "王温舒平时在广平时，就已经把河内豪强奸恶之家摸得一清二楚。到任时，九月抵达。他下令郡中准备私马五十匹，从河内到长安一路设下驿站，部署官吏照搬广平时的方略，大肆搜捕郡中豪强狡猾之徒，郡中豪猾相连坐罪的有一千多家。"
    },
    "M013": {
      "status": "conveyed",
      "claim_fp": "2b0f044c4ec8ffbd",
      "checked_at": "2026-08-09T09:04:07.891968+00:00",
      "note": "他上书请示，大罪者灭族，小罪者处死，家产全部没收抵赃。"
    },
    "M014": {
      "status": "conveyed",
      "claim_fp": "a5a5cdc14b3be3b3",
      "checked_at": "2026-08-09T09:04:07.891970+00:00",
      "note": "奏章发出不过两三天，就得到批准。"
    },
    "M015": {
      "status": "conveyed",
      "claim_fp": "cf5ee89aece9a41b",
      "checked_at": "2026-08-09T09:04:07.891973+00:00",
      "note": "判决上报，行刑时流血长达十余里。"
    },
    "M016": {
      "status": "conveyed",
      "claim_fp": "8d40f63dda9a4ff0",
      "checked_at": "2026-08-09T09:04:07.891976+00:00",
      "note": "河内人都惊怪他奏报之快，认为神速。"
    },
    "M017–M018": {
      "status": "conveyed",
      "claim_fp": "e51e81d0b6245998",
      "checked_at": "2026-08-09T09:04:07.891978+00:00",
      "note": "到十二月，郡中寂静无声，没人敢夜里出行，野外连犬吠的盗贼都没有。那些没抓到的漏网之鱼，逃到旁郡邻国，追捕的人追过去抓回来，正好赶上春天。按汉法，春天不行刑，王温舒急得跺脚叹息说：「嗟乎，要是冬天能延长一个月，我的事就办完了！」他喜好杀伐、逞威而不爱惜人命，到了这种地步。"
    },
    "M019": {
      "status": "conveyed",
      "claim_fp": "4db1cf385168bcc5",
      "checked_at": "2026-08-09T09:04:12.456823+00:00",
      "note": "天子听说了王温舒在河内的所作所为，认为他有才能，升他做了中尉。"
    },
    "M020": {
      "status": "conveyed",
      "claim_fp": "99d674152996721a",
      "checked_at": "2026-08-09T09:04:12.456844+00:00",
      "note": "治理办法完全照搬河内那一套，把各地有名的凶恶狡猾的官吏都调来给自己当差——河内那边用的是杨皆、麻戊，关中这边用的是杨赣、成信等人。"
    },
    "M021": {
      "status": "conveyed",
      "claim_fp": "eb779001fbeba4bc",
      "checked_at": "2026-08-09T09:04:12.456850+00:00",
      "note": "当时义纵正做着内史，对王温舒心存忌惮，不敢放手行事。"
    },
    "M022": {
      "status": "conveyed",
      "claim_fp": "2cea7aaddcd3247d",
      "checked_at": "2026-08-09T09:04:12.456853+00:00",
      "note": "等到义纵死了，张汤也垮台之后，王温舒调任廷尉，而尹齐接替他做了中尉。"
    },
    "M017–M019": {
      "status": "conveyed",
      "claim_fp": "9ccffc676d766598",
      "checked_at": "2026-08-09T09:04:14.245036+00:00",
      "note": "白话译文中明确提到“到十二月，郡中寂静无声，没人敢夜里出行，野外连犬吠的盗贼都没有。”以及“那些没抓到的漏网之鱼，逃到旁郡邻国，追捕的人追过去抓回来，正好赶上春天。按汉法，春天不行刑，王温舒急得跺脚叹息说：‘嗟乎，要是冬天能延长一个月，我的事就办完了！’他喜好杀伐、逞威而不爱惜人命，到了这种地步。”和“天子听说了王温舒在河内的所作所为，认为他有才能，升他做了中尉。”"
    }
  }
