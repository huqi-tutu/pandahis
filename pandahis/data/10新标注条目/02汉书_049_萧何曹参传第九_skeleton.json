  "entries": [
    {
      "史略ID": "HANSHU_049_01",
      "史略名称": "酂侯萧何",
      "史略简介": "酂侯萧何",
      "原文字句": "萧何，沛人也。以文毋害为沛主吏掾。高祖为布衣时，数以吏事护高祖。高祖为亭长，常佑之。高祖以吏繇咸阳，吏皆送奉钱三，何独以五。秦御史监郡者，与从事辩之。何乃给泗水卒史事，第一。秦御史欲入言征何，何固请，得毋行。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷49·萧何曹参传》",
      "paragraphs": [
