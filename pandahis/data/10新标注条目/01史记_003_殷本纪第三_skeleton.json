    },
    {
      "史略ID": "SHIJI_003_02",
      "史略名称": "帝辛（纣）",
      "史略简介": "帝辛（纣）",
      "原文字句": "帝乙长子曰微子启，启母贱，不得嗣。少子辛，辛母正后，辛为嗣。帝乙崩，子辛立，是为帝辛，天下谓之纣。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷3·殷本纪》",
      "paragraphs": [
        {
          "volume": "殷本纪",
          "paragraph_from": 33,
          "paragraph_to": 40
        }
      ],
      "五级细坐标": "史记·卷003·君王·02",
      "六级段落锚点": "[P33-P40]",
      "原文出处": "殷本纪·P33-P40"
    },
    {
      "史略ID": "SHIJI_003_03",
      "史略名称": "成汤",
      "史略简介": "成汤",
      "原文字句": "成汤，自契至汤八迁。汤始居亳，从先王居，作帝诰。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷3·殷本纪》",
      "paragraphs": [
        {
          "volume": "殷本纪",
          "paragraph_from": 3,
          "paragraph_to": 11
        }
      ],
      "五级细坐标": "史记·卷003·君王·03",
      "六级段落锚点": "[P3-P11]",
      "原文出处": "殷本纪·P3-P11"
    },
    {
      "史略ID": "SHIJI_003_04",
      "史略名称": "武丁",
      "史略简介": "武丁",
      "原文字句": "帝小乙崩，子帝武丁立。帝武丁即位，思复兴殷，而未得其佐。三年不言，政事决定於冢宰，以观国风。武丁夜梦得圣人，名曰说。以梦所见视群臣百吏，皆非也。於是乃使百工营求之野，得说於傅险中。是时说为胥靡，筑於傅险。见於武丁，武丁曰是也。得而与之语，果圣人，举以为相，殷国大治。故遂以傅险姓之，号曰傅说。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷3·殷本纪》",
      "paragraphs": [
        {
          "volume": "殷本纪",
          "paragraph_from": 25,
          "paragraph_to": 27
        }
      ],
      "五级细坐标": "史记·卷003·君王·04",
      "六级段落锚点": "[P25-P27]",
      "原文出处": "殷本纪·P25-P27"
    },
    {
      "史略ID": "SHIJI_003_05",
      "史略名称": "盘庚",
      "史略简介": "盘庚",
      "原文字句": "帝阳甲崩，弟盘庚立，是为帝盘庚。帝盘庚之时，殷已都河北，盘庚渡河南，复居成汤之故居，乃五迁，无定处。殷民咨胥皆怨，不欲徙。盘庚乃告谕诸侯大臣曰：“昔高后成汤与尔之先祖俱定天下，法则可修。舍而弗勉，何以成德！”",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷3·殷本纪》",
      "paragraphs": [
