    },
    {
      "史略ID": "SHIJI_046_03",
      "史略名称": "齐威王",
      "史略简介": "齐威王",
      "原文字句": "六年，救卫。桓公卒，子威王因齐立。是岁，故齐康公卒，绝无后，奉邑皆入田氏。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷46·田敬仲完世家》",
      "paragraphs": [
        {
