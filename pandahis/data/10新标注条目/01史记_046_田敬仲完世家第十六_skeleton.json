    },
    {
      "史略ID": "SHIJI_046_02",
      "史略名称": "齐桓公午",
      "史略简介": "齐桓公午",
      "原文字句": "齐侯太公和立二年，和卒，子桓公午立。桓公午五年，秦、魏攻韩，韩求救於齐。齐桓公召大臣而谋曰：“蚤救之孰与晚救之？”驺忌曰：“不若勿救。”",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷46·田敬仲完世家》",
      "paragraphs": [
        {
          "volume": "田敬仲完世家",
