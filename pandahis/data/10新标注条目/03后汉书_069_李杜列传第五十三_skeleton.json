  "entries": [
    {
      "史略ID": "HOUHANSHU_069_01",
      "史略名称": "李固",
      "史略简介": "李固",
      "原文字句": "李固字子坚，汉中南郑人，司徒郃之子也。郃在《方术传》。固貌状有奇表，鼎角匿犀，足履龟文。少好学，常步行寻师，不远千里。遂究览坟籍，结交英贤。四方有志之士，多慕其风而来学。京师咸叹曰：“是复为李公矣。”司隶、益州并命郡举孝廉，辟司空掾，皆不就。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷69·李杜列传》",
      "paragraphs": [
