      "六级段落锚点": "[P7-P11]",
      "原文出处": "隽疏于薛平彭传·P7-P11"
    },
    {
      "史略ID": "HANSHU_083_03",
      "史略名称": "于定国",
      "史略简介": "于定国",
      "原文字句": "于定国字曼倩，东海郯人也。其父于公为县狱吏、郡决曹，决狱平，罗文法者于公所决皆不恨。郡中为之生立祠，号曰于公祠。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷83·隽疏于薛平彭传》",
      "paragraphs": [
        {
          "volume": "隽疏于薛平彭传",
          "paragraph_from": 12,
          "paragraph_to": 19
        }
      ],
