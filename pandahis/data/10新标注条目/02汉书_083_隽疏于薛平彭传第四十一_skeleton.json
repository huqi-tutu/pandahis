      "六级段落锚点": "[P12-P19]",
      "原文出处": "隽疏于薛平彭传·P12-P19"
    },
    {
      "史略ID": "HANSHU_083_04",
      "史略名称": "薛广德",
      "史略简介": "薛广德",
      "原文字句": "薛广德字长卿，沛郡相人也。以《鲁诗》教授楚国，龚胜、舍师事焉。萧望之为御史大夫，除广德为属，数与论议，器之，荐广德经行宜充本朝。为博士，论石渠，迁谏大夫，代贡禹为长信少府、御史大夫。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷83·隽疏于薛平彭传》",
      "paragraphs": [
        {
          "volume": "隽疏于薛平彭传",
          "paragraph_from": 20,
          "paragraph_to": 22
        }
      ],
      "五级细坐标": "汉书·卷083·文臣·04",
      "六级段落锚点": "[P20-P22]",
      "原文出处": "隽疏于薛平彭传·P20-P22"
    },
    {
      "史略ID": "HANSHU_083_05",
      "史略名称": "平当",
      "史略简介": "平当",
      "原文字句": "平当字子思，祖父以訾百万，自下邑徙平陵。当少为大行治礼丞，功次补大鸿胪文学，察廉为顺阳长、栒邑令，以明经为博士，公卿荐当论议通明，给事中。每有灾异，当辄傅经术，言得失。文雅虽不能及萧望之、匡衡，然指意略同。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷83·隽疏于薛平彭传》",
      "paragraphs": [
        {
          "volume": "隽疏于薛平彭传",
          "paragraph_from": 23,
          "paragraph_to": 27
        }
      ],
      "五级细坐标": "汉书·卷083·文臣·05",
      "六级段落锚点": "[P23-P27]",
      "原文出处": "隽疏于薛平彭传·P23-P27"
    },
    {
      "史略ID": "HANSHU_083_06",
      "史略名称": "彭宣",
      "史略简介": "彭宣",
      "原文字句": "鼓宣字子佩，淮阳阳夏人也。治《易》，事张禹，举为博士，迁东平太傅。禹以帝师见尊信，荐宣经明有威重，可任政事，繇是入为右扶风，迁廷尉，以王国人出为太原太守。数年，复入为大司农、光禄勋、右将军。哀帝即位，徙为左将军。岁余，上欲令丁、傅处爪牙官，乃策宣曰：“有司数奏言诸侯国人不得宿卫，将军不宜典兵马，处大位。朕唯将军任汉将之重，而子又前取淮阳王女，婚姻不绝，非国之制。使光禄大夫曼赐将军黄金五十斤、安车驷",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷83·隽疏于薛平彭传》",
