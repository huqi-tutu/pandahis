  "entries": [
    {
      "史略ID": "HOUHANSHU_011_01",
      "史略名称": "光武郭皇后",
      "史略简介": "光武郭皇后",
      "原文字句": "光武郭皇后讳圣通，真定稿人也。为郡著姓。父昌，让田宅财产数百万与异母弟，国人义之。仕郡功曹。娶真定恭王女，号郭主，生后及子况。昌早卒。郭主虽王家女，而好礼节俭，有母仪之德。更始二年春，光武击王郎，至真定，因纳后，有宠。及即位，以为贵人。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷11·皇后纪第十上》",
      "paragraphs": [
        {
          "volume": "皇后纪第十上",
          "paragraph_from": 6,
          "paragraph_to": 10
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_011_02",
      "史略名称": "光烈阴皇后",
      "史略简介": "光烈阴皇后",
      "原文字句": "光烈阴皇后讳丽华，南阳新野人。初，光武适新野，闻后美，心悦之。后至长安，见执金吾车骑甚盛，因叹曰：“仕宦当作执金吾，娶妻当得阴丽华。”更始元年六月，遂纳后于宛当成里，时年十九。及光武为司隶校尉，方西之洛阳，令后归新野。及邓奉起兵，后兄识为之将，后随家属徙淯阴，止于奉舍。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷11·皇后纪第十上》",
      "paragraphs": [
        {
          "volume": "皇后纪第十上",
          "paragraph_from": 12,
          "paragraph_to": 16
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_011_03",
      "史略名称": "明德马皇后",
      "史略简介": "明德马皇后",
      "原文字句": "明德马皇后讳某，伏波将军援之小女也。少丧父母。兄客卿惠敏早夭，母蔺夫人悲伤发疾慌惚。后时年十岁，干理家事，敕制僮御，内外咨禀，事同成人。初，诸家莫知者，后闻之，咸叹异焉。后尝久疾，太夫人令筮之，筮者曰：“此女虽有患状而当大贵，兆不可言也。”后又呼相者使占诸女，见后，大惊曰：“我必为此女称臣。然贵而少子，若养它子者得力，乃当逾于所生。”",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷11·皇后纪第十上》",
      "paragraphs": [
        {
          "volume": "皇后纪第十上",
          "paragraph_from": 17,
          "paragraph_to": 29
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_011_04",
      "史略名称": "章德窦皇后",
      "史略简介": "章德窦皇后",
      "原文字句": "章德窦皇后讳某，扶风平陵人，大司空融之曾孙也。祖穆，父勋，坐事死，事在《窦融传》。勋尚东海恭王强女沘阳公主，后其长女也。家既废坏，数呼相工问息耗，见后者皆言当大尊贵，非臣妾容貌。年六岁能书，亲家皆奇之。建初二年，后与女弟俱以选例入见长乐宫，进止有序，风容甚盛。肃宗先闻后有才色，数以讯诸姬傅。及见，雅以为美，马太后亦异焉，因入掖庭，见于北宫章德殿。后性敏给，倾心承接，称誉日闻。明年，遂立为皇后，妹为",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷11·皇后纪第十上》",
      "paragraphs": [
        {
          "volume": "皇后纪第十上",
          "paragraph_from": 31,
          "paragraph_to": 32
        },
