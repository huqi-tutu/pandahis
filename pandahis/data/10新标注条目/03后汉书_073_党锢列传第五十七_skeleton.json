  "entries": [
    {
      "史略ID": "HOUHANSHU_073_01",
      "史略名称": "李膺",
      "史略简介": "李膺",
      "原文字句": "李膺字元礼，颍川襄城人也。祖父脩，安帝时为太尉。父益，赵国相。膺性简亢，无所交接，唯以同郡荀淑、陈寔为师友。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷73·党锢列传》",
      "paragraphs": [
        {
          "volume": "党锢列传",
          "paragraph_from": 16,
          "paragraph_to": 28
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_073_02",
      "史略名称": "范滂",
      "史略简介": "范滂",
      "原文字句": "范滂字孟博，汝南征羌人也。少厉清节，为州里所服，举孝廉，光禄四行。时冀州饥荒，盗贼群起，乃以滂为清诏使，案察之。滂登车揽辔，慨然有澄清天下之志。乃至州境，守令自知臧污，望风解印绶去。其所举奏，莫不厌塞众议。迁光禄勋主事。时，陈蕃为光禄勋，滂执公仪诣蕃，蕃不止之，滂怀恨，投版弃官而去。郭林宗闻而让蕃曰：“若范孟博者，岂宜以公礼格之？今成其去就之名，得无自取不优之议也？”蕃乃谢焉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷73·党锢列传》",
      "paragraphs": [
        {
          "volume": "党锢列传",
          "paragraph_from": 46,
          "paragraph_to": 52
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_073_03",
      "史略名称": "张俭",
      "史略简介": "张俭",
      "原文字句": "张俭字元节，山阳高平人，赵王张耳之后也。父成，江夏太守，俭初举茂才，以刺史非其人，谢病不起。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷73·党锢列传》",
      "paragraphs": [
        {
          "volume": "党锢列传",
          "paragraph_from": 58,
          "paragraph_to": 61
        }
      ]
    }
