    {
      "史略ID": "HANSHU_092_04",
      "史略名称": "刘竟",
      "史略简介": "刘竟",
      "原文字句": "中山哀王竟，初元二年立为清河王。三年，徙中山，以幼少未之国。建昭四年，薨邸，葬杜陵，无子，绝。太后归居外家戎氏。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷92·宣元六王传》",
      "paragraphs": [
