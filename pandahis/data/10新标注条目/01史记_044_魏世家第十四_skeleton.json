  "entries": [
    {
      "史略ID": "SHIJI_044_01",
      "史略名称": "魏文侯",
      "史略简介": "魏文侯",
      "原文字句": "桓子之孙曰文侯都。魏文侯元年，秦灵公之元年也。与韩武子、赵桓子、周威王同时。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷44·魏世家》",
      "paragraphs": [
        {
          "volume": "魏世家",
          "paragraph_from": 10,
          "paragraph_to": 19
        }
      ],
      "五级细坐标": "史记·卷044·诸侯·01",
      "六级段落锚点": "[P10-P19]",
      "原文出处": "魏世家·P10-P19"
    },
    {
      "史略ID": "SHIJI_044_02",
      "史略名称": "魏武侯",
      "史略简介": "魏武侯",
      "原文字句": "三十八年，伐秦，败我武下，得其将识。是岁，文侯卒，子击立，是为武侯。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷44·魏世家》",
      "paragraphs": [
        {
          "volume": "魏世家",
          "paragraph_from": 19,
          "paragraph_to": 22
        }
      ],
      "五级细坐标": "史记·卷044·诸侯·02",
      "六级段落锚点": "[P19-P22]",
      "原文出处": "魏世家·P19-P22"
    },
    {
      "史略ID": "SHIJI_044_03",
      "史略名称": "魏惠王",
      "史略简介": "魏惠王",
      "原文字句": "十六年，伐楚，取鲁阳。武侯卒，子罃立，是为惠王。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷44·魏世家》",
      "paragraphs": [
        {
          "volume": "魏世家",
          "paragraph_from": 22,
          "paragraph_to": 33
        }
      ],
      "五级细坐标": "史记·卷044·诸侯·03",
      "六级段落锚点": "[P22-P33]",
      "原文出处": "魏世家·P22-P33"
    },
    {
      "史略ID": "SHIJI_044_04",
      "史略名称": "魏安釐王",
      "史略简介": "魏安釐王",
      "原文字句": "十三年，秦拔我安城。兵到大梁，去。十八年，秦拔郢，楚王徙陈。十九年，昭王卒，子安釐王立。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷44·魏世家》",
      "paragraphs": [
