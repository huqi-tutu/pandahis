          "volume": "吴延史卢赵列传",
          "paragraph_from": 2,
          "paragraph_to": 6
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_070_02",
      "史略名称": "延笃",
      "史略简介": "延笃",
      "原文字句": "延笃字叔坚，南阳犨人也。少从颍川唐溪典受《左氏传》，旬日能讽之，典深敬焉。又从马融受业，博通经传及百家之言，能著文章，有名京师。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷70·吴延史卢赵列传》",
      "paragraphs": [
        {
          "volume": "吴延史卢赵列传",
          "paragraph_from": 7,
          "paragraph_to": 15
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_070_03",
      "史略名称": "史弼",
      "史略简介": "史弼",
      "原文字句": "史弼字公谦，陈留考城人也。父敞，顺帝时以佞辩至尚书、郡守。弼少笃学，聚徒数百。仕州郡，辟公府，迁北军中候。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷70·吴延史卢赵列传》",
      "paragraphs": [
        {
          "volume": "吴延史卢赵列传",
          "paragraph_from": 16,
          "paragraph_to": 21
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_070_04",
      "史略名称": "卢植",
      "史略简介": "卢植",
      "原文字句": "卢植字子幹，涿郡涿人也。身长八尺二寸，音声如钟。少与郑玄俱事马融，能通古今学，好研精而不守章句。融外戚豪家，多列女倡歌舞于前。植侍讲积年，未尝转眄，融以是敬之。学终辞归，阖门教授。性刚毅有大节，常怀济世志，不好辞赋，能饮酒一石。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷70·吴延史卢赵列传》",
      "paragraphs": [
        {
          "volume": "吴延史卢赵列传",
          "paragraph_from": 23,
          "paragraph_to": 36
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_070_05",
      "史略名称": "赵岐",
      "史略简介": "赵岐",
      "原文字句": "赵岐字邠卿，京兆长陵人也。初名嘉，生于御史台，因字台卿，后避难，故自改名字，示不忘本土也。岐少明经，有才艺，娶扶风马融兄女。融外戚豪家，岐常鄙之，不与融相见，仕州郡，以廉直疾恶见惮。年三十余，有重疾，卧蓐七年，自虑奄忽，乃为遗令敕兄子曰：“大丈夫生世，遁无箕山之操，仕无伊、吕之勋，天不我与，复何言哉！可立一员石于吾墓前，刻之曰：‘汉有逸人，姓赵名嘉。有志无时，命也奈何！’”其后疾瘳。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷70·吴延史卢赵列传》",
