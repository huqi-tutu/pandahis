  "entries": [
    {
      "史略ID": "SHIJI_081_01",
      "史略名称": "廉颇",
      "史略简介": "廉颇",
      "原文字句": "廉颇者，赵之良将也。赵惠文王十六年，廉颇为赵将伐齐，大破之，取阳晋，拜为上卿，以勇气闻於诸侯。蔺相如者，赵人也，为赵宦者令缪贤舍人。",
      "史略分类": "武将",
