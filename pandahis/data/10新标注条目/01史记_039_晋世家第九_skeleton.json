    {
      "史略ID": "SHIJI_039_01",
      "史略名称": "晋唐叔虞",
      "史略简介": "晋唐叔虞",
      "原文字句": "晋唐叔虞者，周武王子而成王弟。初，武王与叔虞母会时，梦天谓武王曰：“余命女生子，名虞，余与之唐。”及生子，文在其手曰“虞”，故遂因命之曰虞。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
      "paragraphs": [
        {
          "volume": "晋世家",
          "paragraph_from": 1,
          "paragraph_to": 2
        }
      ],
      "五级细坐标": "史记·卷039·诸侯·01",
      "六级段落锚点": "[P1-P2]",
      "原文出处": "晋世家·P1-P2"
    },
    {
      "史略ID": "SHIJI_039_02",
      "史略名称": "晋悼公",
      "史略简介": "晋悼公",
      "原文字句": "公弗听，谢栾书等以诛郤氏罪：“大夫复位。”二子顿首曰：“幸甚幸甚！”公使胥童为卿。闰月乙卯，厉公游匠骊氏，栾书、中行偃以其党袭捕厉公，囚之，杀胥童，而使人迎公子周于周而立之，是为悼公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
      "paragraphs": [
        {
          "volume": "晋世家",
          "paragraph_from": 151,
          "paragraph_to": 156
        }
      ],
      "五级细坐标": "史记·卷039·诸侯·02",
      "六级段落锚点": "[P151-P156]",
      "原文出处": "晋世家·P151-P156"
    },
    {
      "史略ID": "SHIJI_039_03",
      "史略名称": "晋文公",
      "史略简介": "晋文公",
      "原文字句": "何以教之？”怀公卒杀狐突。秦缪公乃发兵送内重耳，使人告栾、郤之党为内应，杀怀公於高梁，入重耳。重耳立，是为文公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
      "paragraphs": [
        {
          "volume": "晋世家",
          "paragraph_from": 62,
          "paragraph_to": 103
        }
      ],
      "五级细坐标": "史记·卷039·诸侯·03",
      "六级段落锚点": "[P62-P103]",
      "原文出处": "晋世家·P62-P103"
    },
    {
      "史略ID": "SHIJI_039_04",
      "史略名称": "晋献公",
      "史略简介": "晋献公",
      "原文字句": "武公称者，先晋穆侯曾孙也，曲沃桓叔孙也。桓叔者，始封曲沃。武公，庄伯子也。自桓叔初封曲沃以至武公灭晋也，凡六十七岁，而卒代晋为诸侯。武公代晋二岁，卒。与曲沃通年，即位凡三十九年而卒。子献公诡诸立。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷39·晋世家》",
