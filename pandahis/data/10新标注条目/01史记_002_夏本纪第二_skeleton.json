      "五级细坐标": "史记·卷002·君王·02",
      "六级段落锚点": "[P39-P42]",
      "原文出处": "夏本纪·P39-P42"
    },
    {
      "史略ID": "SHIJI_002_03",
      "史略名称": "太康",
      "史略简介": "太康",
      "原文字句": "夏后帝启崩，子帝太康立。帝太康失国，昆弟五人，须于洛汭，作五子之歌。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷2·夏本纪》",
      "paragraphs": [
        {
          "volume": "夏本纪",
          "paragraph_from": 42,
          "paragraph_to": 42
        }
      ],
      "五级细坐标": "史记·卷002·君王·03",
      "六级段落锚点": "[P42]",
      "原文出处": "夏本纪·P42"
    },
    {
      "史略ID": "SHIJI_002_04",
      "史略名称": "孔甲",
      "史略简介": "孔甲",
      "原文字句": "帝孔甲立，好方鬼神，事淫乱。夏后氏德衰，诸侯畔之。天降龙二，有雌雄，孔甲不能食，未得豢龙氏。陶唐既衰，其后有刘累，学扰龙于豢龙氏，以事孔甲。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷2·夏本纪》",
      "paragraphs": [
        {
          "volume": "夏本纪",
          "paragraph_from": 45,
          "paragraph_to": 46
        }
      ],
      "五级细坐标": "史记·卷002·君王·04",
      "六级段落锚点": "[P45-P46]",
      "原文出处": "夏本纪·P45-P46"
    },
    {
      "史略ID": "SHIJI_002_05",
      "史略名称": "桀",
      "史略简介": "桀",
      "原文字句": "孔甲崩，子帝皋立。帝皋崩，子帝发立。帝发崩，子帝履癸立，是为桀。帝桀之时，自孔甲以来而诸侯多畔夏，桀不务德而武伤百姓，百姓弗堪。乃召汤而囚之夏台，已而释之。汤修德，诸侯皆归汤，汤遂率兵以伐夏桀。桀走鸣条，遂放而死。桀谓人曰：“吾悔不遂杀汤於夏台，使至此。”汤乃践天子位，代夏朝天下。汤封夏之后，至周封於杞也。",
      "史略分类": "君王",
      "主要史料出处": "《史记·卷2·夏本纪》",
      "paragraphs": [
        {
          "volume": "夏本纪",
          "paragraph_from": 47,
