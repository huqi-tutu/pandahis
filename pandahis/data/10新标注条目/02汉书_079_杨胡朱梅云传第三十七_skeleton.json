          "paragraph_to": 15
        }
      ],
      "五级细坐标": "汉书·卷079·文臣·03",
      "六级段落锚点": "[P8-P15]",
      "原文出处": "杨胡朱梅云传·P8-P15"
    },
    {
      "史略ID": "HANSHU_079_04",
      "史略名称": "梅福",
      "史略简介": "梅福",
      "原文字句": "梅福字子真，九江寿春人也。少学长安，明《尚书》《谷梁春秋》，为郡文学，补南昌尉。后去官归寿春，数因县道上言变事，求假轺传，诣行在所条对急政，辄报罢。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷79·杨胡朱梅云传》",
      "paragraphs": [
        {
          "volume": "杨胡朱梅云传",
          "paragraph_from": 16,
          "paragraph_to": 26
        }
      ],
      "五级细坐标": "汉书·卷079·文臣·04",
      "六级段落锚点": "[P16-P26]",
      "原文出处": "杨胡朱梅云传·P16-P26"
    },
    {
      "史略ID": "HANSHU_079_05",
      "史略名称": "云敞",
      "史略简介": "云敞",
      "原文字句": "云敞字幼孺，平陵人也。师事同县吴章，章治《尚书经》为博士。平帝以中山王即帝位，年幼，莽秉政，自号安汉公。以平帝为成帝后，不得顾私亲，帝母及外家卫氏皆留中山，不得至京师。莽长子宇，非莽隔绝卫氏，恐帝长大后见怨。宇与吴章谋，夜以血涂莽门，若鬼神之戒，冀以惧莽。章欲因对其咎。事发觉，莽杀宇，诛灭卫氏，谋所联及，死者百余人。章坐要斩，磔尸东市门。初，章为当世名儒，教授尤盛，弟子千余人，莽以为恶人党，皆当禁",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷79·杨胡朱梅云传》",
