  "entries": [
    {
      "史略ID": "HANSHU_113_01",
      "史略名称": "孝成许皇后",
      "史略简介": "孝成许皇后",
      "原文字句": "孝成许皇后，大司马车骑将军平恩侯嘉女也。元帝悼伤母恭哀后居位日浅而遭霍氏之辜，故选嘉女以配皇太子。初入太子家，上令中常侍黄门亲近者侍送，还白太子欢说状，元帝喜谓左右：“酌酒贺我！”左右皆称万岁。久之，有一男，失之。乃成帝即位，立许妃为皇后，复生一女，失之。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 4,
          "paragraph_to": 15
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·01",
      "六级段落锚点": "[P4-P15]",
      "原文出处": "外戚传第六十七下·P4-P15"
    },
    {
      "史略ID": "HANSHU_113_02",
      "史略名称": "孝成班婕妤",
      "史略简介": "孝成班婕妤",
      "原文字句": "孝成班婕妤。帝初即位选入后宫。始为少使，蛾而大幸，为婕妤，居增成舍，再就馆，有男，数月失之。成帝游于后庭，尝欲与婕妤同辇载，婕妤辞曰：“观古图画，贤圣之君皆有名臣在侧，三代末主乃有嬖女，今欲同辇，得无近似之乎？”上善其言而止。太后闻之，喜曰：“古有樊姬，今有班婕妤。”婕妤诵《诗》及《窃窕》《德象》《女师》之篇。每进见上疏，依则古礼。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 16,
          "paragraph_to": 22
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·02",
      "六级段落锚点": "[P16-P22]",
      "原文出处": "外戚传第六十七下·P16-P22"
    },
    {
      "史略ID": "HANSHU_113_03",
      "史略名称": "孝成赵皇后",
      "史略简介": "孝成赵皇后",
      "原文字句": "孝成赵皇后，本长安宫人。初生时，父母不举，三日不死，乃收养之。及壮，属阳阿主家，学歌舞，号曰飞燕。成帝尝微行出。过阳阿主，作乐，上见飞燕而说之，召入宫，大幸。有女弟复召入，俱为婕妤，贵倾后宫。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 23,
          "paragraph_to": 40
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·03",
      "六级段落锚点": "[P23-P40]",
      "原文出处": "外戚传第六十七下·P23-P40"
    },
    {
      "史略ID": "HANSHU_113_04",
      "史略名称": "孝元傅昭仪",
      "史略简介": "孝元傅昭仪",
      "原文字句": "孝元傅昭仪，哀帝祖母也。父河内温人，蚤卒，母更嫁为魏郡郑翁妻，生男恽。昭仪少为上官太后才人，自元帝为太子，得进幸。元帝即位，立为婕妤，甚有宠。为人有材略，善事人，下至宫人左右，饮酒酹地，皆祝延之。产一男一女，女为平都公主，男为定陶恭王。恭王有材艺，尤爱于上。元帝既重傅婕妤，及冯婕妤亦幸，生中山孝王，上欲殊之于后宫，以二人皆有子为王，上尚在，未得称太后，乃更号曰昭仪，赐以印绶，在婕妤上。昭其仪，尊之",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 41,
          "paragraph_to": 45
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·04",
      "六级段落锚点": "[P41-P45]",
      "原文出处": "外戚传第六十七下·P41-P45"
    },
    {
      "史略ID": "HANSHU_113_05",
      "史略名称": "孝哀丁姬",
      "史略简介": "孝哀丁姬",
      "原文字句": "定陶丁姬，哀帝母也，《易》祖师丁将军之玄孙。家在山阳瑕丘，父至庐江太守。始，定陶恭王先为山阳王，而丁氏内其女为姬。王后姓张氏，其母郑礼，即傅太后同母弟也。太后以亲戚故，欲其有子，然终无有。唯丁姬河平四年生哀帝。丁姬为帝太后，两兄忠、明。明以帝舅封阳安侯。忠蚤死，封忠子满为平周侯。太后叔父宪、望，望为左将军，宪为太仆。明为大司马票骑将军，辅政。丁氏侯者凡二人，大司马一人，将军、九卿、二千石六人，侍中",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 46,
          "paragraph_to": 50
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·05",
      "六级段落锚点": "[P46-P50]",
      "原文出处": "外戚传第六十七下·P46-P50"
    },
    {
      "史略ID": "HANSHU_113_06",
      "史略名称": "孝哀傅皇后",
      "史略简介": "孝哀傅皇后",
      "原文字句": "孝哀傅皇后，定陶太后从弟子也。哀帝为定陶王时，傅太后欲重亲，取以配王。王入为汉太子，傅氏女为妃。哀帝即位，成帝大行尚在前殿，而傅太后封傅妃父晏为孔乡侯，与帝舅阳安侯丁明同日俱封。时师丹谏，以为：“天下自王者所有，亲戚何患不富贵？而仓卒若是，其不久长矣！”晏封后月余，傅妃立为皇后。傅氏既盛，晏最尊重。哀帝崩，王莽白太皇太后下诏曰：“定陶共王太后与孔乡侯晏同心合谋，背恩忘本，专恣不轨，与至尊同称号，终",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
      "paragraphs": [
        {
          "volume": "外戚传第六十七下",
          "paragraph_from": 51,
          "paragraph_to": 51
        }
      ],
      "五级细坐标": "汉书·卷113·宗戚·06",
      "六级段落锚点": "[P51]",
      "原文出处": "外戚传第六十七下·P51"
    },
    {
      "史略ID": "HANSHU_113_07",
      "史略名称": "孝元冯昭仪",
      "史略简介": "孝元冯昭仪",
      "原文字句": "孝元冯昭仪，平帝祖母也。元帝即位二年，以选入后宫。时父奉世为执金吾。昭仪始为长使，数月至美人，后五年就馆生男，拜为婕妤。时父奉世为右将军光禄勋，奉世长男野王为左冯翊，父子并居朝廷，议者以为器能当其位，非用女宠故也。而冯婕妤内宠与傅昭仪等。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷113·外戚传第六十七下》",
