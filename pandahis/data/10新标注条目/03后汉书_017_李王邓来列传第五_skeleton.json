  "entries": [
    {
      "史略ID": "HOUHANSHU_017_01",
      "史略名称": "李通",
      "史略简介": "李通",
      "原文字句": "李通，字次元，南阳宛人也。世以贷殖著姓。父守，身长九尺，容貌绝异，为人严毅，居家如官廷。初事刘歆，好星历谶记，为王莽宗卿师。通亦为五威将军从事，出补巫丞，有能名。莽未，百姓愁怨，通素闻守说谶云“刘氏复兴，李氏为辅”，私常怀之。且居家富逸，为闾里雄，以此不乐为吏，乃自免归。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷17·李王邓来列传》",
      "paragraphs": [
        {
          "volume": "李王邓来列传",
          "paragraph_from": 2,
          "paragraph_to": 9
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_017_02",
      "史略名称": "王常",
      "史略简介": "王常",
      "原文字句": "王常字颜卿，颍川舞阳人也。王莽未，为弟报仇，亡命江夏。久之，与王凤、王匡等起兵云杜绿林中，聚众数万人，以常为偏裨，攻傍县。后与成丹、张卬别入南郡蓝口，号下江兵。王莽遣严尤、陈茂击破之。常与丹、卬收散卒入蒌溪，劫略钟、龙间，众复振。引军与刑州牧战于上唐，大破之，遂北至宜秋。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷17·李王邓来列传》",
      "paragraphs": [
        {
          "volume": "李王邓来列传",
          "paragraph_from": 11,
          "paragraph_to": 16
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_017_03",
      "史略名称": "邓晨",
      "史略简介": "邓晨",
      "原文字句": "邓晨字伟卿，南阳新野人也。世吏二千石。父宏，预章都尉。晨初聚光武姊元。王莽末，光武尝与兄伯升及晨俱之宛，与穰人蔡少公等宴语。少公颇学图谶，言刘秀当为天子。或曰：“是国师公刘秀乎？”光武戏曰：“何用知非仆耶？”坐者皆大笑，晨心独喜。及光武与家属避吏新野，舍晨庐，甚相亲爱。晨因谓光武曰：“王莽悖暴，盛夏斩人，此天亡之时也。往时会宛，独当应耶？”光武笑不答。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷17·李王邓来列传》",
      "paragraphs": [
        {
          "volume": "李王邓来列传",
          "paragraph_from": 17,
          "paragraph_to": 22
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_017_04",
      "史略名称": "来歙",
      "史略简介": "来歙",
      "原文字句": "来歙字君叔，南阳新野人也。六世祖汉，有才力，武帝世，以光禄大夫副楼船将军杨仆，击破南越、朝鲜。父仲，哀帝时为谏大夫，娶光武祖姑，生歙。光武甚亲敬之，数共往来长安。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷17·李王邓来列传》",
      "paragraphs": [
        {
          "volume": "李王邓来列传",
          "paragraph_from": 23,
          "paragraph_to": 32
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_017_05",
      "史略名称": "来历",
      "史略简介": "来历",
      "原文字句": "历字伯珍，少袭爵，以公主子，永元中为侍中，监羽林右骑。永初三年，迁射声校尉。永宁元年，代冯石为执金吾。延光元年，尊历母为长公主。二年，迁历太仆。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷17·李王邓来列传》",
