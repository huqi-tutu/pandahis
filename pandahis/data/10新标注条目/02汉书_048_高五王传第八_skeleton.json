      "六级段落锚点": "[P8]",
      "原文出处": "高五王传·P8"
    },
    {
      "史略ID": "HANSHU_048_05",
      "史略名称": "燕王刘建",
      "史略简介": "燕王刘建",
      "原文字句": "燕灵王建。十一年，燕王卢绾亡入匈奴，明年，立建为燕王。十五年薨，有美人子，太后使人杀之，绝后。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷48·高五王传》",
