          "paragraph_to": 10
        }
      ],
      "五级细坐标": "史记·卷093·武将·01",
      "六级段落锚点": "[P1-P10]",
      "原文出处": "韩信卢绾列传·P1-P10"
    },
    {
      "史略ID": "SHIJI_093_02",
      "史略名称": "卢绾",
      "史略简介": "卢绾",
      "原文字句": "卢绾者，丰人也，与高祖同里。卢绾亲与高祖太上皇相爱，及生男，高祖、卢绾同日生，里中持羊酒贺两家。及高祖、卢绾壮，俱学书，又相爱也。里中嘉两家亲相爱，生子同日，壮又相爱，复贺两家羊酒。高祖为布衣时，有吏事辟匿，卢绾常随出入上下。及高祖初起沛，",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷93·韩信卢绾列传》",
      "paragraphs": [
        {
          "volume": "韩信卢绾列传",
          "paragraph_from": 11,
          "paragraph_to": 18
        }
      ],
      "五级细坐标": "史记·卷093·武将·02",
      "六级段落锚点": "[P11-P18]",
      "原文出处": "韩信卢绾列传·P11-P18"
    },
    {
      "史略ID": "SHIJI_093_03",
      "史略名称": "陈豨",
      "史略简介": "陈豨",
      "原文字句": "陈豨者，宛朐人也，不知始所以得从。及高祖七年冬，韩王信反，入匈奴，上至平城还，乃封豨为列侯，以赵相国将监赵、代边兵，边兵皆属焉。",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷93·韩信卢绾列传》",
      "paragraphs": [
