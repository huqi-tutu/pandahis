  "entries": [
    {
      "史略ID": "SHIJI_093_01",
      "史略名称": "韩王信",
      "史略简介": "韩王信",
      "原文字句": "韩王信者，故韩襄王孽孙也，长八尺五寸。及项梁之立楚后怀王也，燕、齐、赵、魏皆已前王，唯韩无有后，故立韩诸公子横阳君成为韩王，欲以抚定韩故地。",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷93·韩信卢绾列传》",
      "paragraphs": [
        {
          "volume": "韩信卢绾列传",
