          "paragraph_to": 25
        }
      ],
      "五级细坐标": "汉书·卷055·文臣·03",
      "六级段落锚点": "[P19-P25]",
      "原文出处": "蒯伍江息夫传·P19-P25"
    },
    {
      "史略ID": "HANSHU_055_04",
      "史略名称": "息夫躬",
      "史略简介": "息夫躬",
      "原文字句": "息夫躬字子微，河内河阳人也。少为博士弟子，受《春秋》，通览记书。容貌壮丽，为众所异。",
      "史略分类": "文臣",
