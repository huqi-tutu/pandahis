  "entries": [
    {
      "史略ID": "HANSHU_082_01",
      "史略名称": "傅介子",
      "史略简介": "傅介子",
      "原文字句": "傅介子，北地人也，以从军为官。先是，龟兹、楼兰皆尝杀汉使者，语在《西域传》。至元凤中，介子以骏马监求使大宛，因诏令青楼兰、龟兹国。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷82·傅常郑甘陈段传》",
      "paragraphs": [
