    },
    {
      "史略ID": "HOUHANSHU_034_02",
      "史略名称": "襄楷",
      "史略简介": "襄楷",
      "原文字句": "襄楷字公矩，平原隰阴人也。好学博古，善天文阴阳之术。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷34·郎顗襄楷列传第二十下》",
