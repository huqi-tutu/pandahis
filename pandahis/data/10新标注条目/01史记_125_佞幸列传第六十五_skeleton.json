  "entries": [
    {
      "史略ID": "SHIJI_125_01",
      "史略名称": "邓通",
      "史略简介": "邓通",
      "原文字句": "孝文时中宠臣，士人则邓通，宦者则赵同、北宫伯子。北宫伯子以爱人长者；而赵同以星气幸，常为文帝参乘；邓通无伎能。邓通，蜀郡南安人也，以濯船为黄头郎。孝文帝梦欲上天，不能，有一黄头郎从后推之上天，顾见其衣裻带后穿。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷125·佞幸列传》",
      "paragraphs": [
