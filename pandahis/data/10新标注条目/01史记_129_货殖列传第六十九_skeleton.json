    },
    {
      "史略ID": "SHIJI_129_03",
      "史略名称": "白圭",
      "史略简介": "白圭",
      "原文字句": "至卯，积著率岁倍。欲长钱，取下穀；长石斗，取上种。能薄饮食，忍嗜欲，节衣服，与用事僮仆同苦乐，趋时若猛兽挚鸟之发。故曰：“吾治生产，犹伊尹、吕尚之谋，孙吴用兵，商鞅行法是也。是故其智不足与权变，勇不足以决断，仁不能以取予，彊不能有所守，虽欲",
      "史略分类": "庶众",
      "主要史料出处": "《史记·卷129·货殖列传》",
      "paragraphs": [
        {
