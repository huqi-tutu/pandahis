    {
      "史略ID": "SHIJI_129_04",
      "史略名称": "任氏",
      "史略简介": "任氏",
      "原文字句": "宣曲任氏之先，为督道仓吏。秦之败也，豪杰皆争取金玉，而任氏独窖仓粟。",
      "史略分类": "庶众",
      "主要史料出处": "《史记·卷129·货殖列传》",
      "paragraphs": [
