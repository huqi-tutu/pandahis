  "entries": [
    {
      "史略ID": "HOUHANSHU_040_01",
      "史略名称": "郑兴",
      "史略简介": "郑兴",
      "原文字句": "郑兴字少赣，河南开封人也。少学《公羊春秋》。晚善《左氏传》，遂积精深思，通达其旨，同学者皆师之。天凤中，将门人从刘歆讲正大义，歆美兴才，使撰条例、章句、传诂，及校《三统历》。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷40·郑范陈贾张列传》",
      "paragraphs": [
        {
          "volume": "郑范陈贾张列传",
          "paragraph_from": 2,
          "paragraph_to": 18
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_040_02",
      "史略名称": "范升",
      "史略简介": "范升",
      "原文字句": "范升字辩卿，代郡人也。少孤，依外家居。九岁通《论语》《孝经》，及长，习《梁丘易》《老子》，教授后生。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷40·郑范陈贾张列传》",
      "paragraphs": [
        {
          "volume": "郑范陈贾张列传",
          "paragraph_from": 19,
          "paragraph_to": 25
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_040_03",
      "史略名称": "陈元",
      "史略简介": "陈元",
      "原文字句": "陈元字长孙，苍梧广信人也。父钦，习《左氏春秋》，事黎阳贾护，与刘歆同时而别自名家。王莽从钦受《左氏》学，以钦为厌难将军。元少传父业，为之训诂，锐精覃思，至不与乡里通。以父任为郎。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷40·郑范陈贾张列传》",
      "paragraphs": [
        {
          "volume": "郑范陈贾张列传",
          "paragraph_from": 26,
          "paragraph_to": 35
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_040_04",
      "史略名称": "贾逵",
      "史略简介": "贾逵",
      "原文字句": "贾逵字景伯，扶风平陵人也。九世祖谊，文帝时为梁王太傅。曾祖父光，为常山太守，宣帝时以吏二千石自洛阳徙焉。父徽，从刘歆受《左氏春秋》，兼习《国语》《周官》，又受《古文尚书》于涂恽，学《毛诗》于谢曼卿，作《左氏条例》二十一篇。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷40·郑范陈贾张列传》",
      "paragraphs": [
        {
          "volume": "郑范陈贾张列传",
          "paragraph_from": 36,
          "paragraph_to": 48
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_040_05",
      "史略名称": "张霸",
      "史略简介": "张霸",
      "原文字句": "张霸字伯饶，蜀郡成都人也。年数岁而知孝让，虽出入饮食，自然合礼，乡人号为“张曾子”。七岁通《春秋》，复欲进余经，父母曰：“汝小未能也”，霸曰“我饶为之”，故字曰“饶”焉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷40·郑范陈贾张列传》",
      "paragraphs": [
        {
          "volume": "郑范陈贾张列传",
          "paragraph_from": 50,
          "paragraph_to": 61
        }
      ]
    }
