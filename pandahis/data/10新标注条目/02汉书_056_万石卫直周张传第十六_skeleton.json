  "entries": [
    {
      "史略ID": "HANSHU_056_01",
      "史略名称": "石奋",
      "史略简介": "石奋",
      "原文字句": "万石君石奋，其父赵人也。赵亡，徙温。高祖东击项籍，过河内，时奋年十五，为小吏，侍高祖。高祖与语，爱其恭敬，问曰：“若何有？”对曰：“有母，不幸失明。家贫。有姊，能鼓瑟。”高祖曰：“若能从我乎？”曰：“愿尽力。”于是高祖召其姊为美人，以奋为中涓，受书谒。徙其家长安中戚里，以姊为美人故也。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷56·万石卫直周张传》",
      "paragraphs": [
        {
          "volume": "万石卫直周张传",
          "paragraph_from": 2,
          "paragraph_to": 15
        }
      ],
      "五级细坐标": "汉书·卷056·文臣·01",
      "六级段落锚点": "[P2-P15]",
      "原文出处": "万石卫直周张传·P2-P15"
    },
    {
      "史略ID": "HANSHU_056_02",
      "史略名称": "卫绾",
      "史略简介": "卫绾",
      "原文字句": "卫绾，代人陵人也，以戏车为郎，事文帝，功次迁中郎将，醇谨无它。孝景为太子时，召上左右饮，而绾称病不行。文帝且崩时，属孝景曰：“绾长者，善遇之。”及景帝立，岁余，不孰何绾，绾日以谨力。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷56·万石卫直周张传》",
      "paragraphs": [
        {
          "volume": "万石卫直周张传",
          "paragraph_from": 16,
          "paragraph_to": 20
        }
      ],
      "五级细坐标": "汉书·卷056·文臣·02",
      "六级段落锚点": "[P16-P20]",
      "原文出处": "万石卫直周张传·P16-P20"
    },
    {
      "史略ID": "HANSHU_056_03",
      "史略名称": "直不疑",
      "史略简介": "直不疑",
      "原文字句": "直不疑，南阳人也。为郎，事文帝。其同舍有告归，误持其同舍郎金去。已而同舍郎觉，亡意人疑，不疑谢有之，买金偿。后告归者至而归金，亡金郎大惭，以此称为长者。稍迁至中大夫。朝，廷见，人或毁不疑曰：“不疑状貌甚美，然特毋奈其善盗嫂何也！”不疑闻，曰：“我乃无兄。”然终不自明也。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷56·万石卫直周张传》",
      "paragraphs": [
        {
          "volume": "万石卫直周张传",
          "paragraph_from": 21,
          "paragraph_to": 23
        }
      ],
      "五级细坐标": "汉书·卷056·文臣·03",
      "六级段落锚点": "[P21-P23]",
      "原文出处": "万石卫直周张传·P21-P23"
    },
    {
      "史略ID": "HANSHU_056_04",
      "史略名称": "周仁",
      "史略简介": "周仁",
      "原文字句": "周仁，其先任城人也。以医见。景帝为太子时，为舍人，积功迁至太中大夫。景帝初立，拜仁为郎中令。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷56·万石卫直周张传》",
      "paragraphs": [
        {
          "volume": "万石卫直周张传",
          "paragraph_from": 24,
          "paragraph_to": 25
        }
      ],
