  "entries": [
    {
      "史略ID": "HOUHANSHU_047_01",
      "史略名称": "刘彊",
      "史略简介": "刘彊",
      "原文字句": "东海恭王强。建武二年，立母郭氏为皇后，强为皇太子。十七年而郭后废，强常戚戚不自安，数因左右及诸王陈其恳诚，愿备蕃国。光武不忍，迟回者数岁，乃许焉。十九年，封为东海王，二十八年，就国。帝以强废不以过，去就有礼，故优以大封，兼食鲁郡，合二十九县。赐虎贲旄头，宫殿设钟虡之县，拟于乘舆。强临之国，数上书让还东海，又因皇太子固辞。帝不许，深嘉叹之，以强章宣示公卿。初，鲁恭王好宫室，起灵光殿，甚壮丽，是时犹存",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷47·光武十王列传》",
      "paragraphs": [
        {
          "volume": "光武十王列传",
          "paragraph_from": 3,
          "paragraph_to": 11
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_047_02",
      "史略名称": "刘辅",
      "史略简介": "刘辅",
      "原文字句": "沛献王辅，建武十五年封右翊公。十七年，郭后废为中山太后，故徙辅为中山王，并食常山郡。二十年，复徙封沛王。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷47·光武十王列传》",
      "paragraphs": [
        {
          "volume": "光武十王列传",
          "paragraph_from": 12,
          "paragraph_to": 18
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_047_03",
      "史略名称": "刘英",
      "史略简介": "刘英",
      "原文字句": "楚王英，以建武十五年封为楚公，十七年进爵为王，二十八年就国。母许氏无宠，故英国最贫小。三十年，以临淮之取虑、须昌二县益楚国。自显宗为太子时，英常独归附太子，太子特亲爱之。及即位，数受赏赐。永平元年，特封英舅子许昌为龙舒侯。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷47·光武十王列传》",
      "paragraphs": [
        {
          "volume": "光武十王列传",
          "paragraph_from": 19,
          "paragraph_to": 24
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_047_04",
      "史略名称": "刘苍",
      "史略简介": "刘苍",
      "原文字句": "东平宪王苍，建武十五年封东平公，十七年进爵为王。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷47·光武十王列传》",
      "paragraphs": [
        {
          "volume": "光武十王列传",
          "paragraph_from": 35,
          "paragraph_to": 56
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_047_05",
      "史略名称": "刘荆",
      "史略简介": "刘荆",
      "原文字句": "广陵思王荆，建武十五年封山阳公，十七年进爵为王。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷47·光武十王列传》",
