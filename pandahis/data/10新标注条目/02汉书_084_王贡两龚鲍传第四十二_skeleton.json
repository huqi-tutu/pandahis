  "entries": [
    {
      "史略ID": "HANSHU_084_01",
      "史略名称": "王吉",
      "史略简介": "王吉",
      "原文字句": "王吉字子阳，琅邪皋虞人也。少好学明经，以郡吏举孝廉为郎，补若卢右丞，迁云阳令。举贤良为昌邑中尉，而王好游猎，驱驰国中，动作亡节，吉上疏谏，曰：",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷84·王贡两龚鲍传》",
      "paragraphs": [
        {
          "volume": "王贡两龚鲍传",
          "paragraph_from": 6,
          "paragraph_to": 24
        }
      ],
      "五级细坐标": "汉书·卷084·文臣·01",
      "六级段落锚点": "[P6-P24]",
      "原文出处": "王贡两龚鲍传·P6-P24"
    },
    {
      "史略ID": "HANSHU_084_02",
      "史略名称": "贡禹",
      "史略简介": "贡禹",
      "原文字句": "贡禹字少翁，琅邪人也。以明经洁行著闻，征为博士、凉州刺史，病去官。复举贤良为河南令。岁余，以职事为府官所责，免冠谢。禹曰：“冠一免，安复可冠也！”遂去官。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷84·王贡两龚鲍传》",
      "paragraphs": [
        {
          "volume": "王贡两龚鲍传",
          "paragraph_from": 25,
          "paragraph_to": 42
        }
      ],
      "五级细坐标": "汉书·卷084·文臣·02",
      "六级段落锚点": "[P25-P42]",
      "原文出处": "王贡两龚鲍传·P25-P42"
    },
    {
      "史略ID": "HANSHU_084_03",
      "史略名称": "龚胜",
      "史略简介": "龚胜",
      "原文字句": "两龚皆楚人也，胜字君宾，舍字君倩。二人相友，并著名节，故世谓之楚两龚。少皆好学明经，胜为郡吏，舍不仕。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷84·王贡两龚鲍传》",
      "paragraphs": [
        {
          "volume": "王贡两龚鲍传",
          "paragraph_from": 43,
          "paragraph_to": 53
        }
      ],
      "五级细坐标": "汉书·卷084·文臣·03",
      "六级段落锚点": "[P43-P53]",
      "原文出处": "王贡两龚鲍传·P43-P53"
    },
    {
      "史略ID": "HANSHU_084_04",
      "史略名称": "鲍宣",
      "史略简介": "鲍宣",
      "原文字句": "鲍宣字子都，渤海高城人也。好学，明经，为县乡啬夫，守束州丞。后为都尉、太守功曹，举孝廉为郎，病去官，复为州从事。大司马、卫将军王商辟宣，荐为议郎，后以病去。哀帝初，大司空何武除宣为西曹掾，甚敬重焉，荐宣为谏大夫，迁豫州牧。岁余，丞相司直郭钦奏“宣举错烦苛，代二千石署吏听讼，所察过诏条。行部乘传去法驾，驾一马，舍宿乡亭，为众所非。”宣坐免。归家数月，复征为谏大夫。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷84·王贡两龚鲍传》",
      "paragraphs": [
