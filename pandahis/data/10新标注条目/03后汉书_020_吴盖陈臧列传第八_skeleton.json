  "entries": [
    {
      "史略ID": "HOUHANSHU_020_01",
      "史略名称": "吴汉",
      "史略简介": "吴汉",
      "原文字句": "吴汉字子颜，南阳宛人也。家贫，给事县为亭长。王莽末，以宾客犯法，乃亡命至渔阳，资用乏，以贩马自业，往来燕、蓟间，所至皆交结豪杰。更始立，使使者韩鸿徇河北。或谓鸿曰：“吴子颜，奇士也，可与计事。”鸿召见汉，其悦之，遂承制拜为安乐令。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷20·吴盖陈臧列传》",
      "paragraphs": [
        {
          "volume": "吴盖陈臧列传",
          "paragraph_from": 2,
          "paragraph_to": 21
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_020_02",
      "史略名称": "盖延",
      "史略简介": "盖延",
      "原文字句": "盖延字巨卿，渔阳要阳人也。身长八尺，弯弓三百斤。边俗尚勇力，而延以气闻，历郡列掾、州从事，所在职办。彭宠为太守，召延署营尉，行护军。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷20·吴盖陈臧列传》",
      "paragraphs": [
        {
          "volume": "吴盖陈臧列传",
          "paragraph_from": 23,
          "paragraph_to": 30
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_020_03",
      "史略名称": "陈俊",
      "史略简介": "陈俊",
      "原文字句": "陈俊字子昭，西阳西鄂人也。少为郡吏，更始立，以宗室刘嘉为太常将军，俊为长史。光武徇河北，嘉遣书荐俊，光武以为安集掾。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷20·吴盖陈臧列传》",
      "paragraphs": [
        {
          "volume": "吴盖陈臧列传",
          "paragraph_from": 31,
          "paragraph_to": 36
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_020_04",
      "史略名称": "臧宫",
      "史略简介": "臧宫",
      "原文字句": "臧宫字君翁，颍川郏人也。少为县亭长、游徼，后率宾客入下江兵中为校尉，因从光武征战，诸将多称其勇。光武察宫勤力少言，甚亲纳之。及至河北，以为偏将军，从破群贼，数陷陈却敌。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷20·吴盖陈臧列传》",
      "paragraphs": [
        {
          "volume": "吴盖陈臧列传",
          "paragraph_from": 37,
          "paragraph_to": 45
        }
      ]
    }
