  "entries": [
    {
      "史略ID": "HOUHANSHU_076_01",
      "史略名称": "郑玄",
      "史略简介": "郑玄",
      "原文字句": "郑太字公业，河南开封人，司农众之曾孙也。少有少略。灵帝末，知天下将乱，阴交结豪杰。家富于财，有田四百顷，而食常不足，名闻山东。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷76·郑孔荀列传》",
      "paragraphs": [
        {
          "volume": "郑孔荀列传",
          "paragraph_from": 2,
          "paragraph_to": 7
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_076_02",
      "史略名称": "孔融",
      "史略简介": "孔融",
      "原文字句": "孔融字文举，鲁国人，孔子二十世孙也。七世祖霸，为元帝师，位至侍中。父宙，太山都尉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷76·郑孔荀列传》",
      "paragraphs": [
        {
          "volume": "郑孔荀列传",
          "paragraph_from": 8,
          "paragraph_to": 36
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_076_03",
      "史略名称": "荀彧",
      "史略简介": "荀彧",
      "原文字句": "荀彧字文若，颍川颍阴人，朗陵令淑之孙也。父绲，为济南相。绲畏惮宦官，乃为彧娶中常侍唐衡女。彧以少有才名，故得免于讥议。南阳何颙名知人，见彧而异之，曰：“王佐才也。”",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷76·郑孔荀列传》",
      "paragraphs": [
