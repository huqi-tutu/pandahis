    {
      "史略ID": "SHIJI_074_02",
      "史略名称": "邹衍",
      "史略简介": "邹衍",
      "原文字句": "其次驺衍，后孟子。驺衍睹有国者益淫侈，不能尚德，若大雅整之於身，施及黎庶矣。乃深观阴阳消息而作怪迂之变，终始、大圣之篇十馀万言。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷74·孟子荀卿列传》",
      "paragraphs": [
        {
          "volume": "孟子荀卿列传",
