  "entries": [
    {
      "史略ID": "SHIJI_111_01",
      "史略名称": "卫青",
      "史略简介": "卫青",
      "原文字句": "大将军卫青者，平阳人也。其父郑季，为吏，给事平阳侯家，与侯妾卫媪通，生青。青同母兄卫长子，而姊卫子夫自平阳公主家得幸天子，故冒姓为卫氏。字仲卿。长子更字长君。长君母号为卫媪。媪长女卫孺，次女少儿，次女即子夫。",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷111·卫将军骠骑列传》",
      "paragraphs": [
        {
          "volume": "卫将军骠骑列传",
          "paragraph_from": 1,
          "paragraph_to": 51
        }
      ],
      "翻译视角说明": "P13–P31 与霍去病双挂共用。译卫青史略时以大将军为镜头；P52–P53 骠骑军功总述可略写过渡。P54–P56 已 exclude（附传/卫氏总结）。",
      "五级细坐标": "史记·卷111·武将·01",
      "六级段落锚点": "[P1-P51]",
      "原文出处": "卫将军骠骑列传·P1-P51"
    },
    {
      "史略ID": "SHIJI_111_02",
      "史略名称": "霍去病",
      "史略简介": "霍去病",
      "原文字句": "是岁也，大将军姊子霍去病年十八，幸，为天子侍中。善骑射，再从大将军，受诏与壮士，为剽姚校尉，与轻勇骑八百直弃大军数百里赴利，斩捕首虏过当。",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷111·卫将军骠骑列传》",
      "paragraphs": [
