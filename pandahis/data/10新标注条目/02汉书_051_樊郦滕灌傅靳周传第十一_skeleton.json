  "entries": [
    {
      "史略ID": "HANSHU_051_01",
      "史略名称": "舞阳侯樊哙",
      "史略简介": "舞阳侯樊哙",
      "原文字句": "樊哙，沛人也，以屠狗为事。后与高祖俱隐于芒砀山泽间。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 2,
          "paragraph_to": 10
        }
      ],
      "五级细坐标": "汉书·卷051·武将·01",
      "六级段落锚点": "[P2-P10]",
      "原文出处": "樊郦滕灌傅靳周传·P2-P10"
    },
    {
      "史略ID": "HANSHU_051_02",
      "史略名称": "曲周侯郦商",
      "史略简介": "曲周侯郦商",
      "原文字句": "郦商，高阳人也。陈胜起，商聚少年得数千人。沛公略地六月余，商以所将四千人属沛公于岐。从攻长社，先登，赐爵封信成君。从攻缑氏，绝河津，破秦军雒阳东。从下宛、穰，定十七县。别将攻旬关，西定汉中。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 11,
          "paragraph_to": 15
        }
      ],
      "五级细坐标": "汉书·卷051·武将·02",
      "六级段落锚点": "[P11-P15]",
      "原文出处": "樊郦滕灌傅靳周传·P11-P15"
    },
    {
      "史略ID": "HANSHU_051_03",
      "史略名称": "汝阴侯夏侯婴",
      "史略简介": "汝阴侯夏侯婴",
      "原文字句": "夏侯婴，沛人也。为沛厩司御，每送使客，还过泗上亭，与高祖语，未尝不移日也。婴已而试补县吏，与高祖相爱。高祖戏而伤婴，人有告高祖。高祖时为亭长，重坐伤人，告故不伤婴，婴证之。移狱覆，婴坐高祖系岁余，掠笞数百，终脱高祖。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 16,
          "paragraph_to": 21
        }
      ],
      "五级细坐标": "汉书·卷051·武将·03",
      "六级段落锚点": "[P16-P21]",
      "原文出处": "樊郦滕灌傅靳周传·P16-P21"
    },
    {
      "史略ID": "HANSHU_051_04",
      "史略名称": "颍阴侯灌婴",
      "史略简介": "颍阴侯灌婴",
      "原文字句": "灌婴，睢阳贩缯者也。高祖为沛公，略地至雍丘，章邯杀项梁，而沛公还军于砀，婴以中涓从，击破东郡尉于成武及秦军于杠里，疾斗，赐爵七大夫。又从攻秦军亳南、开封、曲遇，战疾力，赐爵执帛，号宣陵君。从攻阳武以西至雒阳，破秦军尸北。北绝河津，南破南阳守齮阳城东，遂定南阳郡。西入武关，战于蓝田，疾力，至霸上，赐爵执圭，号昌文君。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 22,
          "paragraph_to": 33
        }
      ],
      "五级细坐标": "汉书·卷051·武将·04",
      "六级段落锚点": "[P22-P33]",
      "原文出处": "樊郦滕灌傅靳周传·P22-P33"
    },
    {
      "史略ID": "HANSHU_051_05",
      "史略名称": "阳陵侯傅宽",
      "史略简介": "阳陵侯傅宽",
      "原文字句": "傅宽，以魏五大夫骑将从，为舍人，起横阳。从攻安阳、杠里，赵贲军于开封，及击杨熊曲遇、阳武、斩首十二级，赐爵卿。从至霸上。沛公为汉王，赐宽封号共德君。从入汉中，为右骑将。定三秦，赐食邑雕阴。从击项籍，待怀，赐爵通德侯。从击项冠、周兰、龙且，所将卒斩骑将一人敖下，益食邑。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 34,
          "paragraph_to": 36
        }
      ],
      "五级细坐标": "汉书·卷051·武将·05",
      "六级段落锚点": "[P34-P36]",
      "原文出处": "樊郦滕灌傅靳周传·P34-P36"
    },
    {
      "史略ID": "HANSHU_051_06",
      "史略名称": "信武侯靳歙",
      "史略简介": "信武侯靳歙",
      "原文字句": "靳歙，以中涓从，起宛朐。攻济阳。破李由军。击秦军开封东，斩骑千人将一人，首五十七级，捕虏七十三人，赐爵封临平君。又战蓝田北，斩车司马二人，骑长一人，首二十八级，捕虏五十七人。至霸上，沛公为汉王，赐歙爵建武侯，迁骑都尉。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
          "paragraph_from": 37,
          "paragraph_to": 42
        }
      ],
      "五级细坐标": "汉书·卷051·武将·06",
      "六级段落锚点": "[P37-P42]",
      "原文出处": "樊郦滕灌傅靳周传·P37-P42"
    },
    {
      "史略ID": "HANSHU_051_07",
      "史略名称": "蒯成侯周緤",
      "史略简介": "蒯成侯周緤",
      "原文字句": "周緤，沛人也。以舍人从高祖起沛。至霸上，西入蜀汉，还定三秦，常为参乘，赐食邑池阳。从东击项羽荥阳，绝甬道，从出度平阴，遇韩信军襄国，战有利不利，终亡离上心。上以緤为信武侯，食邑三千三百户。",
      "史略分类": "武将",
      "主要史料出处": "《02汉书·卷51·樊郦滕灌傅靳周传》",
      "paragraphs": [
        {
          "volume": "樊郦滕灌傅靳周传",
