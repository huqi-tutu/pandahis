    {
      "id": 1,
      "text": "卷十五下"
    },
    {
      "id": 2,
      "text": "王子侯表第三下"
    },
    {
      "id": 3,
      "text": "孝元之世，亡王子侯者，盛衰终始，岂非命哉！元始之际，王莽擅朝，伪褒宗室，侯及王之孙焉；居摄而愈多，非其正，故弗录。旋踵亦绝，悲夫！"
    },
    {
      "id": 4,
      "text": "（表略）"
    }
  ]
}