  "entries": [
    {
      "史略ID": "HANSHU_088_01",
      "史略名称": "赵广汉",
      "史略简介": "赵广汉",
      "原文字句": "赵广汉字子都，涿郡蠡吾人也，故属河间。少为郡吏、州从事，以廉洁通敏下士为名。举茂材，平准令。察廉为阳翟令。以治行尤异，迁京辅都尉，守京兆尹。会昭帝崩，而新丰杜建为京兆掾，护作平陵方上。建素豪侠，宾客为奸利，广汉闻之，先风告。建不改，于是收案致法。中贵人豪长者为请无不至，终无所听。宗族宾客谋欲篡取，广汉尽知其计议主名起居，使吏告曰：“若计如此，且并灭家。”令数吏将建弃市，莫敢近者。京师称之。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
        {
          "volume": "赵尹韩张两王传",
          "paragraph_from": 2,
          "paragraph_to": 12
        }
      ],
      "五级细坐标": "汉书·卷088·文臣·01",
      "六级段落锚点": "[P2-P12]",
      "原文出处": "赵尹韩张两王传·P2-P12"
    },
    {
      "史略ID": "HANSHU_088_02",
      "史略名称": "尹翁归",
      "史略简介": "尹翁归",
      "原文字句": "尹翁归字子兄，河东平阳人也，徙杜陵。翁归少孤，与季父居。为狱小吏，晓习文法。喜击剑，人莫能当。是时，大将军霍光秉政，诸霍在平阳，奴客持刀兵入市斗变，吏不能禁，及翁归为市吏，莫敢犯者。公廉不受馈，百贾畏之。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
        {
          "volume": "赵尹韩张两王传",
          "paragraph_from": 13,
          "paragraph_to": 19
        }
      ],
      "五级细坐标": "汉书·卷088·文臣·02",
      "六级段落锚点": "[P13-P19]",
      "原文出处": "赵尹韩张两王传·P13-P19"
    },
    {
      "史略ID": "HANSHU_088_03",
      "史略名称": "韩延寿",
      "史略简介": "韩延寿",
      "原文字句": "韩延寿字长公，燕人也，徙杜陵。少为郡文学。父义为燕郎中。刺王之谋逆也，义谏而死，燕人闵之。是时，昭帝富于春秋，大将军霍光持政，征郡国贤良、文学，问以得失。时魏相以文学对策，以为“赏罚所以劝善禁恶，政之本也。日者燕王为无道，韩义出身强谏，为王所杀。义无比干之亲而蹈比干之节，宜显赏其子，以示天下，明为人臣之义。”光纳其言，因擢延寿为谏大夫，迁淮阳太守。治甚有名，徙颍川。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
        {
          "volume": "赵尹韩张两王传",
          "paragraph_from": 20,
          "paragraph_to": 27
        }
      ],
      "五级细坐标": "汉书·卷088·文臣·03",
      "六级段落锚点": "[P20-P27]",
      "原文出处": "赵尹韩张两王传·P20-P27"
    },
    {
      "史略ID": "HANSHU_088_04",
      "史略名称": "张敞",
      "史略简介": "张敞",
      "原文字句": "张敞字子高，本河东平阳人也。祖父孺为上谷太守，徙茂陵。敞父福事孝武帝，官至光禄大夫。敞后随宣帝徙杜陵。敞本以乡有秩补太守卒史，察廉为甘泉仓长，稍迁太仆丞，杜延年甚奇之。会昌邑王征即位，动作不由法度，敞上书谏曰：“孝昭皇帝蚤崩无嗣，大臣忧惧，选贤圣承宗庙，东迎之日，唯恐属车之行迟。今天子以盛年初即位，天下莫不拭目倾耳，观化听风。国辅大臣未褒，而昌邑小辇先迁，此过之大者也。”后十余日王贺废，敞以切谏显",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
        {
          "volume": "赵尹韩张两王传",
          "paragraph_from": 28,
          "paragraph_to": 40
        }
      ],
      "五级细坐标": "汉书·卷088·文臣·04",
      "六级段落锚点": "[P28-P40]",
      "原文出处": "赵尹韩张两王传·P28-P40"
    },
    {
      "史略ID": "HANSHU_088_05",
      "史略名称": "王尊",
      "史略简介": "王尊",
      "原文字句": "王尊字子赣，涿郡高阳人也。少孤，归诸父，使牧羊泽中。尊窃学问，能史书。年十三，求为狱小吏。数岁，给事太守府，问诏书行事，尊无不对。太守奇之，除补书佐，署守属监狱。久之，尊称病去，事师郡文学官，治《尚书》《论语》，略通大义。复召署守属治狱，为郡决曹史。数岁，以令举幽州刺史从事。而太守察尊廉，补辽西盐官长。数上书言便言事，事下丞相、御史。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
        {
          "volume": "赵尹韩张两王传",
          "paragraph_from": 41,
          "paragraph_to": 51
        }
      ],
      "五级细坐标": "汉书·卷088·文臣·05",
      "六级段落锚点": "[P41-P51]",
      "原文出处": "赵尹韩张两王传·P41-P51"
    },
    {
      "史略ID": "HANSHU_088_06",
      "史略名称": "王章",
      "史略简介": "王章",
      "原文字句": "王章字仲卿，泰山巨平人也。少以文学为官，稍迁至谏大夫，在朝廷名敢直言。元帝初，擢为左曹中郎将，与御史中丞陈咸相善，共毁中书令石显，为显所陷，咸减死髡，章免官。成帝立，征章为谏大夫，迁司隶校尉，大臣贵戚敬惮之。王尊免后，代者不称职，章以选为京兆尹。时，帝舅大将军王凤辅政，章虽为凤所举，非凤专权，不亲附凤。会日有蚀之，章奏封事，召见，言凤不可任用，宜更选忠贤。上初纳受章言，后不忍退凤。章由是见疑，遂为",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷88·赵尹韩张两王传》",
      "paragraphs": [
