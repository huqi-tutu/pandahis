  "entries": [
    {
      "史略ID": "SHIJI_042_01",
      "史略名称": "郑桓公",
      "史略简介": "郑桓公",
      "原文字句": "郑桓公友者，周厉王少子而宣王庶弟也。宣王立二十二年，友初封于郑。封三十三岁，百姓皆便爱之。幽王以为司徒。和集周民，周民皆说，河雒之间，人便思之。为司徒一岁，幽王以襃后故，王室治多邪，诸侯或畔之。於是桓公问太史伯曰：“王室多故，予安逃死乎？”太史伯对曰：“独雒之东土，河济之南可居。”公曰：“何以？”对曰：“地近虢、郐，虢、郐之君贪而好利，百姓不附。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
      "paragraphs": [
        {
          "volume": "郑世家",
          "paragraph_from": 1,
          "paragraph_to": 4
        }
      ],
      "五级细坐标": "史记·卷042·诸侯·01",
      "六级段落锚点": "[P1-P4]",
      "原文出处": "郑世家·P1-P4"
    },
    {
      "史略ID": "SHIJI_042_02",
      "史略名称": "郑庄公",
      "史略简介": "郑庄公",
      "原文字句": "武公十年，娶申侯女为夫人，曰武姜。生太子寤生，生之难，及生，夫人弗爱。后生少子叔段，段生易，夫人爱之。二十七年，武公疾。夫人请公，欲立段为太子，公弗听。是岁，武公卒，寤生立，是为庄公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
      "paragraphs": [
        {
          "volume": "郑世家",
          "paragraph_from": 5,
          "paragraph_to": 12
        }
      ],
      "五级细坐标": "史记·卷042·诸侯·02",
      "六级段落锚点": "[P5-P12]",
      "原文出处": "郑世家·P5-P12"
    },
    {
      "史略ID": "SHIJI_042_03",
      "史略名称": "郑厉公",
      "史略简介": "郑厉公",
      "原文字句": "庄公又娶宋雍氏女，生厉公突。雍氏有宠於宋。宋庄公闻祭仲之立忽，乃使人诱召祭仲而执之，曰：“不立突，将死。”亦执突以求赂焉。祭仲许宋，与宋盟。以突归，立之。昭公忽闻祭仲以宋要立其弟突，九月丁亥，忽出奔卫。己亥，突至郑，立，是为厉公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
      "paragraphs": [
        {
          "volume": "郑世家",
          "paragraph_from": 13,
          "paragraph_to": 25
        }
      ],
      "五级细坐标": "史记·卷042·诸侯·03",
      "六级段落锚点": "[P13-P25]",
      "原文出处": "郑世家·P13-P25"
    },
    {
      "史略ID": "SHIJI_042_04",
      "史略名称": "郑简公",
      "史略简介": "郑简公",
      "原文字句": "釐公五年，郑相子驷朝釐公，釐公不礼。子驷怒，使厨人药杀釐公，赴诸侯曰“釐公暴病卒”。立釐公子嘉，嘉时年五岁，是为简公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
      "paragraphs": [
        {
          "volume": "郑世家",
          "paragraph_from": 51,
          "paragraph_to": 59
        }
      ],
      "五级细坐标": "史记·卷042·诸侯·04",
      "六级段落锚点": "[P51-P59]",
      "原文出处": "郑世家·P51-P59"
    },
    {
      "史略ID": "SHIJI_042_05",
      "史略名称": "郑定公",
      "史略简介": "郑定公",
      "原文字句": "三十六年，简公卒，子定公宁立。秋，定公朝晋昭公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷42·郑世家》",
