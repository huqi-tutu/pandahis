    {
      "史略ID": "SHIJI_094_02",
      "史略名称": "田荣",
      "史略简介": "田荣",
      "原文字句": "田荣之走东阿，章邯追围之。项梁闻田荣之急，乃引兵击破章邯军东阿下。",
      "史略分类": "武将",
      "主要史料出处": "《史记·卷94·田儋列传》",
      "paragraphs": [
        {
          "volume": "田儋列传",
          "paragraph_from": 5,
