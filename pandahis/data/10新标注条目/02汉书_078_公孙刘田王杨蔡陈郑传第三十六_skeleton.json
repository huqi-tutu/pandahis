    {
      "史略ID": "HANSHU_078_01",
      "史略名称": "公孙贺",
      "史略简介": "公孙贺",
      "原文字句": "公孙贺字子叔，北地义渠人也。贺祖父昆邪，景帝时为陇西守，以将军击吴、楚有功，封平曲侯，著书十余篇。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷78·公孙刘田王杨蔡陈郑传》",
      "paragraphs": [
