  "entries": [
    {
      "史略ID": "HOUHANSHU_036_01",
      "史略名称": "樊宏",
      "史略简介": "樊宏",
      "原文字句": "樊宏字靡卿，南阳湖阳人也，世祖之舅。其先周仲山甫，封于樊，因而氏焉，为乡里著姓。父重，字君云，世善农稼，好货殖。重性温厚，有法度，三世共财，子孙朝夕礼敬，常若公家。其营理产业，物无所弃，课役童隶，各得其宜，故能上下戮力，财利岁倍，至乃开广田土三百余顷。其所起庐舍，皆有重堂高阁，陂渠灌注。又池鱼牧畜，有求必给。尝欲作器物，先种梓漆，时人嗤之，然积以岁月，皆得其用，向之笑者咸求假焉。资至巨万，而赈赡宗",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷36·樊宏阴识列传》",
      "paragraphs": [
        {
          "volume": "樊宏阴识列传",
          "paragraph_from": 2,
          "paragraph_to": 6
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_036_02",
      "史略名称": "樊鯈",
      "史略简介": "樊鯈",
      "原文字句": "鯈字长鱼，谨约有父风。事后母至孝，及母卒，哀思过礼，毁病不自支，世祖常遣中黄门朝暮送饘粥。服阕，就侍中丁恭受《公羊严氏春秋》。建武中，禁网尚阔，诸王既长，各招引宾客，以鯈外戚，争遣致之，而鯈清静自保，无所交结。及沛王辅事发，贵戚子弟多见收捕，鯈以不豫得免。帝崩，鯈为复土校尉。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷36·樊宏阴识列传》",
      "paragraphs": [
        {
          "volume": "樊宏阴识列传",
          "paragraph_from": 8,
          "paragraph_to": 14
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_036_03",
      "史略名称": "樊准",
      "史略简介": "樊准",
      "原文字句": "准字幼陵，宏之族曾孙也。父瑞，好黄老言，清静少欲。准少励志行，修儒术，以先父产业数百万让孤兄子。永元十五年，和帝幸南阳，准为郡功曹，召见，帝器之，拜郎中，从车驾还宫，特补尚书郎。邓太后临朝，儒学陵替，准乃上疏曰：",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷36·樊宏阴识列传》",
      "paragraphs": [
        {
          "volume": "樊宏阴识列传",
          "paragraph_from": 15,
          "paragraph_to": 23
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_036_04",
      "史略名称": "阴识",
      "史略简介": "阴识",
      "原文字句": "阴识字次伯，南阳新野人也，光烈皇后之前母兄也。其先出自管仲，管仲七世孙修，自齐适楚，为阴大夫，因而氏焉。秦、汉之际，始家新野。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷36·樊宏阴识列传》",
      "paragraphs": [
        {
          "volume": "樊宏阴识列传",
          "paragraph_from": 24,
          "paragraph_to": 29
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_036_05",
      "史略名称": "阴兴",
      "史略简介": "阴兴",
      "原文字句": "兴字君陵，光烈皇后母弟也，为人有膂力。建武二年，为黄门侍郎，守期门仆射，典将武骑，从征伐，平定郡国。兴每从出入，常操持小盖，障翳风雨，躬履涂泥，率先期门。光武所幸之处，辄先入清宫，甚见亲信。虽好施接宾，然门无侠客。与同郡张宗、上谷鲜于裒不相好，知其有用，犹称所长而达之；友人张汜、杜禽与兴厚善，以为华而少实，但私之以财，终不为言：是以世称其忠平。第宅苟完，裁蔽风雨。",
      "史略分类": "宗戚",
      "主要史料出处": "《03后汉书·卷36·樊宏阴识列传》",
      "paragraphs": [
        {
          "volume": "樊宏阴识列传",
          "paragraph_from": 30,
          "paragraph_to": 35
        }
      ]
    }
  ]
