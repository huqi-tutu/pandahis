  "entries": [
    {
      "史略ID": "HOUHANSHU_057_01",
      "史略名称": "崔骃",
      "史略简介": "崔骃",
      "原文字句": "崔骃字亭伯，涿郡安平人也。高祖父朝，昭帝时为幽州从事，谏刺史无与燕剌王通。及剌王败，擢为侍御史。生子舒，历四郡太守，所在有能名。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷57·崔骃列传》",
      "paragraphs": [
        {
          "volume": "崔骃列传",
          "paragraph_from": 2,
          "paragraph_to": 20
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_057_02",
      "史略名称": "崔瑗",
      "史略简介": "崔瑗",
      "原文字句": "瑗字子玉，早孤，锐志好学，尽能传其父业。年十八，至京师，从侍中贾逵质正大义，逵善待之，瑗因留游学，遂明天官、历数、《京房易传》、六日七分。诸儒宗之。与扶风马融、南阳张衡特相友好。初，瑗兄章为州人所杀，瑗手刃报仇，因亡命。会赦，归家。家贫，兄弟同居数十年，乡邑化之。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷57·崔骃列传》",
      "paragraphs": [
        {
          "volume": "崔骃列传",
          "paragraph_from": 21,
          "paragraph_to": 26
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_057_03",
      "史略名称": "崔寔",
      "史略简介": "崔寔",
      "原文字句": "寔字子真，一名台，字元始。少沉静，好典籍。父卒，隐居墓侧。服竟，三公并辟，皆不就。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷57·崔骃列传》",
      "paragraphs": [
        {
          "volume": "崔骃列传",
