    },
    {
      "史略ID": "HANSHU_063_03",
      "史略名称": "江都王刘非",
      "史略简介": "江都王刘非",
      "原文字句": "江都易王非以孝景前二年立为汝南王。吴、楚反时，非年十五，有材气，上书自请击吴。景帝赐非将军印，击吴。吴已破，徙王江都，治故吴国，以军功赐天子旗。元光中，匈奴大入汉边，非上书愿击匈奴，上不许。非好气力，治宫馆，招四方豪杰，骄奢甚。二十七年薨，子建嗣。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷63·景十三王传》",
      "paragraphs": [
        {
          "volume": "景十三王传",
          "paragraph_from": 15,
          "paragraph_to": 21
        }
