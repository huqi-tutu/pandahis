  "entries": [
    {
      "史略ID": "HANSHU_097_01",
      "史略名称": "谷永",
      "史略简介": "谷永",
      "原文字句": "谷永字子云，长安人也。父吉，为卫司马，使送郅支单于侍子，为郅支所杀，语在《陈汤传》。永少为长安小史，后博学经书。建昭中，御史大夫繁延寿闻其有茂材，除补属，举为太常丞，数上疏言得失。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷97·谷永杜邺传》",
      "paragraphs": [
