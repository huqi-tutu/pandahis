  "entries": [
    {
      "史略ID": "HOUHANSHU_032_01",
      "史略名称": "申屠刚",
      "史略简介": "申屠刚",
      "原文字句": "申屠刚字巨卿，扶风茂陵人也。七世祖嘉，文帝时为丞相。刚质性方直，常慕史、汲黯之为人。仕郡功曹。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷32·申屠刚鲍永郅恽列传》",
      "paragraphs": [
        {
          "volume": "申屠刚鲍永郅恽列传",
          "paragraph_from": 2,
          "paragraph_to": 11
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_032_02",
      "史略名称": "鲍永",
      "史略简介": "鲍永",
      "原文字句": "鲍永字君长，上党屯留人也。父宣，哀帝时任司隶校尉，为王莽所杀。永少有志操，习欧阳《尚书》。事后母至孝，妻尝于母前叱狗，而永即去之。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷32·申屠刚鲍永郅恽列传》",
      "paragraphs": [
        {
          "volume": "申屠刚鲍永郅恽列传",
          "paragraph_from": 12,
          "paragraph_to": 19
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_032_03",
      "史略名称": "鲍昱",
      "史略简介": "鲍昱",
      "原文字句": "昱字文泉。少传父学，客授于东平。建武初，太行山中有剧贼，太守戴涉闻昱鲍永子，有智略，乃就谒，请署守高都长，昱应之，遂讨击群贼，诛其渠帅，道路开通，由是知名。后为沘阳长，政化仁爱，境内清净。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷32·申屠刚鲍永郅恽列传》",
      "paragraphs": [
        {
          "volume": "申屠刚鲍永郅恽列传",
          "paragraph_from": 21,
          "paragraph_to": 27
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_032_04",
      "史略名称": "郅恽",
      "史略简介": "郅恽",
      "原文字句": "郅恽字君章，汝南西平人也。年十二失母，居丧过礼。及长，理《韩诗》《严氏春秋》，明天文历数。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷32·申屠刚鲍永郅恽列传》",
