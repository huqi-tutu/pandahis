  "entries": [
    {
      "史略ID": "HOUHANSHU_018_01",
      "史略名称": "邓禹",
      "史略简介": "邓禹",
      "原文字句": "邓禹字仲华，南阳新野人也。年十三，能诵诗，受业长安。时光武亦游学京师，禹年虽幼，而见光武知非常人，遂相亲附。数年归家。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷18·邓寇列传》",
      "paragraphs": [
        {
          "volume": "邓寇列传",
          "paragraph_from": 2,
          "paragraph_to": 19
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_018_02",
      "史略名称": "邓训",
      "史略简介": "邓训",
      "原文字句": "训字平叔，禹第六子也。少有大志，不好文学，禹常非之。显宗即位，初以为郎中。训乐施下士，士大夫多归之。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷18·邓寇列传》",
      "paragraphs": [
        {
          "volume": "邓寇列传",
          "paragraph_from": 21,
          "paragraph_to": 31
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_018_03",
      "史略名称": "邓骘",
      "史略简介": "邓骘",
      "原文字句": "骘字昭伯，少辟大将军窦宪府。及女弟为贵人，骘兄弟皆除郎中。及贵人立，是为和熹皇后。骘三迁虎贲中郎将，京、悝、弘、阊皆黄门侍郎。京卒于官。延平元年，拜骘车骑将军、仪同三司。仪同三司始自骘也。悝虎贲中郎将，弘、阊皆侍中。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷18·邓寇列传》",
      "paragraphs": [
        {
          "volume": "邓寇列传",
          "paragraph_from": 32,
          "paragraph_to": 42
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_018_04",
      "史略名称": "寇恂",
      "史略简介": "寇恂",
      "原文字句": "寇恂字子翼，上谷昌平人也，世为著姓。恂初为郡功曹，太守耿况甚重之。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷18·邓寇列传》",
      "paragraphs": [
        {
          "volume": "邓寇列传",
