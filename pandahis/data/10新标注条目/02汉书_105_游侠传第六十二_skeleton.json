    },
    {
      "史略ID": "HANSHU_105_02",
      "史略名称": "剧孟",
      "史略简介": "剧孟",
      "原文字句": "楚田仲以侠闻，父事朱家，自以为行弗及也。田仲死后，有剧孟。",
      "史略分类": "庶众",
      "主要史料出处": "《02汉书·卷105·游侠传》",
      "paragraphs": [
        {
