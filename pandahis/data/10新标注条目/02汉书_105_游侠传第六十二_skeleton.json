      ],
      "五级细坐标": "汉书·卷105·庶众·02",
      "六级段落锚点": "[P8-P9]",
      "原文出处": "游侠传·P8-P9"
    },
    {
      "史略ID": "HANSHU_105_03",
      "史略名称": "郭解",
      "史略简介": "郭解",
      "原文字句": "郭解，河内轵人也，温善相人许负外孙也。解父任侠，孝文时诛死。解为人静悍，不饮酒。少时阴贼感概，不快意，所杀甚众。以躯借友报仇，臧命作奸剽攻，休乃铸钱掘冢，不可胜数。适有天幸，窘急常得脱，若遇赦。",
      "史略分类": "庶众",
      "主要史料出处": "《02汉书·卷105·游侠传》",
      "paragraphs": [
        {
          "volume": "游侠传",
          "paragraph_from": 10,
          "paragraph_to": 17
        }
      ],
