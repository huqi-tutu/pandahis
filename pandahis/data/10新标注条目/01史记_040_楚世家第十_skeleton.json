  "entries": [
    {
      "史略ID": "SHIJI_040_01",
      "史略名称": "楚平王",
      "史略简介": "楚平王",
      "原文字句": "初王及子晳遂自杀。丙辰，弃疾即位为王，改名熊居，是为平王。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷40·楚世家》",
      "paragraphs": [
        {
          "volume": "楚世家",
          "paragraph_from": 56,
          "paragraph_to": 69
        }
      ],
      "五级细坐标": "史记·卷040·诸侯·01",
      "六级段落锚点": "[P56-P69]",
      "原文出处": "楚世家·P56-P69"
    },
    {
      "史略ID": "SHIJI_040_02",
      "史略名称": "楚庄王",
      "史略简介": "楚庄王",
      "原文字句": "穆王立，以其太子宫予潘崇，使为太师，掌国事。穆王三年，灭江。四年，灭六、蓼。六、蓼，皋陶之后。八年，伐陈。十二年，卒。子庄王侣立。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷40·楚世家》",
      "paragraphs": [
        {
          "volume": "楚世家",
          "paragraph_from": 30,
          "paragraph_to": 42
        }
      ],
      "五级细坐标": "史记·卷040·诸侯·02",
      "六级段落锚点": "[P30-P42]",
      "原文出处": "楚世家·P30-P42"
    },
    {
      "史略ID": "SHIJI_040_03",
      "史略名称": "楚怀王",
      "史略简介": "楚怀王",
      "原文字句": "十一年，威王卒，子怀王熊槐立。魏闻楚丧，伐楚，取我陉山。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷40·楚世家》",
      "paragraphs": [
        {
          "volume": "楚世家",
          "paragraph_from": 94,
          "paragraph_to": 114
        }
      ],
      "五级细坐标": "史记·卷040·诸侯·03",
      "六级段落锚点": "[P94-P114]",
      "原文出处": "楚世家·P94-P114"
    },
    {
      "史略ID": "SHIJI_040_04",
      "史略名称": "楚武王",
      "史略简介": "楚武王",
      "原文字句": "二十七年，若敖卒，子熊坎立，是为霄敖。霄敖六年，卒，子熊眴立，是为蚡冒。蚡冒十三年，晋始乱，以曲沃之故。蚡冒十七年，卒。蚡冒弟熊通弑蚡冒子而代立，是为楚武王。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷40·楚世家》",
      "paragraphs": [
        {
          "volume": "楚世家",
          "paragraph_from": 14,
          "paragraph_to": 18
        }
      ],
