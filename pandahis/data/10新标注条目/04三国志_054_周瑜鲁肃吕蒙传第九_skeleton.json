  "entries": [
    {
      "史略ID": "SANGUOZHI_054_01",
      "史略名称": "周瑜",
      "史略简介": "周瑜",
      "原文字句": "周瑜字公瑾，庐江舒人也。从祖父景，景子忠，皆为汉太尉。父异，洛阳令。",
      "史略分类": "武将",
      "主要史料出处": "《04三国志·卷54·周瑜鲁肃吕蒙传》",
      "paragraphs": [
