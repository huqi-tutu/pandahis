  "entries": [
    {
      "史略ID": "HOUHANSHU_049_01",
      "史略名称": "邓彪",
      "史略简介": "邓彪",
      "原文字句": "邓彪字智伯，南阳新野人，太傅禹之宗也。父邯，中兴初以功封鄳侯，仕至勃海太守。彪少励志，修孝行。父卒，让国于异母弟荆凤，显宗高其节，下诏许焉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷49·邓张徐张胡列传》",
      "paragraphs": [
        {
          "volume": "邓张徐张胡列传",
          "paragraph_from": 2,
          "paragraph_to": 4
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_049_02",
      "史略名称": "张禹",
      "史略简介": "张禹",
      "原文字句": "张禹字伯达，赵国襄国人也。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷49·邓张徐张胡列传》",
      "paragraphs": [
        {
          "volume": "邓张徐张胡列传",
          "paragraph_from": 5,
          "paragraph_to": 12
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_049_03",
      "史略名称": "徐防",
      "史略简介": "徐防",
      "原文字句": "徐防字谒卿，沛国铚人也。祖父宣，为讲学大夫，以《易》教授王莽。父宪，亦传宣业。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷49·邓张徐张胡列传》",
      "paragraphs": [
        {
          "volume": "邓张徐张胡列传",
          "paragraph_from": 13,
          "paragraph_to": 20
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_049_04",
      "史略名称": "张敏",
      "史略简介": "张敏",
      "原文字句": "张敏字伯达，河间鄚人也。建初二年，举孝廉，四迁，五年，为尚书。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷49·邓张徐张胡列传》",
      "paragraphs": [
        {
          "volume": "邓张徐张胡列传",
          "paragraph_from": 21,
          "paragraph_to": 27
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_049_05",
      "史略名称": "胡广",
      "史略简介": "胡广",
      "原文字句": "胡广字伯始，南郡华容人也。六世祖刚，清高有志节。平帝时，大司徒马宫辟之。值王莽居摄，刚解其衣冠，县府门而去，遂亡命交阯，隐于屠肆之间。后莽败，乃归乡里。父贡，交阯都尉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷49·邓张徐张胡列传》",
      "paragraphs": [
        {
          "volume": "邓张徐张胡列传",
          "paragraph_from": 28,
          "paragraph_to": 41
        }
      ]
    }
