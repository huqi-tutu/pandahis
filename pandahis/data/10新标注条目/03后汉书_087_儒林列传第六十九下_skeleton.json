  "entries": [
    {
      "史略ID": "HOUHANSHU_087_01",
      "史略名称": "包咸",
      "史略简介": "包咸",
      "原文字句": "包咸字子良，会稽曲阿人也。少为诸生，受业长安，师事博士右师细君，习《鲁诗》《论语》。王莽末，去归乡里，于东海界为赤眉贼所得，遂见拘执。十余日，咸晨夜诵经自若，贼异而遣之。因住东海，立精舍讲授。光武即位，乃归乡里。太守黄谠署户曹史，欲召咸入授其子。咸曰：“礼有来学，而无往教。”谠遂遣子师之。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 5,
          "paragraph_to": 8
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_087_02",
      "史略名称": "赵晔",
      "史略简介": "赵晔",
      "原文字句": "赵晔字长君，会稽山阴人也。少尝为县吏，奉檄迎督邮，晔耻于斯役，遂弃车马去。到犍为资中，诣杜抚受《韩诗》，究竟其术。积二十年，绝问不还，家为发丧制服。抚卒乃归。州召补从事，不就。举有道。卒于家。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 26,
          "paragraph_to": 27
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_087_03",
      "史略名称": "卫宏",
      "史略简介": "卫宏",
      "原文字句": "卫宏字敬仲，东海人也。少与河南郑兴俱好古学。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 29,
          "paragraph_to": 31
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_087_04",
      "史略名称": "丁恭",
      "史略简介": "丁恭",
      "原文字句": "丁恭字子然，山阳东缗人也。习《公羊严氏春秋》。恭学义精明，教授常数百人，州郡请召不应。建武初，为谏议大夫、博士，封关内侯。十一年，迁少府。诸生自远方至者，著录数千人，当世称为大儒。太常楼望、侍中承宫、长水校尉樊儵等皆受业于恭。二十年，拜侍中祭酒、骑都尉，与侍中刘昆俱在光武左右，每事谘访焉。卒于官。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 38,
          "paragraph_to": 38
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_087_05",
      "史略名称": "何休",
      "史略简介": "何休",
      "原文字句": "何休字邵公，任城樊人也。父豹，少府。休为人质朴讷口，而雅有心思，精研《六经》，世儒无及者。以列卿子诏拜郎中，非其好也，辞疾而去。不仕州郡。进退必以礼。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 57,
          "paragraph_to": 59
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_087_06",
      "史略名称": "许慎",
      "史略简介": "许慎",
      "原文字句": "许慎字叔重，汝南召陵人也。性淳笃，少博学经籍，马融常推敬之，时人为之语曰：“《五经》无双许叔重。”为郡功曹，举孝廉，再迁除洨长。卒于家。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷87·儒林列传第六十九下》",
      "paragraphs": [
        {
          "volume": "儒林列传第六十九下",
          "paragraph_from": 67,
          "paragraph_to": 68
        }
      ]
    }
  ]
