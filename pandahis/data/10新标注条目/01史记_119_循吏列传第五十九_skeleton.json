    {
      "史略ID": "SHIJI_119_02",
      "史略名称": "子产",
      "史略简介": "子产",
      "原文字句": "子产者，郑之列大夫也。郑昭君之时，以所爱徐挚为相，国乱，上下不亲，父子不和。大宫子期言之君，以子产为相。为相一年，竖子不戏狎，斑白不提挈，僮子不犁畔。二年，市不豫贾。三年，门不夜关，道不拾遗。四年，田器不归。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷119·循吏列传》",
      "paragraphs": [
        {
          "volume": "循吏列传",
          "paragraph_from": 7,
          "paragraph_to": 8
        }
      ],
      "五级细坐标": "史记·卷119·文臣·02",
      "六级段落锚点": "[P7-P8]",
