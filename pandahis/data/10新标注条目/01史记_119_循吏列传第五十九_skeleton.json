    },
    {
      "史略ID": "SHIJI_119_03",
      "史略名称": "公仪休",
      "史略简介": "公仪休",
      "原文字句": "公仪休者，鲁博士也。以高弟为鲁相。奉法循理，无所变更，百官自正。使食禄者不得与下民争利，受大者不得取小。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷119·循吏列传》",
      "paragraphs": [
