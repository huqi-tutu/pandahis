    {
      "史略ID": "SANGUOZHI_048_01",
      "史略名称": "吴会稽王",
      "史略简介": "吴会稽王",
      "原文字句": "孙亮字子明，权少子也。权春秋高，而亮最少，故尤留意。姊全公主尝谮太子和子母，心不自安，因倚权意，欲豫自结，数称述全尚女，劝为亮纳。赤乌十三年，和废，权遂立亮为太子，以全氏为妃。",
      "史略分类": "君王",
      "主要史料出处": "《04三国志·卷48·三嗣主传》",
      "paragraphs": [
