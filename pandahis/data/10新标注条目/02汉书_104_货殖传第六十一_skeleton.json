    {
      "史略ID": "HANSHU_104_04",
      "史略名称": "蜀卓氏",
      "史略简介": "蜀卓氏",
      "原文字句": "蜀卓氏之先，赵人也，用铁冶富。秦破赵，迁卓氏之蜀，夫妻推辇行。诸迁虏少有余财，急与吏，求近处，处葭萌。唯卓氏曰：“此地狭薄。吾闻崏山之下沃野，下有踆鸱，至死不饥。民工作布，易贾。”乃求远迁。致之临邛，大憙，即铁山鼓铸，运筹算，贾滇、蜀民，富至童八百人，田池射猎之乐拟于人君。",
      "史略分类": "庶众",
      "主要史料出处": "《02汉书·卷104·货殖传》",
      "paragraphs": [
        {
          "volume": "货殖传",
          "paragraph_from": 14,
          "paragraph_to": 14
