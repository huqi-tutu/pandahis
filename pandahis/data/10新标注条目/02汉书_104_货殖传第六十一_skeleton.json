      "史略ID": "HANSHU_104_03",
      "史略名称": "猗顿",
      "史略简介": "猗顿",
      "原文字句": "猗顿用盬盐起，邯郸郭纵以铸冶成业，与王者埒富。",
      "史略分类": "庶众",
      "主要史料出处": "《02汉书·卷104·货殖传》",
      "paragraphs": [
