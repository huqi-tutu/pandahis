      ],
      "五级细坐标": "汉书·卷104·庶众·04",
      "六级段落锚点": "[P14]",
      "原文出处": "货殖传·P14"
    },
    {
      "史略ID": "HANSHU_104_05",
      "史略名称": "罗裒",
      "史略简介": "罗裒",
      "原文字句": "程、卓既衰，至成、哀间，成都罗裒訾至巨万。初，裒贾京师，随身数十百万，为平陵石氏持钱。其人强力。石氏訾次如、苴，亲信，厚资遣之，令往来巴、蜀，数年间致千余万。裒举其半赂遗曲阳、定陵侯，依其权力，赊贷郡国，人莫敢负。擅盐井之利，期年所得自倍，遂殖其货。",
      "史略分类": "庶众",
      "主要史料出处": "《02汉书·卷104·货殖传》",
