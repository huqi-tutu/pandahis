  "entries": [
    {
      "史略ID": "HOUHANSHU_067_01",
      "史略名称": "左雄",
      "史略简介": "左雄",
      "原文字句": "左雄字伯豪，南阳涅阳人也。安帝时，举孝廉，稍迁冀州刺史。州部多豪族，好请托，雄常闭门不与交通。奏案贪猾二千石，无所回忌。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷67·左周黄列传》",
      "paragraphs": [
        {
          "volume": "左周黄列传",
          "paragraph_from": 2,
          "paragraph_to": 15
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_067_02",
      "史略名称": "周举",
      "史略简介": "周举",
      "原文字句": "周举字宣光，汝南汝阳人，陈留太守防之子。防在《儒林传》。举姿貌短陋，而博学洽闻，为儒者所宗，故京师为之语曰：“《五经》从横周宣光。”",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷67·左周黄列传》",
      "paragraphs": [
        {
          "volume": "左周黄列传",
          "paragraph_from": 16,
          "paragraph_to": 30
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_067_03",
      "史略名称": "黄琼",
      "史略简介": "黄琼",
      "原文字句": "黄琼字世英，江夏安陆人，魏郡太守香之子也。香在《文苑传》。琼初以父任为太子舍人，辞病不就。遭父忧，服阕，五府俱辟，连年不应。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷67·左周黄列传》",
      "paragraphs": [
        {
          "volume": "左周黄列传",
