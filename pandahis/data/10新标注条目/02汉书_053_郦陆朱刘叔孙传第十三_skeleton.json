          "paragraph_to": 16
        }
      ],
      "五级细坐标": "汉书·卷053·文臣·02",
      "六级段落锚点": "[P10-P16]",
      "原文出处": "郦陆朱刘叔孙传·P10-P16"
    },
    {
      "史略ID": "HANSHU_053_03",
      "史略名称": "朱建",
      "史略简介": "朱建",
      "原文字句": "朱建，楚人也。故尝为淮南王黥布相，有罪去，后复事布。布欲反时，问建，建谏止之。布不听，听梁父侯，遂反。汉既诛布，闻建谏之，高祖赐建号平原君，家徙长安。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷53·郦陆朱刘叔孙传》",
      "paragraphs": [
        {
          "volume": "郦陆朱刘叔孙传",
          "paragraph_from": 17,
          "paragraph_to": 21
        }
      ],
      "五级细坐标": "汉书·卷053·文臣·03",
      "六级段落锚点": "[P17-P21]",
      "原文出处": "郦陆朱刘叔孙传·P17-P21"
    },
    {
      "史略ID": "HANSHU_053_04",
      "史略名称": "刘敬",
      "史略简介": "刘敬",
      "原文字句": "娄敬，齐人也。汉五年，戍陇西，过雒阳，高帝在焉。敬脱挽辂，见齐人虞将军曰：“臣愿见上言便宜。”虞将军欲与鲜衣，敬曰：“臣衣帛，衣帛见，衣褐，衣褐见，不敢易衣。”虞将军入言上，上召见，赐食。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷53·郦陆朱刘叔孙传》",
      "paragraphs": [
        {
          "volume": "郦陆朱刘叔孙传",
          "paragraph_from": 22,
          "paragraph_to": 26
        }
      ],
      "五级细坐标": "汉书·卷053·文臣·04",
      "六级段落锚点": "[P22-P26]",
      "原文出处": "郦陆朱刘叔孙传·P22-P26"
    },
    {
      "史略ID": "HANSHU_053_05",
      "史略名称": "叔孙通",
      "史略简介": "叔孙通",
      "原文字句": "叔孙通，薛人也。秦时以文学征，待诏博士。数岁，陈胜起，二世召博士诸儒生问曰：“楚戍卒攻蕲入陈，于公何如？”博士诸生三十余人前曰：“人臣无将，将则反，罪死无赦。愿陛下急发兵击之。”二世怒，作色。通前曰：“诸生言皆非。夫天下为一家，毁郡县城，铄其兵，视天下弗复用。且明主在上，法令具于下，吏人人奉职，四方辐辏，安有反者！此特群盗鼠窃狗盗，何足置齿牙间哉？郡守尉今捕诛，何足忧？”二世喜，尽问诸生，诸生或言",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷53·郦陆朱刘叔孙传》",
