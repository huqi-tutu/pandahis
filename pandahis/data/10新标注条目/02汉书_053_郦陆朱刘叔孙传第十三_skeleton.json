    {
      "史略ID": "HANSHU_053_02",
      "史略名称": "陆贾",
      "史略简介": "陆贾",
      "原文字句": "陆贾，楚人也。以客从高祖定天下，名有口辩，居左右，常使诸侯。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷53·郦陆朱刘叔孙传》",
      "paragraphs": [
        {
          "volume": "郦陆朱刘叔孙传",
