  "entries": [
    {
      "史略ID": "SHIJI_052_01",
      "史略名称": "齐悼惠王刘肥",
      "史略简介": "齐悼惠王刘肥",
      "原文字句": "齐悼惠王刘肥者，高祖长庶男也。其母外妇也，曰曹氏。高祖六年，立肥为齐王，食七十城，诸民能齐言者皆予齐王。",
      "史略分类": "宗戚",
      "主要史料出处": "《史记·卷52·齐悼惠王世家》",
      "paragraphs": [
        {
          "volume": "齐悼惠王世家",
          "paragraph_from": 1,
          "paragraph_to": 4
        }
      ],
      "五级细坐标": "史记·卷052·宗戚·01",
      "六级段落锚点": "[P1-P4]",
      "原文出处": "齐悼惠王世家·P1-P4"
    },
    {
      "史略ID": "SHIJI_052_02",
      "史略名称": "刘襄",
      "史略简介": "刘襄",
      "原文字句": "悼惠王即位十三年，以惠帝六年卒。子襄立，是为哀王。",
      "史略分类": "宗戚",
      "主要史料出处": "《史记·卷52·齐悼惠王世家》",
      "paragraphs": [
        {
          "volume": "齐悼惠王世家",
          "paragraph_from": 4,
          "paragraph_to": 24
        }
      ],
      "五级细坐标": "史记·卷052·宗戚·02",
      "六级段落锚点": "[P4-P24]",
      "原文出处": "齐悼惠王世家·P4-P24"
    },
    {
      "史略ID": "SHIJI_052_03",
      "史略名称": "刘则",
      "史略简介": "刘则",
      "原文字句": "是岁，齐哀王卒，太子则立，是为文王。",
      "史略分类": "宗戚",
      "主要史料出处": "《史记·卷52·齐悼惠王世家》",
      "paragraphs": [
        {
          "volume": "齐悼惠王世家",
          "paragraph_from": 24,
          "paragraph_to": 28
        }
      ],
      "五级细坐标": "史记·卷052·宗戚·03",
      "六级段落锚点": "[P24-P28]",
      "原文出处": "齐悼惠王世家·P24-P28"
    },
    {
      "史略ID": "SHIJI_052_04",
      "史略名称": "刘将闾",
      "史略简介": "刘将闾",
      "原文字句": "后一岁，孝文帝以所封悼惠王子分齐为王，齐孝王将闾以悼惠王子杨虚侯为齐王。故齐别郡尽以王悼惠王子：子志为济北王，子辟光为济南王，子贤为菑川王，子卬为胶西王，子雄渠为胶东王，与城阳、齐凡七王。",
      "史略分类": "宗戚",
      "主要史料出处": "《史记·卷52·齐悼惠王世家》",
      "paragraphs": [
        {
          "volume": "齐悼惠王世家",
          "paragraph_from": 29,
          "paragraph_to": 31
        }
      ],
      "五级细坐标": "史记·卷052·宗戚·04",
      "六级段落锚点": "[P29-P31]",
      "原文出处": "齐悼惠王世家·P29-P31"
    },
    {
      "史略ID": "SHIJI_052_05",
      "史略名称": "刘次景",
      "史略简介": "刘次景",
      "原文字句": "已而复闻齐初与三国有谋，将欲移兵伐齐。齐孝王惧，乃饮药自杀。景帝闻之，以为齐首善，以迫劫有谋，非其罪也，乃立孝王太子寿为齐王，是为懿王，续齐后。而胶西、胶东、济南、菑川王咸诛灭，地入于汉。徙济北王王菑川。齐懿王立二十二年卒，子次景立，是为厉王。",
      "史略分类": "宗戚",
      "主要史料出处": "《史记·卷52·齐悼惠王世家》",
      "paragraphs": [
        {
          "volume": "齐悼惠王世家",
