  "entries": [
    {
      "史略ID": "SHIJI_032_01",
      "史略名称": "齐太公",
      "史略简介": "齐太公",
      "原文字句": "太公望吕尚者，东海上人。其先祖尝为四岳，佐禹平水土甚有功。虞夏之际封於吕，或封於申，姓姜氏。夏商之时，申、吕或封枝庶子孙，或为庶人，尚其后苗裔也。本姓姜氏，从其封姓，故曰吕尚。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷32·齐太公世家》",
      "paragraphs": [
        {
          "volume": "齐太公世家",
          "paragraph_from": 1,
          "paragraph_to": 11
        }
      ],
      "五级细坐标": "史记·卷032·诸侯·01",
      "六级段落锚点": "[P1-P11]",
      "原文出处": "齐太公世家·P1-P11"
    },
    {
      "史略ID": "SHIJI_032_02",
      "史略名称": "齐平公",
      "史略简介": "齐平公",
      "原文字句": "子我归，属徒攻闱与大门，皆弗胜，乃出。田氏追之。丰丘人执子我以告，杀之郭关。成子将杀大陆子方，田逆请而免之。以公命取车於道，出雍门。田豹与之车，弗受，曰：“逆为余请，豹与余车，余有私焉。事子我而有私於其雠，何以见鲁、卫之士？”庚辰，田常执简公于俆州。公曰：“余蚤从御鞅言，不及此。”甲午，田常弑简公于袪州。田常乃立简公弟骜，是为平公。平公即位，田常相之，专齐之政，割齐安平以东为田氏封邑。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷32·齐太公世家》",
      "paragraphs": [
        {
          "volume": "齐太公世家",
          "paragraph_from": 92,
          "paragraph_to": 93
        }
      ],
      "五级细坐标": "史记·卷032·诸侯·02",
      "六级段落锚点": "[P92-P93]",
      "原文出处": "齐太公世家·P92-P93"
    },
    {
      "史略ID": "SHIJI_032_03",
      "史略名称": "齐景公",
      "史略简介": "齐景公",
      "原文字句": "丁丑，崔杼立庄公异母弟杵臼，是为景公。景公母，鲁叔孙宣伯女也。景公立，以崔杼为右相，庆封为左相。二相恐乱起，乃与国人盟曰：“不与崔庆者死！”",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷32·齐太公世家》",
      "paragraphs": [
        {
          "volume": "齐太公世家",
          "paragraph_from": 73,
          "paragraph_to": 85
        }
      ],
      "五级细坐标": "史记·卷032·诸侯·03",
      "六级段落锚点": "[P73-P85]",
      "原文出处": "齐太公世家·P73-P85"
    },
    {
      "史略ID": "SHIJI_032_04",
      "史略名称": "齐桓公",
      "史略简介": "齐桓公",
      "原文字句": "初，襄公之醉杀鲁桓公，通其夫人，杀诛数不当，淫於妇人，数欺大臣，群弟恐祸及，故次弟纠奔鲁。其母鲁女也。管仲、召忽傅之。次弟小白奔莒，鲍叔傅之。小白母，卫女也，有宠於釐公。小白自少好善大夫高傒。及雍林人杀无知，议立君，高、国先阴召小白於莒。鲁闻无知死，亦发兵送公子纠，而使管仲别将兵遮莒道，射中小白带钩。小白详死，管仲使人驰报鲁。鲁送纠者行益迟，六日至齐，则小白已入，高傒立之，是为桓公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷32·齐太公世家》",
      "paragraphs": [
        {
          "volume": "齐太公世家",
          "paragraph_from": 31,
          "paragraph_to": 52
        }
      ],
      "五级细坐标": "史记·卷032·诸侯·04",
      "六级段落锚点": "[P31-P52]",
      "原文出处": "齐太公世家·P31-P52"
    },
    {
      "史略ID": "SHIJI_032_05",
      "史略名称": "齐襄公",
      "史略简介": "齐襄公",
      "原文字句": "三十三年，釐公卒，太子诸儿立，是为襄公。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷32·齐太公世家》",
