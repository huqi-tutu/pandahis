    {
      "史略ID": "HOUHANSHU_058_01",
      "史略名称": "周燮",
      "史略简介": "周燮",
      "原文字句": "周燮字彦祖，汝南安城人，决曹掾燕之后也。燮生而钦颐折頞，丑状骇人。其母欲弃之，其父不听，曰：“吾闻贤圣多有异貌。兴我宗者，乃此儿也。”于是养之。",
      "史略分类": "庶众",
      "主要史料出处": "《03后汉书·卷58·周黄徐姜申屠列传》",
      "paragraphs": [
        {
          "volume": "周黄徐姜申屠列传",
          "paragraph_from": 7,
          "paragraph_to": 10
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_058_02",
      "史略名称": "黄宪",
      "史略简介": "黄宪",
      "原文字句": "黄宪字叔度，汝南慎阳人也。世贫贱，父为牛医。",
      "史略分类": "庶众",
      "主要史料出处": "《03后汉书·卷58·周黄徐姜申屠列传》",
      "paragraphs": [
        {
          "volume": "周黄徐姜申屠列传",
          "paragraph_from": 11,
          "paragraph_to": 13
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_058_03",
      "史略名称": "徐稚",
      "史略简介": "徐稚",
      "原文字句": "徐稺，字孺子，豫章南昌人也。家贫，常自耕稼，非其力不食。恭俭义让，所居服其德。屡辟公府，不起。",
      "史略分类": "庶众",
      "主要史料出处": "《03后汉书·卷58·周黄徐姜申屠列传》",
      "paragraphs": [
        {
          "volume": "周黄徐姜申屠列传",
          "paragraph_from": 15,
          "paragraph_to": 20
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_058_04",
      "史略名称": "姜肱",
      "史略简介": "姜肱",
      "原文字句": "姜肱字伯淮，彭城广戚人也。家世名族。肱与二弟仲海、季江，俱以孝行著闻。其友爱天至，常共卧起。及各娶妻，兄弟相恋，不能别寝，以系嗣当立，乃递往就室。",
      "史略分类": "庶众",
      "主要史料出处": "《03后汉书·卷58·周黄徐姜申屠列传》",
      "paragraphs": [
        {
          "volume": "周黄徐姜申屠列传",
          "paragraph_from": 22,
          "paragraph_to": 26
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_058_05",
      "史略名称": "申屠蟠",
      "史略简介": "申屠蟠",
      "原文字句": "申屠蟠字子龙，陈留外黄人也。九岁丧父，哀毁过礼。服除，不进酒肉十余年。每忌日，辄三日不食。",
      "史略分类": "庶众",
      "主要史料出处": "《03后汉书·卷58·周黄徐姜申屠列传》",
      "paragraphs": [
        {
          "volume": "周黄徐姜申屠列传",
          "paragraph_from": 27,
          "paragraph_to": 34
        }
      ]
    }
