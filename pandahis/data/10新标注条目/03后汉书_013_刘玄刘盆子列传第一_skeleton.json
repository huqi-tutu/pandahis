  "entries": [
    {
      "史略ID": "HOUHANSHU_013_01",
      "史略名称": "汉更始帝",
      "史略简介": "汉更始帝",
      "原文字句": "刘玄字圣公，光武族兄也。弟为人所杀，圣公结客欲报之。客犯法，圣公避吏于平林。吏系圣公父子张。圣公诈死，使人持丧归舂陵，吏乃出子张，圣公因自逃匿。",
      "史略分类": "君王",
      "主要史料出处": "《03后汉书·卷13·刘玄刘盆子列传》",
