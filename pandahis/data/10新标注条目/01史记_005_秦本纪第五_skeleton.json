  "entries": [
    {
      "史略ID": "SHIJI_005_01",
      "史略名称": "秦孝公",
      "史略简介": "秦孝公",
      "原文字句": "孝公元年，河山以东彊国六，与齐威、楚宣、魏惠、燕悼、韩哀、赵成侯并。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷5·秦本纪》",
      "paragraphs": [
        {
          "volume": "秦本纪",
          "paragraph_from": 82,
          "paragraph_to": 93
        }
      ],
      "五级细坐标": "史记·卷005·诸侯·01",
      "六级段落锚点": "[P82-P93]",
      "原文出处": "秦本纪·P82-P93"
    },
    {
      "史略ID": "SHIJI_005_02",
      "史略名称": "秦庄襄王",
      "史略简介": "秦庄襄王",
      "原文字句": "庄襄王元年，大赦罪人，修先王功臣，施德厚骨肉而布惠於民。东周君与诸侯谋秦，秦使相国吕不韦诛之，尽入其国。秦不绝其祀，以阳人地赐周君，奉其祭祀。使蒙骜伐韩，韩献成皋、巩。秦界至大梁，初置三川郡。二年，使蒙骜攻赵，定太原。三年，蒙骜攻魏高都、汲，拔之。攻赵榆次、新城、狼孟，取三十七城。四月日食。王龁攻上党。初置太原郡。魏将无忌率五国兵击秦，秦卻於河外。蒙骜败，解而去。五月丙午，庄襄王卒，子政立，是为秦",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷5·秦本纪》",
      "paragraphs": [
        {
          "volume": "秦本纪",
          "paragraph_from": 115,
          "paragraph_to": 115
        }
      ],
      "五级细坐标": "史记·卷005·诸侯·02",
      "六级段落锚点": "[P115]",
      "原文出处": "秦本纪·P115"
    },
    {
      "史略ID": "SHIJI_005_03",
      "史略名称": "秦昭襄王",
      "史略简介": "秦昭襄王",
      "原文字句": "昭襄王元年，严君疾为相。甘茂出之魏。二年，彗星见。庶长壮与大臣、诸侯、公子为逆，皆诛，及惠文后皆不得良死。悼武王后出归魏。三年，王冠。与楚王会黄棘，与楚上庸。四年，取蒲阪。彗星见。五年，魏王来朝应亭，复与魏蒲阪。六年，蜀侯煇反，司马错定蜀。庶长奂伐楚，斩首二万。泾阳君质於齐。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷5·秦本纪》",
      "paragraphs": [
        {
          "volume": "秦本纪",
          "paragraph_from": 100,
          "paragraph_to": 113
        }
      ],
      "五级细坐标": "史记·卷005·诸侯·03",
      "六级段落锚点": "[P100-P113]",
      "原文出处": "秦本纪·P100-P113"
    },
    {
      "史略ID": "SHIJI_005_04",
      "史略名称": "秦穆公",
      "史略简介": "秦穆公",
      "原文字句": "缪公任好元年，自将伐茅津，胜之。四年，迎妇於晋，晋太子申生姊也。其岁，齐桓公伐楚，至邵陵。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷5·秦本纪》",
      "paragraphs": [
        {
          "volume": "秦本纪",
          "paragraph_from": 30,
          "paragraph_to": 58
        }
      ],
      "五级细坐标": "史记·卷005·诸侯·04",
      "六级段落锚点": "[P30-P58]",
      "原文出处": "秦本纪·P30-P58"
    },
    {
      "史略ID": "SHIJI_005_05",
      "史略名称": "非子",
      "史略简介": "非子",
      "原文字句": "非子居犬丘，好马及畜，善养息之。犬丘人言之周孝王，孝王召使主马于汧渭之间，马大蕃息。孝王欲以为大骆適嗣。申侯之女为大骆妻，生子成为適。申侯乃言孝王曰：“昔我先郦山之女，为戎胥轩妻，生中潏，以亲故归周，保西垂，西垂以其故和睦。今我复与大骆妻，生適子成。申骆重婚，西戎皆服，所以为王。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷5·秦本纪》",
      "paragraphs": [
        {
          "volume": "秦本纪",
          "paragraph_from": 8,
          "paragraph_to": 9
        }
      ],
      "五级细坐标": "史记·卷005·诸侯·05",
      "六级段落锚点": "[P8-P9]",
      "原文出处": "秦本纪·P8-P9"
    }
  ]
