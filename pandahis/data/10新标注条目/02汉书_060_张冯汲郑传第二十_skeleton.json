    {
      "史略ID": "HANSHU_060_02",
      "史略名称": "冯唐",
      "史略简介": "冯唐",
      "原文字句": "冯唐，祖父赵人也。父徙代。汉兴徙安陵。唐以孝著，为郎中署长，事文帝。帝辇过，问唐曰：“父老何自为郎？家安在？”具以实言。文帝曰：“吾居代时，吾尚食监高祛数为我言赵将李齐之贤，战于巨鹿下。吾每饮食，意未尝不在巨鹿也。父老知之乎？”唐对曰：“齐尚不如廉颇、李牧之为将也。”上曰：“何已？”唐曰：“臣大父在赵时，为官帅将，善李牧。臣父故为代相，善李齐，知其为人也。”上既闻廉颇、李牧为人，良说，乃拊髀曰：“",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷60·张冯汲郑传》",
      "paragraphs": [
        {
          "volume": "张冯汲郑传",
          "paragraph_from": 12,
          "paragraph_to": 14
        }
      ],
      "五级细坐标": "汉书·卷060·文臣·02",
      "六级段落锚点": "[P12-P14]",
      "原文出处": "张冯汲郑传·P12-P14"
    },
    {
      "史略ID": "HANSHU_060_03",
      "史略名称": "汲黯",
      "史略简介": "汲黯",
      "原文字句": "汲黯字长孺，濮阳人也。其行有宠于古之卫君也。至黯十世，世为卿大夫。以父任，孝景时为太子洗马，以严见惮。",
      "史略分类": "文臣",
      "主要史料出处": "《02汉书·卷60·张冯汲郑传》",
      "paragraphs": [
