    {
      "史略ID": "SHIJI_062_02",
      "史略名称": "晏婴",
      "史略简介": "晏婴",
      "原文字句": "晏平仲婴者，莱之夷维人也。事齐灵公、庄公、景公，以节俭力行重於齐。",
      "史略分类": "文臣",
