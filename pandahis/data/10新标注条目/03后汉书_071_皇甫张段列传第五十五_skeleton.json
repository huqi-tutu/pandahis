  "entries": [
    {
      "史略ID": "HOUHANSHU_071_01",
      "史略名称": "皇甫规",
      "史略简介": "皇甫规",
      "原文字句": "皇甫规字威明，安定朝那人也。祖父棱，度辽将军。父旗，扶风都尉。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷71·皇甫张段列传》",
      "paragraphs": [
        {
          "volume": "皇甫张段列传",
          "paragraph_from": 2,
          "paragraph_to": 22
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_071_02",
      "史略名称": "张奂",
      "史略简介": "张奂",
      "原文字句": "张奂字然明，敦煌渊泉人也。父惇，为汉阳太守。奂少游三辅，师事太尉朱宠，学《欧阳尚书》。初，《牟氏章句》浮辞繁多，有四十五万余言，奂减为九万言。后辟大将军梁冀府，乃上书桓帝，奏其《章句》，诏下东观，以疾去官，复举贤良，对策第一，擢拜议郎。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷71·皇甫张段列传》",
      "paragraphs": [
        {
          "volume": "皇甫张段列传",
          "paragraph_from": 24,
          "paragraph_to": 42
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_071_03",
      "史略名称": "段颎",
      "史略简介": "段颎",
      "原文字句": "段颎字纪明，武威姑臧人也。其先出郑共叔段，西域都护会宗之从曾孙也。颎少便习弓马，尚游侠，轻财贿，长乃折节好古学。初举孝廉，为宪陵园丞、阳陵令，所在有能政。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷71·皇甫张段列传》",
      "paragraphs": [
        {
          "volume": "皇甫张段列传",
