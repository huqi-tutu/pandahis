  "entries": [
    {
      "史略ID": "HOUHANSHU_077_01",
      "史略名称": "皇甫嵩",
      "史略简介": "皇甫嵩",
      "原文字句": "皇甫嵩字义真，安定朝那人，度辽将军规之兄子也。父节，雁门太守。嵩少有文武志介，好《诗》《书》，习弓马。初举孝廉、茂才。太尉陈蕃、大将军窦武连辟，并不到。灵帝公车征为议郎，迁北地太守。",
      "史略分类": "武将",
      "主要史料出处": "《03后汉书·卷77·皇甫嵩朱俊列传》",
      "paragraphs": [
