    {
      "史略ID": "SHIJI_121_04",
      "史略名称": "辕固生",
      "史略简介": "辕固生",
      "原文字句": "清河王太傅辕固生者，齐人也。以治诗，孝景时为博士。与黄生争论景帝前。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷121·儒林列传》",
      "paragraphs": [
        {
          "volume": "儒林列传",
          "paragraph_from": 13,
          "paragraph_to": 17
        }
      ],
      "五级细坐标": "史记·卷121·文臣·04",
      "六级段落锚点": "[P13-P17]",
      "原文出处": "儒林列传·P13-P17"
    },
    {
      "史略ID": "SHIJI_121_05",
      "史略名称": "韩婴",
      "史略简介": "韩婴",
      "原文字句": "韩生者，燕人也。孝文帝时为博士，景帝时为常山王太傅。韩生推诗之意而为内外传数万言，其语颇与齐鲁间殊，然其归一也。淮南贲生受之。自是之后，而燕赵间言诗者由韩生。韩生孙商为今上博士。",
      "史略分类": "文臣",
      "主要史料出处": "《史记·卷121·儒林列传》",
