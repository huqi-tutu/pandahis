  "entries": [
    {
      "史略ID": "HANSHU_045_01",
      "史略名称": "荆王刘贾",
      "史略简介": "荆王刘贾",
      "原文字句": "荆王刘贾，高帝从父兄也，不知其初起时。汉元年，还定三秦，贾为将军，定塞地，从东击项籍。",
      "史略分类": "宗戚",
      "主要史料出处": "《02汉书·卷45·荆燕吴传》",
      "paragraphs": [
