    {
      "史略ID": "SHIJI_037_03",
      "史略名称": "卫庄公",
      "史略简介": "卫庄公",
      "原文字句": "武公即位，修康叔之政，百姓和集。四十二年，犬戎杀周幽王，武公将兵往佐周平戎，甚有功，周平王命武公为公。五十五年，卒，子庄公扬立。",
      "史略分类": "诸侯",
      "主要史料出处": "《史记·卷37·卫康叔世家》",
      "paragraphs": [
        {
