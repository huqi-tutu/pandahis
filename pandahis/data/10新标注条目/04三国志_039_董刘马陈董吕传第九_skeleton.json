    {
      "史略ID": "SANGUOZHI_039_03",
      "史略名称": "马良",
      "史略简介": "马良",
      "原文字句": "马良字季常，襄阳宜城人也。兄弟五人，并有才名，乡里为之谚曰：“马氏五常，白眉最良。”良眉中有白毛，故以称之。先主领荆州，辟为从事。及先主入蜀，诸葛亮亦从后往，良留荆州，与亮书曰：“闻雒城已拔，此天祚也。尊兄应期赞世，配业光国，魄兆见矣。夫变用雅虑，审贵垂明，于以简才，宜適其时。若乃和光悦远，迈德天壤，使时闲于听，世服于道，齐高妙之音，正郑、卫之声，并利于事，无相夺伦，此乃管弦之至，牙、旷之调也。虽",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷39·董刘马陈董吕传》",
      "paragraphs": [
        {
          "volume": "董刘马陈董吕传",
          "paragraph_from": 6,
          "paragraph_to": 10
        }
      ]
