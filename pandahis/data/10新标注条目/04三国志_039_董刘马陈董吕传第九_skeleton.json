    {
      "史略ID": "SANGUOZHI_039_02",
      "史略名称": "刘巴",
      "史略简介": "刘巴",
      "原文字句": "刘巴字子初，零陵烝阳人也。少知名，荆州牧刘表连辟，及举茂才，皆不就。表卒，曹公征荆州。先主奔江南，荆、楚群士从之如云，而巴北诣曹公。曹公辟为掾，使招纳长沙、零陵、桂阳。会先主略有三郡，巴不得反使，遂远適交阯，先主深以为恨。",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷39·董刘马陈董吕传》",
      "paragraphs": [
        {
          "volume": "董刘马陈董吕传",
          "paragraph_from": 4,
          "paragraph_to": 5
        }
      ]
