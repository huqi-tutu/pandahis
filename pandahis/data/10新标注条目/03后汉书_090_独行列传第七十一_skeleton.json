  "entries": [
    {
      "史略ID": "HOUHANSHU_090_01",
      "史略名称": "谯玄",
      "史略简介": "谯玄",
      "原文字句": "谯玄字君黄，巴郡阆中人也。少好学，能说《易》《春秋》。仕于州郡。成帝永始二年，有日食之灾，乃诏举敦朴逊让、有行义者各一人。州举玄，诣公车，对策高第，拜议郎。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 4,
          "paragraph_to": 11
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_090_02",
      "史略名称": "李业",
      "史略简介": "李业",
      "原文字句": "李业字巨游，广汉梓潼人也。少有志操，介特。习《鲁诗》，师博士许晃。元始中，举明经，除为郎。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 12,
          "paragraph_to": 17
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_090_03",
      "史略名称": "范式",
      "史略简介": "范式",
      "原文字句": "范式字巨卿，山阳金乡人也，一名汜。少游太学，为诸生，与汝南张劭为友。劭字元伯。二人并告归乡里。式谓元伯曰：“后二年当还，将过拜尊亲，见孺子焉。”乃共克期日。后期方至，元伯具以白母，请设馔以候之。母曰：“二年之别，千里结言，尔何相信之审邪？”对曰：“巨卿信士，必不乖违。”母曰：“若然，当为尔酝酒。”至其日，巨卿果到，升堂拜饮，尽欢而别。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 36,
          "paragraph_to": 41
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_090_04",
      "史略名称": "陆续",
      "史略简介": "陆续",
      "原文字句": "陆续字智初，会稽吴人也。世为族姓。祖父闳，字子春，建武中为尚书令。美姿貌，喜着越布单衣，光武见而好之，自是常敕会稽郡献越布。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 48,
          "paragraph_to": 51
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_090_05",
      "史略名称": "范冉",
      "史略简介": "范冉",
      "原文字句": "范冉字史云，陈留外黄人也。少为县小吏，年十八，奉檄迎督邮，冉耻之，乃遁去。到南阳，受业于樊英。又游三辅，就马融通经，历年乃还。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 72,
          "paragraph_to": 77
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_090_06",
      "史略名称": "王烈",
      "史略简介": "王烈",
      "原文字句": "王烈字彦方，太原人也。少师事陈寔，以义行称乡里。有盗牛者，主得之，盗请罪曰：“刑戮是甘，乞不使王彦方知也。”烈闻而使人谢之，遗布一端。或问其故，烈曰：“盗惧吾闻其过，是有耻恶之心。既怀耻恶，必能改善，故以此激之。”后有老父遗剑于路，行道一人见而守之，至暮，老父还寻，得剑，怪而问其姓名，以事告烈。烈使推求，乃先盗牛者也。诸有争讼曲直，将质之于烈，或至涂而反，或望庐而还。其以德感人若此。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷90·独行列传》",
      "paragraphs": [
        {
          "volume": "独行列传",
          "paragraph_from": 91,
          "paragraph_to": 92
        }
      ]
    }
  ]
