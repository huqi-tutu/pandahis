  "entries": [
    {
      "史略ID": "HOUHANSHU_046_01",
      "史略名称": "第五伦",
      "史略简介": "第五伦",
      "原文字句": "第五伦字伯鱼，京兆长陵人也。其先齐诸田，诸田徙园陵者多，故以次第为氏。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷46·第五钟离宋寒列传》",
      "paragraphs": [
        {
          "volume": "第五钟离宋寒列传",
          "paragraph_from": 2,
          "paragraph_to": 20
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_046_02",
      "史略名称": "第五种",
      "史略简介": "第五种",
      "原文字句": "种字兴先，少厉志义，为吏，冠名州郡。永寿中，以司徒掾清诏使冀州，廉察灾害，举奏刺史、二千石以下，所刑免甚众，弃官奔走者数十人。还，以奉使称职，拜高密侯相。是时徐、兖二州盗贼群辈，高密在二州之郊，种乃大储粮稸，勤厉吏士，贼闻皆惮之，桴鼓不鸣，流民归者，岁中至数千家。以能换为卫相。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷46·第五钟离宋寒列传》",
      "paragraphs": [
        {
          "volume": "第五钟离宋寒列传",
          "paragraph_from": 22,
          "paragraph_to": 27
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_046_03",
      "史略名称": "钟离意",
      "史略简介": "钟离意",
      "原文字句": "钟离意字子阿，会稽山阴人也。少为郡督邮。时部县亭长有受人酒礼者，府下记案考之。意封还记，入言于太守曰：“《春秋》先内后外，《诗》云‘刑于寡妻，以御于家邦’，明政化之本，由近及远。今宜先清府内，且阔略远县细微之愆。”太守甚贤之，遂任以县事。建武十四年，会稽大疫，死者万数，意独身自隐亲，经给医药，所部多蒙全济。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷46·第五钟离宋寒列传》",
      "paragraphs": [
        {
          "volume": "第五钟离宋寒列传",
          "paragraph_from": 28,
          "paragraph_to": 39
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_046_04",
      "史略名称": "宋均",
      "史略简介": "宋均",
      "原文字句": "宋均字叔庠，南阳安众人也。父伯，建武初为五官中郎将。均以父任为郎，时年十五，好经书，每休沐日，辄受业博士，通《诗》《礼》，善论难。至二十余，调补辰阳长。其俗少学者而信巫鬼，均为立学校，禁绝淫祀，人皆安之。以祖母丧去官，客授颍川。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷46·第五钟离宋寒列传》",
      "paragraphs": [
        {
          "volume": "第五钟离宋寒列传",
          "paragraph_from": 40,
          "paragraph_to": 53
        }
      ]
    },
    {
      "史略ID": "HOUHANSHU_046_05",
      "史略名称": "寒朗",
      "史略简介": "寒朗",
      "原文字句": "寒朗字伯奇，鲁国薛人也。生三日，遭天下乱，弃之荆刺；数日兵解，母往视，犹尚气息，遂收养之。及长，好经学，博通书传，以《尚书》教授。举孝廉。",
      "史略分类": "文臣",
      "主要史料出处": "《03后汉书·卷46·第五钟离宋寒列传》",
      "paragraphs": [
        {
          "volume": "第五钟离宋寒列传",
          "paragraph_from": 54,
          "paragraph_to": 57
        }
      ]
    }
  ]
}
