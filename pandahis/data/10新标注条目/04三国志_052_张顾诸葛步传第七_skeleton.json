    {
      "史略ID": "SANGUOZHI_052_01",
      "史略名称": "张昭",
      "史略简介": "张昭",
      "原文字句": "张昭字子布，彭城人也。少好学，善隶书，从白侯子安受《左氏春秋》，博览众书，与琅邪赵昱、东海王朗俱发名友善。弱冠察孝廉，不就，与朗共论旧君讳事，州里才士陈琳等皆称善之。刺史陶谦举茂才，不应，谦以为轻己，遂见拘执。昱倾身营救，方以得免。汉末大乱，徐方士民多避难扬土，昭皆南渡江。孙策创业，命昭为长史、抚军中郎将，升堂拜母，如比肩之旧，文武之事，一以委昭。昭每得北方士大夫书疏，专归美于昭，昭欲嘿而不宣则惧",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷52·张顾诸葛步传》",
      "paragraphs": [
        {
          "volume": "张顾诸葛步传",
          "paragraph_from": 2,
          "paragraph_to": 10
        }
      ]
    },
    {
      "史略ID": "SANGUOZHI_052_02",
      "史略名称": "顾雍",
      "史略简介": "顾雍",
      "原文字句": "顾雍字元叹，吴郡吴人也。蔡伯喈从朔方还，尝避怨于吴，雍从学琴书。州郡表荐，弱冠为合肥长，后转在娄、曲阿、上虞，皆有治迹。孙权领会稽太守，不之郡，以雍为丞，行太守事，讨除寇贼，郡界宁静，吏民归服。数年，入为左司马。权为吴王，累迁大理奉常，领尚书令，封阳遂乡侯，拜侯还寺，而家人不知，后闻乃惊。",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷52·张顾诸葛步传》",
      "paragraphs": [
        {
          "volume": "张顾诸葛步传",
          "paragraph_from": 11,
          "paragraph_to": 16
        }
      ]
    },
    {
      "史略ID": "SANGUOZHI_052_03",
      "史略名称": "诸葛瑾",
      "史略简介": "诸葛瑾",
      "原文字句": "诸葛瑾字子瑜，琅邪阳都人也。汉末避乱江东。值孙策卒，孙权姊婿曲阿弘咨见而异之，荐之于权，与鲁肃等并见宾待，后为权长史，转中司马。建安二十年，权遣瑾使蜀通好刘备，与其弟亮俱公会相见，退无私面。",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷52·张顾诸葛步传》",
      "paragraphs": [
        {
          "volume": "张顾诸葛步传",
          "paragraph_from": 17,
          "paragraph_to": 22
        }
      ]
    },
    {
      "史略ID": "SANGUOZHI_052_04",
      "史略名称": "步骘",
      "史略简介": "步骘",
      "原文字句": "步骘字子山，临淮淮阴人也。世乱，避难江东，单身穷困，与广陵卫旌同年相善，俱以种瓜自给，昼勤四体，夜诵经传。",
      "史略分类": "文臣",
      "主要史料出处": "《04三国志·卷52·张顾诸葛步传》",
      "paragraphs": [
        {
          "volume": "张顾诸葛步传",
          "paragraph_from": 23,
          "paragraph_to": 31
        }
      ]
    }
  ]
